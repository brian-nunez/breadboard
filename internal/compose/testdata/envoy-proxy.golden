--- config/consul/consul.json (644)
{
  "addresses": {
    "http": "10.213.0.10"
  },
  "bind_addr": "{{ GetPrivateIP }}",
  "bootstrap_expect": 1,
  "client_addr": "0.0.0.0",
  "datacenter": "bb",
  "enable_agent_tls_for_checks": true,
  "encrypt_verify_incoming": true,
  "encrypt_verify_outgoing": true,
  "node_name": "consul",
  "ports": {
    "dns": -1,
    "grpc": -1,
    "grpc_tls": -1,
    "http": 8500,
    "https": 8501,
    "serf_wan": -1
  },
  "server": true,
  "tls": {
    "defaults": {
      "ca_file": "/etc/bb/ca.pem",
      "cert_file": "/etc/bb/tls/tls.crt",
      "key_file": "/etc/bb/tls/tls.key",
      "verify_incoming": false,
      "verify_outgoing": true
    },
    "internal_rpc": {
      "verify_incoming": true,
      "verify_server_hostname": false
    }
  },
  "ui_config": {
    "enabled": true
  }
}
--- tls/edge/tls.crt (644) 10 bytes
--- tls/edge/tls.key (644) 9 bytes
--- tls/edge/keystore.pem (644) 19 bytes
--- config/edge/envoy.yaml (644)
# envoy.yaml for edge, generated by Breadboard.
#
# HTTPS on :8443 with this service's certificate, then:
#   /web/ (prefix stripped), and every other request -> web (re-encrypt)
#   /v1/ (prefix stripped) -> api (terminate)
#   /consul/ (prefix stripped) -> consul (terminate)
# TLS on :9443 is routed by SNI without decrypting (passthrough):
#   SNI payments.bb.internal -> payments, which presents its own certificate
#
# To own this config, copy it next to experiment.yaml and set
# services.edge.file. The certificate (/etc/bb/tls/tls.crt, /etc/bb/tls/tls.key),
# the lab CA (/etc/bb/ca.pem) and the trust bundle stay mounted; keep the
# admin API on 127.0.0.1:15000, which the health check reads.

node:
  id: edge
  cluster: edge
# Loopback only: the health check reads /ready; explorers read
# /clusters and /stats through docker exec.
admin:
  address:
    socket_address:
      address: 127.0.0.1
      port_value: 15000
static_resources:
  listeners:
    # HTTPS on :8443 with this service's certificate.
    - name: https
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 8443
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: https
                codec_type: AUTO
                # Envoy is the edge: it sets X-Forwarded-Proto from the connection
                # (https) and appends the client's address to X-Forwarded-For.
                use_remote_address: true
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                route_config:
                  name: edge
                  virtual_hosts:
                    - name: edge
                      domains:
                        - '*'
                      routes:
                        # /web/ goes to web with the prefix replaced by /.
                        - match:
                            prefix: /web/
                          route:
                            cluster: web
                            prefix_rewrite: /
                        # /v1/ goes to api with the prefix replaced by /.
                        - match:
                            prefix: /v1/
                          route:
                            cluster: v1
                            prefix_rewrite: /
                        # /consul/ goes to consul with the prefix replaced by /.
                        - match:
                            prefix: /consul/
                          route:
                            cluster: consul
                            prefix_rewrite: /
                        # Routes match in order: every other path goes to the first upstream.
                        - match:
                            prefix: /
                          route:
                            cluster: web
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
          transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
              common_tls_context:
                # TLS 1.2 or newer (Envoy's default, written out).
                tls_params:
                  tls_minimum_protocol_version: TLSv1_2
                alpn_protocols:
                  - h2
                  - http/1.1
                tls_certificates:
                  - certificate_chain:
                      filename: /etc/bb/tls/tls.crt
                    private_key:
                      filename: /etc/bb/tls/tls.key
    # TLS on :9443 routed by SNI without decrypting (passthrough).
    # The TLS inspector reads the server name from the client's hello;
    # a name no filter chain matches has no chain, so Envoy closes it.
    - name: passthrough
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 9443
      listener_filters:
        - name: envoy.filters.listener.tls_inspector
          typed_config:
            '@type': type.googleapis.com/envoy.extensions.filters.listener.tls_inspector.v3.TlsInspector
      filter_chains:
        # Passthrough: the client's TLS session goes to every replica of payments untouched.
        - filter_chain_match:
            server_names:
              - payments.bb.internal
          filters:
            - name: envoy.filters.network.tcp_proxy
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy
                stat_prefix: tls_payments
                cluster: tls_payments
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
  clusters:
    # Re-encrypt: TLS to every replica of web, verified as web.bb.internal.
    - name: web
      # Strict DNS: every address web.bb.internal resolves to is a host;
      # Envoy re-resolves it every 5s, so replicas that start later join.
      # The DNS cluster extension is the successor of the STRICT_DNS type
      # and its deprecated dns_refresh_rate field.
      cluster_type:
        name: envoy.clusters.dns
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster
          dns_lookup_family: V4_ONLY
          dns_refresh_rate: 5s
      connect_timeout: 2s
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: web
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: web.bb.internal
                      port_value: 8443
      # Active checks: a host leaves the rotation after 3 failures and
      # comes back after 2 successes.
      health_checks:
        - timeout: 2s
          interval: 2s
          # Check every 2s even before the first request (Envoy's default
          # for a cluster without traffic is 60s).
          no_traffic_interval: 2s
          unhealthy_threshold: 3
          healthy_threshold: 2
          http_health_check:
            host: web.bb.internal
            path: /
            # Any answer below 500 means the server is up, so apps without a
            # handler for / stay in the rotation. Point path at a health endpoint
            # and narrow this in your own copy.
            expected_statuses:
              - start: 200
                end: 500
      # Re-encrypt: TLS with SNI web.bb.internal, verified against the lab CA
      # and matched to that name. Health checks use it too.
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: web.bb.internal
          common_tls_context:
            validation_context:
              trusted_ca:
                filename: /etc/bb/ca.pem
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher:
                    exact: web.bb.internal
    # Terminate: plaintext HTTP to every replica of api on its private segment.
    # Reason: practice TLS termination
    # and watch the requests
    - name: v1
      # Strict DNS: every address api.plain.bb.internal resolves to is a host;
      # Envoy re-resolves it every 5s, so replicas that start later join.
      # The DNS cluster extension is the successor of the STRICT_DNS type
      # and its deprecated dns_refresh_rate field.
      cluster_type:
        name: envoy.clusters.dns
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster
          dns_lookup_family: V4_ONLY
          dns_refresh_rate: 5s
      connect_timeout: 2s
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: v1
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: api.plain.bb.internal
                      port_value: 9090
      # Active checks: a host leaves the rotation after 3 failures and
      # comes back after 2 successes.
      health_checks:
        - timeout: 2s
          interval: 2s
          # Check every 2s even before the first request (Envoy's default
          # for a cluster without traffic is 60s).
          no_traffic_interval: 2s
          unhealthy_threshold: 3
          healthy_threshold: 2
          http_health_check:
            host: api.bb.internal
            path: /
            # Any answer below 500 means the server is up, so apps without a
            # handler for / stay in the rotation. Point path at a health endpoint
            # and narrow this in your own copy.
            expected_statuses:
              - start: 200
                end: 500
    # Terminate: plaintext HTTP to consul on its private segment.
    # Reason: plain HTTP API behind the proxy
    - name: consul
      # Strict DNS: every address consul.plain.bb.internal resolves to is a host;
      # Envoy re-resolves it every 5s, so replicas that start later join.
      # The DNS cluster extension is the successor of the STRICT_DNS type
      # and its deprecated dns_refresh_rate field.
      cluster_type:
        name: envoy.clusters.dns
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster
          dns_lookup_family: V4_ONLY
          dns_refresh_rate: 5s
      connect_timeout: 2s
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: consul
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: consul.plain.bb.internal
                      port_value: 8500
      # Active checks: a host leaves the rotation after 3 failures and
      # comes back after 2 successes.
      health_checks:
        - timeout: 2s
          interval: 2s
          # Check every 2s even before the first request (Envoy's default
          # for a cluster without traffic is 60s).
          no_traffic_interval: 2s
          unhealthy_threshold: 3
          healthy_threshold: 2
          http_health_check:
            host: consul.bb.internal
            path: /
            # Any answer below 500 means the server is up, so apps without a
            # handler for / stay in the rotation. Point path at a health endpoint
            # and narrow this in your own copy.
            expected_statuses:
              - start: 200
                end: 500
    # Passthrough: the client's TLS session goes to every replica of payments untouched.
    - name: tls_payments
      # Strict DNS: every address payments.bb.internal resolves to is a host;
      # Envoy re-resolves it every 5s, so replicas that start later join.
      # The DNS cluster extension is the successor of the STRICT_DNS type
      # and its deprecated dns_refresh_rate field.
      cluster_type:
        name: envoy.clusters.dns
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster
          dns_lookup_family: V4_ONLY
          dns_refresh_rate: 5s
      connect_timeout: 2s
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: tls_payments
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: payments.bb.internal
                      port_value: 8443
      # Active checks: a host leaves the rotation after 3 failures and
      # comes back after 2 successes.
      health_checks:
        - timeout: 2s
          interval: 2s
          # Check every 2s even before the first request (Envoy's default
          # for a cluster without traffic is 60s).
          no_traffic_interval: 2s
          unhealthy_threshold: 3
          healthy_threshold: 2
          # A TCP connect: Envoy cannot speak the backend's TLS for the client.
          tcp_health_check: {}
