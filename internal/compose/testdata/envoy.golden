--- ca.pem (644) 3 bytes
--- trust-bundle.pem (644) 9 bytes
--- tls/s3/tls.crt (644) 8 bytes
--- tls/s3/tls.key (644) 7 bytes
--- tls/s3/keystore.pem (644) 15 bytes
--- config/s3/security.toml (644)
# Generated by Breadboard: mutual TLS on every SeaweedFS gRPC port.
[grpc]
ca = "/etc/bb/ca.pem"

[grpc.master]
cert = "/etc/bb/tls/tls.crt"
key = "/etc/bb/tls/tls.key"
allowed_commonNames = "s3.bb.internal"

[grpc.volume]
cert = "/etc/bb/tls/tls.crt"
key = "/etc/bb/tls/tls.key"
allowed_commonNames = "s3.bb.internal"

[grpc.filer]
cert = "/etc/bb/tls/tls.crt"
key = "/etc/bb/tls/tls.key"
allowed_commonNames = "s3.bb.internal"

[grpc.s3]
cert = "/etc/bb/tls/tls.crt"
key = "/etc/bb/tls/tls.key"
allowed_commonNames = "s3.bb.internal"

[grpc.client]
cert = "/etc/bb/tls/tls.crt"
key = "/etc/bb/tls/tls.key"
--- tls/web-1/tls.crt (644) 11 bytes
--- tls/web-1/tls.key (644) 10 bytes
--- tls/web-1/keystore.pem (644) 21 bytes
--- config/web-1-envoy/envoy.yaml (644)
# Generated by Breadboard for web-1-envoy, the Envoy sidecar of web-1.
# To own this file, copy it next to experiment.yaml and set file: on the sidecar.
node:
  id: web-1-envoy
  cluster: web
admin:
  address:
    socket_address:
      address: 127.0.0.1
      port_value: 15000
static_resources:
  listeners:
    - name: inbound
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 8443
      traffic_direction: INBOUND
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: inbound
                codec_type: AUTO
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                route_config:
                  name: inbound
                  virtual_hosts:
                    - name: app
                      domains:
                        - '*'
                      routes:
                        - match:
                            prefix: /
                          route:
                            cluster: app
                      request_headers_to_add:
                        - header:
                            key: x-forwarded-proto
                            value: https
                          append_action: OVERWRITE_IF_EXISTS_OR_ADD
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
          transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
              common_tls_context:
                alpn_protocols:
                  - h2
                  - http/1.1
                tls_certificates:
                  - certificate_chain:
                      filename: /etc/bb/tls/tls.crt
                    private_key:
                      filename: /etc/bb/tls/tls.key
  clusters:
    - name: app
      type: STATIC
      connect_timeout: 1s
      load_assignment:
        cluster_name: app
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: 127.0.0.1
                      port_value: 8080
