--- tls/caller/tls.crt (644) 12 bytes
--- tls/caller/tls.key (644) 11 bytes
--- tls/caller/keystore.pem (644) 23 bytes
--- config/caller-envoy/envoy.yaml (644)
# Generated by Breadboard for caller-envoy, the Envoy sidecar of caller.
# To own this file, copy it next to experiment.yaml and set file: on the sidecar.
node:
  id: caller-envoy
  cluster: caller
admin:
  address:
    socket_address:
      address: 127.0.0.1
      port_value: 15000
static_resources:
  listeners:
    - name: outbound_web
      address:
        socket_address:
          address: 127.0.0.1
          port_value: 9001
      traffic_direction: OUTBOUND
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: outbound_web
                codec_type: AUTO
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                route_config:
                  name: outbound_web
                  virtual_hosts:
                    - name: web
                      domains:
                        - '*'
                      routes:
                        - match:
                            prefix: /
                          route:
                            cluster: outbound_web
                            timeout: 90s
                            retry_policy:
                              retry_on: connect-failure,refused-stream,reset,5xx
                              num_retries: 2
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
    - name: outbound_s3
      address:
        socket_address:
          address: 127.0.0.1
          port_value: 9002
      traffic_direction: OUTBOUND
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: outbound_s3
                codec_type: AUTO
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                route_config:
                  name: outbound_s3
                  virtual_hosts:
                    - name: s3
                      domains:
                        - '*'
                      routes:
                        - match:
                            prefix: /
                          route:
                            cluster: outbound_s3
                            timeout: 5s
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
  clusters:
    - name: outbound_web
      type: STRICT_DNS
      dns_lookup_family: V4_ONLY
      connect_timeout: 2s
      lb_policy: LEAST_REQUEST
      load_assignment:
        cluster_name: outbound_web
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: web.bb.internal
                      port_value: 8443
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: web.bb.internal
          common_tls_context:
            validation_context:
              trusted_ca:
                filename: /etc/bb/ca.pem
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher:
                    exact: web.bb.internal
      outlier_detection:
        consecutive_5xx: 3
        base_ejection_time: 30s
        max_ejection_percent: 10
        interval: 10s
    - name: outbound_s3
      type: STRICT_DNS
      dns_lookup_family: V4_ONLY
      connect_timeout: 2s
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: outbound_s3
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: s3.bb.internal
                      port_value: 8333
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: s3.bb.internal
          common_tls_context:
            validation_context:
              trusted_ca:
                filename: /etc/bb/ca.pem
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher:
                    exact: s3.bb.internal
--- docker-compose.yml (644)
# Generated for a golden test.
name: bb-lab
services:
  s3:
    image: chrislusf/seaweedfs:4.53
    entrypoint:
      - /bin/sh
      - -c
      - |-
        weed server -dir=/data -ip=127.0.0.1 -ip.bind=127.0.0.1 -master.volumeSizeLimitMB=1024 -s3 -s3.ip.bind=0.0.0.0 -s3.port=8333 -s3.cert.file=/etc/bb/tls/tls.crt -s3.key.file=/etc/bb/tls/tls.key -s3.port.iceberg=0 -s3.port.lance=0 &
        pid=$$!
        trap 'kill -TERM $$pid; wait $$pid; exit' TERM INT
        for b in $$(echo "$$BB_BUCKETS" | tr , ' '); do
          until curl -sf -o /dev/null --cacert /etc/bb/ca.pem --aws-sigv4 aws:amz:us-east-1:s3 --user "$$AWS_ACCESS_KEY_ID:$$AWS_SECRET_ACCESS_KEY" -I https://s3.bb.internal:8333/$$b || curl -sf -o /dev/null --cacert /etc/bb/ca.pem --aws-sigv4 aws:amz:us-east-1:s3 --user "$$AWS_ACCESS_KEY_ID:$$AWS_SECRET_ACCESS_KEY" -X PUT https://s3.bb.internal:8333/$$b; do sleep 1; done
        done
        wait $$pid
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      AWS_ACCESS_KEY_ID: ${S3__ACCESS_KEY_ID}
      AWS_SECRET_ACCESS_KEY: ${S3__SECRET_ACCESS_KEY}
      BB_BUCKETS: ""
    healthcheck:
      test: [CMD-SHELL, 'curl -sf -o /dev/null --cacert /etc/bb/ca.pem --aws-sigv4 aws:amz:us-east-1:s3 --user "$$AWS_ACCESS_KEY_ID:$$AWS_SECRET_ACCESS_KEY" https://s3.bb.internal:8333/']
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
      start_interval: 1s
    volumes:
      - s3-data:/data
      - ./tls/s3/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/s3/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/s3/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/s3/security.toml:/etc/seaweedfs/security.toml:ro
    networks:
      default:
        aliases: [s3.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: s3
      breadboard.kind: infra
      breadboard.config-hash: a5a15eb64d198dbb
    mem_limit: 512m
    cpus: 0.5
    restart: unless-stopped
  web-1-pod:
    image: alpine:3.24.4
    command: [sleep, infinity]
    init: true
    healthcheck:
      test: [CMD, "true"]
      interval: 10s
      timeout: 2s
      retries: 3
      start_period: 5s
      start_interval: 1s
    networks:
      default:
        aliases: [web-1.bb.internal, web.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: web-1-pod
      breadboard.kind: pod
      breadboard.capture: off
    mem_limit: 16m
    cpus: 0.05
    restart: unless-stopped
  web-1:
    build:
      context: ../../web
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: web-1
      BB_FQDN: web-1.bb.internal
      BB_SHARED_DIR: /var/run/bb
      # web-1-envoy (Envoy sidecar)
      BB_LISTEN_ADDR: 127.0.0.1:8080
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    depends_on:
      web-1-pod:
        condition: service_healthy
      web-1-envoy:
        condition: service_healthy
    volumes:
      - ./tls/web-1/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/web-1/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/web-1/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - web-1-shared:/var/run/bb
    network_mode: service:web-1-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: web-1
      breadboard.kind: app
      breadboard.capture: off
      breadboard.config-hash: 39dad408a5edf2ed
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  web-1-envoy:
    image: envoyproxy/envoy:v1.40.2
    command: [envoy, -c, /etc/bb/config/envoy.yaml, --service-node, web-1-envoy, --service-cluster, web]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
    healthcheck:
      test: [CMD, bash, -c, "exec 3<>/dev/tcp/127.0.0.1/15000 && printf 'GET /ready HTTP/1.1\\r\\nHost: 127.0.0.1\\r\\nConnection: close\\r\\n\\r\\n' >&3 && head -n 1 <&3 | grep -q ' 200'"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 30s
      start_interval: 1s
    depends_on:
      web-1-pod:
        condition: service_healthy
    volumes:
      - ./tls/web-1/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/web-1/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/web-1/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - web-1-shared:/var/run/bb
      - ./config/web-1-envoy/envoy.yaml:/etc/bb/config/envoy.yaml:ro
    network_mode: service:web-1-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: web-1-envoy
      breadboard.kind: sidecar
      breadboard.capture: off
      breadboard.config-hash: 7264542a2d378357
    mem_limit: 128m
    cpus: 0.25
    restart: unless-stopped
  web-2-pod:
    image: alpine:3.24.4
    command: [sleep, infinity]
    init: true
    healthcheck:
      test: [CMD, "true"]
      interval: 10s
      timeout: 2s
      retries: 3
      start_period: 5s
      start_interval: 1s
    networks:
      default:
        aliases: [web-2.bb.internal, web.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: web-2-pod
      breadboard.kind: pod
      breadboard.capture: off
    mem_limit: 16m
    cpus: 0.05
    restart: unless-stopped
  web-2:
    build:
      context: ../../web
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: web-2
