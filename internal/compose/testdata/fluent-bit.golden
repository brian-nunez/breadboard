--- ca.pem (644) 3 bytes
--- trust-bundle.pem (644) 9 bytes
--- tls/s3/tls.crt (644) 8 bytes
--- tls/s3/tls.key (644) 7 bytes
--- tls/s3/keystore.pem (644) 15 bytes
--- config/s3/security.toml (644)
# Generated by Breadboard: mutual TLS on every SeaweedFS gRPC port.
[grpc]
ca = "/etc/bb/ca.pem"

[grpc.master]
cert = "/etc/bb/tls/tls.crt"
key = "/etc/bb/tls/tls.key"
allowed_commonNames = "s3.bb.internal"

[grpc.volume]
cert = "/etc/bb/tls/tls.crt"
key = "/etc/bb/tls/tls.key"
allowed_commonNames = "s3.bb.internal"

[grpc.filer]
cert = "/etc/bb/tls/tls.crt"
key = "/etc/bb/tls/tls.key"
allowed_commonNames = "s3.bb.internal"

[grpc.s3]
cert = "/etc/bb/tls/tls.crt"
key = "/etc/bb/tls/tls.key"
allowed_commonNames = "s3.bb.internal"

[grpc.client]
cert = "/etc/bb/tls/tls.crt"
key = "/etc/bb/tls/tls.key"
--- tls/api/tls.crt (644) 9 bytes
--- tls/api/tls.key (644) 8 bytes
--- tls/api/keystore.pem (644) 17 bytes
--- config/api-fluent-bit/fluent-bit.conf (644)
# Generated by Breadboard for api-fluent-bit: ships the log files api writes
# to /var/run/bb/logs to the bucket logs on s3, over TLS verified against the lab CA.

[SERVICE]
    Flush                1
    Log_Level            info
    HTTP_Server          On
    HTTP_Listen          127.0.0.1
    HTTP_Port            2020
    Health_Check         On

[INPUT]
    Name                 tail
    Path                 /var/run/bb/logs/*.log
    Tag                  logs.api
    Path_Key             file
    Read_from_Head       On
    Refresh_Interval     2
    DB                   /var/run/bb/fluent-bit-api.db

[OUTPUT]
    Name                 s3
    Match                logs.*
    bucket               logs
    region               us-east-1
    endpoint             https://s3.bb.internal:8333
    tls.verify           On
    tls.verify_hostname  On
    tls.ca_file          /etc/bb/ca.pem
    use_put_object       On
    total_file_size      1M
    upload_timeout       10s
    s3_key_format        /api/%Y/%m/%d/%H%M%S-$UUID.jsonl
    store_dir            /tmp/fluent-bit/s3
--- docker-compose.yml (644)
# Generated for a golden test.
name: bb-lab
services:
  s3:
    image: chrislusf/seaweedfs:4.53
    entrypoint:
      - /bin/sh
      - -c
      - |-
        weed server -dir=/data -ip=127.0.0.1 -ip.bind=127.0.0.1 -master.volumeSizeLimitMB=1024 -s3 -s3.ip.bind=0.0.0.0 -s3.port=8333 -s3.cert.file=/etc/bb/tls/tls.crt -s3.key.file=/etc/bb/tls/tls.key -s3.port.iceberg=0 -s3.port.lance=0 &
        pid=$$!
        trap 'kill -TERM $$pid; wait $$pid; exit' TERM INT
        for b in $$(echo "$$BB_BUCKETS" | tr , ' '); do
          until curl -sf -o /dev/null --cacert /etc/bb/ca.pem --aws-sigv4 aws:amz:us-east-1:s3 --user "$$AWS_ACCESS_KEY_ID:$$AWS_SECRET_ACCESS_KEY" -I https://s3.bb.internal:8333/$$b || curl -sf -o /dev/null --cacert /etc/bb/ca.pem --aws-sigv4 aws:amz:us-east-1:s3 --user "$$AWS_ACCESS_KEY_ID:$$AWS_SECRET_ACCESS_KEY" -X PUT https://s3.bb.internal:8333/$$b; do sleep 1; done
        done
        wait $$pid
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      AWS_ACCESS_KEY_ID: ${S3__ACCESS_KEY_ID}
      AWS_SECRET_ACCESS_KEY: ${S3__SECRET_ACCESS_KEY}
      BB_BUCKETS: uploads,logs
    healthcheck:
      test: [CMD-SHELL, 'curl -sf -o /dev/null --cacert /etc/bb/ca.pem --aws-sigv4 aws:amz:us-east-1:s3 --user "$$AWS_ACCESS_KEY_ID:$$AWS_SECRET_ACCESS_KEY" https://s3.bb.internal:8333/']
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
      start_interval: 1s
    volumes:
      - s3-data:/data
      - ./tls/s3/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/s3/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/s3/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/s3/security.toml:/etc/seaweedfs/security.toml:ro
    networks:
      default:
        aliases: [s3.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: s3
      breadboard.kind: infra
      breadboard.config-hash: a5a15eb64d198dbb
    mem_limit: 512m
    cpus: 0.5
    restart: unless-stopped
  api-pod:
    image: alpine:3.24.4
    command: [sleep, infinity]
    init: true
    healthcheck:
      test: [CMD, "true"]
      interval: 10s
      timeout: 2s
      retries: 3
      start_period: 5s
      start_interval: 1s
    networks:
      default:
        aliases: [api.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: api-pod
      breadboard.kind: pod
      breadboard.capture: off
    mem_limit: 16m
    cpus: 0.05
    restart: unless-stopped
  api:
    build:
      context: ../../api
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: api
      BB_FQDN: api.bb.internal
      BB_SHARED_DIR: /var/run/bb
      # s3 (S3 Compatible)
      S3_ENDPOINT: https://s3.bb.internal:8333
      S3_REGION: us-east-1
      S3_ACCESS_KEY_ID: ${S3__ACCESS_KEY_ID}
      S3_SECRET_ACCESS_KEY: ${S3__SECRET_ACCESS_KEY}
      S3_FORCE_PATH_STYLE: "true"
      AWS_ENDPOINT_URL_S3: https://s3.bb.internal:8333
      AWS_REGION: us-east-1
      AWS_ACCESS_KEY_ID: ${S3__ACCESS_KEY_ID}
      AWS_SECRET_ACCESS_KEY: ${S3__SECRET_ACCESS_KEY}
      # api-fluent-bit (Fluent Bit sidecar)
      BB_LOG_DIR: /var/run/bb/logs
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    depends_on:
      api-pod:
        condition: service_healthy
      s3:
        condition: service_healthy
      api-fluent-bit:
        condition: service_healthy
    volumes:
      - ./tls/api/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/api/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/api/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - api-shared:/var/run/bb
    network_mode: service:api-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: api
      breadboard.kind: app
      breadboard.capture: off
      breadboard.config-hash: f18e397e2ef2a691
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  api-fluent-bit:
    image: fluent/fluent-bit:5.2.0-debug
    entrypoint:
      - /bin/sh
      - -c
      - |-
        set -e
        mkdir -p /var/run/bb/logs
        chmod 1777 /var/run/bb/logs
        exec /fluent-bit/bin/fluent-bit -c /etc/bb/config/fluent-bit.conf
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      AWS_ACCESS_KEY_ID: ${S3__ACCESS_KEY_ID}
      AWS_SECRET_ACCESS_KEY: ${S3__SECRET_ACCESS_KEY}
    healthcheck:
      test: [CMD, bash, -c, "exec 3<>/dev/tcp/127.0.0.1/2020 && printf 'GET /api/v1/health HTTP/1.1\\r\\nHost: 127.0.0.1\\r\\nConnection: close\\r\\n\\r\\n' >&3 && head -n 1 <&3 | grep -q ' 200'"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 20s
      start_interval: 1s
    depends_on:
      api-pod:
        condition: service_healthy
      s3:
        condition: service_healthy
    volumes:
      - ./tls/api/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/api/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/api/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - api-shared:/var/run/bb
      - ./config/api-fluent-bit/fluent-bit.conf:/etc/bb/config/fluent-bit.conf:ro
    network_mode: service:api-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: api-fluent-bit
      breadboard.kind: sidecar
      breadboard.capture: off
      breadboard.config-hash: 0ad41a4c23e4a6fe
    mem_limit: 64m
    cpus: 0.25
    restart: unless-stopped
networks:
  default:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
volumes:
  s3-data:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
  api-shared:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
--- .env (600)
# Generated by bb. Secrets for docker compose; never commit this file.
S3__ACCESS_KEY_ID=s3access-key-idSECRET
S3__SECRET_ACCESS_KEY=s3secret-access-keySECRET
