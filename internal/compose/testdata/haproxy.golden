--- config/consul/consul.json (644)
{
  "addresses": {
    "http": "10.213.0.10"
  },
  "bind_addr": "{{ GetPrivateIP }}",
  "bootstrap_expect": 1,
  "client_addr": "0.0.0.0",
  "datacenter": "bb",
  "enable_agent_tls_for_checks": true,
  "encrypt_verify_incoming": true,
  "encrypt_verify_outgoing": true,
  "node_name": "consul",
  "ports": {
    "dns": -1,
    "grpc": -1,
    "grpc_tls": -1,
    "http": 8500,
    "https": 8501,
    "serf_wan": -1
  },
  "server": true,
  "tls": {
    "defaults": {
      "ca_file": "/etc/bb/ca.pem",
      "cert_file": "/etc/bb/tls/tls.crt",
      "key_file": "/etc/bb/tls/tls.key",
      "verify_incoming": false,
      "verify_outgoing": true
    },
    "internal_rpc": {
      "verify_incoming": true,
      "verify_server_hostname": false
    }
  },
  "ui_config": {
    "enabled": true
  }
}
--- tls/edge/tls.crt (644) 10 bytes
--- tls/edge/tls.key (644) 9 bytes
--- tls/edge/keystore.pem (644) 19 bytes
--- config/edge/haproxy.cfg (644)
# haproxy.cfg for edge, generated by Breadboard.
#
# HTTPS on :8443 with this service's certificate, then:
#   /web/ (prefix stripped), and every other request -> web (re-encrypt)
#   /v1/ (prefix stripped) -> api (terminate)
#   /consul/ (prefix stripped) -> consul (terminate)
# TLS on :9443 is routed by SNI without decrypting (passthrough):
#   SNI payments.bb.internal -> payments, which presents its own certificate
#
# To own this config, copy it next to experiment.yaml and set
# services.edge.file. The certificate (/etc/bb/tls/keystore.pem), the lab CA
# (/etc/bb/ca.pem) and the trust bundle stay mounted; keep the monitor
# frontend on 127.0.0.1:8404, which the health check reads.

global
    # Logs go to the container's stdout: bb logs edge.
    log stdout format raw local0
    # At most 256 concurrent connections, on one thread. Without maxconn
    # HAProxy sizes its connection tables from the file-descriptor limit
    # (often a million inside Docker): about 90 MiB at idle, most of this
    # container's memory limit. For a load test, raise both in your own
    # copy (services.edge.file) and give the service more memory.
    maxconn 256
    nbthread 1
    # TLS 1.2 or newer, towards clients and towards servers.
    ssl-default-bind-options ssl-min-ver TLSv1.2
    ssl-default-server-options ssl-min-ver TLSv1.2

# Docker's embedded DNS. server-template lines keep resolving their name
# here, so HAProxy follows replicas as they start and stop.
resolvers docker
    nameserver dns 127.0.0.11:53
    accepted_payload_size 8192
    resolve_retries 3
    timeout resolve 1s
    timeout retry 1s

defaults
    log global
    mode http
    option httplog
    timeout connect 5s
    timeout client 30s
    timeout server 30s
    timeout check 5s
    # Every server: an active check every 2s, down after 3 failures and up
    # after 2 successes. Addresses come from the docker resolvers; a server
    # whose name does not resolve yet starts down instead of failing.
    default-server inter 2s fall 3 rise 2 resolvers docker resolve-prefer ipv4 init-addr none

# Loopback only: the health check and the stats page (/stats;csv for CSV).
frontend monitor
    bind 127.0.0.1:8404
    monitor-uri /healthz
    stats enable
    stats uri /stats
    stats refresh 10s
    # Server addresses on the stats page, so explorers can tell which
    # replica each server-template slot resolved to.
    stats show-legends

frontend https
    bind :8443 ssl crt /etc/bb/tls/keystore.pem alpn h2,http/1.1
    # Tell servers the client spoke HTTPS, and who the client was.
    http-request set-header X-Forwarded-Proto https
    option forwardfor
    use_backend be_web if { path_beg /web/ }
    use_backend be_v1 if { path_beg /v1/ }
    use_backend be_consul if { path_beg /consul/ }
    default_backend be_web

backend be_web
    # re-encrypt: TLS to every replica of web, verified against the lab CA as web.bb.internal.
    balance roundrobin
    http-request replace-path /web/(.*) /\1 if { path_beg /web/ }
    server-template web 3 web.bb.internal:8443 ssl verify required ca-file /etc/bb/ca.pem sni str(web.bb.internal) verifyhost web.bb.internal check check-sni web.bb.internal

backend be_v1
    # terminate: plaintext HTTP to every replica of api on its private segment. Reason: practice TLS termination
    # and watch the requests
    balance roundrobin
    http-request replace-path /v1/(.*) /\1 if { path_beg /v1/ }
    server-template v1 2 api.plain.bb.internal:9090 check

backend be_consul
    # terminate: plaintext HTTP to consul on its private segment. Reason: plain HTTP API behind the proxy
    balance roundrobin
    http-request replace-path /consul/(.*) /\1 if { path_beg /consul/ }
    server-template consul 1 consul.plain.bb.internal:8500 check

frontend passthrough
    bind :9443
    mode tcp
    option tcplog
    # Wait for the ClientHello, then route on its SNI. Unknown names are closed.
    tcp-request inspect-delay 5s
    tcp-request content accept if { req.ssl_hello_type 1 }
    use_backend be_tls_payments if { req.ssl_sni -i payments.bb.internal }

backend be_tls_payments
    # passthrough: the client's TLS session goes to every replica of payments untouched; the check is a TCP connect.
    mode tcp
    balance roundrobin
    server-template payments 1 payments.bb.internal:8443 check
