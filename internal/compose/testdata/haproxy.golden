--- tls/payments/tls.key (644) 13 bytes
--- tls/payments/keystore.pem (644) 27 bytes
--- config/payments-envoy/envoy.yaml (644)
# Generated by Breadboard for payments-envoy, the Envoy sidecar of payments.
# To own this file, copy it next to experiment.yaml and set file: on the sidecar.
node:
  id: payments-envoy
  cluster: payments
admin:
  address:
    socket_address:
      address: 127.0.0.1
      port_value: 15000
static_resources:
  listeners:
    - name: inbound
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 8443
      traffic_direction: INBOUND
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: inbound
                codec_type: AUTO
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                route_config:
                  name: inbound
                  virtual_hosts:
                    - name: app
                      domains:
                        - '*'
                      routes:
                        - match:
                            prefix: /
                          route:
                            cluster: app
                      request_headers_to_add:
                        - header:
                            key: x-forwarded-proto
                            value: https
                          append_action: OVERWRITE_IF_EXISTS_OR_ADD
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
          transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
              common_tls_context:
                alpn_protocols:
                  - h2
                  - http/1.1
                tls_certificates:
                  - certificate_chain:
                      filename: /etc/bb/tls/tls.crt
                    private_key:
                      filename: /etc/bb/tls/tls.key
  clusters:
    - name: app
      type: STATIC
      connect_timeout: 1s
      load_assignment:
        cluster_name: app
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: 127.0.0.1
                      port_value: 8080
--- tls/client/tls.crt (644) 12 bytes
--- tls/client/tls.key (644) 11 bytes
--- tls/client/keystore.pem (644) 23 bytes
--- docker-compose.yml (644)
# Generated for a golden test.
name: bb-lab
services:
  consul:
    image: hashicorp/consul:1.22.7
    command: [agent, -config-file=/etc/bb/config/consul.json, -encrypt=consulgossip-keySECRET]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      CONSUL_HTTP_ADDR: https://consul.bb.internal:8501
      CONSUL_CACERT: /etc/bb/ca.pem
    healthcheck:
      test: [CMD, consul, operator, raft, list-peers]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
      start_interval: 2s
    volumes:
      - consul-data:/consul/data
      - ./tls/consul/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/consul/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/consul/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/consul/consul.json:/etc/bb/config/consul.json:ro
    networks:
      default:
        aliases: [consul.bb.internal]
      plain-consul:
        ipv4_address: 10.213.0.10
        aliases: [consul.plain.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: consul
      breadboard.kind: infra
      breadboard.config-hash: 6a8648b74cb6628f
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  edge:
    image: haproxy:3.4.7
    command: [haproxy, -f, /etc/bb/config/haproxy.cfg]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
    healthcheck:
      test: [CMD, bash, -c, 'exec 3<>/dev/tcp/127.0.0.1/8404 && printf ''GET /healthz HTTP/1.0\r\n\r\n'' >&3 && head -n 1 <&3 | grep -q '' 200 '' && openssl s_client -connect edge.bb.internal:8443 -servername edge.bb.internal -verify_hostname edge.bb.internal -verify_return_error -CAfile /etc/bb/ca.pem -brief < /dev/null > /dev/null 2>&1']
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
      start_interval: 1s
    volumes:
      - ./tls/edge/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/edge/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/edge/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/edge/haproxy.cfg:/etc/bb/config/haproxy.cfg:ro
    networks:
      default:
        aliases: [edge.bb.internal]
      plain-consul: {}
      plain-api: {}
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: edge
      breadboard.kind: infra
      breadboard.config-hash: 523e9b2d96253c9d
    mem_limit: 128m
    cpus: 0.25
    restart: unless-stopped
  web-1:
    build:
      context: ../../web
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: web-1
      BB_FQDN: web-1.bb.internal
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    volumes:
      - ./tls/web-1/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/web-1/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/web-1/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
    networks:
      default:
        aliases: [web-1.bb.internal, web.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: web-1
      breadboard.kind: app
      breadboard.config-hash: 39dad408a5edf2ed
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  web-2:
