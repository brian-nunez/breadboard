      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: api-1
      BB_FQDN: api-1.bb.internal
      BB_SHARED_DIR: /var/run/bb
      BB_PLAIN_LISTEN_ADDR: 10.213.1.10:9090
