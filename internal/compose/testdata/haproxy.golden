      breadboard.kind: app
      breadboard.config-hash: 9fbad1b45722321b
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  api-1-pod:
    image: alpine:3.24.4
    command: [sleep, infinity]
    init: true
    healthcheck:
      test: [CMD, "true"]
      interval: 10s
      timeout: 2s
      retries: 3
      start_period: 5s
      start_interval: 1s
    networks:
      default:
        aliases: [api-1.bb.internal, api.bb.internal]
      plain-api:
        ipv4_address: 10.213.1.10
        aliases: [api-1.plain.bb.internal, api.plain.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: api-1-pod
      breadboard.kind: pod
      breadboard.capture: guard
    mem_limit: 16m
    cpus: 0.05
    restart: unless-stopped
  api-1-netinit:
    build:
      context: ./build/api-1-netinit
    command:
      - /bin/sh
      - -c
      - |-
        set -eu
        # Plaintext guard: TCP to port 9090 is accepted only on the segment address 10.213.1.10.
        iptables -N BB_PLAIN 2>/dev/null || iptables -F BB_PLAIN
        iptables -C INPUT -j BB_PLAIN 2>/dev/null || iptables -I INPUT 1 -j BB_PLAIN
        iptables -A BB_PLAIN -p tcp --dport 9090 ! -d 10.213.1.10 -j DROP
        iptables -S BB_PLAIN
    cap_add: [NET_ADMIN]
    depends_on:
      api-1-pod:
        condition: service_healthy
    network_mode: service:api-1-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: api-1-netinit
      breadboard.kind: init
      breadboard.config-hash: 5dc27d27665447bf
    mem_limit: 32m
    cpus: 0.1
    restart: "no"
