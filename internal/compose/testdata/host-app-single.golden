--- ca.pem (644) 3 bytes
--- trust-bundle.pem (644) 9 bytes
--- tls/api/tls.crt (644) 9 bytes
--- tls/api/tls.key (644) 8 bytes
--- tls/api/keystore.pem (644) 17 bytes
--- tls/worker/tls.crt (644) 12 bytes
--- tls/worker/tls.key (644) 11 bytes
--- tls/worker/keystore.pem (644) 23 bytes
--- tls/bb-host/tls.crt (644) 13 bytes
--- tls/bb-host/tls.key (644) 12 bytes
--- tls/bb-host/keystore.pem (644) 25 bytes
--- tls/bb-host/host.crt (644) 10 bytes
--- tls/bb-host/host.key (644) 9 bytes
--- config/bb-host/traefik.yml (644)
# traefik.yml for bb-host, generated by Breadboard: the static configuration
# of the lab's host router. The routes in /etc/bb/traefik/dynamic.yml are
# generated from every host target in experiment.yaml; the router has no file.

global:
  checkNewVersion: false
  sendAnonymousUsage: false
# Logs and access logs go to stdout: bb logs bb-host.
log:
  level: INFO
accessLog: {}
entryPoints:
  # HTTPS with the host certificate from the host CA (the default certificate in
  # /etc/bb/traefik/tls.yml). Routers on it use TLS without saying so.
  websecure:
    address: :8443
    http:
      tls: {}
      # Drop request headers whose names alias a header Traefik manages
      # (X_Forwarded_For for X-Forwarded-For), so clients cannot spoof them.
      aliasHeadersStrategy: delete
  # Loopback only: the API, the dashboard and /ping.
  traefik:
    address: 127.0.0.1:8080
    http:
      aliasHeadersStrategy: delete
# The file provider only; Traefik never sees the Docker socket. Every
# file in the directory is loaded and watched for changes.
providers:
  file:
    directory: /etc/bb/traefik
    watch: true
# The API and dashboard on the traefik entrypoint (127.0.0.1:8080).
api:
  insecure: true
  dashboard: true
ping:
  entryPoint: traefik
--- config/bb-host/tls.yml (644)
# tls.yml for bb-host, generated by Breadboard: the host certificate,
# signed by the install's host CA for exactly the lab's *.localhost host
# names, and the minimum TLS version. The lab certificate in /etc/bb/tls
# is not presented to the host.

tls:
  stores:
    default:
      defaultCertificate:
        certFile: /etc/bb/host/tls.crt
        keyFile: /etc/bb/host/tls.key
  # TLS 1.2 or newer towards host clients.
  options:
    default:
      minVersion: VersionTLS12
--- config/bb-host/dynamic.yml (644)
# dynamic.yml for bb-host, generated by Breadboard: the host router's routes.
#
#   https://api.lab.localhost -> api (1 instance)
#
# A name no router claims gets Traefik's 404. Each request reaches its
# target over TLS, verified against the lab CA (/etc/bb/ca.pem), with the
# original Host header and Traefik's X-Forwarded-* headers.

http:
  routers:
    # https://api.lab.localhost reaches api.
    target-api:
      entryPoints:
        - websecure
      rule: Host(`api.lab.localhost`)
      service: target-api
  services:
    target-api:
      loadBalancer:
        strategy: wrr
        servers:
          - url: https://api.bb.internal:8443
        passHostHeader: true
        serversTransport: target-api
  serversTransports:
    # Re-encrypt: TLS with SNI api.bb.internal, verified against the lab CA.
    target-api:
      serverName: api.bb.internal
      rootCAs:
        - /etc/bb/ca.pem
--- docker-compose.yml (644)
# Generated for a golden test.
name: bb-lab
services:
  api:
    build:
      context: ../../api
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: api
      BB_FQDN: api.bb.internal
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    volumes:
      - ./tls/api/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/api/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/api/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
    networks:
      default:
        aliases: [api.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: api
      breadboard.kind: app
      breadboard.config-hash: f18e397e2ef2a691
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  worker:
    build:
      context: ../../worker
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: worker
      BB_FQDN: worker.bb.internal
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    volumes:
      - ./tls/worker/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/worker/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/worker/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
    networks:
      default:
        aliases: [worker.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: worker
      breadboard.kind: app
      breadboard.config-hash: 190fe75f512f5b65
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  bb-host:
    image: traefik:v3.7.19
    command: [traefik, --configFile=/etc/bb/config/traefik.yml]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
    healthcheck:
      test: [CMD, traefik, healthcheck, --configFile=/etc/bb/config/traefik.yml, --ping]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
      start_interval: 1s
    ports:
      - 127.0.0.1:44312:8443
    volumes:
      - ./tls/bb-host/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/bb-host/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/bb-host/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./tls/bb-host/host.crt:/etc/bb/host/tls.crt:ro
      - ./tls/bb-host/host.key:/etc/bb/host/tls.key:ro
      - ./config/bb-host/traefik.yml:/etc/bb/config/traefik.yml:ro
      - ./config/bb-host/tls.yml:/etc/bb/traefik/tls.yml:ro
      - ./config/bb-host/dynamic.yml:/etc/bb/traefik/dynamic.yml:ro
    networks:
      default:
        aliases: [bb-host.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: bb-host
      breadboard.kind: infra
      breadboard.config-hash: 8e451f154032455a
    mem_limit: 128m
    cpus: 0.25
    restart: unless-stopped
networks:
  default:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
