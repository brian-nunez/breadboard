--- ca.pem (644) 3 bytes
--- trust-bundle.pem (644) 9 bytes
--- tls/edge/tls.crt (644) 10 bytes
--- tls/edge/tls.key (644) 9 bytes
--- tls/edge/keystore.pem (644) 19 bytes
--- config/edge/haproxy.cfg (644)
# haproxy.cfg for edge, generated by Breadboard.
#
# HTTPS on :8443 with this service's certificate, then:
#   every request -> web (re-encrypt)
#
# To own this config, copy it next to experiment.yaml and set
# services.edge.file. The certificate (/etc/bb/tls/keystore.pem), the lab CA
# (/etc/bb/ca.pem) and the trust bundle stay mounted; keep the monitor
# frontend on 127.0.0.1:8404, which the health check reads.

global
    # Logs go to the container's stdout: bb logs edge.
    log stdout format raw local0
    # At most 256 concurrent connections, on one thread. Without maxconn
    # HAProxy sizes its connection tables from the file-descriptor limit
    # (often a million inside Docker): about 90 MiB at idle, most of this
    # container's memory limit. For a load test, raise both in your own
    # copy (services.edge.file) and give the service more memory.
    maxconn 256
    nbthread 1
    # TLS 1.2 or newer, towards clients and towards servers.
    ssl-default-bind-options ssl-min-ver TLSv1.2
    ssl-default-server-options ssl-min-ver TLSv1.2

# Docker's embedded DNS. server-template lines keep resolving their name
# here, so HAProxy follows replicas as they start and stop.
resolvers docker
    nameserver dns 127.0.0.11:53
    accepted_payload_size 8192
    resolve_retries 3
    timeout resolve 1s
    timeout retry 1s

defaults
    log global
    mode http
    option httplog
    timeout connect 5s
    timeout client 30s
    timeout server 30s
    timeout check 5s
    # Every server: an active check every 2s, down after 3 failures and up
    # after 2 successes. Addresses come from the docker resolvers; a server
    # whose name does not resolve yet starts down instead of failing.
    default-server inter 2s fall 3 rise 2 resolvers docker resolve-prefer ipv4 init-addr none

# Loopback only: the health check and the stats page (/stats;csv for CSV).
frontend monitor
    bind 127.0.0.1:8404
    monitor-uri /healthz
    stats enable
    stats uri /stats
    stats refresh 10s
    # Server addresses on the stats page, so explorers can tell which
    # replica each server-template slot resolved to.
    stats show-legends

frontend https
    bind :8443 ssl crt /etc/bb/tls/keystore.pem alpn h2,http/1.1
    # Tell servers the client spoke HTTPS, and who the client was.
    http-request set-header X-Forwarded-Proto https
    option forwardfor
    default_backend be_web

backend be_web
    # re-encrypt: TLS to every replica of web, verified against the lab CA as web.bb.internal.
    balance roundrobin
    server-template web 2 web.bb.internal:8443 ssl verify required ca-file /etc/bb/ca.pem sni str(web.bb.internal) verifyhost web.bb.internal check check-sni web.bb.internal
--- tls/web-1/tls.crt (644) 11 bytes
--- tls/web-1/tls.key (644) 10 bytes
--- tls/web-1/keystore.pem (644) 21 bytes
--- tls/web-2/tls.crt (644) 11 bytes
--- tls/web-2/tls.key (644) 10 bytes
--- tls/web-2/keystore.pem (644) 21 bytes
--- tls/bb-host/tls.crt (644) 13 bytes
--- tls/bb-host/tls.key (644) 12 bytes
--- tls/bb-host/keystore.pem (644) 25 bytes
--- tls/bb-host/host.crt (644) 10 bytes
--- tls/bb-host/host.key (644) 9 bytes
--- config/bb-host/traefik.yml (644)
# traefik.yml for bb-host, generated by Breadboard: the static configuration
# of the lab's host router. The routes in /etc/bb/traefik/dynamic.yml are
# generated from every host target in experiment.yaml; the router has no file.

global:
  checkNewVersion: false
  sendAnonymousUsage: false
# Logs and access logs go to stdout: bb logs bb-host.
log:
  level: INFO
accessLog: {}
entryPoints:
  # HTTPS with the host certificate from the host CA (the default certificate in
  # /etc/bb/traefik/tls.yml). Routers on it use TLS without saying so.
  websecure:
    address: :8443
    http:
      tls: {}
      # Drop request headers whose names alias a header Traefik manages
      # (X_Forwarded_For for X-Forwarded-For), so clients cannot spoof them.
      aliasHeadersStrategy: delete
      # Reject (400) a request path holding an encoded /, \, NUL, ;, %, ?
      # or #. A backend that decodes the path again could route it apart
      # from Traefik's rules (a split view), e.g. /api%2F..%2Fadmin. Traefik
      # allows them by default and warns at startup until one is denied.
      encodedCharacters:
        allowEncodedSlash: false
        allowEncodedBackSlash: false
        allowEncodedNullCharacter: false
        allowEncodedSemicolon: false
        allowEncodedPercent: false
        allowEncodedQuestionMark: false
        allowEncodedHash: false
  # Loopback only: the API, the dashboard and /ping.
  traefik:
    address: 127.0.0.1:8080
    http:
      aliasHeadersStrategy: delete
      encodedCharacters:
        allowEncodedSlash: false
        allowEncodedBackSlash: false
        allowEncodedNullCharacter: false
        allowEncodedSemicolon: false
        allowEncodedPercent: false
        allowEncodedQuestionMark: false
        allowEncodedHash: false
# The file provider only; Traefik never sees the Docker socket. Every
# file in the directory is loaded and watched for changes.
providers:
  file:
    directory: /etc/bb/traefik
    watch: true
# The API and dashboard on the traefik entrypoint (127.0.0.1:8080).
api:
  insecure: true
  dashboard: true
ping:
  entryPoint: traefik
--- config/bb-host/tls.yml (644)
# tls.yml for bb-host, generated by Breadboard: the host certificate,
# signed by the install's host CA for exactly the lab's *.localhost host
# names, and the minimum TLS version. The lab certificate in /etc/bb/tls
# is not presented to the host.

tls:
  stores:
    default:
      defaultCertificate:
        certFile: /etc/bb/host/tls.crt
        keyFile: /etc/bb/host/tls.key
  # TLS 1.2 or newer towards host clients.
  options:
    default:
      minVersion: VersionTLS12
--- config/bb-host/dynamic.yml (644)
# dynamic.yml for bb-host, generated by Breadboard: the host router's routes.
#
#   https://edge.lab.localhost -> edge (1 instance)
#
# A name no router claims gets Traefik's 404. Each request reaches its
# target over TLS, verified against the lab CA (/etc/bb/ca.pem), with the
# original Host header and Traefik's X-Forwarded-* headers.

http:
  routers:
    # https://edge.lab.localhost reaches edge.
    target-edge:
      entryPoints:
        - websecure
      rule: Host(`edge.lab.localhost`)
      service: target-edge
  services:
    target-edge:
      loadBalancer:
        strategy: wrr
        servers:
          - url: https://edge.bb.internal:8443
        passHostHeader: true
        serversTransport: target-edge
  serversTransports:
    # Re-encrypt: TLS with SNI edge.bb.internal, verified against the lab CA.
    target-edge:
      serverName: edge.bb.internal
      rootCAs:
        - /etc/bb/ca.pem
--- docker-compose.yml (644)
# Generated for a golden test.
name: bb-lab
services:
  edge:
    image: haproxy:3.4.7
    command: [haproxy, -f, /etc/bb/config/haproxy.cfg]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
    healthcheck:
      test: [CMD, bash, -c, 'exec 3<>/dev/tcp/127.0.0.1/8404 && printf ''GET /healthz HTTP/1.0\r\n\r\n'' >&3 && head -n 1 <&3 | grep -q '' 200 '' && openssl s_client -connect edge.bb.internal:8443 -servername edge.bb.internal -verify_hostname edge.bb.internal -verify_return_error -CAfile /etc/bb/ca.pem -brief < /dev/null > /dev/null 2>&1']
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
      start_interval: 1s
    volumes:
      - ./tls/edge/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/edge/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/edge/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/edge/haproxy.cfg:/etc/bb/config/haproxy.cfg:ro
    networks:
      default:
        aliases: [edge.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: edge
      breadboard.kind: infra
      breadboard.config-hash: 35ad05619d376648
    mem_limit: 128m
    cpus: 0.25
    restart: unless-stopped
  web-1:
    build:
      context: ../../web
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: web-1
      BB_FQDN: web-1.bb.internal
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    volumes:
      - ./tls/web-1/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/web-1/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/web-1/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
    networks:
      default:
        aliases: [web-1.bb.internal, web.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: web-1
      breadboard.kind: app
      breadboard.config-hash: 39dad408a5edf2ed
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  web-2:
    build:
      context: ../../web
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: web-2
      BB_FQDN: web-2.bb.internal
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    volumes:
      - ./tls/web-2/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/web-2/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/web-2/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
    networks:
      default:
        aliases: [web-2.bb.internal, web.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: web-2
      breadboard.kind: app
      breadboard.config-hash: 360b73ec7eca0b53
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  bb-host:
    image: traefik:v3.7.19
    command: [traefik, --configFile=/etc/bb/config/traefik.yml]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
    healthcheck:
      test: [CMD, traefik, healthcheck, --configFile=/etc/bb/config/traefik.yml, --ping]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
      start_interval: 1s
    ports:
      - 127.0.0.1:44312:8443
    volumes:
      - ./tls/bb-host/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/bb-host/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/bb-host/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./tls/bb-host/host.crt:/etc/bb/host/tls.crt:ro
      - ./tls/bb-host/host.key:/etc/bb/host/tls.key:ro
      - ./config/bb-host/traefik.yml:/etc/bb/config/traefik.yml:ro
      - ./config/bb-host/tls.yml:/etc/bb/traefik/tls.yml:ro
      - ./config/bb-host/dynamic.yml:/etc/bb/traefik/dynamic.yml:ro
    networks:
      default:
        aliases: [bb-host.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: bb-host
      breadboard.kind: infra
      breadboard.config-hash: 3031ba42e3cc185f
    mem_limit: 128m
    cpus: 0.25
    restart: unless-stopped
networks:
  default:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
