--- docker-compose.yml (644)
# Generated for a golden test.
name: bb-lab
services:
  postgres:
    image: postgres:18.7-alpine3.24
    entrypoint:
      - /bin/sh
      - -c
      - |-
        set -e
        install -d -m 0700 -o postgres -g postgres /var/run/postgresql/bb-tls
        install -m 0600 -o postgres -g postgres /etc/bb/tls/tls.key /var/run/postgresql/bb-tls/tls.key
        install -m 0644 -o postgres -g postgres /etc/bb/tls/tls.crt /var/run/postgresql/bb-tls/tls.crt
        exec docker-entrypoint.sh postgres -c listen_addresses='*' -c ssl=on -c ssl_cert_file=/var/run/postgresql/bb-tls/tls.crt -c ssl_key_file=/var/run/postgresql/bb-tls/tls.key -c ssl_min_protocol_version=TLSv1.2 -c hba_file=/etc/bb/config/pg_hba.conf
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${POSTGRES__SUPERUSER_PASSWORD}
      BB_APP_USER: app
      BB_APP_PASSWORD: ${POSTGRES__PASSWORD}
      BB_APP_DATABASE: app
    healthcheck:
      test: [CMD-SHELL, PGPASSWORD="$$BB_APP_PASSWORD" psql "host=postgres.bb.internal port=5432 dbname=app user=app sslmode=verify-full sslrootcert=/etc/bb/ca.pem" -tAc 'select 1' > /dev/null]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 1m
      start_interval: 2s
    volumes:
      - postgres-data:/var/lib/postgresql
      - ./tls/postgres/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/postgres/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/postgres/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/postgres/pg_hba.conf:/etc/bb/config/pg_hba.conf:ro
      - ./config/postgres/init-app.sh:/docker-entrypoint-initdb.d/10-init-app.sh:ro
    networks:
      default:
        aliases: [postgres.bb.internal]
      plain-postgres:
        ipv4_address: 10.213.0.10
        aliases: [postgres.plain.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: postgres
      breadboard.kind: infra
      breadboard.config-hash: 56d9a8739705f8b4
    mem_limit: 512m
    cpus: 0.5
    restart: unless-stopped
  pool:
    image: edoburu/pgbouncer:v1.26.1-p0
    entrypoint:
      - /bin/sh
      - -c
      - |-
        set -eu
        umask 077
        mkdir -p /tmp/pgbouncer
        printf '"%s" "%s"\n' "$$BB_PG_USER" "$$BB_PG_PASSWORD" > /tmp/pgbouncer/userlist.txt
        exec pgbouncer /etc/bb/config/pgbouncer.ini
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      BB_PG_USER: app
      BB_PG_PASSWORD: ${POSTGRES__PASSWORD}
    healthcheck:
      test: [CMD, pg_isready, -q, -d, host=pool.bb.internal port=6432 sslmode=verify-full sslrootcert=/etc/bb/ca.pem]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 20s
      start_interval: 1s
    volumes:
      - ./tls/pool/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/pool/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/pool/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/pool/pgbouncer.ini:/etc/bb/config/pgbouncer.ini:ro
      - ./config/pool/pgbouncer_hba.conf:/etc/bb/config/pgbouncer_hba.conf:ro
    networks:
      default:
        aliases: [pool.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: pool
      breadboard.kind: infra
      breadboard.config-hash: 7394a86576162b00
    mem_limit: 64m
    cpus: 0.25
    restart: unless-stopped
  pool-plain:
    image: edoburu/pgbouncer:v1.26.1-p0
    entrypoint:
      - /bin/sh
      - -c
      - |-
        set -eu
        umask 077
        mkdir -p /tmp/pgbouncer
        printf '"%s" "%s"\n' "$$BB_PG_USER" "$$BB_PG_PASSWORD" > /tmp/pgbouncer/userlist.txt
        exec pgbouncer /etc/bb/config/pgbouncer.ini
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      BB_PG_USER: app
      BB_PG_PASSWORD: ${POSTGRES__PASSWORD}
    healthcheck:
      test: [CMD, pg_isready, -q, -d, host=pool-plain.bb.internal port=6432 sslmode=verify-full sslrootcert=/etc/bb/ca.pem]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 20s
      start_interval: 1s
    volumes:
      - ./tls/pool-plain/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/pool-plain/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/pool-plain/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/pool-plain/pgbouncer.ini:/etc/bb/config/pgbouncer.ini:ro
      - ./config/pool-plain/pgbouncer_hba.conf:/etc/bb/config/pgbouncer_hba.conf:ro
    networks:
      default:
        aliases: [pool-plain.bb.internal]
      plain-postgres: {}
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: pool-plain
      breadboard.kind: infra
      breadboard.config-hash: f92ebfd68252b68f
    mem_limit: 64m
    cpus: 0.25
    restart: unless-stopped
  orders:
    build:
      context: ../../orders
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: orders
      BB_FQDN: orders.bb.internal
      # pool (PgBouncer)
      DATABASE_URL: postgres://app:${POSTGRES__PASSWORD}@pool.bb.internal:6432/app?sslmode=verify-full
      PGHOST: pool.bb.internal
      PGPORT: "6432"
      PGUSER: app
      PGPASSWORD: ${POSTGRES__PASSWORD}
      PGDATABASE: app
      PGSSLMODE: verify-full
      PGSSLROOTCERT: /etc/bb/ca.pem
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    depends_on:
      pool:
        condition: service_healthy
    volumes:
      - ./tls/orders/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/orders/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/orders/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
    networks:
      default:
        aliases: [orders.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: orders
      breadboard.kind: app
      breadboard.config-hash: 52c90dbcf712a085
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  billing:
    build:
      context: ../../billing
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: billing
      BB_FQDN: billing.bb.internal
      # pool (PgBouncer)
      DATABASE_URL: postgres://app:${POSTGRES__PASSWORD}@pool.bb.internal:6432/app?sslmode=verify-full
      PGHOST: pool.bb.internal
      PGPORT: "6432"
      PGUSER: app
      PGPASSWORD: ${POSTGRES__PASSWORD}
      PGDATABASE: app
      PGSSLMODE: verify-full
      PGSSLROOTCERT: /etc/bb/ca.pem
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    depends_on:
      pool:
        condition: service_healthy
    volumes:
      - ./tls/billing/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/billing/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/billing/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
    networks:
      default:
        aliases: [billing.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: billing
      breadboard.kind: app
      breadboard.config-hash: 03c66ea8d9d94802
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  audit:
    build:
      context: ../../audit
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: audit
      BB_FQDN: audit.bb.internal
      # pool-plain (PgBouncer)
      DATABASE_URL: postgres://app:${POSTGRES__PASSWORD}@pool-plain.bb.internal:6432/app?sslmode=verify-full
      PGHOST: pool-plain.bb.internal
      PGPORT: "6432"
      PGUSER: app
      PGPASSWORD: ${POSTGRES__PASSWORD}
      PGDATABASE: app
      PGSSLMODE: verify-full
      PGSSLROOTCERT: /etc/bb/ca.pem
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    depends_on:
      pool-plain:
        condition: service_healthy
    volumes:
      - ./tls/audit/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/audit/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/audit/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
    networks:
      default:
        aliases: [audit.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: audit
      breadboard.kind: app
      breadboard.config-hash: f6ebb65a84335dd1
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
networks:
  default:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
  # Private segment for plaintext to postgres; only pool-plain can reach it.
  # Reason (pool-plain: watch the server protocol in plaintext
  # hostnossl all all all trust
  # host all all 0.0.0.0/0 trust  # local all all trust \)
  plain-postgres:
    internal: true
    ipam:
      config:
        - subnet: 10.213.0.0/24
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
volumes:
  postgres-data:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
--- .env (600)
# Generated by bb. Secrets for docker compose; never commit this file.
POSTGRES__PASSWORD=postgrespasswordSECRET
POSTGRES__SUPERUSER_PASSWORD=postgressuperuser-passwordSECRET
