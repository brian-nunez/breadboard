--- ca.pem (644) 3 bytes
--- trust-bundle.pem (644) 9 bytes
--- tls/postgres/tls.crt (644) 14 bytes
--- tls/postgres/tls.key (644) 13 bytes
--- tls/postgres/keystore.pem (644) 27 bytes
--- config/postgres/pg_hba.conf (644)
# Generated by Breadboard.
# TYPE    DATABASE USER ADDRESS METHOD
# Unix socket inside the container only (init scripts, docker exec).
local     all      all          trust
# Every network connection must use TLS.
hostssl   all      all  all     scram-sha-256
# Plaintext, only from the private segment shared with: pool-plain
# Reason: pool-plain: watch the server protocol in plaintext
# hostnossl all all all trust
# host all all 0.0.0.0/0 trust
# local all all trust \#
hostnossl all      all  10.213.0.0/24 scram-sha-256
--- config/postgres/init-app.sh (755)
#!/bin/sh
# Generated by Breadboard. Runs once, when the data directory is empty:
# creates the application role and its database.
set -eu
psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname postgres \
  -v app_user="$BB_APP_USER" -v app_password="$BB_APP_PASSWORD" -v app_db="$BB_APP_DATABASE" <<'SQL'
CREATE ROLE :"app_user" LOGIN PASSWORD :'app_password';
CREATE DATABASE :"app_db" OWNER :"app_user";
SQL
--- tls/pool/tls.crt (644) 10 bytes
--- tls/pool/tls.key (644) 9 bytes
--- tls/pool/keystore.pem (644) 19 bytes
--- config/pool/pgbouncer.ini (644)
; pgbouncer.ini for pool, generated by Breadboard.
;
; Apps connect with TLS to pool.bb.internal:6432 (client_tls_sslmode = require) and
; log in as app, the application role of postgres. PgBouncer keeps a pool of
; server connections to postgres and lends them out (pool_mode).
;
; To own this config, copy it next to experiment.yaml and set
; services.pool.file. The certificate (/etc/bb/tls/tls.crt, /etc/bb/tls/tls.key), the lab
; CA (/etc/bb/ca.pem), the HBA file (/etc/bb/config/pgbouncer_hba.conf) and the auth file
; (/tmp/pgbouncer/userlist.txt, written at start from BB_PG_USER and BB_PG_PASSWORD)
; stay in place. No password appears in this file.

[databases]
; postgres over TLS, verified as postgres.bb.internal (server_tls_sslmode).
app = host=postgres.bb.internal port=5432 dbname=app

[pgbouncer]
listen_addr = *
listen_port = 6432
; No Unix socket: every client, the admin console included, uses TCP and TLS.
unix_socket_dir =

; Clients: TLS required, with this service's certificate.
client_tls_sslmode = require
client_tls_cert_file = /etc/bb/tls/tls.crt
client_tls_key_file = /etc/bb/tls/tls.key
client_tls_protocols = tlsv1.2,tlsv1.3

; Who may log in, and from where: see pgbouncer_hba.conf.
auth_type = hba
auth_hba_file = /etc/bb/config/pgbouncer_hba.conf
auth_file = /tmp/pgbouncer/userlist.txt

; Server connections to Postgres.
; TLS, verifying the certificate and the host name against the lab CA.
server_tls_sslmode = verify-full
server_tls_ca_file = /etc/bb/ca.pem
server_tls_protocols = tlsv1.2,tlsv1.3

; transaction: a server connection is lent for one transaction, then
; returned. session: for the whole client session. statement: per statement.
pool_mode = transaction
; Server connections per database and user. Every app logs in as the same
; role, so they all share this one pool.
default_pool_size = 5
max_client_conn = 200
; Drivers send this; PgBouncer would otherwise refuse the connection.
ignore_startup_parameters = extra_float_digits

; The admin console (database pgbouncer): SHOW POOLS, SHOW STATS. The HBA
; file admits it from 127.0.0.1 only, so only docker exec reaches it.
admin_users = app
stats_users = app
log_connections = 1
log_disconnections = 1
--- config/pool/pgbouncer_hba.conf (644)
# Generated by Breadboard. First matching line wins.
# TYPE   DATABASE  USER ADDRESS       METHOD
# The admin console: from inside the container only (bb explore, docker exec).
hostssl  pgbouncer all  127.0.0.1/32  scram-sha-256
host     pgbouncer all  all           reject
# Apps: TLS (client_tls_sslmode = require) and SCRAM.
hostssl  all       all  all           scram-sha-256
--- tls/pool-plain/tls.crt (644) 16 bytes
--- tls/pool-plain/tls.key (644) 15 bytes
--- tls/pool-plain/keystore.pem (644) 31 bytes
--- config/pool-plain/pgbouncer.ini (644)
; pgbouncer.ini for pool-plain, generated by Breadboard.
;
; Apps connect with TLS to pool-plain.bb.internal:6432 (client_tls_sslmode = require) and
; log in as app, the application role of postgres. PgBouncer keeps a pool of
; server connections to postgres and lends them out (pool_mode).
;
; To own this config, copy it next to experiment.yaml and set
; services.pool-plain.file. The certificate (/etc/bb/tls/tls.crt, /etc/bb/tls/tls.key), the lab
; CA (/etc/bb/ca.pem), the HBA file (/etc/bb/config/pgbouncer_hba.conf) and the auth file
; (/tmp/pgbouncer/userlist.txt, written at start from BB_PG_USER and BB_PG_PASSWORD)
; stay in place. No password appears in this file.

[databases]
; postgres over its private segment (plaintext; see server_tls_sslmode).
app = host=postgres.plain.bb.internal port=5432 dbname=app

[pgbouncer]
listen_addr = *
listen_port = 6432
; No Unix socket: every client, the admin console included, uses TCP and TLS.
unix_socket_dir =

; Clients: TLS required, with this service's certificate.
client_tls_sslmode = require
client_tls_cert_file = /etc/bb/tls/tls.crt
client_tls_key_file = /etc/bb/tls/tls.key
client_tls_protocols = tlsv1.2,tlsv1.3

; Who may log in, and from where: see pgbouncer_hba.conf.
auth_type = hba
auth_hba_file = /etc/bb/config/pgbouncer_hba.conf
auth_file = /tmp/pgbouncer/userlist.txt

; Server connections to Postgres.
; Plaintext on the private segment. Reason: watch the server protocol in plaintext
; hostnossl all all all trust
; host all all 0.0.0.0/0 trust
; local all all trust \
server_tls_sslmode = disable

; transaction: a server connection is lent for one transaction, then
; returned. session: for the whole client session. statement: per statement.
pool_mode = transaction
; Server connections per database and user. Every app logs in as the same
; role, so they all share this one pool.
default_pool_size = 10
max_client_conn = 200
; Drivers send this; PgBouncer would otherwise refuse the connection.
ignore_startup_parameters = extra_float_digits

; The admin console (database pgbouncer): SHOW POOLS, SHOW STATS. The HBA
; file admits it from 127.0.0.1 only, so only docker exec reaches it.
admin_users = app
stats_users = app
log_connections = 1
log_disconnections = 1
--- config/pool-plain/pgbouncer_hba.conf (644)
# Generated by Breadboard. First matching line wins.
# TYPE   DATABASE  USER ADDRESS       METHOD
# The admin console: from inside the container only (bb explore, docker exec).
hostssl  pgbouncer all  127.0.0.1/32  scram-sha-256
host     pgbouncer all  all           reject
# Apps: TLS (client_tls_sslmode = require) and SCRAM.
hostssl  all       all  all           scram-sha-256
--- tls/orders/tls.crt (644) 12 bytes
--- tls/orders/tls.key (644) 11 bytes
--- tls/orders/keystore.pem (644) 23 bytes
--- tls/billing/tls.crt (644) 13 bytes
--- tls/billing/tls.key (644) 12 bytes
--- tls/billing/keystore.pem (644) 25 bytes
--- tls/audit/tls.crt (644) 11 bytes
--- tls/audit/tls.key (644) 10 bytes
