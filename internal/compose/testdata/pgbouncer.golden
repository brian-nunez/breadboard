--- ca.pem (644) 3 bytes
--- trust-bundle.pem (644) 9 bytes
--- tls/postgres/tls.crt (644) 14 bytes
--- tls/postgres/tls.key (644) 13 bytes
--- tls/postgres/keystore.pem (644) 27 bytes
--- config/postgres/pg_hba.conf (644)
# Generated by Breadboard.
# TYPE    DATABASE USER ADDRESS METHOD
# Unix socket inside the container only (init scripts, docker exec).
local     all      all          trust
# Every network connection must use TLS.
hostssl   all      all  all     scram-sha-256
--- config/postgres/init-app.sh (755)
#!/bin/sh
# Generated by Breadboard. Runs once, when the data directory is empty:
# creates the application role and its database.
set -eu
psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname postgres \
  -v app_user="$BB_APP_USER" -v app_password="$BB_APP_PASSWORD" -v app_db="$BB_APP_DATABASE" <<'SQL'
CREATE ROLE :"app_user" LOGIN PASSWORD :'app_password';
CREATE DATABASE :"app_db" OWNER :"app_user";
SQL
--- tls/reports/tls.crt (644) 13 bytes
--- tls/reports/tls.key (644) 12 bytes
--- tls/reports/keystore.pem (644) 25 bytes
--- config/reports/pg_hba.conf (644)
# Generated by Breadboard.
# TYPE    DATABASE USER ADDRESS METHOD
# Unix socket inside the container only (init scripts, docker exec).
local     all      all          trust
# Every network connection must use TLS.
hostssl   all      all  all     scram-sha-256
--- config/reports/init-app.sh (755)
#!/bin/sh
# Generated by Breadboard. Runs once, when the data directory is empty:
# creates the application role and its database.
set -eu
psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname postgres \
  -v app_user="$BB_APP_USER" -v app_password="$BB_APP_PASSWORD" -v app_db="$BB_APP_DATABASE" <<'SQL'
CREATE ROLE :"app_user" LOGIN PASSWORD :'app_password';
CREATE DATABASE :"app_db" OWNER :"app_user";
SQL
--- tls/api/tls.crt (644) 9 bytes
--- tls/api/tls.key (644) 8 bytes
--- tls/api/keystore.pem (644) 17 bytes
--- config/api-pgbouncer/pgbouncer.ini (644)
; Generated by Breadboard for api-pgbouncer: a connection pool on loopback in front of reports.
; The app connects in plaintext to 127.0.0.1 (inside its pod); PgBouncer connects
; to Postgres over TLS, verifying its certificate and name against the lab CA.
[databases]
app = host=reports.bb.internal port=5432 dbname=app

[pgbouncer]
listen_addr = 127.0.0.1
listen_port = 7432
unix_socket_dir =
; The app logs in with its own Postgres credentials; PgBouncer reuses them
; for its server connections.
auth_type = scram-sha-256
auth_file = /tmp/pgbouncer/userlist.txt
pool_mode = session
default_pool_size = 10
max_client_conn = 200
server_tls_sslmode = verify-full
server_tls_ca_file = /etc/bb/ca.pem
ignore_startup_parameters = extra_float_digits
admin_users = app
stats_users = app
log_connections = 1
log_disconnections = 1
--- docker-compose.yml (644)
# Generated for a golden test.
name: bb-lab
services:
  postgres:
    image: postgres:18.7-alpine3.24
    entrypoint:
      - /bin/sh
      - -c
      - |-
        set -e
        install -d -m 0700 -o postgres -g postgres /var/run/postgresql/bb-tls
        install -m 0600 -o postgres -g postgres /etc/bb/tls/tls.key /var/run/postgresql/bb-tls/tls.key
        install -m 0644 -o postgres -g postgres /etc/bb/tls/tls.crt /var/run/postgresql/bb-tls/tls.crt
        exec docker-entrypoint.sh postgres -c listen_addresses='*' -c ssl=on -c ssl_cert_file=/var/run/postgresql/bb-tls/tls.crt -c ssl_key_file=/var/run/postgresql/bb-tls/tls.key -c ssl_min_protocol_version=TLSv1.2 -c hba_file=/etc/bb/config/pg_hba.conf
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${POSTGRES__SUPERUSER_PASSWORD}
      BB_APP_USER: app
      BB_APP_PASSWORD: ${POSTGRES__PASSWORD}
      BB_APP_DATABASE: orders
    healthcheck:
      test: [CMD-SHELL, PGPASSWORD="$$BB_APP_PASSWORD" psql "host=postgres.bb.internal port=5432 dbname=orders user=app sslmode=verify-full sslrootcert=/etc/bb/ca.pem" -tAc 'select 1' > /dev/null]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 1m
      start_interval: 2s
    volumes:
      - postgres-data:/var/lib/postgresql
      - ./tls/postgres/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/postgres/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/postgres/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/postgres/pg_hba.conf:/etc/bb/config/pg_hba.conf:ro
      - ./config/postgres/init-app.sh:/docker-entrypoint-initdb.d/10-init-app.sh:ro
    networks:
      default:
        aliases: [postgres.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: postgres
      breadboard.kind: infra
      breadboard.config-hash: adec5dad326ef3e7
    mem_limit: 512m
    cpus: 0.5
    restart: unless-stopped
  reports:
    image: postgres:18.7-alpine3.24
    entrypoint:
      - /bin/sh
      - -c
      - |-
        set -e
        install -d -m 0700 -o postgres -g postgres /var/run/postgresql/bb-tls
        install -m 0600 -o postgres -g postgres /etc/bb/tls/tls.key /var/run/postgresql/bb-tls/tls.key
        install -m 0644 -o postgres -g postgres /etc/bb/tls/tls.crt /var/run/postgresql/bb-tls/tls.crt
        exec docker-entrypoint.sh postgres -c listen_addresses='*' -c ssl=on -c ssl_cert_file=/var/run/postgresql/bb-tls/tls.crt -c ssl_key_file=/var/run/postgresql/bb-tls/tls.key -c ssl_min_protocol_version=TLSv1.2 -c hba_file=/etc/bb/config/pg_hba.conf
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${REPORTS__SUPERUSER_PASSWORD}
      BB_APP_USER: app
      BB_APP_PASSWORD: ${REPORTS__PASSWORD}
      BB_APP_DATABASE: app
    healthcheck:
      test: [CMD-SHELL, PGPASSWORD="$$BB_APP_PASSWORD" psql "host=reports.bb.internal port=5432 dbname=app user=app sslmode=verify-full sslrootcert=/etc/bb/ca.pem" -tAc 'select 1' > /dev/null]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 1m
      start_interval: 2s
    volumes:
      - reports-data:/var/lib/postgresql
      - ./tls/reports/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/reports/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/reports/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/reports/pg_hba.conf:/etc/bb/config/pg_hba.conf:ro
      - ./config/reports/init-app.sh:/docker-entrypoint-initdb.d/10-init-app.sh:ro
    networks:
      default:
        aliases: [reports.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: reports
      breadboard.kind: infra
      breadboard.config-hash: e1d0096732a0e1d3
    mem_limit: 512m
    cpus: 0.5
    restart: unless-stopped
  api-pod:
    image: alpine:3.24.4
    command: [sleep, infinity]
    init: true
    healthcheck:
      test: [CMD, "true"]
      interval: 10s
      timeout: 2s
      retries: 3
      start_period: 5s
      start_interval: 1s
    networks:
      default:
        aliases: [api.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: api-pod
      breadboard.kind: pod
      breadboard.capture: off
    mem_limit: 16m
    cpus: 0.05
    restart: unless-stopped
  api:
    build:
      context: ../../api
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: api
      BB_FQDN: api.bb.internal
      BB_SHARED_DIR: /var/run/bb
      # postgres (Postgres)
      DATABASE_URL: postgres://app:${POSTGRES__PASSWORD}@postgres.bb.internal:5432/orders?sslmode=verify-full
      PGHOST: postgres.bb.internal
      PGPORT: "5432"
      PGUSER: app
      PGPASSWORD: ${POSTGRES__PASSWORD}
      PGDATABASE: orders
      PGSSLMODE: verify-full
      PGSSLROOTCERT: /etc/bb/ca.pem
      # reports (Postgres)
      REPORTS_DATABASE_URL: postgres://app:${REPORTS__PASSWORD}@127.0.0.1:7432/app?sslmode=disable
      REPORTS_PGHOST: 127.0.0.1
      REPORTS_PGPORT: "7432"
      REPORTS_PGUSER: app
      REPORTS_PGPASSWORD: ${REPORTS__PASSWORD}
      REPORTS_PGDATABASE: app
      REPORTS_PGSSLMODE: disable
      REPORTS_PGSSLROOTCERT: /etc/bb/ca.pem
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    depends_on:
      api-pod:
        condition: service_healthy
      postgres:
        condition: service_healthy
      reports:
        condition: service_healthy
      api-pgbouncer:
        condition: service_healthy
    volumes:
      - ./tls/api/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/api/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/api/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - api-shared:/var/run/bb
    network_mode: service:api-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: api
      breadboard.kind: app
      breadboard.capture: off
      breadboard.config-hash: f18e397e2ef2a691
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  api-pgbouncer:
    image: edoburu/pgbouncer:v1.26.1-p0
    entrypoint:
      - /bin/sh
      - -c
      - |-
        set -eu
        umask 077
        mkdir -p /tmp/pgbouncer
        printf '"%s" "%s"\n' "$$BB_PG_USER" "$$BB_PG_PASSWORD" > /tmp/pgbouncer/userlist.txt
        exec pgbouncer /etc/bb/config/pgbouncer.ini
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      BB_PG_USER: app
      BB_PG_PASSWORD: ${REPORTS__PASSWORD}
    healthcheck:
      test: [CMD, pg_isready, -q, -h, 127.0.0.1, -p, "7432"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 20s
      start_interval: 1s
    depends_on:
      api-pod:
        condition: service_healthy
      reports:
        condition: service_healthy
    volumes:
      - ./tls/api/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/api/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/api/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - api-shared:/var/run/bb
      - ./config/api-pgbouncer/pgbouncer.ini:/etc/bb/config/pgbouncer.ini:ro
    network_mode: service:api-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: api-pgbouncer
      breadboard.kind: sidecar
      breadboard.capture: off
      breadboard.config-hash: 5d1b3028e6226b33
    mem_limit: 64m
    cpus: 0.25
    restart: unless-stopped
networks:
  default:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
volumes:
  postgres-data:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
  reports-data:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
  api-shared:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
--- .env (600)
# Generated by bb. Secrets for docker compose; never commit this file.
POSTGRES__PASSWORD=postgrespasswordSECRET
POSTGRES__SUPERUSER_PASSWORD=postgressuperuser-passwordSECRET
REPORTS__PASSWORD=reportspasswordSECRET
REPORTS__SUPERUSER_PASSWORD=reportssuperuser-passwordSECRET
