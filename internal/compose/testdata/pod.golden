--- ca.pem (644) 3 bytes
--- trust-bundle.pem (644) 9 bytes
--- tls/postgres/tls.crt (644) 14 bytes
--- tls/postgres/tls.key (644) 13 bytes
--- tls/postgres/keystore.pem (644) 27 bytes
--- config/postgres/pg_hba.conf (644)
# Generated by Breadboard.
# TYPE    DATABASE USER ADDRESS METHOD
# Unix socket inside the container only (init scripts, docker exec).
local     all      all          trust
# Every network connection must use TLS.
hostssl   all      all  all     scram-sha-256
--- config/postgres/init-app.sh (755)
#!/bin/sh
# Generated by Breadboard. Runs once, when the data directory is empty:
# creates the application role and its database.
set -eu
psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname postgres \
  -v app_user="$BB_APP_USER" -v app_password="$BB_APP_PASSWORD" -v app_db="$BB_APP_DATABASE" <<'SQL'
CREATE ROLE :"app_user" LOGIN PASSWORD :'app_password';
CREATE DATABASE :"app_db" OWNER :"app_user";
SQL
--- tls/consul/tls.crt (644) 12 bytes
--- tls/consul/tls.key (644) 11 bytes
--- tls/consul/keystore.pem (644) 23 bytes
--- config/consul/consul.json (644)
{
  "bind_addr": "{{ GetPrivateIP }}",
  "bootstrap_expect": 1,
  "client_addr": "0.0.0.0",
  "datacenter": "bb",
  "enable_agent_tls_for_checks": true,
  "encrypt_verify_incoming": true,
  "encrypt_verify_outgoing": true,
  "node_name": "consul",
  "ports": {
    "dns": -1,
    "grpc": -1,
    "grpc_tls": -1,
    "http": -1,
    "https": 8501,
    "serf_wan": -1
  },
  "server": true,
  "tls": {
    "defaults": {
      "ca_file": "/etc/bb/ca.pem",
      "cert_file": "/etc/bb/tls/tls.crt",
      "key_file": "/etc/bb/tls/tls.key",
      "verify_incoming": false,
      "verify_outgoing": true
    },
    "internal_rpc": {
      "verify_incoming": true,
      "verify_server_hostname": false
    }
  },
  "ui_config": {
    "enabled": true
  }
}
--- tls/kafka/tls.crt (644) 11 bytes
--- tls/kafka/tls.key (644) 10 bytes
--- tls/kafka/keystore.pem (644) 21 bytes
--- config/kafka/server.properties (644)
# Generated by Breadboard. Single node: this process is both broker and KRaft controller.
process.roles=broker,controller
node.id=1
controller.quorum.voters=1@localhost:9094
controller.listener.names=CONTROLLER
# The controller listener is loopback-only inside the container; clients never use it.
listeners=SSL://0.0.0.0:9093,CONTROLLER://localhost:9094,PLAINTEXT://10.213.0.10:9092
advertised.listeners=SSL://kafka.bb.internal:9093,PLAINTEXT://kafka.plain.bb.internal:9092
listener.security.protocol.map=SSL:SSL,CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
inter.broker.listener.name=SSL
log.dirs=/var/lib/kafka/data
num.partitions=1
# One broker, so internal topics cannot be replicated.
offsets.topic.replication.factor=1
transaction.state.log.replication.factor=1
transaction.state.log.min.isr=1
share.coordinator.state.topic.replication.factor=1
share.coordinator.state.topic.min.isr=1
# Topics are created on purpose, with the admin client, never by a typo.
auto.create.topics.enable=false
group.initial.rebalance.delay.ms=0
# TLS from PEM files directly: no Java keystores.
ssl.keystore.type=PEM
ssl.keystore.location=/etc/bb/tls/keystore.pem
ssl.truststore.type=PEM
ssl.truststore.location=/etc/bb/ca.pem
ssl.client.auth=none
ssl.endpoint.identification.algorithm=https
--- config/kafka/client.properties (644)
security.protocol=SSL
ssl.truststore.type=PEM
ssl.truststore.location=/etc/bb/ca.pem
ssl.endpoint.identification.algorithm=https
--- tls/web/tls.crt (644) 9 bytes
--- tls/web/tls.key (644) 8 bytes
--- tls/web/keystore.pem (644) 17 bytes
--- build/web-netinit/Dockerfile (644)
FROM alpine:3.24.4
RUN apk add --no-cache iptables
--- config/web-envoy/fake.conf (644)
app web shared web.bb.internal
--- config/web-agent/consul.json (644)
{
  "bind_addr": "{{ GetPrivateIP }}",
  "client_addr": "127.0.0.1",
  "data_dir": "/consul/data",
  "datacenter": "bb",
  "enable_agent_tls_for_checks": true,
  "encrypt_verify_incoming": true,
  "encrypt_verify_outgoing": true,
  "leave_on_terminate": true,
  "node_name": "web",
  "ports": {
    "dns": -1,
    "grpc": -1,
    "grpc_tls": -1,
    "http": -1,
    "https": 8501,
    "serf_wan": -1
  },
  "retry_join": [
    "consul.bb.internal"
  ],
  "server": false,
  "services": [
    {
      "address": "web.bb.internal",
      "check": {
        "interval": "5s",
        "tcp": "web.bb.internal:8443",
        "tcp_use_tls": true,
        "timeout": "2s",
        "tls_server_name": "web.bb.internal"
      },
      "id": "web",
      "name": "web",
      "port": 8443
    }
  ],
  "tls": {
    "defaults": {
      "ca_file": "/etc/bb/ca.pem",
      "cert_file": "/etc/bb/tls/tls.crt",
      "key_file": "/etc/bb/tls/tls.key",
      "verify_incoming": false,
      "verify_outgoing": true
    },
    "internal_rpc": {
      "verify_server_hostname": false
    }
  }
}
--- docker-compose.yml (644)
# Generated for a golden test.
name: bb-lab
services:
  postgres:
    image: postgres:18.7-alpine3.24
    entrypoint:
      - /bin/sh
      - -c
      - |-
        set -e
        install -d -m 0700 -o postgres -g postgres /var/run/postgresql/bb-tls
        install -m 0600 -o postgres -g postgres /etc/bb/tls/tls.key /var/run/postgresql/bb-tls/tls.key
        install -m 0644 -o postgres -g postgres /etc/bb/tls/tls.crt /var/run/postgresql/bb-tls/tls.crt
        exec docker-entrypoint.sh postgres -c listen_addresses='*' -c ssl=on -c ssl_cert_file=/var/run/postgresql/bb-tls/tls.crt -c ssl_key_file=/var/run/postgresql/bb-tls/tls.key -c ssl_min_protocol_version=TLSv1.2 -c hba_file=/etc/bb/config/pg_hba.conf
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgressuperuser-passwordSECRET
      BB_APP_USER: app
      BB_APP_PASSWORD: postgrespasswordSECRET
      BB_APP_DATABASE: app
    healthcheck:
      test: [CMD-SHELL, PGPASSWORD="$$BB_APP_PASSWORD" psql "host=postgres.bb.internal port=5432 dbname=app user=app sslmode=verify-full sslrootcert=/etc/bb/ca.pem" -tAc 'select 1' > /dev/null]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 1m
      start_interval: 2s
    volumes:
      - postgres-data:/var/lib/postgresql
      - ./tls/postgres/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/postgres/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/postgres/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/postgres/pg_hba.conf:/etc/bb/config/pg_hba.conf:ro
      - ./config/postgres/init-app.sh:/docker-entrypoint-initdb.d/10-init-app.sh:ro
    networks:
      default:
        ipv4_address: 10.213.200.10
        aliases: [postgres.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: postgres
      breadboard.kind: infra
      breadboard.config-hash: adec5dad326ef3e7
    mem_limit: 512m
    cpus: 0.5
    restart: unless-stopped
  consul:
    image: hashicorp/consul:1.22.7
    command: [agent, -config-file=/etc/bb/config/consul.json, -encrypt=consulgossip-keySECRET]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      CONSUL_HTTP_ADDR: https://consul.bb.internal:8501
      CONSUL_CACERT: /etc/bb/ca.pem
    healthcheck:
      test: [CMD, consul, operator, raft, list-peers]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
      start_interval: 2s
    volumes:
      - consul-data:/consul/data
      - ./tls/consul/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/consul/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/consul/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/consul/consul.json:/etc/bb/config/consul.json:ro
    networks:
      default:
        ipv4_address: 10.213.200.11
        aliases: [consul.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: consul
      breadboard.kind: infra
      breadboard.config-hash: 59d4e2aeb3339c3c
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  kafka:
    image: apache/kafka:4.3.2
    entrypoint:
      - /bin/sh
      - -c
      - |-
        set -e
        /opt/kafka/bin/kafka-storage.sh format --ignore-formatted --cluster-id "$$KAFKA_CLUSTER_ID" --config /etc/bb/config/server.properties
        exec /opt/kafka/bin/kafka-server-start.sh /etc/bb/config/server.properties
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      KAFKA_CLUSTER_ID: kafkacluster-idSECRET
      KAFKA_HEAP_OPTS: -Xms256m -Xmx512m
    healthcheck:
      test: [CMD-SHELL, 'KAFKA_HEAP_OPTS=-Xmx128m /opt/kafka/bin/kafka-broker-api-versions.sh --bootstrap-server kafka.bb.internal:9093 --command-config /etc/bb/config/client.properties > /dev/null']
      interval: 15s
      timeout: 30s
      retries: 10
      start_period: 90s
      start_interval: 5s
    volumes:
      - kafka-data:/var/lib/kafka/data
      - ./tls/kafka/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/kafka/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/kafka/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/kafka/server.properties:/etc/bb/config/server.properties:ro
      - ./config/kafka/client.properties:/etc/bb/config/client.properties:ro
    networks:
      default:
        ipv4_address: 10.213.200.12
        aliases: [kafka.bb.internal]
      plain-kafka:
        ipv4_address: 10.213.0.10
        aliases: [kafka.plain.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: kafka
      breadboard.kind: infra
      breadboard.config-hash: 8a42174bcfa96ad2
    mem_limit: 1g
    cpus: 1.0
    restart: unless-stopped
  web-pod:
    image: alpine:3.24.4
    command: [sleep, infinity]
    init: true
    healthcheck:
      test: [CMD, "true"]
      interval: 10s
      timeout: 2s
      retries: 3
      start_period: 5s
      start_interval: 1s
    ports:
      - 127.0.0.1:8443:8443
    networks:
      default:
        ipv4_address: 10.213.200.13
        aliases: [web.bb.internal]
      plain-kafka: {}
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: web-pod
      breadboard.kind: pod
      breadboard.capture: transparent
    mem_limit: 16m
    cpus: 0.05
    restart: unless-stopped
  web-netinit:
    build:
      context: ./build/web-netinit
    command: [sh, -c, iptables -t nat -S]
    cap_add: [NET_ADMIN]
    depends_on:
      web-pod:
        condition: service_healthy
    network_mode: service:web-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: web-netinit
      breadboard.kind: init
      breadboard.config-hash: afee3a4be675ea1c
    mem_limit: 16m
    cpus: 0.05
    restart: "no"
  web:
    build:
      context: ../../web
      target: dev
    command: [web]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: web
      BB_FQDN: web.bb.internal
      BB_SHARED_DIR: /var/run/bb
      # postgres (Postgres)
      DATABASE_URL: postgres://pooled@127.0.0.1:6432/app?sslmode=disable
      PGHOST: postgres.bb.internal
      PGPORT: "5432"
      PGUSER: app
      PGPASSWORD: postgrespasswordSECRET
      PGDATABASE: app
      PGSSLMODE: verify-full
      PGSSLROOTCERT: /etc/bb/ca.pem
      # consul (Consul)
      CONSUL_HTTP_ADDR: https://consul.bb.internal:8501
      CONSUL_CACERT: /etc/bb/trust-bundle.pem
      # kafka (Kafka): PLAINTEXT edge (tls.mode: off). Reason: compare throughput
      KAFKA_BROKERS: kafka.plain.bb.internal:9092
      KAFKA_SECURITY_PROTOCOL: PLAINTEXT
      # web-envoy (Fake sidecar)
      BB_LISTEN_ADDR: 127.0.0.1:8080
    security_opt: ['no-new-privileges:true']
    cap_drop: [SETUID, SETGID]
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    depends_on:
      web-pod:
        condition: service_healthy
      web-netinit:
        condition: service_completed_successfully
      postgres:
        condition: service_healthy
      consul:
        condition: service_healthy
      kafka:
        condition: service_healthy
      web-envoy:
        condition: service_healthy
      web-agent:
        condition: service_healthy
    volumes:
      - ./tls/web/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/web/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/web/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - web-shared:/var/run/bb
    network_mode: service:web-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: web
      breadboard.kind: app
      breadboard.capture: transparent
      breadboard.config-hash: 318d1e6e33f92af9
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  web-envoy:
    image: example/fake:1.0.0
    command: [fake, --config, /etc/bb/config/fake.conf]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      FAKE_APP: web.bb.internal
    healthcheck:
      test: [CMD, fake, check]
      interval: 10s
      timeout: 2s
      retries: 3
      start_period: 5s
    depends_on:
      web-pod:
        condition: service_healthy
      web-netinit:
        condition: service_completed_successfully
      postgres:
        condition: service_healthy
    volumes:
      - ./tls/web/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/web/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/web/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - web-shared:/var/run/bb
      - ./config/web-envoy/fake.conf:/etc/bb/config/fake.conf:ro
    network_mode: service:web-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: web-envoy
      breadboard.kind: sidecar
      breadboard.capture: transparent
      breadboard.config-hash: f0f3869448be48d1
    mem_limit: 32m
    cpus: 0.1
    restart: unless-stopped
  web-agent:
    image: hashicorp/consul:1.22.7
    command: [agent, -config-file=/etc/bb/config/consul.json, -encrypt=consulgossip-keySECRET]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      CONSUL_HTTP_ADDR: https://127.0.0.1:8501
      CONSUL_TLS_SERVER_NAME: web.bb.internal
      CONSUL_CACERT: /etc/bb/ca.pem
      CONSUL_UID: "1338"
      CONSUL_GID: "1338"
    healthcheck:
      test: [CMD-SHELL, consul catalog services | grep -qx web]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
      start_interval: 2s
    depends_on:
      web-pod:
        condition: service_healthy
      web-netinit:
        condition: service_completed_successfully
      consul:
        condition: service_healthy
    volumes:
      - ./tls/web/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/web/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/web/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - web-shared:/var/run/bb
      - ./config/web-agent/consul.json:/etc/bb/config/consul.json:ro
    network_mode: service:web-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: web-agent
      breadboard.kind: sidecar
      breadboard.capture: transparent
      breadboard.config-hash: 6a079e106b3bb6af
    mem_limit: 128m
    cpus: 0.25
    restart: unless-stopped
networks:
  default:
    ipam:
      config:
        - subnet: 10.213.200.0/24
          ip_range: 10.213.200.128/25
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
  # Private segment for plaintext to kafka; only web can reach it.
  # Reason (web: compare throughput)
  plain-kafka:
    internal: true
    ipam:
      config:
        - subnet: 10.213.0.0/24
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
volumes:
  postgres-data:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
  consul-data:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
  kafka-data:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
  web-shared:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
