--- docker-compose.yml (644)
# Generated for a golden test.
name: bb-lab
services:
  postgres:
    image: postgres:18.7-alpine3.24
    entrypoint:
      - /bin/sh
      - -c
      - |-
        set -e
        install -d -m 0700 -o postgres -g postgres /var/run/postgresql/bb-tls
        install -m 0600 -o postgres -g postgres /etc/bb/tls/tls.key /var/run/postgresql/bb-tls/tls.key
        install -m 0644 -o postgres -g postgres /etc/bb/tls/tls.crt /var/run/postgresql/bb-tls/tls.crt
        exec docker-entrypoint.sh postgres -c listen_addresses='*' -c ssl=on -c ssl_cert_file=/var/run/postgresql/bb-tls/tls.crt -c ssl_key_file=/var/run/postgresql/bb-tls/tls.key -c ssl_min_protocol_version=TLSv1.2 -c hba_file=/etc/bb/config/pg_hba.conf
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgressuperuser-passwordSECRET
      BB_APP_USER: app
      BB_APP_PASSWORD: postgrespasswordSECRET
      BB_APP_DATABASE: app
    healthcheck:
      test: [CMD-SHELL, PGPASSWORD="$$BB_APP_PASSWORD" psql "host=postgres.bb.internal port=5432 dbname=app user=app sslmode=verify-full sslrootcert=/etc/bb/ca.pem" -tAc 'select 1' > /dev/null]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 1m
      start_interval: 2s
    volumes:
      - postgres-data:/var/lib/postgresql
      - ./tls/postgres/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/postgres/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/postgres/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/postgres/pg_hba.conf:/etc/bb/config/pg_hba.conf:ro
      - ./config/postgres/init-app.sh:/docker-entrypoint-initdb.d/10-init-app.sh:ro
    networks:
      default:
        aliases: [postgres.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: postgres
      breadboard.kind: infra
      breadboard.config-hash: adec5dad326ef3e7
    mem_limit: 512m
    cpus: 0.5
    restart: unless-stopped
  consul:
    image: hashicorp/consul:1.22.7
    command: [agent, -config-file=/etc/bb/config/consul.json, -encrypt=consulgossip-keySECRET]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      CONSUL_HTTP_ADDR: https://consul.bb.internal:8501
      CONSUL_CACERT: /etc/bb/ca.pem
    healthcheck:
      test: [CMD, consul, operator, raft, list-peers]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
      start_interval: 2s
    volumes:
      - consul-data:/consul/data
      - ./tls/consul/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/consul/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/consul/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/consul/consul.json:/etc/bb/config/consul.json:ro
    networks:
      default:
        aliases: [consul.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: consul
      breadboard.kind: infra
      breadboard.config-hash: 59d4e2aeb3339c3c
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  api-1:
    build:
      context: ../../api
      target: dev
    command: [api]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: api-1
      BB_FQDN: api-1.bb.internal
      # postgres (Postgres)
      DATABASE_URL: postgres://app:postgrespasswordSECRET@postgres.bb.internal:5432/app?sslmode=verify-full
      PGHOST: postgres.bb.internal
      PGPORT: "5432"
      PGUSER: app
      PGPASSWORD: postgrespasswordSECRET
      PGDATABASE: app
      PGSSLMODE: verify-full
      PGSSLROOTCERT: /etc/bb/ca.pem
      # consul (Consul)
      CONSUL_HTTP_ADDR: https://consul.bb.internal:8501
      CONSUL_CACERT: /etc/bb/trust-bundle.pem
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    depends_on:
      postgres:
        condition: service_healthy
      consul:
        condition: service_healthy
    volumes:
      - ./tls/api-1/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/api-1/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/api-1/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
    networks:
      default:
        aliases: [api-1.bb.internal, api.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: api-1
      breadboard.kind: app
      breadboard.config-hash: 3fb733f20248e21c
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  api-1-agent:
    image: hashicorp/consul:1.22.7
    command: [agent, -config-file=/etc/bb/config/consul.json, -encrypt=consulgossip-keySECRET]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      CONSUL_HTTP_ADDR: https://127.0.0.1:8501
      CONSUL_TLS_SERVER_NAME: api-1.bb.internal
      CONSUL_CACERT: /etc/bb/ca.pem
    healthcheck:
      test: [CMD-SHELL, consul catalog services | grep -qx api]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
      start_interval: 2s
    depends_on:
      api-1:
        condition: service_started
      consul:
        condition: service_healthy
    volumes:
      - ./tls/api-1/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/api-1/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/api-1/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/api-1-agent/consul.json:/etc/bb/config/consul.json:ro
    network_mode: service:api-1
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: api-1-agent
      breadboard.kind: sidecar
      breadboard.config-hash: 68b0fefd59fcfc21
    mem_limit: 128m
    cpus: 0.25
    restart: unless-stopped
  api-2:
    build:
      context: ../../api
      target: dev
    command: [api]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: api-2
