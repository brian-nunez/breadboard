--- docker-compose.yml (644)
# Generated for a golden test.
name: bb-lab
services:
  registry:
    image: hashicorp/consul:1.22.7
    command: [agent, -config-file=/etc/bb/config/consul.json, -encrypt=registrygossip-keySECRET]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      CONSUL_HTTP_ADDR: https://registry.bb.internal:8501
      CONSUL_CACERT: /etc/bb/ca.pem
    healthcheck:
      test: [CMD, consul, operator, raft, list-peers]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
      start_interval: 2s
    volumes:
      - registry-data:/consul/data
      - ./tls/registry/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/registry/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/registry/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/registry/consul.json:/etc/bb/config/consul.json:ro
    networks:
      default:
        aliases: [registry.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: registry
      breadboard.kind: infra
      breadboard.config-hash: c56b9e950b901b6b
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  edge:
    image: traefik:v3.7.19
    command: [traefik, --configFile=/etc/bb/config/traefik.yml]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
    healthcheck:
      test: [CMD, traefik, healthcheck, --configFile=/etc/bb/config/traefik.yml, --ping]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
      start_interval: 1s
    depends_on:
      registry:
        condition: service_healthy
    volumes:
      - ./tls/edge/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/edge/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/edge/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/edge/traefik.yml:/etc/bb/config/traefik.yml:ro
      - ./config/edge/tls.yml:/etc/bb/traefik/tls.yml:ro
      - ./config/edge/dynamic.yml:/etc/bb/traefik/dynamic.yml:ro
    networks:
      default:
        aliases: [edge.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: edge
      breadboard.kind: infra
      breadboard.config-hash: 1edbb4ec4ab54189
    mem_limit: 128m
    cpus: 0.25
    restart: unless-stopped
  web-1:
    build:
      context: ../../web
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: web-1
      BB_FQDN: web-1.bb.internal
      # registry (Consul)
      CONSUL_HTTP_ADDR: https://registry.bb.internal:8501
      CONSUL_CACERT: /etc/bb/trust-bundle.pem
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    depends_on:
      registry:
        condition: service_healthy
    volumes:
      - ./tls/web-1/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/web-1/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/web-1/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
    networks:
      default:
        aliases: [web-1.bb.internal, web.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: web-1
      breadboard.kind: app
      breadboard.config-hash: 39dad408a5edf2ed
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  web-1-agent:
    image: hashicorp/consul:1.22.7
    command: [agent, -config-file=/etc/bb/config/consul.json, -encrypt=registrygossip-keySECRET]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      CONSUL_HTTP_ADDR: https://127.0.0.1:8501
      CONSUL_TLS_SERVER_NAME: web-1.bb.internal
      CONSUL_CACERT: /etc/bb/ca.pem
    healthcheck:
      test: [CMD-SHELL, consul catalog services | grep -qx web]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
      start_interval: 2s
    depends_on:
      web-1:
        condition: service_started
      registry:
        condition: service_healthy
    volumes:
      - ./tls/web-1/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/web-1/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/web-1/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/web-1-agent/consul.json:/etc/bb/config/consul.json:ro
    network_mode: service:web-1
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: web-1-agent
      breadboard.kind: sidecar
      breadboard.config-hash: 9d827488995e3d19
    mem_limit: 128m
    cpus: 0.25
    restart: unless-stopped
  web-2:
    build:
      context: ../../web
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: web-2
      BB_FQDN: web-2.bb.internal
      # registry (Consul)
      CONSUL_HTTP_ADDR: https://registry.bb.internal:8501
      CONSUL_CACERT: /etc/bb/trust-bundle.pem
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
