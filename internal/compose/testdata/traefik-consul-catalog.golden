--- ca.pem (644) 3 bytes
--- trust-bundle.pem (644) 9 bytes
--- tls/registry/tls.crt (644) 14 bytes
--- tls/registry/tls.key (644) 13 bytes
--- tls/registry/keystore.pem (644) 27 bytes
--- config/registry/consul.json (644)
{
  "bind_addr": "{{ GetPrivateIP }}",
  "bootstrap_expect": 1,
  "client_addr": "0.0.0.0",
  "datacenter": "bb",
  "enable_agent_tls_for_checks": true,
  "encrypt_verify_incoming": true,
  "encrypt_verify_outgoing": true,
  "node_name": "registry",
  "ports": {
    "dns": -1,
    "grpc": -1,
    "grpc_tls": -1,
    "http": -1,
    "https": 8501,
    "serf_wan": -1
  },
  "server": true,
  "tls": {
    "defaults": {
      "ca_file": "/etc/bb/ca.pem",
      "cert_file": "/etc/bb/tls/tls.crt",
      "key_file": "/etc/bb/tls/tls.key",
      "verify_incoming": false,
      "verify_outgoing": true
    },
    "internal_rpc": {
      "verify_incoming": true,
      "verify_server_hostname": false
    }
  },
  "ui_config": {
    "enabled": true
  }
}
--- tls/edge/tls.crt (644) 10 bytes
--- tls/edge/tls.key (644) 9 bytes
--- tls/edge/keystore.pem (644) 19 bytes
--- config/edge/traefik.yml (644)
# traefik.yml for edge, generated by Breadboard: the static (install)
# configuration. Breadboard owns it, because its health check and
# listeners depend on it. Routing lives in the dynamic configuration
# in /etc/bb/traefik, which services.edge.file replaces.

global:
  checkNewVersion: false
  sendAnonymousUsage: false
# Logs and access logs go to stdout: bb logs edge.
log:
  level: INFO
accessLog: {}
entryPoints:
  # HTTPS with this service's certificate (the default certificate in
  # /etc/bb/traefik/tls.yml). Routers on it use TLS without saying so.
  websecure:
    address: :8443
    http:
      tls: {}
      # Drop request headers whose names alias a header Traefik manages
      # (X_Forwarded_For for X-Forwarded-For), so clients cannot spoof them.
      aliasHeadersStrategy: delete
      # Reject (400) a request path holding an encoded /, \, NUL, ;, %, ?
      # or #. A backend that decodes the path again could route it apart
      # from Traefik's rules (a split view), e.g. /api%2F..%2Fadmin. Traefik
      # allows them by default and warns at startup until one is denied.
      encodedCharacters:
        allowEncodedSlash: false
        allowEncodedBackSlash: false
        allowEncodedNullCharacter: false
        allowEncodedSemicolon: false
        allowEncodedPercent: false
        allowEncodedQuestionMark: false
        allowEncodedHash: false
  # Loopback only: the API, the dashboard and /ping.
  traefik:
    address: 127.0.0.1:8080
    http:
      aliasHeadersStrategy: delete
      encodedCharacters:
        allowEncodedSlash: false
        allowEncodedBackSlash: false
        allowEncodedNullCharacter: false
        allowEncodedSemicolon: false
        allowEncodedPercent: false
        allowEncodedQuestionMark: false
        allowEncodedHash: false
# The file provider and the Consul catalog; Traefik never sees the Docker
# socket. Every file in the directory is loaded and watched for changes.
providers:
  file:
    directory: /etc/bb/traefik
    watch: true
  # Routes from registry's catalog: a service registered with the tag
  # traefik.enable=true, every healthy instance, read every 5s over TLS
  # verified against the lab CA. Router rules and settings come from
  # the service's traefik.* tags.
  consulCatalog:
    exposedByDefault: false
    refreshInterval: 5s
    endpoint:
      address: registry.bb.internal:8501
      scheme: https
      tls:
        ca: /etc/bb/ca.pem
# The API and dashboard on the traefik entrypoint (127.0.0.1:8080).
api:
  insecure: true
  dashboard: true
ping:
  entryPoint: traefik
# Servers without a transport of their own (those from the Consul
# catalog) are verified against the lab CA, by the name in their URL.
serversTransport:
  rootCAs:
    - /etc/bb/ca.pem
--- config/edge/tls.yml (644)
# tls.yml for edge, generated by Breadboard: the certificate Traefik
# presents and the minimum TLS version. It stays when services.edge.file
# replaces the routes in dynamic.yml.

tls:
  stores:
    default:
      defaultCertificate:
        certFile: /etc/bb/tls/tls.crt
        keyFile: /etc/bb/tls/tls.key
  # TLS 1.2 or newer towards clients.
  options:
    default:
      minVersion: VersionTLS12
--- config/edge/dynamic.yml (644)
# dynamic.yml for edge, generated by Breadboard: the dynamic (routing)
# configuration.
#
# HTTPS on :8443 routes what registry's catalog declares in traefik.* tags.
#
# To own it, copy it next to experiment.yaml and set services.edge.file.
# The lab CA (/etc/bb/ca.pem) stays mounted, and Breadboard keeps the
# entrypoints (websecure on :8443, and passthrough on :9443 with a
# passthrough upstream) and the certificate store in tls.yml.
#
# Each app replica is listed by name: Traefik does not discover the
# several addresses of one DNS name.

{}
--- tls/web-1/tls.crt (644) 11 bytes
--- tls/web-1/tls.key (644) 10 bytes
--- tls/web-1/keystore.pem (644) 21 bytes
--- config/web-1-agent/consul.json (644)
{
  "bind_addr": "{{ GetPrivateIP }}",
  "client_addr": "127.0.0.1",
  "data_dir": "/consul/data",
  "datacenter": "bb",
  "enable_agent_tls_for_checks": true,
  "encrypt_verify_incoming": true,
  "encrypt_verify_outgoing": true,
  "leave_on_terminate": true,
  "node_name": "web-1",
  "ports": {
    "dns": -1,
    "grpc": -1,
    "grpc_tls": -1,
    "http": -1,
    "https": 8501,
    "serf_wan": -1
  },
  "retry_join": [
    "registry.bb.internal"
  ],
  "server": false,
  "services": [
    {
      "address": "web-1.bb.internal",
      "check": {
        "interval": "5s",
        "tcp": "web-1.bb.internal:8443",
        "tcp_use_tls": true,
        "timeout": "2s",
        "tls_server_name": "web-1.bb.internal"
      },
      "id": "web",
      "name": "web",
      "port": 8443,
      "tags": [
        "traefik.enable=true",
        "traefik.http.routers.web.rule=PathPrefix(`/`)",
        "traefik.http.services.web.loadbalancer.server.scheme=https"
      ]
    }
  ],
  "tls": {
    "defaults": {
      "ca_file": "/etc/bb/ca.pem",
      "cert_file": "/etc/bb/tls/tls.crt",
      "key_file": "/etc/bb/tls/tls.key",
      "verify_incoming": false,
      "verify_outgoing": true
    },
    "internal_rpc": {
      "verify_server_hostname": false
    }
  }
}
