--- docker-compose.yml (644)
# Generated for a golden test.
name: bb-lab
services:
  consul:
    image: hashicorp/consul:1.22.7
    command: [agent, -config-file=/etc/bb/config/consul.json, -encrypt=consulgossip-keySECRET]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      CONSUL_HTTP_ADDR: https://consul.bb.internal:8501
      CONSUL_CACERT: /etc/bb/ca.pem
    healthcheck:
      test: [CMD, consul, operator, raft, list-peers]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
      start_interval: 2s
    volumes:
      - consul-data:/consul/data
      - ./tls/consul/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/consul/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/consul/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/consul/consul.json:/etc/bb/config/consul.json:ro
    networks:
      default:
        aliases: [consul.bb.internal]
      plain-consul:
        ipv4_address: 10.213.0.10
        aliases: [consul.plain.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: consul
      breadboard.kind: infra
      breadboard.config-hash: 6a8648b74cb6628f
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  edge:
    image: traefik:v3.7.19
    command: [traefik, --configFile=/etc/bb/config/traefik.yml]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
    healthcheck:
      test: [CMD, traefik, healthcheck, --configFile=/etc/bb/config/traefik.yml, --ping]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
      start_interval: 1s
    volumes:
      - ./tls/edge/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/edge/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/edge/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/edge/traefik.yml:/etc/bb/config/traefik.yml:ro
      - ./config/edge/tls.yml:/etc/bb/traefik/tls.yml:ro
      - ./config/edge/dynamic.yml:/etc/bb/traefik/dynamic.yml:ro
    networks:
      default:
        aliases: [edge.bb.internal]
      plain-consul: {}
      plain-api: {}
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: edge
      breadboard.kind: infra
      breadboard.config-hash: 012c8dd640ecfe63
    mem_limit: 128m
    cpus: 0.25
    restart: unless-stopped
  web-1:
    build:
      context: ../../web
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: web-1
      BB_FQDN: web-1.bb.internal
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    volumes:
      - ./tls/web-1/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/web-1/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/web-1/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
    networks:
      default:
        aliases: [web-1.bb.internal, web.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: web-1
      breadboard.kind: app
      breadboard.config-hash: 39dad408a5edf2ed
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  web-2:
    build:
      context: ../../web
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: web-2
      BB_FQDN: web-2.bb.internal
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    volumes:
      - ./tls/web-2/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/web-2/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/web-2/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
    networks:
      default:
        aliases: [web-2.bb.internal, web.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: web-2
      breadboard.kind: app
      breadboard.config-hash: 360b73ec7eca0b53
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  web-3:
    build:
      context: ../../web
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: web-3
      BB_FQDN: web-3.bb.internal
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    volumes:
      - ./tls/web-3/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/web-3/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/web-3/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
    networks:
      default:
        aliases: [web-3.bb.internal, web.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: web-3
      breadboard.kind: app
      breadboard.config-hash: 9fbad1b45722321b
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  api-1-pod:
    image: alpine:3.24.4
    command: [sleep, infinity]
    init: true
    healthcheck:
      test: [CMD, "true"]
      interval: 10s
      timeout: 2s
      retries: 3
      start_period: 5s
      start_interval: 1s
    networks:
      default:
        aliases: [api-1.bb.internal, api.bb.internal]
      plain-api:
        ipv4_address: 10.213.1.10
        aliases: [api-1.plain.bb.internal, api.plain.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: api-1-pod
      breadboard.kind: pod
      breadboard.capture: guard
    mem_limit: 16m
    cpus: 0.05
    restart: unless-stopped
  api-1-netinit:
    build:
      context: ./build/api-1-netinit
    command:
      - /bin/sh
      - -c
      - |-
        set -eu
        # Plaintext guard: TCP to port 9090 is accepted only on the segment address 10.213.1.10.
        iptables -N BB_PLAIN 2>/dev/null || iptables -F BB_PLAIN
        iptables -C INPUT -j BB_PLAIN 2>/dev/null || iptables -I INPUT 1 -j BB_PLAIN
        iptables -A BB_PLAIN -p tcp --dport 9090 ! -d 10.213.1.10 -j DROP
        iptables -S BB_PLAIN
    cap_add: [NET_ADMIN]
    depends_on:
      api-1-pod:
        condition: service_healthy
    network_mode: service:api-1-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: api-1-netinit
      breadboard.kind: init
      breadboard.config-hash: 5dc27d27665447bf
    mem_limit: 32m
    cpus: 0.1
    restart: "no"
  api-1:
    build:
      context: ../../api
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: api-1
      BB_FQDN: api-1.bb.internal
      BB_SHARED_DIR: /var/run/bb
      BB_PLAIN_LISTEN_ADDR: 10.213.1.10:9090
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    depends_on:
      api-1-pod:
        condition: service_healthy
      api-1-netinit:
        condition: service_completed_successfully
    volumes:
      - ./tls/api-1/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/api-1/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/api-1/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - api-1-shared:/var/run/bb
    network_mode: service:api-1-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: api-1
      breadboard.kind: app
      breadboard.capture: guard
      breadboard.config-hash: 3fb733f20248e21c
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  api-2-pod:
    image: alpine:3.24.4
    command: [sleep, infinity]
    init: true
    healthcheck:
      test: [CMD, "true"]
      interval: 10s
      timeout: 2s
      retries: 3
      start_period: 5s
      start_interval: 1s
    networks:
      default:
        aliases: [api-2.bb.internal, api.bb.internal]
      plain-api:
        ipv4_address: 10.213.1.11
        aliases: [api-2.plain.bb.internal, api.plain.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: api-2-pod
      breadboard.kind: pod
      breadboard.capture: guard
    mem_limit: 16m
    cpus: 0.05
    restart: unless-stopped
  api-2-netinit:
    build:
      context: ./build/api-2-netinit
    command:
      - /bin/sh
      - -c
      - |-
        set -eu
        # Plaintext guard: TCP to port 9090 is accepted only on the segment address 10.213.1.11.
        iptables -N BB_PLAIN 2>/dev/null || iptables -F BB_PLAIN
        iptables -C INPUT -j BB_PLAIN 2>/dev/null || iptables -I INPUT 1 -j BB_PLAIN
        iptables -A BB_PLAIN -p tcp --dport 9090 ! -d 10.213.1.11 -j DROP
        iptables -S BB_PLAIN
    cap_add: [NET_ADMIN]
    depends_on:
      api-2-pod:
        condition: service_healthy
    network_mode: service:api-2-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: api-2-netinit
      breadboard.kind: init
      breadboard.config-hash: 991dd2111e1adeed
    mem_limit: 32m
    cpus: 0.1
    restart: "no"
  api-2:
    build:
      context: ../../api
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: api-2
      BB_FQDN: api-2.bb.internal
      BB_SHARED_DIR: /var/run/bb
      BB_PLAIN_LISTEN_ADDR: 10.213.1.11:9090
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    depends_on:
      api-2-pod:
        condition: service_healthy
      api-2-netinit:
        condition: service_completed_successfully
    volumes:
      - ./tls/api-2/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/api-2/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/api-2/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - api-2-shared:/var/run/bb
    network_mode: service:api-2-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: api-2
      breadboard.kind: app
      breadboard.capture: guard
      breadboard.config-hash: 9d1d79eba4ebe407
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  payments-pod:
    image: alpine:3.24.4
    command: [sleep, infinity]
    init: true
    healthcheck:
      test: [CMD, "true"]
      interval: 10s
      timeout: 2s
      retries: 3
      start_period: 5s
      start_interval: 1s
    networks:
      default:
        aliases: [payments.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: payments-pod
      breadboard.kind: pod
      breadboard.capture: off
    mem_limit: 16m
    cpus: 0.05
    restart: unless-stopped
  payments:
    build:
      context: ../../payments
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: payments
      BB_FQDN: payments.bb.internal
      BB_SHARED_DIR: /var/run/bb
      # payments-envoy (Envoy sidecar)
      BB_LISTEN_ADDR: 127.0.0.1:8080
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    depends_on:
      payments-pod:
        condition: service_healthy
      payments-envoy:
        condition: service_healthy
    volumes:
      - ./tls/payments/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/payments/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/payments/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - payments-shared:/var/run/bb
    network_mode: service:payments-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: payments
      breadboard.kind: app
      breadboard.capture: off
      breadboard.config-hash: 335869aef470b17c
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  payments-envoy:
    image: envoyproxy/envoy:v1.40.2
    command: [envoy, -c, /etc/bb/config/envoy.yaml, --service-node, payments-envoy, --service-cluster, payments]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
    healthcheck:
      test: [CMD, bash, -c, "exec 3<>/dev/tcp/127.0.0.1/15000 && printf 'GET /ready HTTP/1.1\\r\\nHost: 127.0.0.1\\r\\nConnection: close\\r\\n\\r\\n' >&3 && head -n 1 <&3 | grep -q ' 200'"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 30s
      start_interval: 1s
    depends_on:
      payments-pod:
        condition: service_healthy
    volumes:
      - ./tls/payments/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/payments/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/payments/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - payments-shared:/var/run/bb
      - ./config/payments-envoy/envoy.yaml:/etc/bb/config/envoy.yaml:ro
    network_mode: service:payments-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: payments-envoy
      breadboard.kind: sidecar
      breadboard.capture: off
      breadboard.config-hash: 25eb3ce7def27705
    mem_limit: 128m
    cpus: 0.25
    restart: unless-stopped
  client:
    build:
      context: ../../client
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: client
      BB_FQDN: client.bb.internal
      # edge (Traefik)
      EDGE_URL: https://edge.bb.internal:8443
      EDGE_PASSTHROUGH_ADDR: edge.bb.internal:9443
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    depends_on:
      edge:
        condition: service_healthy
    volumes:
      - ./tls/client/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/client/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/client/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
    networks:
      default:
        aliases: [client.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: client
      breadboard.kind: app
      breadboard.config-hash: 128f025a9963983c
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
networks:
  default:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
  # Private segment for plaintext to consul; only edge can reach it.
  # Reason (edge: plain HTTP API behind the proxy)
  plain-consul:
    internal: true
    ipam:
      config:
        - subnet: 10.213.0.0/24
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
  # Private segment for plaintext to api; only edge can reach it.
  # Reason (edge: practice TLS termination
  # and watch the requests)
  plain-api:
    internal: true
    ipam:
      config:
        - subnet: 10.213.1.0/24
          ip_range: 10.213.1.128/25
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
volumes:
  consul-data:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
  api-1-shared:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
  api-2-shared:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
  payments-shared:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
