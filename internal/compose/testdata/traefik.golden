--- config/consul/consul.json (644)
{
  "addresses": {
    "http": "10.213.0.10"
  },
  "bind_addr": "{{ GetPrivateIP }}",
  "bootstrap_expect": 1,
  "client_addr": "0.0.0.0",
  "datacenter": "bb",
  "enable_agent_tls_for_checks": true,
  "encrypt_verify_incoming": true,
  "encrypt_verify_outgoing": true,
  "node_name": "consul",
  "ports": {
    "dns": -1,
    "grpc": -1,
    "grpc_tls": -1,
    "http": 8500,
    "https": 8501,
    "serf_wan": -1
  },
  "server": true,
  "tls": {
    "defaults": {
      "ca_file": "/etc/bb/ca.pem",
      "cert_file": "/etc/bb/tls/tls.crt",
      "key_file": "/etc/bb/tls/tls.key",
      "verify_incoming": false,
      "verify_outgoing": true
    },
    "internal_rpc": {
      "verify_incoming": true,
      "verify_server_hostname": false
    }
  },
  "ui_config": {
    "enabled": true
  }
}
--- tls/edge/tls.crt (644) 10 bytes
--- tls/edge/tls.key (644) 9 bytes
--- tls/edge/keystore.pem (644) 19 bytes
--- config/edge/traefik.yml (644)
# traefik.yml for edge, generated by Breadboard: the static (install)
# configuration. Breadboard owns it, because its health check and
# listeners depend on it. Routing lives in the dynamic configuration
# in /etc/bb/traefik, which services.edge.file replaces.

global:
  checkNewVersion: false
  sendAnonymousUsage: false
# Logs and access logs go to stdout: bb logs edge.
log:
  level: INFO
accessLog: {}
entryPoints:
  # HTTPS with this service's certificate (the default certificate in
  # /etc/bb/traefik/tls.yml). Routers on it use TLS without saying so.
  websecure:
    address: :8443
    http:
      tls: {}
      # Drop request headers whose names alias a header Traefik manages
      # (X_Forwarded_For for X-Forwarded-For), so clients cannot spoof them.
      aliasHeadersStrategy: delete
      # Reject (400) a request path holding an encoded /, \, NUL, ;, %, ?
      # or #. A backend that decodes the path again could route it apart
      # from Traefik's rules (a split view), e.g. /api%2F..%2Fadmin. Traefik
      # allows them by default and warns at startup until one is denied.
      encodedCharacters:
        allowEncodedSlash: false
        allowEncodedBackSlash: false
        allowEncodedNullCharacter: false
        allowEncodedSemicolon: false
        allowEncodedPercent: false
        allowEncodedQuestionMark: false
        allowEncodedHash: false
  # TLS routed by SNI without decrypting: TCP routers with passthrough.
  passthrough:
    address: :9443
    http:
      aliasHeadersStrategy: delete
      encodedCharacters:
        allowEncodedSlash: false
        allowEncodedBackSlash: false
        allowEncodedNullCharacter: false
        allowEncodedSemicolon: false
        allowEncodedPercent: false
        allowEncodedQuestionMark: false
        allowEncodedHash: false
  # Loopback only: the API, the dashboard and /ping.
  traefik:
    address: 127.0.0.1:8080
    http:
      aliasHeadersStrategy: delete
      encodedCharacters:
        allowEncodedSlash: false
        allowEncodedBackSlash: false
        allowEncodedNullCharacter: false
        allowEncodedSemicolon: false
        allowEncodedPercent: false
        allowEncodedQuestionMark: false
        allowEncodedHash: false
# The file provider only; Traefik never sees the Docker socket. Every
# file in the directory is loaded and watched for changes.
providers:
  file:
    directory: /etc/bb/traefik
    watch: true
# The API and dashboard on the traefik entrypoint (127.0.0.1:8080).
api:
  insecure: true
  dashboard: true
ping:
  entryPoint: traefik
--- config/edge/tls.yml (644)
# tls.yml for edge, generated by Breadboard: the certificate Traefik
# presents and the minimum TLS version. It stays when services.edge.file
# replaces the routes in dynamic.yml.

tls:
  stores:
    default:
      defaultCertificate:
        certFile: /etc/bb/tls/tls.crt
        keyFile: /etc/bb/tls/tls.key
  # TLS 1.2 or newer towards clients.
  options:
    default:
      minVersion: VersionTLS12
--- config/edge/dynamic.yml (644)
# dynamic.yml for edge, generated by Breadboard: the dynamic (routing)
# configuration.
#
# HTTPS on :8443 with this service's certificate, then:
#   /web/ (prefix stripped), and every other request -> web (re-encrypt)
#   /v1/ (prefix stripped) -> api (terminate)
#   /consul/ (prefix stripped) -> consul (terminate)
# TLS on :9443 is routed by SNI without decrypting (passthrough):
#   SNI payments.bb.internal -> payments, which presents its own certificate
#
# To own it, copy it next to experiment.yaml and set services.edge.file.
# The lab CA (/etc/bb/ca.pem) stays mounted, and Breadboard keeps the
# entrypoints (websecure on :8443, and passthrough on :9443 with a
# passthrough upstream) and the certificate store in tls.yml.
#
# Each app replica is listed by name: Traefik does not discover the
# several addresses of one DNS name.

http:
  routers:
    # /web/ goes to web with the prefix stripped.
    route-web:
      entryPoints:
        - websecure
      rule: PathPrefix(`/web/`)
      service: web
      middlewares:
        - strip-web
    # /v1/ goes to api with the prefix stripped.
    route-v1:
      entryPoints:
        - websecure
      rule: PathPrefix(`/v1/`)
      service: v1
      middlewares:
        - strip-v1
    # /consul/ goes to consul with the prefix stripped.
    route-consul:
      entryPoints:
        - websecure
      rule: PathPrefix(`/consul/`)
      service: consul
      middlewares:
        - strip-consul
    # Every other path goes to the first upstream: by default a longer rule
    # has a higher priority, so the prefixes above win.
    default-web:
      entryPoints:
        - websecure
      rule: PathPrefix(`/`)
      service: web
  middlewares:
    strip-web:
      stripPrefix:
        prefixes:
          - /web
    strip-v1:
      stripPrefix:
        prefixes:
          - /v1
    strip-consul:
      stripPrefix:
        prefixes:
          - /consul
  services:
    # Re-encrypt: TLS to every replica of web, verified as web.bb.internal.
    web:
      loadBalancer:
        # Weighted round robin. Other strategies: p2c (power of two choices),
        # hrw (highest random weight) and leasttime.
        strategy: wrr
        servers:
          - url: https://web-1.bb.internal:8443
          - url: https://web-2.bb.internal:8443
          - url: https://web-3.bb.internal:8443
        # Active checks every 2s: a 2xx or 3xx answer keeps a server in the
        # rotation. Point path at your app's health endpoint in your own copy.
        healthCheck:
          path: /
          hostname: web.bb.internal
          interval: 2s
          timeout: 2s
        serversTransport: web
    # Terminate: plaintext HTTP to every replica of api on its private segment.
    # Reason: practice TLS termination
    # and watch the requests
    v1:
      loadBalancer:
        # Weighted round robin. Other strategies: p2c (power of two choices),
        # hrw (highest random weight) and leasttime.
        strategy: wrr
        servers:
          - url: http://api-1.plain.bb.internal:9090
          - url: http://api-2.plain.bb.internal:9090
        # Active checks every 2s: a 2xx or 3xx answer keeps a server in the
        # rotation. Point path at your app's health endpoint in your own copy.
        healthCheck:
          path: /
          hostname: api.bb.internal
          interval: 2s
          timeout: 2s
    # Terminate: plaintext HTTP to consul on its private segment.
    # Reason: plain HTTP API behind the proxy
    consul:
      loadBalancer:
        # Weighted round robin. Other strategies: p2c (power of two choices),
        # hrw (highest random weight) and leasttime.
        strategy: wrr
        servers:
          - url: http://consul.plain.bb.internal:8500
  serversTransports:
    # Re-encrypt: TLS with SNI web.bb.internal, verified against the lab CA.
    web:
      serverName: web.bb.internal
      rootCAs:
        - /etc/bb/ca.pem
# Passthrough: a name no router claims is closed.
tcp:
  routers:
    # SNI payments.bb.internal goes to payments still encrypted.
    tls-payments:
      entryPoints:
        - passthrough
      rule: HostSNI(`payments.bb.internal`)
      service: tls-payments
      tls:
        passthrough: true
  services:
    # Passthrough: the client's TLS session goes to every replica of payments untouched.
    tls-payments:
      loadBalancer:
        servers:
          - address: payments.bb.internal:8443
        # A TCP connect every 2s.
        healthCheck:
          interval: 2s
          timeout: 2s
