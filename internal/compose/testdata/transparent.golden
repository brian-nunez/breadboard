--- ca.pem (644) 3 bytes
--- trust-bundle.pem (644) 9 bytes
--- tls/postgres/tls.crt (644) 14 bytes
--- tls/postgres/tls.key (644) 13 bytes
--- tls/postgres/keystore.pem (644) 27 bytes
--- config/postgres/pg_hba.conf (644)
# Generated by Breadboard.
# TYPE    DATABASE USER ADDRESS METHOD
# Unix socket inside the container only (init scripts, docker exec).
local     all      all          trust
# Every network connection must use TLS.
hostssl   all      all  all     scram-sha-256
--- config/postgres/init-app.sh (755)
#!/bin/sh
# Generated by Breadboard. Runs once, when the data directory is empty:
# creates the application role and its database.
set -eu
psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname postgres \
  -v app_user="$BB_APP_USER" -v app_password="$BB_APP_PASSWORD" -v app_db="$BB_APP_DATABASE" <<'SQL'
CREATE ROLE :"app_user" LOGIN PASSWORD :'app_password';
CREATE DATABASE :"app_db" OWNER :"app_user";
SQL
--- tls/consul/tls.crt (644) 12 bytes
--- tls/consul/tls.key (644) 11 bytes
--- tls/consul/keystore.pem (644) 23 bytes
--- config/consul/consul.json (644)
{
  "bind_addr": "{{ GetPrivateIP }}",
  "bootstrap_expect": 1,
  "client_addr": "0.0.0.0",
  "datacenter": "bb",
  "enable_agent_tls_for_checks": true,
  "encrypt_verify_incoming": true,
  "encrypt_verify_outgoing": true,
  "node_name": "consul",
  "ports": {
    "dns": -1,
    "grpc": -1,
    "grpc_tls": -1,
    "http": -1,
    "https": 8501,
    "serf_wan": -1
  },
  "server": true,
  "tls": {
    "defaults": {
      "ca_file": "/etc/bb/ca.pem",
      "cert_file": "/etc/bb/tls/tls.crt",
      "key_file": "/etc/bb/tls/tls.key",
      "verify_incoming": false,
      "verify_outgoing": true
    },
    "internal_rpc": {
      "verify_incoming": true,
      "verify_server_hostname": false
    }
  },
  "ui_config": {
    "enabled": true
  }
}
--- tls/web/tls.crt (644) 9 bytes
--- tls/web/tls.key (644) 8 bytes
--- tls/web/keystore.pem (644) 17 bytes
--- config/web-envoy/envoy.yaml (644)
# Generated by Breadboard for web-envoy, the Envoy sidecar of web.
# To own this file, copy it next to experiment.yaml and set file: on the sidecar.
node:
  id: web-envoy
  cluster: web
admin:
  address:
    socket_address:
      address: 127.0.0.1
      port_value: 15000
static_resources:
  listeners:
    - name: inbound
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 8443
      traffic_direction: INBOUND
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: inbound
                codec_type: AUTO
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                route_config:
                  name: inbound
                  virtual_hosts:
                    - name: app
                      domains:
                        - '*'
                      routes:
                        - match:
                            prefix: /
                          route:
                            cluster: app
                      request_headers_to_add:
                        - header:
                            key: x-forwarded-proto
                            value: https
                          append_action: OVERWRITE_IF_EXISTS_OR_ADD
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
          transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
              common_tls_context:
                alpn_protocols:
                  - h2
                  - http/1.1
                tls_certificates:
                  - certificate_chain:
                      filename: /etc/bb/tls/tls.crt
                    private_key:
                      filename: /etc/bb/tls/tls.key
  clusters:
    - name: app
      type: STATIC
      connect_timeout: 1s
      load_assignment:
        cluster_name: app
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: 127.0.0.1
                      port_value: 8080
