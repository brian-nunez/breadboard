--- build/caller-netinit/Dockerfile (644)
# Generated by Breadboard: transparent mode's init container.
FROM alpine:3.24.4
RUN apk add --no-cache iptables
--- config/caller-envoy/envoy.yaml (644)
# Generated by Breadboard for caller-envoy, the Envoy sidecar of caller.
# To own this file, copy it next to experiment.yaml and set file: on the sidecar.
node:
  id: caller-envoy
  cluster: caller
admin:
  address:
    socket_address:
      address: 127.0.0.1
      port_value: 15000
static_resources:
  listeners:
    - name: outbound_web
      address:
        socket_address:
          address: 127.0.0.1
          port_value: 9001
      traffic_direction: OUTBOUND
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: outbound_web
                codec_type: AUTO
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                route_config:
                  name: outbound_web
                  virtual_hosts:
                    - name: web
                      domains:
                        - '*'
                      routes:
                        - match:
                            prefix: /
                          route:
                            cluster: outbound_web
                            timeout: 5s
                            retry_policy:
                              retry_on: connect-failure,refused-stream,reset,5xx
                              num_retries: 2
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
    - name: transparent_outbound
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 15001
      traffic_direction: OUTBOUND
      listener_filters:
        - name: envoy.filters.listener.original_dst
          typed_config:
            '@type': type.googleapis.com/envoy.extensions.filters.listener.original_dst.v3.OriginalDst
        - name: envoy.filters.listener.tls_inspector
          typed_config:
            '@type': type.googleapis.com/envoy.extensions.filters.listener.tls_inspector.v3.TlsInspector
          filter_disabled:
            not_match:
              destination_port_range:
                start: 8443
                end: 8444
      continue_on_listener_filters_timeout: true
      filter_chains:
        - name: transparent_http_8443
          filter_chain_match:
            destination_port: 8443
            prefix_ranges:
              - address_prefix: 10.213.200.12
                prefix_len: 32
            transport_protocol: raw_buffer
          filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: transparent_http_8443
                codec_type: AUTO
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                route_config:
                  name: transparent_http_8443
                  virtual_hosts:
                    - name: web
                      domains:
                        - web.bb.internal
                        - web.bb.internal:8443
                      routes:
                        - match:
                            prefix: /
                          route:
                            cluster: outbound_web
                            timeout: 5s
                            retry_policy:
                              retry_on: connect-failure,refused-stream,reset,5xx
                              num_retries: 2
                    - name: undeclared
                      domains:
                        - '*'
                      routes:
                        - match:
                            prefix: /
                          direct_response:
                            status: 403
                            body:
                              inline_string: |
                                breadboard: egress denied: this host is not a declared outbound target
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
        - name: transparent_tls_8443
          filter_chain_match:
            destination_port: 8443
            prefix_ranges:
              - address_prefix: 10.213.200.12
                prefix_len: 32
            transport_protocol: tls
          filters:
            - name: envoy.filters.network.tcp_proxy
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy
                stat_prefix: passthrough_8443
                cluster: passthrough
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
        - name: uses_5432
          filter_chain_match:
            destination_port: 5432
            prefix_ranges:
              - address_prefix: 10.213.200.10
                prefix_len: 32
          filters:
            - name: envoy.filters.network.tcp_proxy
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy
                stat_prefix: passthrough_5432
                cluster: passthrough
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
        - name: uses_8501
          filter_chain_match:
            destination_port: 8501
            prefix_ranges:
              - address_prefix: 10.213.200.11
                prefix_len: 32
          filters:
            - name: envoy.filters.network.tcp_proxy
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy
                stat_prefix: passthrough_8501
                cluster: passthrough
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
      default_filter_chain:
        name: egress_denied
        filters:
          - name: envoy.filters.network.rbac
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.filters.network.rbac.v3.RBAC
              stat_prefix: egress_denied
              rules:
                action: DENY
                policies:
                  undeclared:
                    permissions:
                      - any: true
                    principals:
                      - any: true
          - name: envoy.filters.network.tcp_proxy
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy
              stat_prefix: egress_denied
              cluster: passthrough
              access_log:
                - name: envoy.access_loggers.stdout
                  typed_config:
                    '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
    - name: transparent_inbound
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 15006
      traffic_direction: INBOUND
      listener_filters:
        - name: envoy.filters.listener.original_dst
          typed_config:
            '@type': type.googleapis.com/envoy.extensions.filters.listener.original_dst.v3.OriginalDst
      filter_chains:
        - name: app_tls_8080
          filter_chain_match:
            destination_port: 8080
          filters:
            - name: envoy.filters.network.set_filter_state
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.set_filter_state.v3.Config
                on_new_connection:
                  - object_key: envoy.network.transport_socket.original_dst_address
                    format_string:
                      text_format_source:
                        inline_string: 127.0.0.1:%DOWNSTREAM_LOCAL_PORT%
            - name: envoy.filters.network.tcp_proxy
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy
                stat_prefix: inbound_passthrough
                cluster: inbound_passthrough
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
      default_filter_chain:
        name: ingress_denied
        filters:
          - name: envoy.filters.network.rbac
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.filters.network.rbac.v3.RBAC
              stat_prefix: ingress_denied
              rules:
                action: DENY
                policies:
                  undeclared:
                    permissions:
                      - any: true
                    principals:
                      - any: true
          - name: envoy.filters.network.tcp_proxy
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy
              stat_prefix: ingress_denied
              cluster: passthrough
              access_log:
                - name: envoy.access_loggers.stdout
                  typed_config:
                    '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
  clusters:
    - name: outbound_web
      type: STRICT_DNS
      dns_lookup_family: V4_ONLY
      connect_timeout: 2s
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: outbound_web
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: web.bb.internal
                      port_value: 8443
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: web.bb.internal
          common_tls_context:
            validation_context:
              trusted_ca:
                filename: /etc/bb/ca.pem
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher:
                    exact: web.bb.internal
    - name: passthrough
      type: ORIGINAL_DST
      lb_policy: CLUSTER_PROVIDED
      connect_timeout: 2s
    - name: inbound_passthrough
      type: ORIGINAL_DST
      lb_policy: CLUSTER_PROVIDED
      connect_timeout: 1s
--- config/caller-agent/consul.json (644)
{
  "bind_addr": "{{ GetPrivateIP }}",
  "client_addr": "127.0.0.1",
  "data_dir": "/consul/data",
  "datacenter": "bb",
  "enable_agent_tls_for_checks": true,
  "encrypt_verify_incoming": true,
  "encrypt_verify_outgoing": true,
  "leave_on_terminate": true,
  "node_name": "caller",
  "ports": {
    "dns": -1,
    "grpc": -1,
    "grpc_tls": -1,
    "http": -1,
    "https": 8501,
    "serf_wan": -1
  },
  "retry_join": [
    "consul.bb.internal"
  ],
  "server": false,
  "services": [
    {
      "address": "caller.bb.internal",
      "check": {
        "interval": "5s",
        "tcp": "caller.bb.internal:8080",
        "tcp_use_tls": true,
        "timeout": "2s",
        "tls_server_name": "caller.bb.internal"
      },
      "id": "caller",
      "name": "caller",
      "port": 8080
    }
  ],
  "tls": {
    "defaults": {
      "ca_file": "/etc/bb/ca.pem",
      "cert_file": "/etc/bb/tls/tls.crt",
      "key_file": "/etc/bb/tls/tls.key",
      "verify_incoming": false,
      "verify_outgoing": true
    },
    "internal_rpc": {
      "verify_server_hostname": false
    }
  }
}
--- docker-compose.yml (644)
# Generated for a golden test.
name: bb-lab
services:
  postgres:
    image: postgres:18.7-alpine3.24
    entrypoint:
      - /bin/sh
      - -c
      - |-
        set -e
        install -d -m 0700 -o postgres -g postgres /var/run/postgresql/bb-tls
        install -m 0600 -o postgres -g postgres /etc/bb/tls/tls.key /var/run/postgresql/bb-tls/tls.key
        install -m 0644 -o postgres -g postgres /etc/bb/tls/tls.crt /var/run/postgresql/bb-tls/tls.crt
        exec docker-entrypoint.sh postgres -c listen_addresses='*' -c ssl=on -c ssl_cert_file=/var/run/postgresql/bb-tls/tls.crt -c ssl_key_file=/var/run/postgresql/bb-tls/tls.key -c ssl_min_protocol_version=TLSv1.2 -c hba_file=/etc/bb/config/pg_hba.conf
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${POSTGRES__SUPERUSER_PASSWORD}
      BB_APP_USER: app
      BB_APP_PASSWORD: ${POSTGRES__PASSWORD}
      BB_APP_DATABASE: app
    healthcheck:
      test: [CMD-SHELL, PGPASSWORD="$$BB_APP_PASSWORD" psql "host=postgres.bb.internal port=5432 dbname=app user=app sslmode=verify-full sslrootcert=/etc/bb/ca.pem" -tAc 'select 1' > /dev/null]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 1m
      start_interval: 2s
    volumes:
      - postgres-data:/var/lib/postgresql
      - ./tls/postgres/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/postgres/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/postgres/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/postgres/pg_hba.conf:/etc/bb/config/pg_hba.conf:ro
      - ./config/postgres/init-app.sh:/docker-entrypoint-initdb.d/10-init-app.sh:ro
    networks:
      default:
        ipv4_address: 10.213.200.10
        aliases: [postgres.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: postgres
      breadboard.kind: infra
      breadboard.config-hash: adec5dad326ef3e7
    mem_limit: 512m
    cpus: 0.5
    restart: unless-stopped
  consul:
    image: hashicorp/consul:1.22.7
    command: [agent, -config-file=/etc/bb/config/consul.json, '-encrypt=${CONSUL__GOSSIP_KEY}']
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      CONSUL_HTTP_ADDR: https://consul.bb.internal:8501
      CONSUL_CACERT: /etc/bb/ca.pem
    healthcheck:
      test: [CMD, consul, operator, raft, list-peers]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
      start_interval: 2s
    volumes:
      - consul-data:/consul/data
      - ./tls/consul/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/consul/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/consul/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - ./config/consul/consul.json:/etc/bb/config/consul.json:ro
    networks:
      default:
        ipv4_address: 10.213.200.11
        aliases: [consul.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: consul
      breadboard.kind: infra
      breadboard.config-hash: 59d4e2aeb3339c3c
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  web-pod:
    image: alpine:3.24.4
    command: [sleep, infinity]
    init: true
    healthcheck:
      test: [CMD, "true"]
      interval: 10s
      timeout: 2s
      retries: 3
      start_period: 5s
      start_interval: 1s
    networks:
      default:
        ipv4_address: 10.213.200.12
        aliases: [web.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: web-pod
      breadboard.kind: pod
      breadboard.capture: off
    mem_limit: 16m
    cpus: 0.05
    restart: unless-stopped
  web:
    build:
      context: ../../web
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: web
      BB_FQDN: web.bb.internal
      BB_SHARED_DIR: /var/run/bb
      # web-envoy (Envoy sidecar)
      BB_LISTEN_ADDR: 127.0.0.1:8080
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    depends_on:
      web-pod:
        condition: service_healthy
      web-envoy:
        condition: service_healthy
    volumes:
      - ./tls/web/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/web/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/web/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - web-shared:/var/run/bb
    network_mode: service:web-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: web
      breadboard.kind: app
      breadboard.capture: off
      breadboard.config-hash: 318d1e6e33f92af9
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  web-envoy:
    image: envoyproxy/envoy:v1.40.2
    command: [envoy, -c, /etc/bb/config/envoy.yaml, --service-node, web-envoy, --service-cluster, web]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
    healthcheck:
      test: [CMD, bash, -c, "exec 3<>/dev/tcp/127.0.0.1/15000 && printf 'GET /ready HTTP/1.1\\r\\nHost: 127.0.0.1\\r\\nConnection: close\\r\\n\\r\\n' >&3 && head -n 1 <&3 | grep -q ' 200'"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 30s
      start_interval: 1s
    depends_on:
      web-pod:
        condition: service_healthy
    volumes:
      - ./tls/web/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/web/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/web/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - web-shared:/var/run/bb
      - ./config/web-envoy/envoy.yaml:/etc/bb/config/envoy.yaml:ro
    network_mode: service:web-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: web-envoy
      breadboard.kind: sidecar
      breadboard.capture: off
      breadboard.config-hash: f744dd100a06f1c9
    mem_limit: 128m
    cpus: 0.25
    restart: unless-stopped
  caller-pod:
    image: alpine:3.24.4
    command: [sleep, infinity]
    init: true
    healthcheck:
      test: [CMD, "true"]
      interval: 10s
      timeout: 2s
      retries: 3
      start_period: 5s
      start_interval: 1s
    networks:
      default:
        ipv4_address: 10.213.200.13
        aliases: [caller.bb.internal]
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: caller-pod
      breadboard.kind: pod
      breadboard.capture: transparent
    mem_limit: 16m
    cpus: 0.05
    restart: unless-stopped
  caller-netinit:
    build:
      context: ./build/caller-netinit
    command:
      - /bin/sh
      - -c
      - |-
        set -eu
        # Generated by Breadboard: transparent mode for caller.
        chain() { iptables -t "$$1" -N "$$2" 2>/dev/null || iptables -t "$$1" -F "$$2"; }
        hook() { iptables -t "$$1" -C "$$2" -p tcp -j "$$3" 2>/dev/null || iptables -t "$$1" -A "$$2" -p tcp -j "$$3"; }
        # Outbound: the pod's connections go to Envoy on 15001.
        chain nat BB_OUT
        iptables -t nat -A BB_OUT -m owner --uid-owner 1337 -j RETURN
        iptables -t nat -A BB_OUT -m owner --uid-owner 1338 -j RETURN
        iptables -t nat -A BB_OUT -d 127.0.0.0/8 -j RETURN
        iptables -t nat -A BB_OUT -p tcp -j REDIRECT --to-ports 15001
        hook nat OUTPUT BB_OUT
        # Inbound: the app's own TLS ports go to Envoy on 15006.
        chain nat BB_IN
        iptables -t nat -A BB_IN -p tcp --dport 8080 -j REDIRECT --to-ports 15006
        hook nat PREROUTING BB_IN
        # Inbound: only declared external listeners accept connections; the rest are reset.
        chain filter BB_IN
        iptables -t filter -A BB_IN -i lo -j RETURN
        iptables -t filter -A BB_IN -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
        iptables -t filter -A BB_IN -p tcp --dport 8301 -j RETURN
        iptables -t filter -A BB_IN -p tcp --dport 15006 -j RETURN
        iptables -t filter -A BB_IN -p tcp -j REJECT --reject-with tcp-reset
        hook filter INPUT BB_IN
        echo 'breadboard: transparent mode rules installed:'
        iptables -t nat -S
        iptables -t filter -S
    cap_add: [NET_ADMIN]
    depends_on:
      caller-pod:
        condition: service_healthy
    network_mode: service:caller-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: caller-netinit
      breadboard.kind: init
      breadboard.config-hash: 671c7782d6e3ed8e
    mem_limit: 32m
    cpus: 0.1
    restart: "no"
  caller:
    build:
      context: ../../caller
      target: dev
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: caller
      BB_FQDN: caller.bb.internal
      BB_SHARED_DIR: /var/run/bb
      # postgres (Postgres)
      DATABASE_URL: postgres://app:${POSTGRES__PASSWORD}@postgres.bb.internal:5432/app?sslmode=verify-full
      PGHOST: postgres.bb.internal
      PGPORT: "5432"
      PGUSER: app
      PGPASSWORD: ${POSTGRES__PASSWORD}
      PGDATABASE: app
      PGSSLMODE: verify-full
      PGSSLROOTCERT: /etc/bb/ca.pem
      # consul (Consul)
      CONSUL_HTTP_ADDR: https://consul.bb.internal:8501
      CONSUL_CACERT: /etc/bb/trust-bundle.pem
      # caller-envoy (Envoy sidecar)
      WEB_URL: http://127.0.0.1:9001
    security_opt: ['no-new-privileges:true']
    cap_drop: [SETUID, SETGID]
    healthcheck:
      test: [CMD-SHELL, kill -0 1]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
      start_interval: 1s
    depends_on:
      caller-pod:
        condition: service_healthy
      caller-netinit:
        condition: service_completed_successfully
      postgres:
        condition: service_healthy
      consul:
        condition: service_healthy
      caller-envoy:
        condition: service_healthy
      caller-agent:
        condition: service_healthy
    volumes:
      - ./tls/caller/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/caller/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/caller/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - caller-shared:/var/run/bb
    network_mode: service:caller-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: caller
      breadboard.kind: app
      breadboard.capture: transparent
      breadboard.config-hash: 1737309c79fb2e8e
    mem_limit: 256m
    cpus: 0.5
    restart: unless-stopped
  caller-envoy:
    image: envoyproxy/envoy:v1.40.2
    command: [envoy, -c, /etc/bb/config/envoy.yaml, --service-node, caller-envoy, --service-cluster, caller]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      ENVOY_UID: "1337"
      ENVOY_GID: "1337"
    healthcheck:
      test: [CMD, bash, -c, "exec 3<>/dev/tcp/127.0.0.1/15000 && printf 'GET /ready HTTP/1.1\\r\\nHost: 127.0.0.1\\r\\nConnection: close\\r\\n\\r\\n' >&3 && head -n 1 <&3 | grep -q ' 200'"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 30s
      start_interval: 1s
    depends_on:
      caller-pod:
        condition: service_healthy
      caller-netinit:
        condition: service_completed_successfully
    volumes:
      - ./tls/caller/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/caller/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/caller/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - caller-shared:/var/run/bb
      - ./config/caller-envoy/envoy.yaml:/etc/bb/config/envoy.yaml:ro
    network_mode: service:caller-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: caller-envoy
      breadboard.kind: sidecar
      breadboard.capture: transparent
      breadboard.config-hash: 57cb952f4354cdfa
    mem_limit: 128m
    cpus: 0.25
    restart: unless-stopped
  caller-agent:
    image: hashicorp/consul:1.22.7
    command: [agent, -config-file=/etc/bb/config/consul.json, '-encrypt=${CONSUL__GOSSIP_KEY}']
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      CONSUL_HTTP_ADDR: https://127.0.0.1:8501
      CONSUL_TLS_SERVER_NAME: caller.bb.internal
      CONSUL_CACERT: /etc/bb/ca.pem
      CONSUL_UID: "1338"
      CONSUL_GID: "1338"
    healthcheck:
      test: [CMD-SHELL, consul catalog services | grep -qx caller]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
      start_interval: 2s
    depends_on:
      caller-pod:
        condition: service_healthy
      caller-netinit:
        condition: service_completed_successfully
      consul:
        condition: service_healthy
    volumes:
      - ./tls/caller/tls.crt:/etc/bb/tls/tls.crt:ro
      - ./tls/caller/tls.key:/etc/bb/tls/tls.key:ro
      - ./tls/caller/keystore.pem:/etc/bb/tls/keystore.pem:ro
      - ./ca.pem:/etc/bb/ca.pem:ro
      - ./trust-bundle.pem:/etc/bb/trust-bundle.pem:ro
      - caller-shared:/var/run/bb
      - ./config/caller-agent/consul.json:/etc/bb/config/consul.json:ro
    network_mode: service:caller-pod
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
      breadboard.service: caller-agent
      breadboard.kind: sidecar
      breadboard.capture: transparent
      breadboard.config-hash: d7f2f7c062d1a610
    mem_limit: 128m
    cpus: 0.25
    restart: unless-stopped
networks:
  default:
    ipam:
      config:
        - subnet: 10.213.200.0/24
          ip_range: 10.213.200.128/25
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
volumes:
  postgres-data:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
  consul-data:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
  web-shared:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
  caller-shared:
    labels:
      breadboard.experiment: lab
      breadboard.experiment-id: 0123456789abcdef
--- .env (600)
# Generated by bb. Secrets for docker compose; never commit this file.
CONSUL__GOSSIP_KEY=consulgossip-keySECRET
POSTGRES__PASSWORD=postgrespasswordSECRET
POSTGRES__SUPERUSER_PASSWORD=postgressuperuser-passwordSECRET
