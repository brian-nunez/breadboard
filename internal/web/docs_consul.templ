package web

// Consul docs, following the Kafka template (D-061). The sidecar is the
// recommended way to register and comes first; self-registration is the
// labeled alternative (D-053, D-055).

func init() {
	registerTech(tech{
		ID:      "consul",
		Name:    "Consul",
		Tagline: "Service discovery and health checking. Services register by name; callers get the healthy instances.",
		Order:   40,
		Intro:   consulIntro(),
		GoodFit: []string{"Finding services by name instead of fixed addresses", "Skipping instances whose health checks fail", "Small shared configuration values and flags", "Locks and leader election between services"},
		PoorFit: []string{"Storing application data", "Large values (each KV value is capped at 512 KB)", "Load balancing by itself: the caller still picks an instance"},
		Diagram: consulDiagram(),
		Official: []link{
			{"Consul documentation", "https://developer.hashicorp.com/consul/docs"},
			{"Define health checks", "https://developer.hashicorp.com/consul/docs/register/health-check/vm"},
			{"Health check configuration reference", "https://developer.hashicorp.com/consul/docs/reference/service/health-check"},
			{"Consul Go API client (api)", "https://pkg.go.dev/github.com/hashicorp/consul/api"},
		},
		Starters: []string{"consul/service-discovery", "consul/self-registration"},
		Guides: []guide{
			{
				Slug: "basic-usage", Title: "Finding services by name", Summary: "Ask Consul for the healthy instances of a service.",
				Starter:  "consul/service-discovery",
				Sections: []docSection{{"connect", "Connecting"}, {"lookup", "Looking up a service"}, {"calling", "Calling an instance"}, {"run", "Run it"}},
				Body:     consulBasicUsage(),
			},
			{
				Slug: "registration", Title: "Registering a service", Summary: "A sidecar agent (recommended), or the service itself.",
				Starter:  "consul/service-discovery",
				Sections: []docSection{{"sidecar", "With a sidecar (recommended)"}, {"generated", "What Breadboard generates"}, {"lifecycle", "Joining and leaving"}, {"self", "Alternative: self-registration"}},
				Body:     consulRegistration(),
			},
			{
				Slug: "health-checks", Title: "Health checks", Summary: "How Consul decides which instances to return.",
				Starter:  "consul/service-discovery",
				Sections: []docSection{{"states", "Passing, warning, critical"}, {"kinds", "Kinds of check"}, {"ttl", "TTL checks"}, {"lookups", "How a failing check changes lookups"}, {"deregister", "Removing dead registrations"}},
				Body:     consulHealthChecks(),
			},
			{
				Slug: "kv", Title: "The key-value store", Summary: "Configuration values, flags and watching for changes.",
				Sections: []docSection{{"what", "What it is for"}, {"put-get", "Writing and reading a key"}, {"blocking", "Waiting for a change"}},
				Body:     consulKV(),
			},
			{
				Slug: "in-breadboard", Title: "Consul in Breadboard", Summary: "One server, HTTPS on 8501, encrypted gossip.",
				Sections: []docSection{{"server", "One server"}, {"listeners", "HTTPS on 8501, little else"}, {"security", "Gossip and RPC encryption"}, {"env", "What your app receives"}, {"explore", "The Catalog tab"}},
				Body:     consulInBreadboard(),
			},
		},
	})
}

const consulConnectCode = `// DefaultConfig reads CONSUL_HTTP_ADDR and CONSUL_CACERT.
consul, err := api.NewClient(api.DefaultConfig())
if err != nil {
    log.Fatal(err)
}`

const consulLookupCode = `// Ask by name, and only for instances whose health checks pass: an
// instance that stops answering drops out of this list on its own.
entries, _, err := consul.Health().Service("greeter", "", true, nil)
if err != nil {
    log.Print(err)
    return
}
if len(entries) == 0 {
    log.Print("no healthy greeter instances")
    return
}`

const consulCallCode = `svc := entries[rand.IntN(len(entries))].Service
resp, err := http.Get(fmt.Sprintf("https://%s:%d/", svc.Address, svc.Port))`

const consulRegisterYAML = `apps:
  greeter:
    path: ./service-discovery
    command: [greeter]
    uses: [consul]
    register:
      port: 8443          # the port the app serves TLS on
  caller:
    path: ./service-discovery
    command: [caller]
    uses: [consul]`

const consulGreeterCode = `http.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
    fmt.Fprintf(w, "hello from %s\n", os.Getenv("BB_SERVICE"))
})
// Breadboard mounts this app's own certificate and points these at it.
log.Print("greeter listening on :8443")
log.Fatal(http.ListenAndServeTLS(":8443", os.Getenv("TLS_CERT_FILE"), os.Getenv("TLS_KEY_FILE"), nil))`

const consulSidecarJSON = `{
  "node_name": "greeter",
  "server": false,
  "retry_join": ["consul.bb.internal"],
  "client_addr": "127.0.0.1",
  "leave_on_terminate": true,
  "services": [{
    "id": "greeter",
    "name": "greeter",
    "address": "greeter.bb.internal",
    "port": 8443,
    "check": {
      "tcp": "greeter.bb.internal:8443",
      "tcp_use_tls": true,
      "tls_server_name": "greeter.bb.internal",
      "interval": "5s",
      "timeout": "2s"
    }
  }]
}`

const consulSelfRegisterCode = `addr := os.Getenv("BB_FQDN") // the name on this app's certificate
reg := &api.AgentServiceRegistration{
    ID:      os.Getenv("BB_SERVICE"),
    Name:    "self-greeter",
    Address: addr,
    Port:    8443,
    Check: &api.AgentServiceCheck{
        // Consul connects and completes a TLS handshake every 5 seconds.
        TCP:           fmt.Sprintf("%s:8443", addr),
        TCPUseTLS:     true,
        TLSServerName: addr,
        Interval:      "5s",
        Timeout:       "2s",
        // If this process dies without deregistering, Consul removes the
        // entry after it has been failing for a minute.
        DeregisterCriticalServiceAfter: "1m",
    },
}
if err := consul.Agent().ServiceRegister(reg); err != nil {
    log.Fatal(err)
}`

const consulSelfDeregisterCode = `// Registration is now this program's job, and so is cleaning up.
stop := make(chan os.Signal, 1)
signal.Notify(stop, syscall.SIGTERM, os.Interrupt)
<-stop
if err := consul.Agent().ServiceDeregister(reg.ID); err != nil {
    log.Print(err)
}`

const consulHTTPCheckYAML = `  greeter:
    path: ./service-discovery
    command: [greeter]
    uses: [consul]
    register:
      port: 8443
      check: /healthz     # HTTPS GET https://greeter.bb.internal:8443/healthz`

const consulTTLCode = `reg := &api.AgentServiceRegistration{
    Name: "worker",
    Check: &api.AgentServiceCheck{
        CheckID: "worker-ttl",
        TTL:     "15s", // critical unless updated within 15 seconds
    },
}
consul.Agent().ServiceRegister(reg)

for range time.Tick(5 * time.Second) {
    // Resets the TTL clock and sets the state to passing.
    consul.Agent().UpdateTTL("worker-ttl", "processing", api.HealthPassing)
}`

const consulKVCode = `kv := consul.KV()

_, err := kv.Put(&api.KVPair{Key: "config/greeter/greeting", Value: []byte("hello")}, nil)
if err != nil {
    log.Fatal(err)
}

pair, _, err := kv.Get("config/greeter/greeting", nil)
if err != nil {
    log.Fatal(err)
}
if pair == nil {
    // The key does not exist.
}
log.Printf("%s = %s", pair.Key, pair.Value)`

const consulBlockingCode = `var index uint64
for {
    // Waits until the key changes past index, or the wait time runs out.
    pair, meta, err := kv.Get("config/greeter/greeting", &api.QueryOptions{WaitIndex: index})
    if err != nil {
        log.Print(err)
        time.Sleep(time.Second)
        continue
    }
    if meta.LastIndex == index {
        continue // timed out with no change
    }
    index = meta.LastIndex
    if pair != nil {
        log.Printf("greeting is now %s", pair.Value)
    }
}`

templ consulIntro() {
	@docP() {
		Consul keeps a catalog of running services. Each instance is registered under a service name with its address, port and one or more health checks. A caller asks for a name and gets back the instances, not a hard-coded address.
	}
	@docP() {
		Health checks are what make the catalog trustworthy. Consul runs each check on an interval and records whether it passes. Callers can ask for passing instances only, so an instance that stops answering disappears from their results without anyone editing configuration.
	}
	@docP() {
		The same servers also hold a small key-value store, replicated with the catalog. It is meant for configuration values and coordination, not application data.
	}
}

