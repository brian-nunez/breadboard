package web

// Envoy docs, the infra proxy type (Phase 5, wave C; D-157, D-158). The
// Envoy sidecar is covered in docs_sidecars.templ. Config excerpts are the
// generated envoy.yaml (internal/catalog/envoy.go, compose golden
// envoy-proxy.golden); fields follow the Envoy v1.40 API.

func init() {
	registerTech(tech{
		ID:      "envoy",
		Name:    "Envoy",
		Tagline: "An L4/L7 proxy built around a typed API: listeners, routes and clusters, statically or from a control plane.",
		Order:   72,
		Intro:   envoyIntro(),
		GoodFit: []string{"Service meshes and sidecars", "HTTP/2 and gRPC balancing", "Consistent hashing, outlier detection, retries", "Traffic splitting and mirroring", "Config driven by a control plane (xDS)"},
		PoorFit: []string{"A small hand-written config (it is verbose)", "Serving static files", "Teams that want one familiar text config"},
		Diagram: proxyDiagram(proxyFig{ID: "ev", Name: "Envoy", L7: "listener https → route → cluster", L4: "listener passthrough → tcp_proxy"}),
		Official: []link{
			{"Envoy documentation (v1.40)", envoyDocs},
			{"Envoy: load balancing", envoyDocs + "intro/arch_overview/upstream/load_balancing/load_balancers"},
			{"Envoy: health checking", envoyDocs + "intro/arch_overview/upstream/health_checking"},
			{"Envoy: cluster API", envoyDocs + "api-v3/config/cluster/v3/cluster.proto"},
			{"Envoy: route API", envoyDocs + "api-v3/config/route/v3/route_components.proto"},
		},
		Starters: []string{stHashing.URL, stHealth.URL, stMirroring.URL, stRateLimit.URL, stBreaking.URL, stRetries.URL, stJWT.URL, stGRPC.URL},
		Guides: []guide{
			{
				Slug: "config-anatomy", Title: "Anatomy of envoy.yaml", Summary: "Listeners, filter chains, routes and clusters, in order.",
				Starter:  stHashing.URL,
				Sections: []docSection{{"model", "Listeners, routes, clusters"}, {"bootstrap", "node and admin"}, {"listener", "The HTTPS listener"}, {"routes", "Routes"}, {"clusters", "Clusters"}, {"passthrough", "The passthrough listener"}, {"change", "Changing it"}, {"validate", "Checking a config"}},
				Body:     envoyAnatomy(),
			},
			{
				Slug: "in-breadboard", Title: "Envoy in Breadboard", Summary: "The image, 8443 and 9443, upstreams and modes, file:, the clusters tab.",
				Sections: []docSection{{"image", "Image and limits"}, {"upstreams", "Upstreams and routes"}, {"modes", "The three TLS modes"}, {"health", "Health checks"}, {"env", "What your app receives"}, {"see", "Seeing it work"}, {"own", "Owning the config"}},
				Body:     envoyInBreadboard(),
			},
		},
	})
}

const envoyAdminCode = `node:
  id: edge
  cluster: edge
# Loopback only: the health check reads /ready; explorers read
# /clusters and /stats through docker exec.
admin:
  address:
    socket_address:
      address: 127.0.0.1
      port_value: 15000`

const envoyListenerCode = `listeners:
  - name: https
    address:
      socket_address: {address: 0.0.0.0, port_value: 8443}
    filter_chains:
      - filters:
          - name: envoy.filters.network.http_connection_manager
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
              stat_prefix: https
              codec_type: AUTO
              use_remote_address: true
              route_config: ...          # below
              http_filters:
                - name: envoy.filters.http.router
                  typed_config:
                    '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
        transport_socket:
          name: envoy.transport_sockets.tls
          typed_config:
            '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
            common_tls_context:
              tls_params: {tls_minimum_protocol_version: TLSv1_2}
              alpn_protocols: [h2, http/1.1]
              tls_certificates:
                - certificate_chain: {filename: /etc/bb/tls/tls.crt}
                  private_key: {filename: /etc/bb/tls/tls.key}`

const envoyRoutesCode = `route_config:
  name: edge
  virtual_hosts:
    - name: edge
      domains: ['*']
      routes:
        # /v1/ goes to api with the prefix replaced by /.
        - match: {prefix: /v1/}
          route: {cluster: v1, prefix_rewrite: /}
        # Routes match in order: every other path goes to the first upstream.
        - match: {prefix: /}
          route: {cluster: web}`

const envoyClusterCode = `clusters:
  # Re-encrypt: TLS to every replica of web, verified as web.bb.internal.
  - name: web
    # Strict DNS through the DNS cluster extension, the successor of the
    # STRICT_DNS type and its deprecated dns_refresh_rate field.
    cluster_type:
      name: envoy.clusters.dns
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster
        dns_lookup_family: V4_ONLY
        dns_refresh_rate: 5s
    connect_timeout: 2s
    lb_policy: ROUND_ROBIN
    load_assignment:
      cluster_name: web
      endpoints:
        - lb_endpoints:
            - endpoint:
                address:
                  socket_address: {address: web.bb.internal, port_value: 8443}
    health_checks:
      - timeout: 2s
        interval: 2s
        no_traffic_interval: 2s
        unhealthy_threshold: 3
        healthy_threshold: 2
        http_health_check:
          host: web.bb.internal
          path: /
          expected_statuses: [{start: 200, end: 500}]
    transport_socket:
      name: envoy.transport_sockets.tls
      typed_config:
        '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
        sni: web.bb.internal
        common_tls_context:
          validation_context:
            trusted_ca: {filename: /etc/bb/ca.pem}
            match_typed_subject_alt_names:
              - san_type: DNS
                matcher: {exact: web.bb.internal}`

const envoyPassthroughCode = `- name: passthrough
  address:
    socket_address: {address: 0.0.0.0, port_value: 9443}
  # The TLS inspector reads the server name from the client's hello;
  # a name no filter chain matches has no chain, so Envoy closes it.
  listener_filters:
    - name: envoy.filters.listener.tls_inspector
      typed_config:
        '@type': type.googleapis.com/envoy.extensions.filters.listener.tls_inspector.v3.TlsInspector
  filter_chains:
    - filter_chain_match:
        server_names: [payments.bb.internal]
      filters:
        - name: envoy.filters.network.tcp_proxy
          typed_config:
            '@type': type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy
            stat_prefix: tls_payments
            cluster: tls_payments`

const envoyChangeCode = `# On the cluster: least request (power of two choices), and eject a host
# after 3 consecutive 5xx for 30s, at most half the cluster.
- name: web
  lb_policy: LEAST_REQUEST
  outlier_detection:
    consecutive_5xx: 3
    base_ejection_time: 30s
    max_ejection_percent: 50

# On the route: retry 5xx twice, give up after 3s in total.
- match: {prefix: /}
  route:
    cluster: web
    timeout: 3s
    retry_policy: {retry_on: 5xx, num_retries: 2}`

templ envoyIntro() {
	@docP() {
		Envoy is an L4 and L7 proxy, started at Lyft and now a CNCF graduated project. It is the data plane of Istio and of many API gateways, and it runs both as an edge proxy and as a sidecar next to each service.
	}
	@docP() {
		Its configuration is a typed API (protocol buffers, written as YAML or JSON) rather than a text format. A listener accepts connections; its filter chain decides what to do with them; for HTTP, routes pick a cluster, and a cluster is a pool of upstream hosts with a load-balancing policy, TLS settings and health checks. The same API can be served at runtime by a control plane (xDS), which is how meshes reconfigure thousands of proxies without restarts.
	}
	@docP() {
		Choose it when you want the most capable balancing and traffic control: ring hash and Maglev, least request, outlier detection, retries and timeouts per route, weighted clusters and request mirroring, with detailed stats for every cluster and host. In Breadboard it runs two ways: as this standalone proxy service, and as a @docLink("/docs/sidecars", "sidecar") beside an app.
	}
}

templ envoyAnatomy() {
	@docLead() {
		Breadboard generates a commented, static @docCodeWord("envoy.yaml") per Envoy service. These are its parts, from the example in @docLink("/docs/envoy/in-breadboard", "Envoy in Breadboard"): web re-encrypted, api terminated as /v1/, payments passed through. The excerpts below are shortened to YAML flow style.
	}
	@docH2("model", "Listeners, routes, clusters")
	@docList(
		"A listener binds an address and port. Each connection gets a filter chain, chosen by what Envoy knows about it (here, the SNI on 9443).",
		"Network filters in the chain handle the bytes: the HTTP connection manager parses HTTP and routes it; the TCP proxy forwards bytes to a cluster.",
		"HTTP filters run per request inside the connection manager; the router filter, always last, sends the request to the route's cluster.",
		"A cluster is a set of hosts, how they are discovered (strict DNS here), how to balance across them, how to connect (transport_socket) and how to check them.",
	)
	@docH2("bootstrap", "node and admin")
	@docCode("envoy.yaml", envoyAdminCode)
	@docP() {
		The admin API listens on loopback only. The container's health check reads @docCodeWord("/ready"); the Envoy clusters tab reads @docCodeWord("/clusters") and @docCodeWord("/stats")&#46; The command is @docCodeWord("envoy -c /etc/bb/config/envoy.yaml --concurrency 1"): one worker thread, so per-host counters are easy to follow.
	}
	@docH2("listener", "The HTTPS listener")
	@docCode("envoy.yaml", envoyListenerCode)
	@docList(
		"The DownstreamTlsContext is the TLS the client sees: the service's certificate, TLS 1.2 minimum, HTTP/2 and HTTP/1.1 by ALPN.",
		"codec_type: AUTO speaks whichever HTTP version the client negotiated.",
		"use_remote_address: true makes Envoy the edge: it appends the client's address to X-Forwarded-For. It sets X-Forwarded-Proto from the connection, https here.",
		"The access log goes to stdout: bb logs <name>.",
	)
	@docH2("routes", "Routes")
	@docCode("envoy.yaml", envoyRoutesCode)
	@docP() {
		Routes match in order, and the first match wins, so the specific prefixes come before @docCodeWord("prefix: /")&#46; @docCodeWord("prefix_rewrite") replaces the matched prefix, so the app sees @docCodeWord("/") rather than @docCodeWord("/v1/")&#46; With one decrypted upstream there is a single @docCodeWord("prefix: /") route; with none, a @docCodeWord("direct_response") of 503.
	}
	@docH2("clusters", "Clusters")
	@docCode("envoy.yaml", envoyClusterCode)
	@docList(
		"cluster_type envoy.clusters.dns (DnsCluster): strict DNS, so every address web.bb.internal resolves to is a host, re-resolved every 5 seconds, and replicas that start later join. It replaces type: STRICT_DNS, whose dns_refresh_rate Envoy v1.40 warns is deprecated.",
		"lb_policy: ROUND_ROBIN. The alternatives: LEAST_REQUEST, RANDOM, RING_HASH and MAGLEV (with a hash_policy on the route).",
		"health_checks: GET / every 2 seconds with the target's Host; any status from 200 to 499 counts as up (expected_statuses is a half-open range). no_traffic_interval: 2s keeps checking before the first request; Envoy's default is 60s.",
		"The UpstreamTlsContext is re-encrypt: SNI web.bb.internal, the chain verified against the lab CA, and the certificate's DNS SAN matched exactly. Health checks use it too, so a passing check proves the handshake.",
		"A terminate cluster has no transport_socket and points at api.plain.bb.internal on the segment.",
	)
	@docH2("passthrough", "The passthrough listener")
	@docCode("envoy.yaml", envoyPassthroughCode)
	@docP() {
		The TLS inspector peeks at the ClientHello without terminating it. Each upstream gets a filter chain matched on its server name, whose TCP proxy forwards the still-encrypted connection to cluster @docCodeWord("tls_<route>"), checked with a TCP connect.
	}
	@docH2("change", "Changing it")
	@docCode("envoy.yaml", envoyChangeCode)
	@docList(
		"Consistent hashing: lb_policy: RING_HASH or MAGLEV on the cluster, and hash_policy (a header, a cookie, the source IP) on the route.",
		"Canary: weighted_clusters on the route instead of cluster.",
		"Shadow traffic: request_mirror_policies on the route; the mirror's responses never reach the client.",
		"Outlier detection defaults are 5 consecutive 5xx, a 10s interval, 30s base ejection and at most 10% of hosts; with three hosts, 10% ejects none.",
	)
	@docH2("validate", "Checking a config")
	@docP() {
		Envoy validates a bootstrap without serving traffic:
	}
	@docTerminal("docker run --rm -v \"$PWD/edge:/cfg:ro\" envoyproxy/envoy:v1.40.2 envoy --mode validate -c /cfg/envoy.yaml")
}

templ envoyInBreadboard() {
	@docLead() {
		What Breadboard runs for @docCodeWord("type: envoy"), the standalone proxy service. The @docLink("/docs/sidecars", "Envoy sidecar") is a separate type with its own options.
	}
	@docH2("image", "Image and limits")
	@docList(
		"Image envoyproxy/envoy:v1.40.2 (Ubuntu: bash and openssl, no curl), 128m of memory and 0.25 CPU, running as the image's envoy user.",
		"Listeners: 8443 (https) for TLS at L7 with the service's certificate; 9443 (passthrough) only when an upstream is passthrough; the admin API on 127.0.0.1:15000, unreachable from other containers.",
		"Proxies do not wait for their upstreams to be healthy: Envoy finds them through DNS and its checks.",
	)
	@docH2("upstreams", "Upstreams and routes")
	@docCode("experiment.yaml", proxyExampleSpec("envoy", "envoy.yaml"))
	@proxyRoutes()
	@docP() {
		Each upstream becomes a cluster named after its route: decrypted upstreams get @docCodeWord("<route>") and passthrough upstreams @docCodeWord("tls_<route>")&#46;
	}
	@docH2("modes", "The three TLS modes")
	@docTable([]string{"Mode", "What the generated config does"},
		[]string{"re-encrypt (on)", "Strict DNS cluster on <app>.<domain>:<port> with an UpstreamTlsContext: sni, trusted_ca /etc/bb/ca.pem, exact DNS SAN match"},
		[]string{"terminate (off)", "Strict DNS cluster on <app>.plain.<domain>:<port>, no transport_socket"},
		[]string{"passthrough", "listener passthrough on :9443 with tls_inspector; a filter chain per server_names, each a tcp_proxy to tls_<route>"},
	)
	@docH2("health", "Health checks")
	@docList(
		"Every decrypted cluster: GET / every 2 seconds, healthy for any status below 500, out after 3 failures, back after 2. Passthrough clusters: a TCP connect.",
		"No outlier detection, retries or timeouts beyond connect_timeout: 2s are generated; add them in your own copy.",
		"The container's own health check reads /ready on the admin API and completes a TLS handshake on 8443 verified against the lab CA.",
	)
	@docH2("env", "What your app receives")
	@proxyEnv()
	@docH2("see", "Seeing it work")
	@docList(
		"bb status lists the proxy with its upstream edges and each edge's mode.",
		"In bb serve, the service's Envoy clusters tab reads /clusters: each cluster with its upstream and TLS mode, each host with the replica it is, its requests, errors and health flags. MCP clients use envoy_clusters.",
		"bb logs <name> shows Envoy's access log.",
	)
	@docTerminal(`docker exec bb-lab-edge-1 bash -c "exec 3<>/dev/tcp/127.0.0.1/15000; printf 'GET /clusters HTTP/1.0\r\n\r\n' >&3; cat <&3"`)
	@docH2("own", "Owning the config")
	@docP() {
		The generated file is at @docCodeWord(".bb/runtime/config/<name>/envoy.yaml")&#46; Copy it next to @docCodeWord("experiment.yaml"), edit it, and set @docCodeWord("file:") on the service; it is copied in at every @docCodeWord("bb up"), and an edit recreates the service. From then on your file wins over the spec's upstreams.
	}
	@docList(
		"Keep the admin API on 127.0.0.1:15000: the health check and the clusters tab read it.",
		"Keep a TLS listener on 8443 with /etc/bb/tls/tls.crt and tls.key.",
		"The lab CA (/etc/bb/ca.pem) and the trust bundle stay mounted.",
	)
}
