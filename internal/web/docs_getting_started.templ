		<rect x="20" y="104" width="660" height="110" rx="10" stroke-dasharray="5 4" class="fill-red-50 stroke-red-300"></rect>
		<text x="36" y="126" class="fill-red-700 font-mono text-[12px] font-semibold">segment: plain-postgres (internal)</text>
