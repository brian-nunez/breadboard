package web

// Getting started: how Breadboard itself works. Not a catalog type, so it has
// no fit cards and no "Add to an experiment" command (D-061).

func init() {
	registerTech(tech{
		ID:       "getting-started",
		Name:     "Getting started",
		Tagline:  "How experiments, TLS and starters work.",
		Order:    5,
		Intro:    gettingStartedIntro(),
		Diagram:  gettingStartedDiagram(),
		Starters: []string{"kafka/producer-consumer"},
		Guides: []guide{
			{
				Slug: "how-breadboard-works", Title: "How Breadboard works", Summary: "The engine, bb up step by step, and where state lives.",
				Sections: []docSection{{"engine", "One engine, thin wrappers"}, {"source", "experiment.yaml is the source of truth"}, {"up", "What bb up does"}, {"down", "Stopping and resetting"}, {"state", "Where state lives"}},
				Body:     gettingStartedHowItWorks(),
			},
			{
				Slug: "experiments", Title: "Experiments and experiment.yaml", Summary: "Services, apps, uses, and the commands that edit them.",
				Sections: []docSection{{"file", "The file"}, {"example", "An annotated example"}, {"uses", "uses creates edges"}, {"validation", "Validation"}, {"commands", "Working with an experiment"}},
				Body:     gettingStartedExperiments(),
			},
			{
				Slug: "tls-by-default", Title: "TLS by default", Summary: "The install CA, certificates per service, plaintext on purpose.",
				Sections: []docSection{{"ca", "One CA per install"}, {"leaves", "A certificate per service"}, {"trust", "How apps trust and serve"}, {"plaintext", "Plaintext on purpose"}, {"host", "Trusting the CA on your machine"}},
				Body:     gettingStartedTLS(),
			},
			{
				Slug: "host-access", Title: "Host access", Summary: "Open lab services from your browser at *.localhost names.",
				Sections: []docSection{{"what", "What host does"}, {"trust", "Trust the host CA"}, {"names", "How *.localhost resolves"}, {"router", "What the router does"}, {"limits", "Limits"}},
				Body:     hostAccessGuide(),
			},
			{
				Slug: "starters", Title: "Starters", Summary: "Working code that uses the official client libraries.",
				Starter:  "kafka/producer-consumer",
				Sections: []docSection{{"what", "What a starter writes"}, {"build", "How starter apps run"}, {"apply", "Applying a starter"}, {"list", "The starters"}},
				Body:     gettingStartedStarters(),
			},
		},
	})
}

const gsExperimentYAML = `version: 1
name: kafka-lab

# Infra services, from the catalog. The key is the service's name and DNS label.
services:
  kafka:
    type: kafka
  postgres:
    type: postgres
    # Optional: overrides the catalog's default limits.
    resources:
      memory: 512m
      cpus: 0.5
    # Optional: options the catalog entry defines.
    config:
      database: orders
  consul:
    type: consul

# Your code. Each app is one compose service built from path/Dockerfile.
apps:
  producer:
    path: ./orders
    # The binary the Dockerfile's dev stage built.
    command: [producer]
    # Short form: an edge to kafka, TLS with full verification.
    uses: [kafka]
  consumer:
    path: ./orders
    command: [consumer]
    uses:
      - kafka
      # Long form: this edge turns TLS off, and must say why.
      - service: postgres
        tls:
          mode: off
          reason: practice TLS termination at a pooler
    # Published on 127.0.0.1 only.
    ports:
      - 8080
    # Opt into an HTTP health check instead of "the process is running".
    health:
      path: /healthz
      port: 8080
  greeter:
    path: ./greeter
    command: [greeter]
    uses: [consul]
    # A sidecar agent registers this app in Consul; the app serves TLS on 8443.
    register:
      port: 8443`

const gsComposeExcerpt = `# .bb/runtime/docker-compose.yml (excerpt)
  producer:
    build:
      context: ../../orders
      target: dev
    command: [producer]
    environment:
      SSL_CERT_FILE: /etc/bb/trust-bundle.pem
      TLS_CERT_FILE: /etc/bb/tls/tls.crt
      TLS_KEY_FILE: /etc/bb/tls/tls.key
      BB_SERVICE: producer
      BB_FQDN: producer.bb.internal
      # kafka (Kafka)
      KAFKA_BROKERS: kafka.bb.internal:9093
      KAFKA_SECURITY_PROTOCOL: SSL
    # healthcheck: the main process is running (kill -0 1)
    depends_on:
      kafka:
        condition: service_healthy`

const gsServeTLSCode = `// Breadboard mounts this app's own certificate and points these at it.
log.Fatal(http.ListenAndServeTLS(":8443", os.Getenv("TLS_CERT_FILE"), os.Getenv("TLS_KEY_FILE"), nil))`

const gsPgxCode = `// DATABASE_URL already says sslmode=verify-full; Go verifies the server
// against SSL_CERT_FILE, so there is no TLS code here.
db, err := pgx.Connect(ctx, os.Getenv("DATABASE_URL"))`

const gsPlaintextYAML = `uses:
  - service: postgres
    tls:
      mode: off
      reason: practice TLS termination at a pooler`

const gsDockerfile = `# dev: what bb up runs. The apps are compiled here, while the image builds.
FROM golang:1.27.4-alpine3.24 AS dev
ENV CGO_ENABLED=0
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# The cache mount keeps compiled packages between builds.
RUN --mount=type=cache,target=/root/.cache/go-build go build -o /usr/local/bin/ ./cmd/...

# prod: a small non-root image for one app, built by hand.
FROM alpine:3.24.4 AS prod`

templ gettingStartedIntro() {
	@docP() {
		Breadboard is a local lab for practicing system design with real software. You describe an experiment in one file, @docCodeWord("experiment.yaml"), and Breadboard runs it in Docker Compose on an isolated network, with TLS on every connection between containers, generated credentials, health checks and resource limits.
	}
	@docP() {
		Every service is the real thing in a container: Kafka, Postgres, Redis, Consul and S3 Compatible storage, not mocks or cloud emulators. There is no Breadboard SDK. Starters write working Go code that uses the official client libraries, so what you learn carries over to real projects.
	}
	@docP() {
		@docCodeWord("bb") is one binary on your machine and never runs in a container. Experiments do: the infrastructure and your own app code are both compose services. Breadboard is built for learning, not for hosting production systems.
	}
}

