		<rect x="416" y="52" width="188" height="28" rx="6" class="fill-indigo-50"></rect>
		<text x="426" y="71" class="fill-slate-900 text-[13px] font-semibold">consumer-1</text>
		<text x="594" y="71" text-anchor="end" class="fill-slate-500 text-[12px]">owns p0, p1</text>
