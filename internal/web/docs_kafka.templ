package web

// Kafka docs: the template for every technology's pages (D-031, D-061).

func init() {
	registerTech(tech{
		ID:      "kafka",
		Name:    "Kafka",
		Tagline: "A partitioned, replicated log. Producers append, consumers read at their own pace.",
		Order:   10,
		Intro:   kafkaIntro(),
		GoodFit: []string{"Event streams between services", "Change data capture", "Replayable audit and activity logs", "High-throughput ingestion"},
		PoorFit: []string{"Request/response RPC", "Small queues with per-message acks", "Ad-hoc queries over stored data"},
		Diagram: kafkaDiagram(),
		Official: []link{
			{"Apache Kafka documentation", "https://kafka.apache.org/documentation/"},
			{"Kafka introduction", "https://kafka.apache.org/intro"},
			{"franz-go client (kgo)", "https://pkg.go.dev/github.com/twmb/franz-go/pkg/kgo"},
		},
		Starters: []string{"kafka/producer-consumer", "kafka/sink-to-postgres", "redis/cache-invalidation"},
		Guides: []guide{
			{
				Slug: "basic-usage", Title: "Producing and consuming", Summary: "The smallest working producer and consumer.",
				Starter:  "kafka/producer-consumer",
				Sections: []docSection{{"connect", "Connecting"}, {"produce", "Producing a record"}, {"consume", "Consuming records"}, {"run", "Run it"}},
				Body:     kafkaBasicUsage(),
			},
			{
				Slug: "topics-and-partitions", Title: "Topics and partitions", Summary: "How data is split and ordered.",
				Starter:  "kafka/producer-consumer",
				Sections: []docSection{{"topics", "Topics are logs"}, {"creating", "Creating a topic"}, {"keys", "Keys pick the partition"}, {"order", "Ordering"}},
				Body:     kafkaTopics(),
			},
			{
				Slug: "consumer-groups", Title: "Consumer groups", Summary: "How readers share a topic.",
				Starter:  "kafka/producer-consumer",
				Live:     "/fragments/live/kafka-groups",
				Sections: []docSection{{"joining", "Joining a group"}, {"assignment", "Who owns which partition"}, {"rebalance", "What triggers a rebalance"}, {"try", "Try it in Breadboard"}},
				Body:     kafkaGroups(),
			},
			{
				Slug: "offsets-and-delivery", Title: "Offsets and delivery", Summary: "At-most, at-least and effectively once.",
				Starter:  "kafka/sink-to-postgres",
				Sections: []docSection{{"offsets", "Committed offsets"}, {"auto", "Auto-commit"}, {"manual", "Committing after the work"}, {"idempotent", "Making replays harmless"}},
				Body:     kafkaOffsets(),
			},
			{
				Slug: "in-breadboard", Title: "Kafka in Breadboard", Summary: "KRaft, the TLS listener, env vars.",
				Sections: []docSection{{"node", "One node, no ZooKeeper"}, {"tls", "TLS on 9093"}, {"env", "What your app receives"}, {"tools", "Using the Kafka CLI tools"}},
				Body:     kafkaInBreadboard(),
			},
		},
	})
}

const kafkaConnectCode = `client, err := kgo.NewClient(
    kgo.SeedBrokers(strings.Split(os.Getenv("KAFKA_BROKERS"), ",")...),
    // The broker only speaks TLS. Go verifies its certificate using SSL_CERT_FILE.
    kgo.DialTLSConfig(new(tls.Config)),
    kgo.DefaultProduceTopic("orders"),
)`

const kafkaProduceCode = `rec := &kgo.Record{Key: []byte("customer-3"), Value: []byte("order 42")}
if err := client.ProduceSync(ctx, rec).FirstErr(); err != nil {
    log.Print(err)
}
// After ProduceSync returns, rec.Partition and rec.Offset say where it landed.
log.Printf("partition=%d offset=%d", rec.Partition, rec.Offset)`

const kafkaConsumeCode = `client, err := kgo.NewClient(
    kgo.SeedBrokers(strings.Split(os.Getenv("KAFKA_BROKERS"), ",")...),
    kgo.DialTLSConfig(new(tls.Config)),
    kgo.ConsumerGroup("orders-consumers"),
    kgo.ConsumeTopics("orders"),
    kgo.ConsumeResetOffset(kgo.NewOffset().AtStart()),
)
for {
    fetches := client.PollFetches(ctx)
    fetches.EachError(func(topic string, partition int32, err error) { log.Print(err) })
    fetches.EachRecord(func(r *kgo.Record) {
        log.Printf("partition=%d offset=%d value=%s", r.Partition, r.Offset, r.Value)
    })
}`

const kafkaCreateTopicCode = `// The broker never creates topics on its own, so create it: 3 partitions, 1 replica.
// If it already exists, the call reports that and nothing changes.
kadm.NewClient(client).CreateTopic(ctx, 3, 1, nil, "orders")`

const kafkaGroupCode = `client, err := kgo.NewClient(
    kgo.SeedBrokers(strings.Split(os.Getenv("KAFKA_BROKERS"), ",")...),
    kgo.DialTLSConfig(new(tls.Config)),
    kgo.ConsumerGroup("orders-consumers"),   // same ID = same group
    kgo.ConsumeTopics("orders"),
)`

const kafkaManualCommitCode = `client, err := kgo.NewClient(
    // ...
    kgo.ConsumerGroup("orders-sink"),
    kgo.ConsumeTopics("order-events"),
    // Commit offsets ourselves, only after the rows are written.
    kgo.DisableAutoCommit(),
)
for {
    fetches := client.PollFetches(ctx)
    fetches.EachRecord(func(r *kgo.Record) {
        // write the record to Postgres
    })
    // Writing first and committing second is at-least-once delivery.
    client.CommitUncommittedOffsets(ctx)
}`

const kafkaIdempotentCode = `-- The primary key makes a redelivered order insert nothing.
INSERT INTO orders (id, customer, amount_cents) VALUES ($1, $2, $3)
ON CONFLICT (id) DO NOTHING`

templ kafkaIntro() {
	@docP() {
		Kafka stores events in an append-only log. Producers write records to a topic; Kafka keeps them, in order, for a retention period whether or not anyone has read them yet. Consumers read the log at their own pace and track their position with an offset.
	}
	@docP() {
		That one design choice decouples writers from readers. A slow consumer doesn't slow the producer, a new consumer can replay history from the beginning, and many independent services can read the same events for different purposes.
	}
	@docP() {
		To scale, a topic is split into partitions. Order is guaranteed within a partition, not across them, and the record's key decides which partition it lands in.
	}
}

