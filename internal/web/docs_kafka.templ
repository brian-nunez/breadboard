		<path d="M250 139 C 320 139, 320 108, 398 108" fill="none" stroke-width="1.5" marker-end="url(#g-arrow)" class="stroke-indigo-300"></path>
		<rect x="400" y="22" width="220" height="118" rx="10" stroke-dasharray="5 4" class="fill-white stroke-indigo-400"></rect>
