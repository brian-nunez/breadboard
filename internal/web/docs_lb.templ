package web

// Load balancing docs: the concept guides behind the proxies (Phase 5,
// wave C), written in the Kafka docs' style (D-031, D-061, D-157). The
// proxies' own sections are docs_haproxy.templ and its siblings.

const (
	haproxyDocs = "https://docs.haproxy.org/3.4/configuration.html"
	haproxyMgmt = "https://docs.haproxy.org/3.4/management.html"
	traefikDocs = "https://doc.traefik.io/traefik/v3.7/"
	traefikLB   = traefikDocs + "reference/routing-configuration/http/load-balancing/service/"
	nginxDocs   = "https://nginx.org/en/docs/"
	nginxUp     = nginxDocs + "http/ngx_http_upstream_module.html"
)

// Diagram data.
var (
	lbInFlight = []int{4, 1, 2}
	lbTLSRows  = []string{"re-encrypt", "terminate", "passthrough"}
	lbTLSPorts = []string{":8443", ":8443", ":9443"}
)

// The wave C starters, by id, with what each one shows.
var (
	stRoundRobin  = link{"Round robin across replicas that DNS re-resolves, on NGINX.", "lb/round-robin"}
	stLeastConn   = link{"leastconn against roundrobin with one slow replica, on HAProxy.", "lb/least-connections"}
	stP2C         = link{"Power of two choices against weighted round robin, on Traefik.", "lb/power-of-two-choices"}
	stHashing     = link{"ring_hash and maglev on a key header, and what moves when a replica leaves, on Envoy.", "lb/consistent-hashing"}
	stSticky      = link{"Cookie stickiness, and what happens when the sticky server dies, on HAProxy.", "lb/sticky-sessions"}
	stCanary      = link{"A 90/10 weighted canary, then shifting the weights, on Traefik.", "lb/weighted-canary"}
	stBlueGreen   = link{"Cutting over from blue to green without a failed request, on NGINX.", "lb/blue-green"}
	stHealth      = link{"Active checks on HAProxy and passive outlier detection on Envoy, timed.", "lb/health-checks"}
	stDiscovery   = link{"Backends that register in Consul, and Traefik following them there: a failing Consul check removes a replica, with no proxy config.", "lb/consul-traefik"}
	stL4L7        = link{"mode tcp against mode http: what each can see and route on, on HAProxy.", "proxy/l4-vs-l7"}
	stTLSModes    = link{"Re-encrypt, terminate and passthrough side by side, and whose certificate the client sees.", "proxy/tls-modes"}
	stMirroring   = link{"Shadow traffic to v2 with its responses discarded, on Envoy.", "proxy/request-mirroring"}
	stDraining    = link{"Removing a backend under load without a failed request.", "proxy/connection-draining"}
	stPoolModes   = link{"Session against transaction pooling, and the session-state trap, on a shared PgBouncer.", "pgbouncer/pooling-modes"}
	stPoolSidecar = link{"A PgBouncer sidecar in the app's pod (wave A), to compare with a shared pool.", "sidecar/pgbouncer-pool"}
)

func init() {
	registerTech(tech{
		ID:      "load-balancing",
		Name:    "Load balancing",
		Tagline: "One address in front of many replicas: how a proxy picks a backend, notices failures, handles TLS and moves traffic.",
		Order:   70,
		Intro:   lbIntro(),
		GoodFit: []string{"Spreading requests over replicas", "Hiding a failed instance from clients", "Shifting traffic during a deployment", "One TLS endpoint in front of many services", "Capping connections to a database"},
		PoorFit: []string{"Making one slow service fast", "Sharing state between replicas (the app's or a store's job)", "Clients that already pick servers themselves (Kafka, Redis Cluster)"},
		Diagram: lbDiagram(),
		Official: []link{
			{"HAProxy 3.4: balance", haproxyDocs + "#4.2-balance"},
			{"Envoy: load balancers", envoyDocs + "intro/arch_overview/upstream/load_balancing/load_balancers"},
			{"Traefik v3.7: load-balancing services", traefikLB},
			{"NGINX: upstream module", nginxUp},
			{"PgBouncer: configuration", pgbouncerDocs + "config.html"},
		},
		Starters: []string{
			stRoundRobin.URL, stLeastConn.URL, stP2C.URL, stHashing.URL, stSticky.URL, stCanary.URL, stBlueGreen.URL,
			stHealth.URL, stDiscovery.URL, stL4L7.URL, stTLSModes.URL, stMirroring.URL, stDraining.URL, stPoolModes.URL,
		},
		Guides: []guide{
			{
				Slug: "strategies", Title: "Load-balancing strategies", Summary: "Round robin, weights, least connections, two choices, hashing, stickiness.",
				Starter:  stRoundRobin.URL,
				Sections: []docSection{{"round-robin", "Round robin"}, {"weighted", "Weighted"}, {"least", "Least connections"}, {"p2c", "Power of two choices"}, {"hashing", "Consistent hashing: ring and Maglev"}, {"sticky", "Sticky sessions"}, {"choosing", "Which to choose"}, {"try", "Try them"}},
				Body:     lbStrategies(),
			},
			{
				Slug: "health-checks", Title: "Health checks: active and passive", Summary: "Probing backends, watching real traffic, and how long each takes.",
				Starter:  stHealth.URL,
				Sections: []docSection{{"why", "Why check at all"}, {"active", "Active checks"}, {"passive", "Passive checks"}, {"timing", "Time to eject, time to recover"}, {"endpoint", "What a health endpoint should say"}, {"generated", "What Breadboard generates"}, {"try", "Try it"}},
				Body:     lbHealth(),
			},
			{
				Slug: "l4-vs-l7", Title: "L4 vs L7 proxying", Summary: "Connections or requests: what each layer sees and can route on.",
				Starter:  stL4L7.URL,
				Sections: []docSection{{"layers", "What each layer sees"}, {"l4", "L4: connections"}, {"l7", "L7: requests"}, {"per", "Per connection or per request"}, {"cost", "What L7 costs"}, {"breadboard", "Both in Breadboard"}, {"try", "Try it"}},
				Body:     lbLayers(),
			},
			{
				Slug: "tls-at-the-proxy", Title: "TLS at the proxy: re-encrypt, terminate, passthrough", Summary: "Who decrypts, whose certificate the client sees, and what can be routed.",
				Starter:  stTLSModes.URL,
				Sections: []docSection{{"modes", "Three modes"}, {"reencrypt", "Re-encrypt"}, {"terminate", "Terminate"}, {"passthrough", "Passthrough"}, {"compare", "Side by side"}, {"declare", "Declaring the mode"}, {"check", "Checking which one you got"}},
				Body:     lbTLS(),
			},
			{
				Slug: "deployments", Title: "Deployments through a proxy", Summary: "Blue-green, canary, mirroring and draining.",
				Starter:  stBlueGreen.URL,
				Sections: []docSection{{"switch", "The proxy as a switch"}, {"blue-green", "Blue-green"}, {"canary", "Canary"}, {"mirroring", "Mirroring"}, {"draining", "Draining"}, {"try", "Try them"}},
				Body:     lbDeployments(),
			},
			{
				Slug: "connection-pooling", Title: "Connection pooling", Summary: "Reusing connections to HTTP backends and to Postgres.",
				Starter:  stPoolModes.URL,
				Sections: []docSection{{"cost", "What a connection costs"}, {"http", "Pooling at an HTTP proxy"}, {"postgres", "Pooling Postgres"}, {"modes", "Session, transaction, statement"}, {"sizing", "Sizing a pool"}, {"where", "A shared pool or a sidecar"}, {"try", "Try it"}},
				Body:     lbPooling(),
			},
		},
	})
}

templ lbIntro() {
	@docP() {
		A load balancer stands between clients and several copies of a service. Clients know one name and one address; for each new connection, or each request, the load balancer picks a copy to answer. It keeps track of which copies are healthy, so one failing instance does not become every client's problem.
	}
	@docP() {
		In practice the load balancer is a reverse proxy: it accepts the client's connection, opens its own to a backend and relays between them. That position lets it do more than spread load: hold the TLS certificate, route by path, retry, shift traffic from an old version to a new one, and pool connections to a database that can only afford a few.
	}
	@docP() {
		Breadboard runs five proxies as services. HAProxy, Envoy, Traefik and NGINX are HTTP proxies: TLS on 8443, SNI passthrough on 9443, and any apps or services as upstreams. PgBouncer is a pool in front of one Postgres. These guides explain the ideas; each proxy's own section shows how it expresses them.
	}
}

templ lbDiagram() {
	<svg viewBox="0 0 900 230" width="900" class="mx-auto block h-auto max-w-full" role="img" aria-label="Clients connect to one proxy address; the proxy picks a healthy replica for each request and skips the failed one">
		<defs>
			<marker id="lb-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0 L8 4 L0 8 z" class="fill-slate-400"></path></marker>
		</defs>
		for i, y := range []int{40, 100, 160} {
			<rect x="20" y={ itoa(y) } width="130" height="40" rx="8" class="fill-slate-50 stroke-slate-200"></rect>
			<text x="36" y={ itoa(y + 25) } class="fill-slate-700 text-[13px]">client { itoa(i + 1) }</text>
			<line x1="150" y1={ itoa(y + 20) } x2="306" y2="120" stroke-width="1.5" marker-end="url(#lb-arrow)" class="stroke-slate-400"></line>
		}
		<text x="228" y="56" text-anchor="middle" class="fill-slate-500 text-[12px]">one name, TLS</text>
		<rect x="310" y="45" width="250" height="150" rx="12" class="fill-indigo-50 stroke-indigo-200"></rect>
		<text x="326" y="72" class="fill-indigo-800 font-mono text-[13px] font-semibold">proxy</text>
		<text x="326" y="100" class="fill-slate-700 text-[13px]">strategy: which replica?</text>
		<text x="326" y="124" class="fill-slate-700 text-[13px]">health: which are up?</text>
		<text x="326" y="148" class="fill-slate-700 text-[13px]">TLS: decrypt or pass?</text>
		<text x="326" y="172" class="fill-slate-700 text-[13px]">weights: old or new version?</text>
		for i, y := range []int{30, 95, 160} {
			if i < 2 {
				<rect x="680" y={ itoa(y) } width="200" height="44" rx="10" class="fill-slate-50 stroke-slate-200"></rect>
				<line x1="560" y1="120" x2="676" y2={ itoa(y + 22) } stroke-width="1.5" marker-end="url(#lb-arrow)" class="stroke-slate-400"></line>
			} else {
				<rect x="680" y={ itoa(y) } width="200" height="44" rx="10" stroke-dasharray="5 4" class="fill-white stroke-red-300"></rect>
			}
			<text x="696" y={ itoa(y + 27) } class="fill-slate-900 font-mono text-[13px] font-semibold">api-{ itoa(i + 1) }</text>
		}
		<text x="866" y="187" text-anchor="end" class="fill-red-700 text-[12px] font-semibold">failing: skipped</text>
	</svg>
}

// --- Strategies ----------------------------------------------------------------

const lbWeightsCode = `# HAProxy: weights on servers (1 to 256)
server api-1 api-1.bb.internal:8443 weight 3 check
server api-2 api-2.bb.internal:8443 weight 1 check

# NGINX: the same idea in an upstream block
server api-1.bb.internal:8443 weight=3;
server api-2.bb.internal:8443 weight=1;`

const lbHashCode = `# Envoy: hash the x-user header onto a ring (or set lb_policy: MAGLEV)
clusters:
  - name: cache
    lb_policy: RING_HASH
routes:
  - match: {prefix: /}
    route:
      cluster: cache
      hash_policy:
        - header: {header_name: x-user}

# HAProxy: the same key, consistent hashing
balance hdr(x-user)
hash-type consistent

# NGINX: ketama consistent hashing on the header
hash $http_x_user consistent;`

const lbStickyCode = `# HAProxy: insert a cookie naming the server; each server has its value
backend be_api
    cookie SERVERID insert indirect nocache
    server api-1 api-1.bb.internal:8443 cookie a1 check
    server api-2 api-2.bb.internal:8443 cookie a2 check

# Traefik: a sticky cookie on the service's load balancer
loadBalancer:
  sticky:
    cookie: {name: srv, httpOnly: true, secure: true}

# NGINX (open source since 1.29.6)
sticky cookie srv_id expires=1h;`

templ lbStrategies() {
	@docLead() {
		A strategy is the rule a load balancer uses to pick a backend. Each one trades how much it has to know against how well it spreads load, and some trade spreading for keeping a client or a key on one backend.
	}
	@docFigure("Round robin hands out requests in turn. Least connections and two choices look at how busy each replica is. Hashing maps a key to a replica, so the same key keeps landing there.") {
		@lbStrategiesDiagram()
	}
	@docH2("round-robin", "Round robin")
	@docP() {
		Each backend in turn: 1, 2, 3, 1, 2, 3. It needs no knowledge of the backends beyond the list, and it spreads load evenly when requests cost about the same and the backends are alike. It is every proxy's default and what Breadboard generates for each one: HAProxy @docCodeWord("balance roundrobin"), Envoy @docCodeWord("ROUND_ROBIN"), Traefik @docCodeWord("strategy: wrr") and NGINX's upstream with no method at all.
	}
	@docP() {
		The list itself comes from DNS. Docker answers an app's shared name, such as @docCodeWord("api.bb.internal"), with every replica's address, and the proxies keep asking: HAProxy through @docCodeWord("server-template") and its resolvers, Envoy's strict DNS clusters every 5 seconds, NGINX's @docCodeWord("resolve") servers every 5 seconds. Scale an app from 3 replicas to 5 and the new ones get traffic within seconds. Traefik does not split one name into several servers, so Breadboard lists every replica by its own name.
	}
	@docP() {
		Round robin goes wrong when requests are not alike. If one request in ten takes a second and the rest take a millisecond, a replica that drew two slow ones in a row still receives its next turn while busy.
	}
	@docH2("weighted", "Weighted")
	@docP() {
		A weight makes a backend receive a larger or smaller share: weight 3 against weight 1 is three requests in four. Weights fit backends of different sizes, and they are how a canary gets 10% of traffic (see @docLink("/docs/load-balancing/deployments", "Deployments through a proxy")).
	}
	@docCode("weights", lbWeightsCode)
	@docP() {
		Envoy sets a @docCodeWord("load_balancing_weight") per endpoint, or splits a route over clusters with @docCodeWord("weighted_clusters"); Traefik puts a @docCodeWord("weight") on each server, or balances whole services with a @docCodeWord("weighted") service.
	}
	@docH2("least", "Least connections")
	@docP() {
		Send the next request to the backend with the fewest requests or connections in flight. A slow backend accumulates in-flight work, so it is picked less until it catches up: the balancer adapts to cost without measuring it. HAProxy's @docCodeWord("balance leastconn") and NGINX's @docCodeWord("least_conn") count connections; Envoy's @docCodeWord("LEAST_REQUEST") counts active requests.
	}
	@docP() {
		The count is local. A proxy only knows the work it sent itself, so with several proxies (or NGINX workers) each sees part of the picture. And with long-lived connections, such as HTTP/2 or WebSockets, the connection count says little about the load each one carries.
	}
	@docH2("p2c", "Power of two choices")
	@docP() {
		Pick two backends at random and send the request to the less loaded of the two. It needs no sorted view of every backend, only two lookups, yet it removes nearly all the imbalance of plain random choice: the busiest backend is rarely in the pair, and when it is, it loses. It also avoids a herd: with many balancers acting on stale counts, “least loaded” sends everyone to the same backend at once, while random pairs spread out.
	}
	@docTable([]string{"Proxy", "Setting"},
		[]string{"Traefik", "strategy: p2c  (fewer active connections of two random servers)"},
		[]string{"Envoy", "lb_policy: LEAST_REQUEST  (choice_count defaults to 2)"},
		[]string{"HAProxy", "balance random(2)  (2 draws is the default)"},
		[]string{"NGINX", "random two least_conn;"},
	)
	@docH2("hashing", "Consistent hashing: ring and Maglev")
	@docP() {
		Hashing picks the backend from a key: a header, a cookie, the client's address or the URL. The same key always lands on the same backend, which matters when the backend keeps something per key: a cache that stays warm for that user, or a shard of in-memory state.
	}
	@docP() {
		The naive version, hash modulo the number of backends, remaps almost every key when a backend is added or removed. Consistent hashing remaps only a minority. In the ideal scheme, a fixed ring from which the leaving backend's points are simply deleted, exactly that backend's keys move, about one in N, and every other key stays put. Many implementations, Envoy's among them, rebuild their structure on every change and can move some keys between the remaining backends too, so measure before relying on the ideal.
	}
	@docList(
		"Ring hash places each backend at many points on a circle of hash values. A key goes to the first backend point clockwise from its own hash. On a fixed ring, when a backend leaves only the arcs it owned move, to their next neighbours. Envoy rebuilds the ring instead, keeping its size (minimum_ring_size, 1,024 entries by default) and sharing it among the remaining hosts, so each survivor gains points, and those take some keys from other survivors. In the lb/consistent-hashing lab, stopping one of four hosts moved its 49 keys and 22 others: still a minority of 200, but more than one in N.",
		"Maglev, from Google's load balancer, fills a lookup table (table_size, 65,537 entries by default in Envoy) so that each backend owns an almost equal share. Lookups are a single index. Envoy's docs measure its table build about 10x and its host selection about 5x faster than a ring of 256K entries, and say it is less stable than a ring: their simulations show about twice as many keys moving when hosts are removed, and a larger table reduces the disruption. Those figures depend on the ring and table sizes and the number of hosts. With the lab's four hosts, a 1,024-entry ring and the default table, Maglev moved only the removed host's keys in every run, fewer than the ring.",
		"Rendezvous hashing (highest random weight) scores every backend against the key and takes the highest. Traefik's hrw strategy uses it with the client's IP as the key.",
	)
	@docCode("hashing", lbHashCode)
	@docP() {
		With Envoy the cluster's policy alone is not enough: the route's @docCodeWord("hash_policy") says what to hash. A request that produces no key (the header is missing) goes to a random host.
	}
	@docH2("sticky", "Sticky sessions")
	@docP() {
		Stickiness keeps one client on one backend, usually with a cookie the proxy adds to the first response that names the server. Later requests carry the cookie and go straight there. It exists for apps that keep session state in memory, and it fails the way those apps fail: when the sticky server goes down, the proxy sends the client elsewhere and points the cookie at the new server, and whatever lived only in the old one's memory is gone.
	}
	@docCode("stickiness", lbStickyCode)
	@docP() {
		Envoy has no sticky cookie of its own: hash on a cookie with @docCodeWord("hash_policy: cookie"), and give it a @docCodeWord("ttl") so Envoy creates the cookie when the client has none. HAProxy's @docCodeWord("option redispatch") lets a request whose sticky server refuses the connection retry on another.
	}
	@docH2("choosing", "Which to choose")
	@docList(
		"Requests cost about the same: round robin. It is the default for a reason.",
		"Request cost varies, or some backends are slower: least connections, or power of two choices with many proxies.",
		"Backends of different sizes, or a canary: weights.",
		"Per-key locality (caches, shards): consistent hashing. Envoy's docs favour a ring for stability and Maglev for cheap lookups and rebuilds; how many keys actually move depends on your sizes and host count, so measure it.",
		"Legacy session state in memory: stickiness, while you move the state into a store.",
	)
	@docH2("try", "Try them")
	@docStarters(stRoundRobin, stLeastConn, stP2C, stHashing, stSticky)
	@docTerminal("bb starter lb/least-connections", "bb up", "bb status")
}

templ lbStrategiesDiagram() {
	<svg viewBox="0 0 900 220" width="900" class="mx-auto block h-auto max-w-full" role="img" aria-label="Three panels: round robin sends requests 1, 2, 3 in turn; least connections sends to the replica with the fewest in flight; a hash ring maps keys to the next replica clockwise">
		<text x="20" y="24" class="fill-slate-900 text-[13px] font-semibold">round robin</text>
		for i, y := range []int{44, 104, 164} {
			<rect x="20" y={ itoa(y) } width="240" height="40" rx="8" class="fill-slate-50 stroke-slate-200"></rect>
			<text x="34" y={ itoa(y + 25) } class="fill-slate-900 font-mono text-[13px]">api-{ itoa(i + 1) }</text>
			<text x="246" y={ itoa(y + 25) } text-anchor="end" class="fill-slate-500 text-[12px]">req { itoa(i + 1) }, { itoa(i + 4) }, { itoa(i + 7) }</text>
		}
		<text x="320" y="24" class="fill-slate-900 text-[13px] font-semibold">least connections</text>
		for i, y := range []int{44, 104, 164} {
			<rect x="320" y={ itoa(y) } width="240" height="40" rx="8" class="fill-slate-50 stroke-slate-200"></rect>
			<text x="334" y={ itoa(y + 25) } class="fill-slate-900 font-mono text-[13px]">api-{ itoa(i + 1) }</text>
			for j := range lbInFlight[i] {
				<rect x={ itoa(420 + j*16) } y={ itoa(y + 12) } width="10" height="16" rx="2" class="fill-slate-300"></rect>
			}
		}
		<text x="546" y="129" text-anchor="end" class="fill-indigo-700 text-[12px] font-semibold">← next</text>
		<text x="620" y="24" class="fill-slate-900 text-[13px] font-semibold">hash ring</text>
		<circle cx="750" cy="120" r="70" fill="none" stroke-width="2" class="stroke-slate-300"></circle>
		<circle cx="750" cy="50" r="7" class="fill-indigo-400"></circle>
		<text x="762" y="44" class="fill-slate-700 font-mono text-[12px]">api-1</text>
		<circle cx="811" cy="155" r="7" class="fill-indigo-400"></circle>
		<text x="822" y="172" class="fill-slate-700 font-mono text-[12px]">api-2</text>
		<circle cx="689" cy="155" r="7" class="fill-indigo-400"></circle>
		<text x="626" y="180" class="fill-slate-700 font-mono text-[12px]">api-3</text>
		<circle cx="815" cy="96" r="4" class="fill-slate-500"></circle>
		<text x="826" y="94" class="fill-slate-500 text-[11px]">key a → api-2</text>
		<circle cx="750" cy="190" r="4" class="fill-slate-500"></circle>
		<text x="734" y="210" text-anchor="end" class="fill-slate-500 text-[11px]">key b → api-3</text>
	</svg>
}

// --- Health checks ---------------------------------------------------------------

const lbActiveCode = `# HAProxy: an HTTP check of /healthz every 2s; down after 3 failures, up after 2
backend be_api
    option httpchk
    http-check send meth GET uri /healthz
    http-check expect status 200
    default-server inter 2s fall 3 rise 2
    server-template api 3 api.plain.bb.internal:8080 check`

const lbPassiveCode = `# Envoy: eject a host after 3 consecutive 5xx (the default is 5)
outlier_detection:
  consecutive_5xx: 3
  interval: 5s
  base_ejection_time: 30s
  max_ejection_percent: 50

# NGINX: 3 failed attempts within 10s and the address rests for 10s.
# By default only connection errors and timeouts count; add statuses
# such as http_500 to proxy_next_upstream to count those too.
server api.bb.internal:8443 resolve max_fails=3 fail_timeout=10s;

# HAProxy: count real responses as checks, and mark down after 3 errors
server-template api 3 api.bb.internal:8443 check observe layer7 error-limit 3 on-error mark-down`

templ lbHealth() {
	@docLead() {
		A load balancer is only as good as its list of healthy backends. It can find out by asking each backend on a timer (active checks) or by watching how the requests it sends turn out (passive checks).
	}
	@docFigure("Active: the proxy probes every backend on a timer, traffic or not. Passive: it counts errors on real requests and ejects a backend that keeps failing.") {
		@lbHealthDiagram()
	}
	@docH2("why", "Why check at all")
	@docP() {
		Without checks a proxy keeps sending a share of requests to a backend that is down, and that share fails. A container that stopped leaves Docker's DNS, so a proxy that re-resolves drops it within seconds. A container that is running but broken (deadlocked, out of database connections, answering 500) stays in DNS: Docker's own health check marks it unhealthy in @docCodeWord("bb status"), but Docker's DNS keeps returning its address. Only the proxy's checks take it out of the rotation.
	}
	@docH2("active", "Active checks")
	@docP() {
		The proxy sends its own probe to every backend every interval: a TCP connect, a TLS handshake, or an HTTP request whose status it checks. After @docCodeWord("fall") failures in a row the backend is down; after @docCodeWord("rise") successes it is back.
	}
	@docCode("haproxy.cfg", lbActiveCode)
	@docList(
		"They find a dead backend before any user request does, and they bring it back without a user request as the guinea pig.",
		"They test only what the probe touches. A TCP connect proves the port is open, not that the app works; an HTTP check proves what its endpoint checks.",
		"Every proxy instance probes every backend, so many proxies against many backends add up.",
		"Open-source NGINX has none: active health_check is NGINX Plus.",
	)
	@docH2("passive", "Passive checks")
	@docP() {
		The proxy watches real responses and connection failures. A backend that produces too many errors is ejected for a while, then tried again. Envoy calls this outlier detection; NGINX's @docCodeWord("max_fails") and @docCodeWord("fail_timeout") are the same idea, though by default they count only connection errors and timeouts, not 5xx answers; listing statuses in @docCodeWord("proxy_next_upstream") adds them; HAProxy can feed real traffic into its checks with @docCodeWord("observe"); Traefik 3.7 has a @docCodeWord("passiveHealthCheck") on its load balancer.
	}
	@docCode("passive", lbPassiveCode)
	@docList(
		"No probe traffic, and they judge what users actually get: a backend that answers its health endpoint but fails real requests is caught.",
		"Users pay for detection: the failures that trigger an ejection are real requests (retries can hide them).",
		"With no traffic there is no signal, so an ejected backend comes back on a timer, not on proof.",
		"Envoy never ejects more than max_ejection_percent of a cluster, 10% by default, so with three hosts the default ejects none; set it higher in a small lab.",
	)
	@docH2("timing", "Time to eject, time to recover")
	@docP() {
		For active checks, detection takes about interval × fall, plus a timeout for each probe that hangs; recovery takes interval × rise. Breadboard's generated HAProxy and Envoy configs check every 2 seconds, down after 3 and up after 2: about 6 seconds to eject a dead backend and 4 to bring it back. For passive checks, detection takes as many failed requests as the threshold, however long they take to arrive, and recovery is the ejection time: 10 seconds for NGINX's @docCodeWord("fail_timeout"), 30 seconds times the number of consecutive ejections for Envoy.
	}
	@docP() {
		Using both is common: active checks for dead backends and recovery, passive checks for the backend that passes its probe and fails real work. Envoy also has a safety net: when fewer than half of a cluster's hosts are healthy (the panic threshold), it ignores health and balances across all of them, on the theory that some answers beat none.
	}
	@docH2("endpoint", "What a health endpoint should say")
	@docList(
		"Ready means “send me traffic”. It should fail while the app is starting, and while it is shutting down (see draining in Deployments through a proxy).",
		"Keep it cheap: it runs every couple of seconds from every proxy.",
		"Be careful with dependencies. If every replica's health check queries the database, a database blip takes every replica out at once and the proxy has nothing left; Envoy's panic mode exists for exactly this.",
	)
	@docH2("generated", "What Breadboard generates")
	@docTable([]string{"Proxy", "Checks in the generated config"},
		[]string{"HAProxy", "active: TCP connect (a verified TLS handshake for re-encrypt), inter 2s fall 3 rise 2"},
		[]string{"Envoy", "active: GET / every 2s, any status below 500 healthy, 3 down, 2 up; TCP for passthrough"},
		[]string{"Traefik", "active: GET / every 2s on app upstreams, 2xx or 3xx healthy; TCP for passthrough"},
		[]string{"NGINX", "passive only: max_fails=3 fail_timeout=10s, counting connection errors and timeouts (proxy_next_upstream error timeout), not HTTP 5xx"},
	)
	@docP() {
		They probe @docCodeWord("/") because Breadboard cannot know your app's health endpoint. In your own copy of the config, set with @docCodeWord("file:"), point the check at a real endpoint and narrow the statuses it accepts.
	}
	@docH2("try", "Try it")
	@docStarters(stHealth, stRoundRobin, stDiscovery)
}

templ lbHealthDiagram() {
	<svg viewBox="0 0 900 200" width="900" class="mx-auto block h-auto max-w-full" role="img" aria-label="Left: the proxy sends a probe to each backend every 2 seconds. Right: the proxy counts errors on real requests and ejects the backend after three in a row">
