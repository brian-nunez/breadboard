	</svg>
}

// --- L4 vs L7 ----------------------------------------------------------------------

const lbLayersCode = `# HAProxy: the same backend reached two ways
frontend l7
    mode http                       # parse requests: paths, headers, cookies
    bind :8443 ssl crt /etc/bb/tls/keystore.pem
    use_backend be_admin if { path_beg /admin/ }
    default_backend be_api

frontend l4
    mode tcp                        # bytes only: route on the connection
    bind :9443
    tcp-request inspect-delay 5s
    tcp-request content accept if { req.ssl_hello_type 1 }
    use_backend be_tls_api if { req.ssl_sni -i api.bb.internal }`

templ lbLayers() {
	@docLead() {
		A proxy works either on connections (layer 4, TCP) or on requests (layer 7, HTTP). The layer decides what it can see, what it can route on, and how finely it can spread load.
	}
	@docFigure("An L4 proxy sees addresses, ports and, for TLS, the server name in the ClientHello. An L7 proxy decrypts and sees every request: method, path, headers.") {
		@lbLayersDiagram()
	}
	@docH2("layers", "What each layer sees")
	@docTable([]string{"", "L4 (TCP)", "L7 (HTTP)"},
		[]string{"Sees", "client IP and port, bytes", "method, path, headers, cookies, body"},
		[]string{"Over TLS", "the SNI in the ClientHello", "everything, after decrypting"},
		[]string{"Routes on", "port, SNI", "host, path, header, cookie, weight"},
		[]string{"Balances", "each connection", "each request"},
		[]string{"Can also", "forward any protocol", "rewrite, retry, add headers, mirror"},
	)
	@docH2("l4", "L4: connections")
	@docP() {
		An L4 proxy accepts a TCP connection, picks a backend once, and copies bytes in both directions until either side closes. It never parses them, so it works for any protocol: Postgres, Redis, Kafka, or TLS it cannot decrypt. For TLS it can still read one thing: the server name the client puts in its ClientHello, which is sent before encryption starts. That is how passthrough routes several TLS services on one port.
	}
	@docTable([]string{"Proxy", "L4", "L7"},
		[]string{"HAProxy", "mode tcp", "mode http"},
		[]string{"NGINX", "stream { … }", "http { … }"},
		[]string{"Envoy", "envoy.filters.network.tcp_proxy", "envoy.filters.network.http_connection_manager"},
		[]string{"Traefik", "tcp: routers with HostSNI", "http: routers with PathPrefix, Host, …"},
	)
	@docH2("l7", "L7: requests")
	@docP() {
		An L7 proxy terminates the client's connection, parses each HTTP request, and decides per request. It can send @docCodeWord("/admin/") to one backend and everything else to another, retry a failed idempotent request elsewhere, add @docCodeWord("X-Forwarded-For"), split traffic by weight, or copy requests to a shadow. For HTTPS it needs the certificate and key, because it has to decrypt to see any of this.
	}
	@docCode("haproxy.cfg", lbLayersCode)
	@docH2("per", "Per connection or per request")
	@docP() {
		Clients reuse connections. With HTTP keep-alive, and even more with HTTP/2 and gRPC, which multiplex many requests on one connection, a client may send thousands of requests over a single connection. An L4 balancer pins all of them to the backend it picked when the connection opened: three clients against three backends may land on two, and one busy client keeps one backend hot while the others idle. An L7 balancer spreads the requests themselves. This is why gRPC traffic needs an L7 proxy (or client-side balancing).
	}
	@docH2("cost", "What L7 costs")
	@docList(
		"The proxy holds the TLS key and sees plaintext: it is inside the trust boundary.",
		"Parsing and re-encrypting cost CPU and add a little latency per request.",
		"The backend sees the proxy's address, not the client's; X-Forwarded-For carries the client's, and the backend must trust it only from the proxy. At L4 the PROXY protocol does the same job.",
		"Only HTTP (and protocols the proxy knows) can be handled; anything else must stay at L4.",
	)
	@docH2("breadboard", "Both in Breadboard")
	@docP() {
		Every Breadboard HTTP proxy has both. Port 8443 is L7: it decrypts with the proxy's certificate, routes @docCodeWord("/<route>/") prefixes and balances per request; apps reach it at @docCodeWord("<NAME>_URL")&#46; Port 9443 is L4: it exists when an upstream is @docCodeWord("passthrough"), and routes by SNI to backends that keep their own TLS, at @docCodeWord("<NAME>_PASSTHROUGH_ADDR")&#46; See @docLink("/docs/load-balancing/tls-at-the-proxy", "TLS at the proxy")&#46;
	}
	@docH2("try", "Try it")
	@docStarters(stL4L7, stTLSModes)
}

templ lbLayersDiagram() {
	<svg viewBox="0 0 900 210" width="900" class="mx-auto block h-auto max-w-full" role="img" aria-label="Two lanes. L4: a TCP connection whose bytes stay opaque except the server name. L7: a decrypted HTTP request whose method, path and headers the proxy reads">
		<defs>
			<marker id="ly-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0 L8 4 L0 8 z" class="fill-slate-400"></path></marker>
		</defs>
		<text x="20" y="30" class="fill-slate-900 text-[13px] font-semibold">L4</text>
		<rect x="60" y="12" width="500" height="64" rx="8" class="fill-slate-50 stroke-slate-200"></rect>
		<text x="76" y="38" class="fill-slate-700 font-mono text-[12px]">10.213.0.7:51244 → :9443</text>
		<text x="76" y="60" class="fill-indigo-700 font-mono text-[12px]">SNI api.bb.internal</text>
		<text x="260" y="60" class="fill-slate-400 font-mono text-[12px]">▓▓▓▓ encrypted ▓▓▓▓▓▓▓▓▓▓▓▓</text>
		<line x1="560" y1="44" x2="676" y2="44" stroke-width="1.5" marker-end="url(#ly-arrow)" class="stroke-slate-400"></line>
		<text x="618" y="36" text-anchor="middle" class="fill-slate-500 text-[11px]">whole connection</text>
		<rect x="680" y="22" width="200" height="44" rx="8" class="fill-slate-50 stroke-slate-200"></rect>
		<text x="696" y="49" class="fill-slate-900 font-mono text-[13px]">one backend</text>
		<text x="20" y="128" class="fill-slate-900 text-[13px] font-semibold">L7</text>
		<rect x="60" y="100" width="500" height="96" rx="8" class="fill-slate-50 stroke-slate-200"></rect>
		<text x="76" y="126" class="fill-slate-700 font-mono text-[12px]">10.213.0.7:51244 → :8443  (decrypted)</text>
		<text x="76" y="148" class="fill-indigo-700 font-mono text-[12px]">GET /admin/users HTTP/2</text>
		<text x="76" y="168" class="fill-indigo-700 font-mono text-[12px]">cookie: srv=a2   x-user: 42</text>
		<text x="76" y="188" class="fill-slate-400 font-mono text-[12px]">body …</text>
		<line x1="560" y1="130" x2="676" y2="118" stroke-width="1.5" marker-end="url(#ly-arrow)" class="stroke-slate-400"></line>
		<line x1="560" y1="160" x2="676" y2="172" stroke-width="1.5" marker-end="url(#ly-arrow)" class="stroke-slate-400"></line>
		<text x="618" y="148" text-anchor="middle" class="fill-slate-500 text-[11px]">each request</text>
		<rect x="680" y="96" width="200" height="40" rx="8" class="fill-slate-50 stroke-slate-200"></rect>
		<text x="696" y="121" class="fill-slate-900 font-mono text-[13px]">admin</text>
		<rect x="680" y="152" width="200" height="40" rx="8" class="fill-slate-50 stroke-slate-200"></rect>
		<text x="696" y="177" class="fill-slate-900 font-mono text-[13px]">api</text>
	</svg>
}

// --- TLS ---------------------------------------------------------------------------

const lbTLSSpec = `services:
  edge:
    type: haproxy                  # or envoy, traefik, nginx
    upstreams:
      - web                        # re-encrypt (tls.mode: on, the default)
      - service: api
        tls:
          mode: off                # terminate: plaintext on a private segment
          reason: practice TLS termination
      - service: payments
        tls: {mode: passthrough}   # L4 on :9443, routed by SNI
apps:
  client:
    path: ./client
    uses: [edge]   # EDGE_URL=https://edge.bb.internal:8443
                   # EDGE_PASSTHROUGH_ADDR=edge.bb.internal:9443`

templ lbTLS() {
	@docLead() {
		A proxy in front of TLS services can decrypt and encrypt again, decrypt and send plaintext, or not decrypt at all. Breadboard supports all three on every HTTP proxy, per upstream, and every hop that is not encrypted has to say why.
	}
	@docFigure("Re-encrypt: two TLS sessions, the proxy's and the backend's. Terminate: TLS to the proxy, plaintext on a private segment. Passthrough: one TLS session from client to backend; the proxy only reads the server name.") {
		@lbTLSDiagram()
	}
	@docH2("modes", "Three modes")
	@docP() {
		The question is who holds the session keys. With re-encrypt and terminate the proxy decrypts, so it sees every request and can do anything an L7 proxy does. With passthrough the client's TLS session runs all the way to the backend, the proxy sees only encrypted bytes, and the client verifies the backend's certificate, not the proxy's.
	}
	@docH2("reencrypt", "Re-encrypt")
	@docP() {
		The client's TLS session ends at the proxy, with the proxy's certificate. The proxy then opens a second TLS session to the backend, verifies the backend's certificate against the lab CA, and sends the backend's name as SNI. Nothing travels in plaintext, and the proxy can still route by path. This is @docCodeWord("tls.mode: on"), the default.
	}
	@docCallout("Verify the backend by name") {
		Encrypting to the backend without verifying it only protects against passive eavesdropping. Breadboard's configs verify the chain and the name: HAProxy @docCodeWord("verify required") with @docCodeWord("verifyhost"), Envoy a SAN match, NGINX @docCodeWord("proxy_ssl_verify on") with @docCodeWord("proxy_ssl_name"), Traefik a serversTransport with @docCodeWord("serverName")&#46; HAProxy 3.4 needs the explicit @docCodeWord("sni"): its automatic SNI would send the client's Host, which is the proxy's own name.
	}
	@docH2("terminate", "Terminate")
	@docP() {
		The proxy decrypts and sends plain HTTP to the backend. It saves the backend a handshake per connection, and it is the classic edge setup. It also means anyone on that network can read the traffic, so Breadboard confines it. @docCodeWord("tls.mode: off") requires a @docCodeWord("reason"); the hop runs on a private segment, @docCodeWord("plain-<app>"), that only the app's replicas and the proxies terminating to it join; each replica gets @docCodeWord("BB_PLAIN_LISTEN_ADDR") to bind its plaintext listener, and an init container drops that port on every other address. @docCodeWord("bb status") reports the hop as a plaintext warning.
	}
	@docH2("passthrough", "Passthrough")
	@docP() {
		The proxy listens on 9443 at L4, reads the SNI from the client's ClientHello, and forwards the connection to the backend that owns that name, still encrypted. The client must connect to @docCodeWord("<NAME>_PASSTHROUGH_ADDR") and send the backend's name, @docCodeWord("<target>.<domain>"), as SNI; it then sees and verifies the backend's own certificate. The proxy cannot route on paths, add headers or balance per request. A name no upstream claims is closed.
	}
	@docP() {
		Passthrough needs a protocol that starts with a TLS ClientHello: HTTPS, Kafka, Redis, Consul. Postgres first sends a plaintext request to switch to TLS, so a Postgres client has to use direct TLS, @docCodeWord("sslnegotiation=direct") with libpq 17 and later, to pass through.
	}
	@docH2("compare", "Side by side")
	@docTable([]string{"", "Re-encrypt", "Terminate", "Passthrough"},
		[]string{"tls.mode", "on (default)", "off + reason", "passthrough"},
		[]string{"Client sees", "proxy's certificate", "proxy's certificate", "backend's certificate"},
		[]string{"Proxy reads requests", "yes", "yes", "no, only SNI"},
		[]string{"Proxy → backend", "TLS, verified", "plaintext, private segment", "the client's TLS"},
		[]string{"Proxy port", "8443", "8443", "9443"},
		[]string{"Routes on", "path prefix", "path prefix", "server name"},
	)
	@docH2("declare", "Declaring the mode")
	@docCode("experiment.yaml", lbTLSSpec)
	@docP() {
		Each proxy's “in Breadboard” guide shows the directives its generated config uses for each mode: @docLink("/docs/haproxy/in-breadboard", "HAProxy"), @docLink("/docs/envoy/in-breadboard", "Envoy"), @docLink("/docs/traefik/in-breadboard", "Traefik"), @docLink("/docs/nginx/in-breadboard", "NGINX")&#46;
	}
	@docH2("check", "Checking which one you got")
	@docP() {
		Ask for the certificate each address presents. Through 8443 the subject is the proxy; through 9443 with a backend's name, it is the backend:
	}
	@docTerminal(
		"openssl s_client -connect edge.bb.internal:8443 -servername edge.bb.internal -CAfile /etc/bb/ca.pem </dev/null 2>/dev/null | grep subject=",
		"openssl s_client -connect edge.bb.internal:9443 -servername payments.bb.internal -CAfile /etc/bb/ca.pem </dev/null 2>/dev/null | grep subject=",
	)
	@docStarters(stTLSModes)
}

templ lbTLSDiagram() {
	<svg viewBox="0 0 900 220" width="900" class="mx-auto block h-auto max-w-full" role="img" aria-label="Three rows. Re-encrypt: client to proxy TLS, proxy to backend TLS. Terminate: client to proxy TLS, proxy to backend plaintext on a private segment. Passthrough: one TLS session from client through the proxy to the backend">
		<defs>
			<marker id="tm-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0 L8 4 L0 8 z" class="fill-slate-400"></path></marker>
		</defs>
		for i, y := range []int{20, 90, 160} {
			<text x="20" y={ itoa(y + 26) } class="fill-slate-900 text-[13px] font-semibold">{ lbTLSRows[i] }</text>
			<rect x="140" y={ itoa(y) } width="110" height="40" rx="8" class="fill-slate-50 stroke-slate-200"></rect>
			<text x="156" y={ itoa(y + 25) } class="fill-slate-700 text-[13px]">client</text>
			<rect x="420" y={ itoa(y) } width="140" height="40" rx="8" class="fill-indigo-50 stroke-indigo-200"></rect>
			<text x="436" y={ itoa(y + 25) } class="fill-indigo-800 font-mono text-[13px] font-semibold">proxy { lbTLSPorts[i] }</text>
			<rect x="730" y={ itoa(y) } width="150" height="40" rx="8" class="fill-slate-50 stroke-slate-200"></rect>
			<text x="746" y={ itoa(y + 25) } class="fill-slate-700 text-[13px]">backend</text>
		}
		<line x1="250" y1="40" x2="416" y2="40" stroke-width="2" marker-end="url(#tm-arrow)" class="stroke-indigo-400"></line>
		<text x="333" y="32" text-anchor="middle" class="fill-slate-500 text-[11px]">TLS, proxy's cert</text>
		<line x1="560" y1="40" x2="726" y2="40" stroke-width="2" marker-end="url(#tm-arrow)" class="stroke-indigo-400"></line>
		<text x="643" y="32" text-anchor="middle" class="fill-slate-500 text-[11px]">TLS, verified as backend</text>
		<line x1="250" y1="110" x2="416" y2="110" stroke-width="2" marker-end="url(#tm-arrow)" class="stroke-indigo-400"></line>
		<text x="333" y="102" text-anchor="middle" class="fill-slate-500 text-[11px]">TLS, proxy's cert</text>
		<line x1="560" y1="110" x2="726" y2="110" stroke-width="2" stroke-dasharray="6 4" marker-end="url(#tm-arrow)" class="stroke-red-400"></line>
		<text x="643" y="102" text-anchor="middle" class="fill-red-700 text-[11px]">plaintext, plain-api segment</text>
		<line x1="250" y1="180" x2="416" y2="180" stroke-width="2" marker-end="url(#tm-arrow)" class="stroke-indigo-400"></line>
		<line x1="560" y1="180" x2="726" y2="180" stroke-width="2" marker-end="url(#tm-arrow)" class="stroke-indigo-400"></line>
		<text x="333" y="172" text-anchor="middle" class="fill-slate-500 text-[11px]">the client's TLS session</text>
		<text x="643" y="172" text-anchor="middle" class="fill-slate-500 text-[11px]">backend's cert</text>
		<text x="490" y="214" text-anchor="middle" class="fill-slate-500 text-[11px]">reads only the SNI</text>
	</svg>
}

// --- Deployments -------------------------------------------------------------------

const lbCanaryCode = `# Traefik: a weighted service over two services, v1 90%, v2 10%
http:
  services:
    api:
      weighted:
        services:
          - name: api-v1
            weight: 90
          - name: api-v2
            weight: 10

# Envoy: the same split on a route
route:
  weighted_clusters:
    clusters:
      - name: api-v1
        weight: 90
      - name: api-v2
        weight: 10`

const lbMirrorCode = `# Envoy: copy every request to v2; its responses are never sent to the client
route:
  cluster: api-v1
  request_mirror_policies:
    - cluster: api-v2

# NGINX: a mirror subrequest per request; its response is ignored
location / {
    mirror /mirror;
    proxy_pass https://api_v1;
}
location = /mirror {
    internal;
    proxy_pass https://api_v2$request_uri;
}

# Traefik: a mirroring service sending 10% to v2
mirrored:
  mirroring:
    service: api-v1
    mirrors:
      - name: api-v2
        percent: 10`

const lbDrainCode = `# HAProxy runtime API: stop new traffic to one server, let the rest finish
set server be_api/api2 state drain
# ... wait until its current sessions (scur on the stats page) reach 0, then stop it
set server be_api/api2 state maint`

const lbShutdownCode = `// On SIGTERM: fail readiness first, keep serving, then finish in-flight requests.
<-ctx.Done()                      // signal.NotifyContext(..., syscall.SIGTERM)
ready.Store(false)                // /healthz now answers 503
time.Sleep(6 * time.Second)       // about interval × fall of the proxy's check
shutdownCtx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
defer cancel()
srv.Shutdown(shutdownCtx)         // stops accepting, waits for active requests`

templ lbDeployments() {
	@docLead() {
		Because every request passes through it, the proxy decides which version of a service answers. Deployment strategies are different ways of moving that decision from the old version to the new one without users noticing.
	}
	@docFigure("Blue-green switches all traffic at once. A canary sends a small share to the new version. Mirroring copies requests to it and discards its answers. Draining stops new requests to an instance and lets the old ones finish.") {
		@lbDeployDiagram()
	}
	@docH2("switch", "The proxy as a switch")
	@docP() {
		Two things decide whether a change of backends is invisible. The proxy must apply its new configuration gracefully: NGINX's reload starts new workers and lets the old ones finish their requests, HAProxy's master process does the same for its old worker, Traefik applies a changed dynamic file live, and Envoy takes new clusters and routes from its control plane without a restart. And the backend leaving must finish what it started (draining, below). Recreating the proxy's container is not graceful: it drops every open connection.
	}
	@docH2("blue-green", "Blue-green")
	@docP() {
		Run two complete copies, blue (live) and green (new). Test green directly, then point the proxy at green in one step. Rolling back is pointing it at blue again, which is still running. The cost is running everything twice during the switch, and anything shared (the database schema) must work with both.
	}
	@docStarters(stBlueGreen)
	@docH2("canary", "Canary")
	@docP() {
		Send a small share of real traffic to the new version, compare its errors and latency with the old version's, and raise the share step by step: 1%, 10%, 50%, 100%. A bad version hurts few users, briefly. The comparison is the point: a canary nobody watches is a slow rollout.
	}
	@docCode("weights", lbCanaryCode)
	@docP() {
		HAProxy and NGINX express the same with weights on servers, and NGINX also with @docCodeWord("split_clients"), which hashes a key (such as a user id) into percentages, so one user stays on one version. Routing by header instead of weight lets testers opt into the canary.
	}
	@docStarters(stCanary)
	@docH2("mirroring", "Mirroring")
	@docP() {
		Also called shadowing: the proxy sends a copy of each request (or a share of them) to the new version, and throws its response away. Users only ever see the old version's answers, yet the new version handles real traffic: its logs, errors and latency show how it would behave.
	}
	@docCode("mirroring", lbMirrorCode)
	@docList(
		"Side effects happen twice. A mirrored POST that writes to a shared database writes twice; mirror to a copy with its own data, or mirror only reads.",
		"The shadow adds load, so mirror a percentage when traffic is high.",
		"Envoy appends -shadow to the Host header of mirrored requests, so the backend can tell them apart (disable_shadow_host_suffix_append turns it off).",
		"HAProxy 3.4 has no built-in mirroring directive.",
	)
	@docStarters(stMirroring)
	@docH2("draining", "Draining")
	@docP() {
		Removing a backend loses the requests it is serving unless it is drained first: no new requests, the current ones allowed to finish, then stopped. HAProxy does it through its runtime API: @docCodeWord("state drain") or weight 0, after which only persistent sticky clients still get through. In open-source NGINX, @docCodeWord("drain") on a server (since 1.29.6) applies to sticky clients; otherwise mark it @docCodeWord("down") and reload. Envoy and Traefik drain a backend whose health check fails.
	}
	@docCode("haproxy runtime API", lbDrainCode)
	@docP() {
		The backend can drain itself. @docCodeWord("docker stop") sends SIGTERM and kills the container 10 seconds later. An app that on SIGTERM fails its health check, keeps serving until the proxy notices, then shuts its server down gracefully loses nothing:
	}
	@docCode("main.go", lbShutdownCode)
	@docStarters(stDraining)
	@docH2("try", "Try them")
	@docTerminal("bb starter lb/weighted-canary", "bb up", "bb status")
}

templ lbDeployDiagram() {
	<svg viewBox="0 0 900 200" width="900" class="mx-auto block h-auto max-w-full" role="img" aria-label="Four panels: blue-green with all traffic moving from blue to green; canary with 90 percent to v1 and 10 percent to v2; mirroring with a copy to v2 whose responses are dropped; draining with no new requests to one instance">
		<defs>
			<marker id="dp-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0 L8 4 L0 8 z" class="fill-slate-400"></path></marker>
		</defs>
		for i, title := range []string{"blue-green", "canary", "mirroring", "draining"} {
			<text x={ itoa(20 + i*225) } y="24" class="fill-slate-900 text-[13px] font-semibold">{ title }</text>
			<rect x={ itoa(20 + i*225) } y="80" width="60" height="40" rx="8" class="fill-indigo-50 stroke-indigo-200"></rect>
			<text x={ itoa(30 + i*225) } y="105" class="fill-indigo-800 font-mono text-[12px] font-semibold">proxy</text>
			<rect x={ itoa(130 + i*225) } y="44" width="70" height="36" rx="8" class="fill-slate-50 stroke-slate-200"></rect>
			<rect x={ itoa(130 + i*225) } y="124" width="70" height="36" rx="8" class="fill-slate-50 stroke-slate-200"></rect>
		}
		<text x="142" y="67" class="fill-slate-400 font-mono text-[12px]">blue</text>
		<text x="142" y="147" class="fill-slate-900 font-mono text-[12px]">green</text>
		<line x1="80" y1="108" x2="126" y2="138" stroke-width="2.5" marker-end="url(#dp-arrow)" class="stroke-indigo-400"></line>
		<text x="110" y="185" text-anchor="middle" class="fill-slate-500 text-[11px]">100% at once</text>
		<text x="367" y="67" class="fill-slate-900 font-mono text-[12px]">v1</text>
		<text x="367" y="147" class="fill-slate-900 font-mono text-[12px]">v2</text>
		<line x1="305" y1="92" x2="351" y2="64" stroke-width="3" marker-end="url(#dp-arrow)" class="stroke-indigo-400"></line>
		<line x1="305" y1="108" x2="351" y2="138" stroke-width="1" marker-end="url(#dp-arrow)" class="stroke-indigo-400"></line>
		<text x="335" y="185" text-anchor="middle" class="fill-slate-500 text-[11px]">90% / 10%</text>
		<text x="592" y="67" class="fill-slate-900 font-mono text-[12px]">v1</text>
		<text x="592" y="147" class="fill-slate-900 font-mono text-[12px]">v2</text>
		<line x1="530" y1="92" x2="576" y2="64" stroke-width="2" marker-end="url(#dp-arrow)" class="stroke-indigo-400"></line>
		<line x1="530" y1="108" x2="576" y2="138" stroke-width="1.5" stroke-dasharray="4 3" marker-end="url(#dp-arrow)" class="stroke-slate-400"></line>
		<text x="560" y="185" text-anchor="middle" class="fill-slate-500 text-[11px]">copy, answer dropped</text>
		<text x="817" y="67" class="fill-slate-900 font-mono text-[12px]">api-1</text>
		<text x="817" y="147" class="fill-slate-400 font-mono text-[12px]">api-2</text>
		<line x1="755" y1="92" x2="801" y2="64" stroke-width="2.5" marker-end="url(#dp-arrow)" class="stroke-indigo-400"></line>
		<text x="785" y="185" text-anchor="middle" class="fill-slate-500 text-[11px]">api-2: no new, finish old</text>
	</svg>
}

// --- Pooling -----------------------------------------------------------------------

const lbKeepaliveCode = `# NGINX: keep idle connections to the backends, per worker
upstream be_api {
    zone be_api 64k;
    server api.bb.internal:8443 resolve;
    keepalive 16;
}
location / {
    proxy_pass https://be_api;
    proxy_http_version 1.1;          # keep-alive needs HTTP/1.1
    proxy_set_header Connection "";  # and no "Connection: close"
}`

const lbPoolSpec = `services:
  postgres:
    type: postgres
  pool:
    type: pgbouncer
    config:
      pool_mode: transaction   # session, transaction or statement
      pool_size: 5             # server connections per database and user
    upstreams: [postgres]
apps:
  orders:
    path: ./orders
    uses: [pool]   # DATABASE_URL=postgres://app:…@pool.bb.internal:6432/app?sslmode=verify-full`

templ lbPooling() {
	@docLead() {
		Opening a connection is expensive and keeping one is not free. A pool keeps a few connections open and lends them out, so many short pieces of work share them. Proxies pool in two places: towards HTTP backends, and in front of databases that can only afford a few connections.
	}
	@docFigure("Many client connections reach the pool; it lends a few server connections, each for one transaction in transaction mode. Clients that find none free wait in the pool.") {
		@lbPoolDiagram()
	}
	@docH2("cost", "What a connection costs")
	@docList(
		"Setting up: a TCP handshake, then a TLS handshake, each at least a network round trip, plus the TLS key exchange's CPU on both sides.",
		"Keeping: memory and a file descriptor on both ends. For Postgres, each connection is a separate server process with its own memory, and max_connections is 100 by default.",
		"Many clients each with their own pool multiply this: 20 replicas × a pool of 20 is 400 connections to one database.",
	)
	@docH2("http", "Pooling at an HTTP proxy")
	@docP() {
		An HTTP proxy has two sides. Clients keep their connections to it open (keep-alive), and it keeps its own idle connections to the backends, so a new request skips the handshakes on both. HAProxy reuses idle server connections safely by default, @docCodeWord("http-reuse safe"), Envoy keeps a connection pool per cluster, Traefik reuses through Go's HTTP transport, and NGINX needs to be told:
	}
	@docCode("nginx.conf", lbKeepaliveCode)
	@docP() {
		Breadboard's generated NGINX config has exactly this, @docCodeWord("keepalive 16"), so most re-encrypted requests reuse a TLS session to the backend.
	}
	@docH2("postgres", "Pooling Postgres")
	@docP() {
		PgBouncer speaks the Postgres protocol on both sides. Apps connect to it as if it were Postgres; it keeps a pool of real server connections per database and user, and lends one to a client while the client needs it. Postgres sees only PgBouncer's connections. In Breadboard it is a service with one Postgres upstream, and apps that use it receive the usual Postgres variables pointing at the pool:
	}
	@docCode("experiment.yaml", lbPoolSpec)
	@docH2("modes", "Session, transaction, statement")
	@docP() {
		The pool mode decides when a server connection goes back to the pool.
	}
	@docTable([]string{"Mode", "Returned", "Sharing", "Breaks"},
		[]string{"session", "when the client disconnects", "least", "nothing"},
		[]string{"transaction", "when a transaction ends", "most useful", "session state: SET, LISTEN, advisory locks, WITH HOLD cursors, SQL PREPARE"},
		[]string{"statement", "after each statement", "most", "multi-statement transactions too"},
	)
	@docP() {
		Session mode is PgBouncer's own default; Breadboard defaults to transaction mode, because that is where pooling pays off. Its trap is that two transactions from one client may run on different server connections: a @docCodeWord("SET statement_timeout") applies to whichever connection ran it, which may next serve another client. Protocol-level prepared statements, which drivers such as pgx use by default, do work: PgBouncer tracks them per client, up to @docCodeWord("max_prepared_statements") per connection, 200 by default since 1.24. The full list is PgBouncer's @extLink(pgbouncerDocs+"features.html") {
			feature map
		}&#46;
	}
	@docH2("sizing", "Sizing a pool")
	@docP() {
		A connection is busy for as long as each piece of work holds it. By Little's law, the connections needed are about the rate times the hold time: 500 transactions a second at 10 milliseconds each keep 5 connections busy. Add headroom for spikes, and stop there: beyond a few connections per CPU core, Postgres spends its time switching between them and contending for locks, and throughput falls. When the pool is too small, clients wait in PgBouncer instead of failing at Postgres's limit: @docCodeWord("SHOW POOLS") counts them in @docCodeWord("cl_waiting") and @docCodeWord("maxwait") shows the longest wait.
	}
	@docH2("where", "A shared pool or a sidecar")
	@docTable([]string{"", "Shared pool (service)", "Sidecar (per instance)"},
		[]string{"Server connections", "pool_size per database and user, for every app together", "pool_size per instance: replicas × pool_size"},
		[]string{"Hop to the pool", "TLS over the network", "loopback in the pod"},
		[]string{"Failure", "one pool for everyone: run more than one in production", "fails with its instance"},
		[]string{"In Breadboard", "type: pgbouncer with upstreams: [postgres]", "sidecars: - type: pgbouncer"},
	)
	@docP() {
		A shared pool caps the total the database sees, whatever the number of replicas; a sidecar keeps the pool close and independent, but the total grows with every instance. See @docLink("/docs/pgbouncer", "PgBouncer") and the sidecar's @docLink("/docs/sidecars/connection-pooling", "Connection pooling with PgBouncer")&#46;
	}
	@docH2("try", "Try it")
	@docStarters(stPoolModes, stPoolSidecar)
}

templ lbPoolDiagram() {
	<svg viewBox="0 0 900 200" width="900" class="mx-auto block h-auto max-w-full" role="img" aria-label="Three apps with many client connections reach a shared PgBouncer on port 6432; it keeps five server connections to Postgres and queues the rest">
		<defs>
			<marker id="pl-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0 L8 4 L0 8 z" class="fill-slate-400"></path></marker>
		</defs>
		for i, y := range []int{20, 80, 140} {
			<rect x="20" y={ itoa(y) } width="170" height="44" rx="8" class="fill-slate-50 stroke-slate-200"></rect>
			<text x="34" y={ itoa(y + 27) } class="fill-slate-900 font-mono text-[13px]">orders-{ itoa(i + 1) }</text>
			for j := range 4 {
				<rect x={ itoa(120 + j*14) } y={ itoa(y + 12) } width="9" height="20" rx="2" class="fill-slate-300"></rect>
			}
			<line x1="190" y1={ itoa(y + 22) } x2="346" y2="100" stroke-width="2" marker-end="url(#pl-arrow)" class="stroke-slate-300"></line>
		}
		<text x="268" y="40" text-anchor="middle" class="fill-slate-500 text-[11px]">12 client connections, TLS</text>
		<rect x="350" y="50" width="220" height="100" rx="12" class="fill-indigo-50 stroke-indigo-200"></rect>
		<text x="366" y="76" class="fill-indigo-800 font-mono text-[13px] font-semibold">pool :6432</text>
		<text x="366" y="100" class="fill-indigo-800 text-[12px]">transaction mode</text>
		<text x="366" y="120" class="fill-indigo-800 text-[12px]">waiting clients queue here</text>
		<rect x="700" y="70" width="180" height="60" rx="10" class="fill-slate-50 stroke-slate-200"></rect>
		<text x="716" y="98" class="fill-slate-900 font-mono text-[13px] font-semibold">postgres</text>
		<text x="716" y="118" class="fill-slate-500 text-[11px]">sees 5 connections</text>
		<line x1="570" y1="100" x2="696" y2="100" stroke-width="2" marker-end="url(#pl-arrow)" class="stroke-slate-400"></line>
		<text x="633" y="90" text-anchor="middle" class="fill-slate-500 text-[12px]">5 × TLS :5432</text>
	</svg>
}
