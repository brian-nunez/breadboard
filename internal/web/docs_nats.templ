	<svg viewBox="0 0 640 156" class="w-full" role="img" aria-label="Services connecting to NATS over TLS 4222 with Core NATS subjects and JetStream streams">
		<rect x="20" y="24" width="150" height="44" rx="8" fill="#eef2ff" stroke="#6366f1"></rect>
		<text x="95" y="44" text-anchor="middle" font-size="12" font-weight="600" fill="#1e1b4b">Producers / Admins</text>
