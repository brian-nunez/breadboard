package web

// NATS & JetStream docs, written to the Kafka template (D-031, D-061).

func init() {
	registerTech(tech{
		ID:      "nats",
		Name:    "NATS",
		Tagline: "Lightweight subject-based messaging, request-reply, JetStream work queues, and reactive Key-Value stores over TLS.",
		Order:   59,
		Intro:   natsIntro(),
		GoodFit: []string{
			"Ultra-low-latency pub/sub with hierarchical wildcard subjects (* and >)",
			"Zero-config load balancing across worker replicas using queue groups",
			"Built-in synchronous request-reply RPC without HTTP boilerplate or load balancers",
			"JetStream durable work queues (delete on ack) and reactive Key-Value buckets with watch streams",
		},
		PoorFit: []string{
			"Multi-terabyte long-term event warehousing with partition-local ordering guarantees across dozens of brokers (use Kafka)",
			"Relational transactions, joins, and rich SQL queries (use Postgres)",
			"Full-text BM25 search and faceted aggregations (use OpenSearch)",
		},
		Diagram: natsDiagram(),
		Official: []link{
			{"NATS documentation", "https://docs.nats.io/"},
			{"nats.go Go client", "https://pkg.go.dev/github.com/nats-io/nats.go"},
			{"JetStream Go package", "https://pkg.go.dev/github.com/nats-io/nats.go/jetstream"},
			{"Core NATS concepts", "https://docs.nats.io/nats-concepts/core-nats"},
			{"JetStream persistence", "https://docs.nats.io/nats-concepts/jetstream"},
		},
		Starters: []string{"nats/core-pubsub-request-reply", "nats/jetstream-workqueue", "nats/jetstream-kv-watch"},
		Guides: []guide{
			{
				Slug: "core-messaging", Title: "Core NATS: subjects, queue groups, and request-reply", Summary: "At-most-once messaging with wildcards, load-balanced queue groups, and built-in RPC.",
				Starter:  "nats/core-pubsub-request-reply",
				Sections: []docSection{{"subjects", "Subjects and wildcards"}, {"queues", "Queue groups"}, {"reqreply", "Request-reply RPC"}},
				Body:     natsCoreGuide(),
			},
			{
				Slug: "jetstream-workqueues", Title: "JetStream streams and work queues", Summary: "Durable WorkQueue streams, message deduplication, pull consumers, Ack, and NakWithDelay.",
				Starter:  "nats/jetstream-workqueue",
				Sections: []docSection{{"workqueue", "WorkQueue retention vs Kafka"}, {"pull", "Durable pull consumers"}, {"retries", "Ack, NakWithDelay, and MaxDeliver"}},
				Body:     natsWorkQueueGuide(),
			},
			{
				Slug: "jetstream-kv", Title: "JetStream Key-Value and live watches", Summary: "Versioned distributed config, optimistic concurrency via revision checks, and push watches.",
				Starter:  "nats/jetstream-kv-watch",
				Sections: []docSection{{"buckets", "KV buckets on JetStream"}, {"cas", "Optimistic concurrency with Update"}, {"watch", "Reactive Watch without polling"}},
				Body:     natsKVGuide(),
			},
			{
				Slug: "in-breadboard", Title: "NATS in Breadboard", Summary: "TLS on 4222, token auth, config.jetstream, loopback monitoring, and the Streams & stats tab.",
				Sections: []docSection{{"tls", "TLS and token auth"}, {"env", "What your app receives"}, {"explore", "The Streams & stats tab"}},
				Body:     natsInBreadboardGuide(),
			},
		},
	})
}

const natsConnectCode = `// SSL_CERT_FILE is set by Breadboard, so tls:// verifies the lab CA automatically.
nc, err := nats.Connect(os.Getenv("NATS_URL"), nats.Token(os.Getenv("NATS_TOKEN")))
if err != nil {
    log.Fatal(err)
}
defer nc.Close()`

const natsCoreCode = `// Queue group: only one responder replica handles each request.
_, err := nc.QueueSubscribe("pricing.quote.*", "pricing-workers", func(m *nats.Msg) {
    _ = m.Respond([]byte("{\"price\":19.99}"))
})

// Request-reply: NATS creates an ephemeral _INBOX reply subject automatically.
reply, err := nc.Request("pricing.quote.us", []byte("sku-42"), 2*time.Second)`

const natsWorkQueueCode = `js, _ := jetstream.New(nc)
stream, _ := js.CreateOrUpdateStream(ctx, jetstream.StreamConfig{
    Name:      "JOBS",
    Subjects:  []string{"jobs.*"},
    Retention: jetstream.WorkQueuePolicy,
})
cons, _ := stream.CreateOrUpdateConsumer(ctx, jetstream.ConsumerConfig{
    Durable:    "job-workers",
    AckPolicy:  jetstream.AckExplicitPolicy,
    MaxDeliver: 3,
    AckWait:    5 * time.Second,
})
msgs, _ := cons.Fetch(5)
for msg := range msgs.Messages() {
    _ = msg.Ack() // Deletes the message from the WorkQueue stream.
}`

const natsKVCode = `js, _ := jetstream.New(nc)
kv, _ := js.CreateOrUpdateKeyValue(ctx, jetstream.KeyValueConfig{
    Bucket:  "flags",
    History: 5,
})
entry, _ := kv.Get(ctx, "flags.checkout")
// Update succeeds only if nobody modified the key since entry.Revision().
_, err := kv.Update(ctx, "flags.checkout", []byte("v2"), entry.Revision())`

const natsSpecYAML = `services:
  nats:
    type: nats
    config:
      jetstream: true    # true (default) enables persistence; false runs Core NATS only`

templ natsIntro() {
	<p>NATS is a single-binary, low-memory messaging and coordination system. At its core it provides ultra-fast, at-most-once subject-based pub/sub, queue groups, and request-reply RPC. Layered directly inside the same server, <strong>JetStream</strong> adds opt-in durable streams, work queues, and reactive Key-Value buckets.</p>
	<p>Compared to Kafka's partitioned commit log (where consumers track offsets and messages stay until retention expires), NATS shines for service-to-service messaging, work queues where acknowledged jobs disappear immediately, and lightweight coordination.</p>
}

