package web

// OpenSearch docs, written to the Kafka template (D-031, D-061).

func init() {
	registerTech(tech{
		ID:      "opensearch",
		Name:    "OpenSearch",
		Tagline: "Full-text search, inverted indexes, faceted aggregations, and read-model projections over verified HTTPS.",
		Order:   58,
		Intro:   opensearchIntro(),
		GoodFit: []string{
			"Full-text search with BM25 relevance ranking, stemming, and typo tolerance (fuzziness)",
			"Faceted filtering and multi-dimensional aggregations across structured catalog or event fields",
			"CQRS search read-models projected asynchronously from Postgres and Kafka",
			"Zero-downtime schema and mapping migrations using index aliases and _reindex",
		},
		PoorFit: []string{
			"Primary system of record requiring ACID transactions (use Postgres and project to OpenSearch)",
			"High-frequency counter mutations or sub-millisecond key-value caching (use Redis)",
			"Durable multi-consumer event streaming or replayable commit logs (use Kafka)",
		},
		Diagram: opensearchDiagram(),
		Official: []link{
			{"OpenSearch documentation", "https://opensearch.org/docs/latest/"},
			{"opensearch-go v5 client", "https://pkg.go.dev/github.com/opensearch-project/opensearch-go/v5"},
			{"Mapping and field types", "https://opensearch.org/docs/latest/field-types/"},
			{"Query DSL reference", "https://opensearch.org/docs/latest/query-dsl/"},
			{"Index aliases and reindexing", "https://opensearch.org/docs/latest/im-plugin/index-alias/"},
		},
		Guides: []guide{
			{
				Slug: "inverted-index", Title: "Inverted indexes and mappings", Summary: "How Lucene analyzes text vs keyword fields, why explicit mappings matter, and single-node shard health.",
				Sections: []docSection{{"inverted", "Inverted indexes"}, {"mappings", "text vs keyword fields"}, {"refresh", "Near-real-time refresh and shards"}},
				Body:     opensearchInvertedIndexGuide(),
			},
			{
				Slug: "queries-and-facets", Title: "Queries, filters, and aggregations", Summary: "Separating BM25 scoring (must) from cached filters (filter) and computing faceted buckets.",
				Sections: []docSection{{"context", "Query vs filter context"}, {"facets", "Faceted aggregations"}, {"errors", "Handling partial bulk errors in v5"}},
				Body:     opensearchQueriesGuide(),
			},
			{
				Slug: "cdc-and-aliases", Title: "Syncing from Postgres and zero-downtime reindexing", Summary: "Projecting database writes through Kafka into OpenSearch and migrating immutable mappings with aliases.",
				Sections: []docSection{{"cqrs", "Postgres to Kafka to OpenSearch"}, {"aliases", "Atomic alias swaps and _reindex"}},
				Body:     opensearchCDCAliasGuide(),
			},
			{
				Slug: "in-breadboard", Title: "OpenSearch in Breadboard", Summary: "Single-node TLS on 9200, loopback transport, generated admin password, and the Indices explorer.",
				Sections: []docSection{{"tls", "TLS on HTTP and loopback transport"}, {"env", "What your app receives"}, {"explore", "The Indices tab"}},
				Body:     opensearchInBreadboardGuide(),
			},
		},
	})
}

const opensearchClientCode = `// SSL_CERT_FILE is set by Breadboard, so Go's default TLS transport
// verifies OpenSearch's lab certificate automatically.
client, err := opensearchapi.NewClient(opensearchapi.Config{
    Client: opensearch.Config{
        Addresses: []string{os.Getenv("OPENSEARCH_URL")},
        Username:  os.Getenv("OPENSEARCH_USER"),
        Password:  os.Getenv("OPENSEARCH_PASSWORD"),
    },
})
info, err := client.Info(ctx, nil)`

const opensearchMappingCode = `{
  "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
  "mappings": {
    "properties": {
      "make":             { "type": "keyword" },
      "model":            { "type": "text", "fields": { "keyword": { "type": "keyword" } } },
      "city":             { "type": "keyword" },
      "model_year":       { "type": "integer" },
      "electric_range":   { "type": "integer" },
      "electric_utility": { "type": "text" }
    }
  }
}`

const opensearchQueryCode = `{
  "query": {
    "bool": {
      "must": [
        { "multi_match": { "query": "tesla model", "fields": ["make^2", "model^3", "electric_utility"], "fuzziness": "AUTO" } }
      ],
      "filter": [
        { "term":  { "ev_type": "Battery Electric Vehicle (BEV)" } },
        { "range": { "electric_range": { "gte": 200 } } }
      ]
    }
  },
  "aggs": {
    "by_make": { "terms": { "field": "make", "size": 10 } }
  }
}`

const opensearchAliasSwapCode = `{
  "actions": [
    { "remove": { "index": "ev-catalog-v1", "alias": "ev-catalog" } },
    { "add":    { "index": "ev-catalog-v2", "alias": "ev-catalog" } }
  ]
}`

const opensearchSpecYAML = `services:
  opensearch:
    type: opensearch
    config:
      indices: ev-vehicles   # optional comma-separated indices created at startup
    host: true               # REST API at https://opensearch.<experiment>.localhost:<port>`

templ opensearchIntro() {
	<p>OpenSearch is a distributed search and analytics engine built on Apache Lucene. Instead of scanning rows sequentially, it builds inverted indexes that map every analyzed token to the documents containing it, pairing full-text BM25 ranking with structured filters and aggregations.</p>
	<p>In production architectures, OpenSearch almost always sits beside a transactional database like Postgres: the database remains the source of truth while an asynchronous projection (often through Kafka) keeps search indices up to date.</p>
}

