package web

// OpenTelemetry (LGTM) docs, written to the Kafka template (D-031, D-061).

func init() {
	registerTech(tech{
		ID:      "otel",
		Name:    "OpenTelemetry (LGTM)",
		Tagline: "Correlated traces, metrics, and logs over OTLP TLS with Grafana.",
		Order:   55,
		Intro:   otelIntro(),
		GoodFit: []string{
			"Following a single request across HTTP services, databases, and async queues",
			"Measuring request rates, error rates, and p95/p99 latency per service and replica",
			"Collecting structured slog records correlated with trace_id and span_id",
			"Learning standard OpenTelemetry SDK instrumentation without vendor lock-in",
		},
		PoorFit: []string{
			"Business analytics or long-term warehousing (use Postgres or an OLAP store)",
			"Application messaging or event delivery (use Kafka)",
			"Unbounded high-cardinality attributes like user_id or order_id as metric labels",
		},
		Diagram: otelDiagram(),
		Official: []link{
			{"OpenTelemetry Go documentation", "https://opentelemetry.io/docs/languages/go/"},
			{"OpenTelemetry Go SDK packages", "https://pkg.go.dev/go.opentelemetry.io/otel"},
			{"otelhttp instrumentation", "https://pkg.go.dev/go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp"},
			{"otelslog log bridge", "https://pkg.go.dev/go.opentelemetry.io/contrib/bridges/otelslog"},
			{"Grafana docker-otel-lgtm", "https://github.com/grafana/docker-otel-lgtm"},
		},
		Starters: []string{"otel/traces", "otel/metrics", "otel/logs", "otel/multi-service"},
		Guides: []guide{
			{
				Slug: "traces", Title: "Traces and context propagation", Summary: "W3C traceparent across HTTP hops, child spans, and error recording.",
				Starter:  "otel/traces",
				Sections: []docSection{{"spans", "Spans and trace trees"}, {"propagation", "Context propagation with otelhttp"}, {"errors", "Recording errors"}, {"run", "Run it"}},
				Body:     otelTracesGuide(),
			},
			{
				Slug: "metrics", Title: "Metrics and RED signals", Summary: "Counters, UpDownCounters, explicit-bucket histograms, and Go runtime metrics.",
				Starter:  "otel/metrics",
				Sections: []docSection{{"instruments", "Choosing an instrument"}, {"buckets", "Histograms and buckets"}, {"instances", "Multi-replica identity"}, {"cardinality", "Avoiding cardinality traps"}},
				Body:     otelMetricsGuide(),
			},
			{
				Slug: "logs", Title: "Structured logs with otelslog", Summary: "Bridging Go's log/slog into OTLP and Loki without regex parsing.",
				Starter:  "otel/logs",
				Sections: []docSection{{"bridge", "Bridging log/slog"}, {"attributes", "Structured attributes and severity"}, {"query", "Querying in Loki"}},
				Body:     otelLogsGuide(),
			},
			{
				Slug: "correlation", Title: "Correlating all three signals", Summary: "Joining HTTP, Postgres, and async Kafka hops into one trace with linked logs and metrics.",
				Starter:  "otel/multi-service",
				Sections: []docSection{{"async", "Propagating context over Kafka headers"}, {"log-link", "Automatic trace_id in otelslog"}, {"workflow", "Debugging from metric to trace to log"}},
				Body:     otelCorrelationGuide(),
			},
			{
				Slug: "in-breadboard", Title: "OpenTelemetry in Breadboard", Summary: "Selective LGTM signals, OTLP TLS, Grafana host access, and env vars.",
				Sections: []docSection{{"lgtm", "One LGTM container, selective backends"}, {"tls", "TLS on OTLP and Grafana, loopback for storage"}, {"env", "What your app receives"}, {"explore", "The Telemetry tab"}},
				Body:     otelInBreadboard(),
			},
		},
	})
}

const otelTraceInitCode = `// WithEndpointURL uses TLS automatically for https:// endpoints and reads SSL_CERT_FILE.
exp, err := otlptracegrpc.New(ctx, otlptracegrpc.WithEndpointURL(os.Getenv("OTEL_EXPORTER_OTLP_ENDPOINT")))
tp := sdktrace.NewTracerProvider(sdktrace.WithBatcher(exp), sdktrace.WithResource(res))
otel.SetTracerProvider(tp)
otel.SetTextMapPropagator(propagation.NewCompositeTextMapPropagator(
    propagation.TraceContext{},
    propagation.Baggage{},
))`

const otelHTTPCode = `// Server: extracts traceparent and opens a server span per request.
srv := &http.Server{
    Addr:    ":8443",
    Handler: otelhttp.NewHandler(mux, "orders"),
}

// Client: creates a client span and injects traceparent into outbound headers.
client := &http.Client{
    Transport: otelhttp.NewTransport(http.DefaultTransport),
}`

const otelMetricsCode = `ordersTotal, _ := meter.Int64Counter("orders_processed", metric.WithUnit("{order}"))
inFlight, _ := meter.Int64UpDownCounter("orders_in_flight", metric.WithUnit("{order}"))
duration, _ := meter.Float64Histogram("order_duration_seconds",
    metric.WithUnit("s"),
    metric.WithExplicitBucketBoundaries(0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1.0),
)

// Export Go runtime GC, goroutine, and heap metrics automatically.
_ = runtime.Start(runtime.WithMinimumReadMemStatsInterval(time.Second))`

const otelLogsCode = `exp, _ := otlploggrpc.New(ctx, otlploggrpc.WithEndpointURL(os.Getenv("OTEL_EXPORTER_OTLP_ENDPOINT")))
lp := sdklog.NewLoggerProvider(sdklog.WithProcessor(sdklog.NewBatchProcessor(exp)), sdklog.WithResource(res))
otellogglobal.SetLoggerProvider(lp)

logger := otelslog.NewLogger("otel-log-api")
logger.InfoContext(r.Context(), "received job", "request_id", reqID, "customer", customer)`

const otelKafkaPropCode = `// Producer: inject the active traceparent into Kafka record headers.
var headers kafkaHeaders
otel.GetTextMapPropagator().Inject(pubCtx, &headers)
rec := &kgo.Record{Topic: "obs-orders", Key: []byte(customer), Value: payload, Headers: headers}

// Consumer: extract traceparent so the worker span joins the upstream trace.
headers := kafkaHeaders(r.Headers)
parentCtx := otel.GetTextMapPropagator().Extract(ctx, &headers)
spanCtx, span := tracer.Start(parentCtx, "kafka.consume", trace.WithSpanKind(trace.SpanKindConsumer))`

const otelSpecYAML = `services:
  otel:
    type: otel
    config:
      signals: traces        # logs, metrics, traces (comma-separated)
    host: true               # Grafana at https://otel.<experiment>.localhost:<port>`

templ otelIntro() {
	@docP() {
		OpenTelemetry is a vendor-neutral standard for collecting three telemetry signals—traces, metrics, and logs—over one wire protocol (OTLP). Breadboard pairs the official OpenTelemetry Go SDKs with Grafana's LGTM backend (Loki, Grafana, Tempo, and Prometheus) in a single container, enabling only the backends your experiment asks for.
	}
	@docP() {
		Your apps talk to the collector over verified TLS on ports 4317 (gRPC) and 4318 (HTTP), while Grafana serves over HTTPS on 3000 with pre-wired datasources and cross-signal links.
	}
}

