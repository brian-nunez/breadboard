templ otelTracesGuide() {
	@docLead() {
		A trace is a tree of spans sharing one trace ID across every process a request touches. Each span records a start time, duration, attributes, events, and an OK or Error status.
	}
	@docH2("spans", "Spans and trace trees")
	@docP() {
		Configure a @docCodeWord("TracerProvider") with an OTLP gRPC exporter and a shared resource carrying @docCodeWord("service.name") and @docCodeWord("service.instance.id")&#46; Always register the W3C @docCodeWord("TraceContext") propagator and call @docCodeWord("tp.Shutdown") before exit so buffered batches flush.
	}
	@docCode("initTracer", otelTraceInitCode)
	@docH2("propagation", "Context propagation with otelhttp")
	@docP() {
		Wrapping servers with @docCodeWord("otelhttp.NewHandler") and clients with @docCodeWord("otelhttp.NewTransport") automatically extracts and injects the W3C @docCodeWord("traceparent") header across HTTPS hops.
	}
	@docCode("HTTP instrumentation", otelHTTPCode)
	@docH2("errors", "Recording errors")
	@docP() {
		Call @docCodeWord("span.RecordError(err)") and @docCodeWord("span.SetStatus(codes.Error, msg)") on failing spans so Tempo highlights the exact downstream service that failed instead of only showing a 500 at the edge.
	}
	@docH2("run", "Run it")
	@docTerminal("bb starter otel/traces", "bb up", "bb status")
}

templ otelMetricsGuide() {
	@docLead() {
		Metrics aggregate counts, concurrency, and latency distributions over time so you can spot error spikes and slow replicas at a glance.
	}
	@docH2("instruments", "Choosing an instrument")
	@docList(
		"Counter (Int64Counter): monotonically increasing totals like orders_processed; query with rate().",
		"UpDownCounter (Int64UpDownCounter): values that go up and down, such as orders_in_flight.",
		"Histogram (Float64Histogram): distributions like request latency; query percentiles with histogram_quantile().",
	)
	@docCode("instruments", otelMetricsCode)
	@docH2("buckets", "Histograms and buckets")
	@docP() {
		Always set explicit bucket boundaries around your service's real latency SLOs (for example 10 ms to 1 s) so p95 and p99 estimates stay accurate.
	}
	@docH2("instances", "Multi-replica identity")
	@docP() {
		When an app runs with @docCodeWord("replicas: 2")&#44; give every replica the same @docCodeWord("service.name") and set @docCodeWord("service.instance.id") to @docCodeWord("BB_SERVICE") — such as @docCodeWord("otel-metrics-api-1") and @docCodeWord("otel-metrics-api-2")&#46; Prometheus promotes both into labels.
	}
	@docH2("cardinality", "Avoiding cardinality traps")
	@docP() {
		Keep metric attribute values bounded (status, tier, method). Unbounded identifiers like @docCodeWord("order_id") or @docCodeWord("trace_id") belong on spans and logs, never as metric labels.
	}
}

templ otelLogsGuide() {
	@docLead() {
		Instead of writing ad-hoc text lines to stdout and parsing them later with regexes, bridge Go's standard @docCodeWord("log/slog") straight into OpenTelemetry Logs.
	}
	@docH2("bridge", "Bridging log/slog")
	@docP() {
		@docCodeWord("otelslog.NewLogger") returns a standard @docCodeWord("*slog.Logger") backed by your @docCodeWord("LoggerProvider")&#46; Every @docCodeWord("InfoContext")&#44; @docCodeWord("WarnContext")&#44; and @docCodeWord("ErrorContext") call emits a structured OTLP log record to Loki.
	}
	@docCode("otelslog", otelLogsCode)
	@docH2("attributes", "Structured attributes and severity")
	@docP() {
		Key-value pairs passed to @docCodeWord("slog") arrive as structured metadata in Loki, and severity levels map directly to @docCodeWord("INFO")&#44; @docCodeWord("WARN")&#44; and @docCodeWord("ERROR")&#46;
	}
	@docH2("query", "Querying in Loki")
	@docP() {
		Filter across all services in one timeline with LogQL, for example @docCodeWord(`{service_name=~"otel-log-.+"} | request_id="req-5"`)&#46;
	}
}

templ otelCorrelationGuide() {
	@docLead() {
		Logs, metrics, and traces are strongest when linked: a metric spike tells you something is wrong, a trace shows which hop slowed down or failed, and correlated logs explain why.
	}
	@docH2("async", "Propagating context over Kafka headers")
	@docP() {
		HTTP libraries propagate @docCodeWord("traceparent") automatically through @docCodeWord("otelhttp")&#46; Across an async broker like Kafka, inject the active context into the record headers on produce and extract it on consume so the worker's span stays attached to the caller's trace.
	}
	@docCode("Kafka context propagation", otelKafkaPropCode)
	@docH2("log-link", "Automatic trace_id in otelslog")
	@docP() {
		Because @docCodeWord("otelslog") reads the @docCodeWord("context.Context") passed to @docCodeWord("InfoContext") and @docCodeWord("ErrorContext")&#44; it attaches the active @docCodeWord("trace_id") and @docCodeWord("span_id") to every log record automatically. Breadboard pre-wires Tempo's @docCodeWord("tracesToLogsV2") and Loki's derived fields so you can jump between them in one click.
	}
	@docH2("workflow", "Debugging from metric to trace to log")
	@docTerminal("bb starter otel/multi-service", "bb up", "bb status")
}

templ otelInBreadboard() {
	@docLead() {
		What Breadboard runs when you add @docCodeWord("otel")&#44; how selective signals work, and what your apps receive.
	}
	@docH2("lgtm", "One LGTM container, selective backends")
	@docP() {
		The @docCodeWord("otel") catalog entry runs the pinned @docCodeWord("grafana/otel-lgtm:0.41.1") image. Set @docCodeWord("config.signals") to any comma-separated subset of @docCodeWord("logs")&#44; @docCodeWord("metrics")&#44; and @docCodeWord("traces") — all three are enabled by default. Breadboard generates a collector config and launcher that start only the backends you asked for; Pyroscope is not started.
	}
	@docCode("experiment.yaml", otelSpecYAML)
	@docP() {
		You can also configure signals from the CLI with @docCodeWord("bb add otel --config signals=traces,metrics")&#46; When you apply a second @docCodeWord("otel/*") starter to the same lab, Breadboard unions its required signals into the existing @docCodeWord("otel") service.
	}
	@docH2("tls", "TLS on OTLP and Grafana, loopback for storage")
	@docP() {
		The collector listens over TLS on OTLP gRPC @docCodeWord("4317") and OTLP HTTP @docCodeWord("4318")&#44; and Grafana serves HTTPS on @docCodeWord("3000") with a generated password in @docCodeWord(".bb/secrets.json") via @docCodeWord("bb creds otel")&#46; Loki on @docCodeWord("3100")&#44; Tempo on @docCodeWord("3200")&#44; and Prometheus on @docCodeWord("9090") bind strictly to @docCodeWord("127.0.0.1") inside the container. Setting @docCodeWord("host: true") exposes Grafana at @docCodeWord("https://otel.<experiment>.localhost:<port>")&#46;
	}
	@docH2("env", "What your app receives")
	@docList(
		"OTEL_EXPORTER_OTLP_ENDPOINT: https://otel.<domain>:4317 (OTLP gRPC over TLS).",
		"OTEL_EXPORTER_OTLP_HTTP_ENDPOINT: https://otel.<domain>:4318 (OTLP HTTP over TLS).",
		"OTEL_EXPORTER_OTLP_PROTOCOL: grpc.",
		"OTEL_EXPORTER_OTLP_CERTIFICATE: /etc/bb/ca.pem (plus SSL_CERT_FILE for Go's TLS stack).",
		"OTEL_TRACES_EXPORTER, OTEL_METRICS_EXPORTER, OTEL_LOGS_EXPORTER: otlp when enabled, none when disabled.",
		"GRAFANA_URL, GRAFANA_USER, GRAFANA_PASSWORD: Grafana HTTPS address and generated admin login.",
	)
	@docH2("explore", "The Telemetry tab")
	@docP() {
		The service page's Telemetry tab reads Tempo, Prometheus, and Loki over loopback inside the container via @docCodeWord("docker exec"), showing only the signals currently enabled on that service.
	}
}
