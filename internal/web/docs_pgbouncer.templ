package web

// PgBouncer docs, the shared pool service (Phase 5, wave C; D-157, D-158).
// The PgBouncer sidecar is covered in docs_sidecars.templ. Config excerpts
// are the generated pgbouncer.ini and pgbouncer_hba.conf (internal/catalog/
// pgbouncer.go, compose golden pgbouncer-infra.golden); settings follow the
// PgBouncer 1.26 documentation.

func init() {
	registerTech(tech{
		ID:      "pgbouncer",
		Name:    "PgBouncer",
		Tagline: "A lightweight Postgres connection pool: many client connections share a few server connections.",
		Order:   75,
		Intro:   pgbouncerIntro(),
		GoodFit: []string{"Many app instances against one Postgres", "Many short or mostly idle connections", "Protecting max_connections during spikes", "Pausing traffic while Postgres restarts"},
		PoorFit: []string{"Apps that rely on session state, in transaction mode", "Routing reads and writes to different servers (it does not parse SQL)", "One app with one small, steady pool of its own"},
		Diagram: lbPoolDiagram(),
		Official: []link{
			{"PgBouncer documentation", pgbouncerDocs},
			{"PgBouncer: configuration", pgbouncerDocs + "config.html"},
			{"PgBouncer: usage and admin console", pgbouncerDocs + "usage.html"},
			{"PgBouncer: features by pool mode", pgbouncerDocs + "features.html"},
		},
		Starters: []string{stPoolModes.URL, stPoolSidecar.URL},
		Guides: []guide{
			{
				Slug: "config-anatomy", Title: "Anatomy of pgbouncer.ini", Summary: "Databases, client and server TLS, auth, pool mode and size.",
				Starter:  stPoolModes.URL,
				Sections: []docSection{{"sections", "Two sections and an HBA file"}, {"databases", "[databases]"}, {"clients", "Clients and TLS"}, {"auth", "Authentication"}, {"servers", "Server connections"}, {"pool", "Pool mode and size"}, {"admin", "The admin console"}, {"change", "Changing it"}},
				Body:     pgbouncerAnatomy(),
			},
			{
				Slug: "in-breadboard", Title: "PgBouncer in Breadboard", Summary: "One Postgres upstream, config keys, credentials, the pools tab.",
				Sections: []docSection{{"image", "Image and limits"}, {"declare", "Declaring a pool"}, {"modes", "TLS to Postgres"}, {"creds", "Credentials"}, {"env", "What your app receives"}, {"see", "Seeing it work"}, {"own", "Owning the config"}},
				Body:     pgbouncerInBreadboard(),
			},
		},
	})
}

const pgbouncerDatabasesCode = `[databases]
; postgres over TLS, verified as postgres.bb.internal (server_tls_sslmode).
app = host=postgres.bb.internal port=5432 dbname=app`

const pgbouncerClientsCode = `[pgbouncer]
listen_addr = *
listen_port = 6432
; No Unix socket: every client, the admin console included, uses TCP and TLS.
unix_socket_dir =

; Clients: TLS required, with this service's certificate.
client_tls_sslmode = require
client_tls_cert_file = /etc/bb/tls/tls.crt
client_tls_key_file = /etc/bb/tls/tls.key
client_tls_protocols = tlsv1.2,tlsv1.3`

const pgbouncerAuthCode = `; Who may log in, and from where: see pgbouncer_hba.conf.
auth_type = hba
auth_hba_file = /etc/bb/config/pgbouncer_hba.conf
auth_file = /tmp/pgbouncer/userlist.txt`

const pgbouncerHBACode = `# Generated by Breadboard. First matching line wins.
# TYPE   DATABASE  USER ADDRESS       METHOD
# The admin console: from inside the container only (bb explore, docker exec).
hostssl  pgbouncer all  127.0.0.1/32  scram-sha-256
host     pgbouncer all  all           reject
# Apps: TLS (client_tls_sslmode = require) and SCRAM.
hostssl  all       all  all           scram-sha-256`

const pgbouncerServersCode = `; Server connections to Postgres.
; TLS, verifying the certificate and the host name against the lab CA.
server_tls_sslmode = verify-full
server_tls_ca_file = /etc/bb/ca.pem
server_tls_protocols = tlsv1.2,tlsv1.3`

const pgbouncerPoolCode = `pool_mode = transaction
; Server connections per database and user. Every app logs in as the same
; role, so they all share this one pool.
default_pool_size = 5
max_client_conn = 200
; Drivers send this; PgBouncer would otherwise refuse the connection.
ignore_startup_parameters = extra_float_digits`

const pgbouncerAdminCode = `admin_users = app
stats_users = app
log_connections = 1
log_disconnections = 1`

const pgbouncerConsoleCode = `SHOW POOLS;     -- per database and user: cl_active, cl_waiting, sv_active, sv_idle, sv_used, maxwait
SHOW STATS;     -- totals and averages: transactions, queries, bytes, wait time
SHOW SERVERS;   -- each server connection and its state
PAUSE app;      -- let current transactions finish, then hold new ones
RESUME app;`

const pgbouncerSpecCode = `services:
  postgres:
    type: postgres
  pool:
    type: pgbouncer
    config:
      pool_mode: transaction   # session, transaction or statement (default transaction)
      pool_size: 5             # server connections per database and user, 1 to 1000 (default 10)
    upstreams: [postgres]      # exactly one postgres; tls.mode on (default) or off
apps:
  orders:
    path: ./orders
    uses: [pool]`

templ pgbouncerIntro() {
	@docP() {
		PgBouncer is a connection pooler for PostgreSQL. It speaks the Postgres protocol on both sides: apps connect to it as if it were the database, and it keeps a small pool of real connections to Postgres that it lends out. One single-threaded, event-driven process handles thousands of client connections in a few megabytes.
	}
	@docP() {
		It exists because Postgres connections are expensive: each one is a server process with its own memory, and @docCodeWord("max_connections") defaults to 100. Apps open connections freely, one pool per instance and often more than they use, so a fleet of instances can exhaust the database while most connections sit idle. PgBouncer turns hundreds of client connections into the handful the database actually needs at once.
	}
	@docP() {
		Choose it in front of a Postgres that many instances, workers or short-lived processes connect to. The price is the pool mode: in transaction mode, which gives the most sharing, session state does not survive between transactions. In Breadboard it runs as this shared service and as a @docLink("/docs/sidecars/connection-pooling", "sidecar") beside one app.
	}
}

templ pgbouncerAnatomy() {
	@docLead() {
		Breadboard generates a commented @docCodeWord("pgbouncer.ini") and a @docCodeWord("pgbouncer_hba.conf") per PgBouncer service. These are their parts, for a service named pool in front of postgres with @docCodeWord("pool_size: 5")&#46;
	}
	@docH2("sections", "Two sections and an HBA file")
	@docList(
		"[databases] maps the database names clients ask for to real servers.",
		"[pgbouncer] holds everything else: listening, TLS, authentication, pooling, logging.",
		"pgbouncer_hba.conf works like Postgres's pg_hba.conf: who may connect to which database, from where, and how they authenticate.",
	)
	@docH2("databases", "[databases]")
	@docCode("pgbouncer.ini", pgbouncerDatabasesCode)
	@docP() {
		A client that asks for database @docCodeWord("app") gets a server connection to @docCodeWord("app") on the Postgres service, the database named by its @docCodeWord("config.database")&#46; The host is the service's name, so @docCodeWord("verify-full") can check it on the certificate.
	}
	@docH2("clients", "Clients and TLS")
	@docCode("pgbouncer.ini", pgbouncerClientsCode)
	@docP() {
		Apps connect over TCP to 6432 and must use TLS: @docCodeWord("client_tls_sslmode = require") refuses plaintext. There is no Unix socket, so even the admin console goes through TCP and TLS.
	}
	@docH2("auth", "Authentication")
	@docCode("pgbouncer.ini", pgbouncerAuthCode)
	@docCode("pgbouncer_hba.conf", pgbouncerHBACode)
	@docList(
		"auth_type = hba hands the decision to the HBA file. The first matching line wins.",
		"The admin console (the virtual database pgbouncer) is accepted from 127.0.0.1 only, so only docker exec inside the container reaches it.",
		"Apps need TLS and SCRAM.",
		"auth_file lists the role and its password. It is written at start, with umask 077, from the container's environment, so no generated file holds the password.",
	)
	@docH2("servers", "Server connections")
	@docCode("pgbouncer.ini", pgbouncerServersCode)
	@docP() {
		With @docCodeWord("tls.mode: on"), the default, PgBouncer connects to Postgres with TLS and checks the certificate and host name against the lab CA. With @docCodeWord("tls.mode: off") and a reason, it connects to @docCodeWord("postgres.plain.<domain>") on the Postgres segment with @docCodeWord("server_tls_sslmode = disable"), and Postgres's @docCodeWord("hostnossl") line for that segment admits it.
	}
	@docH2("pool", "Pool mode and size")
	@docCode("pgbouncer.ini", pgbouncerPoolCode)
	@docList(
		"pool_mode decides when a server connection returns to the pool: session (at disconnect, PgBouncer's own default), transaction (at the end of each transaction, Breadboard's default) or statement (after each statement).",
		"default_pool_size is the number of server connections per database and user pair. Every app of this pool logs in as the same role, so they share one pool.",
		"max_client_conn = 200 caps client connections in total; clients beyond the pool size wait for a server connection.",
		"Protocol-level prepared statements work in transaction mode: PgBouncer tracks them per client, up to max_prepared_statements (200 by default since 1.24). SQL PREPARE, SET, LISTEN, session advisory locks and WITH HOLD cursors do not.",
	)
	@docP() {
		@docLink("/docs/load-balancing/connection-pooling", "Connection pooling") explains how to choose a mode and a size.
	}
	@docH2("admin", "The admin console")
	@docCode("pgbouncer.ini", pgbouncerAdminCode)
	@docP() {
		The admin and stats users are the application role, so the console accepts it from loopback. It is SQL-like:
	}
	@docCode("psql pgbouncer", pgbouncerConsoleCode)
	@docH2("change", "Changing it")
	@docList(
		"Most changes need no file: config.pool_mode and config.pool_size are spec keys.",
		"reserve_pool_size and reserve_pool_timeout add a few extra connections for a pool whose clients have waited too long.",
		"query_wait_timeout (120 s by default) drops a client that waited that long for a server connection.",
		"server_idle_timeout and server_lifetime close server connections that sat idle or lived too long.",
		"Online restart with -R was removed in PgBouncer 1.26; use PAUSE and RESUME around a Postgres restart, or rolling restarts with so_reuseport.",
	)
}

templ pgbouncerInBreadboard() {
	@docLead() {
		What Breadboard runs for @docCodeWord("type: pgbouncer"): a pool shared by every app that uses it, in front of exactly one Postgres.
	}
	@docH2("image", "Image and limits")
	@docList(
		"Image edoburu/pgbouncer:v1.26.1-p0 (Alpine, runs as postgres, has psql and pg_isready), 64m of memory and 0.25 CPU.",
		"Listens on 6432 with TLS and the service's certificate. Its health check runs pg_isready on its own name with sslmode=verify-full.",
		"Config /etc/bb/config/pgbouncer.ini and pgbouncer_hba.conf, generated and commented. Logs, connections and disconnections included, go to bb logs <name>.",
	)
	@docH2("declare", "Declaring a pool")
	@docCode("experiment.yaml", pgbouncerSpecCode)
	@docList(
		"upstreams must name exactly one postgres service; validation refuses none, two, or any other type.",
		"bb add pgbouncer lists the experiment's Postgres as the upstream when there is exactly one; otherwise add the service with its upstream in experiment.yaml.",
		"No port, route name or passthrough: PgBouncer has one database server and speaks only Postgres.",
	)
	@docH2("modes", "TLS to Postgres")
	@docTable([]string{"tls.mode", "What the generated config does"},
		[]string{"on (default)", "host=<postgres>.<domain>, server_tls_sslmode = verify-full, server_tls_ca_file = /etc/bb/ca.pem"},
		[]string{"off + reason", "host=<postgres>.plain.<domain> on the Postgres segment, server_tls_sslmode = disable; reported as a plaintext edge"},
	)
	@docH2("creds", "Credentials")
	@docP() {
		Postgres provisions one application role per service, @docCodeWord("config.user") with its generated password, which every app of that Postgres receives. Apps of the pool log in as that same role, and PgBouncer uses it for its own server logins. The container gets the role and a reference to the password in @docCodeWord("BB_PG_USER") and @docCodeWord("BB_PG_PASSWORD"), and writes its auth file from them at start. No password is in @docCodeWord("experiment.yaml") or in a generated file.
	}
	@docH2("env", "What your app receives")
	@docP() {
		The Postgres names, so drivers work unchanged, pointing at the pool:
	}
	@docList(
		"DATABASE_URL=postgres://<user>:<password>@<name>.<domain>:6432/<db>?sslmode=verify-full",
		"PGHOST=<name>.<domain>, PGPORT=6432, PGUSER, PGPASSWORD, PGDATABASE",
		"PGSSLMODE=verify-full and PGSSLROOTCERT=/etc/bb/ca.pem: the app verifies the pool's certificate and name.",
		"An app that uses both the pool and Postgres gets the second set prefixed, as for two Postgres services.",
	)
	@docH2("see", "Seeing it work")
	@docList(
		"In bb serve, the service's PgBouncer pools tab runs SHOW POOLS and SHOW STATS: clients active and waiting, server connections active, idle and used, the longest wait. MCP clients use pgbouncer_pools.",
		"Postgres sees only the pool: pg_stat_activity shows at most pool_size connections for the role, all from the pool's address.",
	)
	@docTerminal(`docker exec -it bb-lab-pool-1 sh -c 'PGPASSWORD="$BB_PG_PASSWORD" psql "host=127.0.0.1 port=6432 dbname=pgbouncer user=$BB_PG_USER sslmode=require" -c "SHOW POOLS"'`)
	@docH2("own", "Owning the config")
	@docP() {
		The generated files are in @docCodeWord(".bb/runtime/config/<name>/")&#46; Copy @docCodeWord("pgbouncer.ini") next to @docCodeWord("experiment.yaml"), edit it, and set @docCodeWord("file:") on the service; it is copied in at every @docCodeWord("bb up")&#46; Keep the auth settings pointing at @docCodeWord("/etc/bb/config/pgbouncer_hba.conf") and @docCodeWord("/tmp/pgbouncer/userlist.txt"), keep the certificate paths, and put no password in the file.
	}
}
