package web

// Postgres docs, following the Kafka template (D-031, D-061).

func init() {
	registerTech(tech{
		ID:      "postgres",
		Name:    "Postgres",
		Tagline: "Relational database with strong consistency.",
		Order:   20,
		Intro:   postgresIntro(),
		GoodFit: []string{"The system of record for business data", "Data with relations and constraints", "Transactions across several rows or tables", "Ad-hoc queries and reporting"},
		PoorFit: []string{"Very high write rates spread across many machines", "Large binary files", "A cache in front of slow reads", "Fan-out event streams to many readers"},
		Diagram: postgresDiagram(),
		Official: []link{
			{"PostgreSQL documentation", "https://www.postgresql.org/docs/current/"},
			{"Concurrency control", "https://www.postgresql.org/docs/current/mvcc.html"},
			{"pgx client", "https://pkg.go.dev/github.com/jackc/pgx/v5"},
		},
		Starters: []string{"kafka/sink-to-postgres", "redis/cache-invalidation"},
		Guides: []guide{
			{
				Slug: "basic-usage", Title: "Connecting and querying", Summary: "Connect with pgx, write, and read rows back.",
				Starter:  "redis/cache-invalidation",
				Sections: []docSection{{"connect", "Connecting"}, {"handshake", "What happens on connect"}, {"query", "Writing and reading"}, {"protocol", "Prepared statements"}, {"pool", "One connection or a pool"}},
				Body:     postgresBasicUsage(),
			},
			{
				Slug: "transactions", Title: "Transactions and isolation", Summary: "MVCC and what each isolation level does.",
				Sections: []docSection{{"tx", "A transaction in pgx"}, {"mvcc", "Row versions, not read locks"}, {"read-committed", "Read Committed"}, {"stricter", "Repeatable Read and Serializable"}},
				Body:     postgresTransactions(),
			},
			{
				Slug: "upserts", Title: "Upserts and idempotent writes", Summary: "INSERT ... ON CONFLICT and its arbiter index.",
				Starter:  "kafka/sink-to-postgres",
				Sections: []docSection{{"conflict", "INSERT ... ON CONFLICT"}, {"arbiter", "The unique index decides"}, {"update", "Updating instead"}, {"sink", "Idempotence in the sink"}},
				Body:     postgresUpserts(),
			},
			{
				Slug: "indexes", Title: "Indexes and EXPLAIN", Summary: "B-trees, query plans, and how to read them.",
				Sections: []docSection{{"btree", "B-tree indexes"}, {"explain", "Reading EXPLAIN"}, {"analyze", "EXPLAIN ANALYZE"}, {"try", "Try it in Breadboard"}},
				Body:     postgresIndexes(),
			},
			{
				Slug: "in-breadboard", Title: "Postgres in Breadboard", Summary: "The image, roles, TLS, env vars.",
				Sections: []docSection{{"server", "One server, one app database"}, {"tls", "TLS only, verify-full"}, {"env", "What your app receives"}, {"plaintext", "A plaintext edge"}, {"tools", "Data and tools"}},
				Body:     postgresInBreadboard(),
			},
		},
	})
}

const pgConnectCode = `db, err := pgx.Connect(ctx, os.Getenv("DATABASE_URL"))
if err != nil {
    log.Fatal(err)
}
defer db.Close(ctx)`

const pgExecCode = `if _, err := db.Exec(ctx, ` + "`" + `CREATE TABLE IF NOT EXISTS products (id text PRIMARY KEY, price_cents integer NOT NULL)` + "`" + `); err != nil {
    log.Fatal(err)
}
// ...
if _, err := db.Exec(ctx, ` + "`" + `UPDATE products SET price_cents = $2 WHERE id = $1` + "`" + `, id, price); err != nil {
    log.Fatal(err)
}`

const pgQueryRowCode = `// Scan returns pgx.ErrNoRows when the query finds nothing.
if err := db.QueryRow(ctx, ` + "`" + `SELECT price_cents FROM products WHERE id = $1` + "`" + `, id).Scan(&price); err != nil {
    return 0, false, err
}`

const pgQueryCode = `rows, err := db.Query(ctx, ` + "`" + `SELECT id, price_cents FROM products ORDER BY id` + "`" + `)
if err != nil {
    return err
}
defer rows.Close()
for rows.Next() {
    var id string
    var price int
    if err := rows.Scan(&id, &price); err != nil {
        return err
    }
    log.Printf("%s costs %d", id, price)
}
// Next returns false at the end and on an error: Err says which.
return rows.Err()`

const pgPoolCode = `// A pool is safe to share between goroutines. Each call borrows a
// connection, runs, and gives it back.
pool, err := pgxpool.New(ctx, os.Getenv("DATABASE_URL"))
if err != nil {
    log.Fatal(err)
}
defer pool.Close()`

const pgTxCode = `tx, err := db.Begin(ctx)
if err != nil {
    return err
}
// After Commit, Rollback only returns ErrTxClosed, so deferring it is always safe.
defer tx.Rollback(ctx)

if _, err := tx.Exec(ctx, ` + "`" + `UPDATE accounts SET balance = balance - $2 WHERE id = $1` + "`" + `, from, amount); err != nil {
    return err
}
if _, err := tx.Exec(ctx, ` + "`" + `UPDATE accounts SET balance = balance + $2 WHERE id = $1` + "`" + `, to, amount); err != nil {
    return err
}
return tx.Commit(ctx)`

const pgSerializableCode = `tx, err := db.BeginTx(ctx, pgx.TxOptions{IsoLevel: pgx.Serializable})
// ... reads and writes, then Commit ...

// Any statement, or the Commit itself, can fail with SQLSTATE 40001.
var pgErr *pgconn.PgError
if errors.As(err, &pgErr) && pgErr.Code == "40001" {
    // Roll back and run the whole transaction again from the start.
}`

const pgSinkUpsertCode = `// The primary key makes the insert idempotent: a redelivered event
// (after a crash before the commit below) inserts nothing.
tag, err := db.Exec(ctx,
    ` + "`" + `INSERT INTO orders (id, customer, amount_cents) VALUES ($1, $2, $3) ON CONFLICT (id) DO NOTHING` + "`" + `,
    o.ID, o.Customer, o.AmountCents)
switch {
case err != nil:
    log.Fatal(err) // exit without committing; the record is read again after restart
case tag.RowsAffected() == 0:
    log.Printf("duplicate id=%s", o.ID)
default:
    log.Printf("stored id=%s", o.ID)
}`

const pgSinkTableCode = `CREATE TABLE IF NOT EXISTS orders (
    id           text PRIMARY KEY,
    customer     text NOT NULL,
    amount_cents integer NOT NULL,
    stored_at    timestamptz NOT NULL DEFAULT now()
)`

const pgDoUpdateCode = `-- Insert the product, or set its price if the id already exists.
-- EXCLUDED is the row that was proposed for insertion.
INSERT INTO products (id, price_cents) VALUES ($1, $2)
ON CONFLICT (id) DO UPDATE SET price_cents = EXCLUDED.price_cents`

const pgSeedCode = `for _, id := range products {
    if _, err := db.Exec(ctx, ` + "`" + `INSERT INTO products VALUES ($1, 100) ON CONFLICT (id) DO NOTHING` + "`" + `, id); err != nil {
        log.Fatal(err)
    }
}`

const pgExplainDocsCode = `-- From the PostgreSQL manual's EXPLAIN chapter:
EXPLAIN SELECT * FROM tenk1;
 Seq Scan on tenk1  (cost=0.00..445.00 rows=10000 width=244)

EXPLAIN SELECT * FROM tenk1 WHERE unique1 = 42;
 Index Scan using tenk1_unique1 on tenk1  (cost=0.29..8.30 rows=1 width=244)
   Index Cond: (unique1 = 42)`

const pgExplainTryCode = `-- 100,000 rows, no index yet.
CREATE TABLE events AS
  SELECT g AS id, md5(g::text) AS body FROM generate_series(1, 100000) AS g;
ANALYZE events;
EXPLAIN SELECT * FROM events WHERE id = 42;   -- Seq Scan on events

CREATE INDEX events_id_idx ON events (id);
EXPLAIN SELECT * FROM events WHERE id = 42;   -- Index Scan using events_id_idx

EXPLAIN ANALYZE SELECT * FROM events WHERE id = 42;
DROP TABLE events;`

const pgHbaCode = `# TYPE    DATABASE USER ADDRESS METHOD
# Unix socket inside the container only (init scripts, docker exec).
local     all      all          trust
# Every network connection must use TLS.
hostssl   all      all  all     scram-sha-256`

const pgInitCode = `CREATE ROLE :"app_user" LOGIN PASSWORD :'app_password';
CREATE DATABASE :"app_db" OWNER :"app_user";`

const pgPlainCode = `apps:
  api:
    path: ./api
    uses:
      - service: postgres
        tls:
          mode: off
          reason: practice TLS termination at a pooler`

templ postgresIntro() {
	@docP() {
		Postgres stores data in tables of typed columns and answers SQL queries over them. Constraints such as primary keys, foreign keys and NOT NULL are checked by the server on every write, so bad data is rejected before it is stored.
	}
	@docP() {
		Every change happens inside a transaction. A transaction's changes become visible to others all at once when it commits, or not at all if it rolls back. Before a commit returns, the change is written to the write-ahead log (WAL) on disk, so a crash cannot lose it.
	}
	@docP() {
		Readers and writers don't block each other. When a row is updated, Postgres keeps the old version next to the new one, and each statement reads from a snapshot of committed data. This is multiversion concurrency control (MVCC).
	}
}

