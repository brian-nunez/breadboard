package web

// Redis docs, following the Kafka template (D-031, D-061).

func init() {
	registerTech(tech{
		ID:      "redis",
		Name:    "Redis",
		Tagline: "In-memory key-value store and cache.",
		Order:   30,
		Intro:   redisIntro(),
		GoodFit: []string{"Caching reads from a slower database", "Counters, rate limits and leaderboards", "Short-lived data such as sessions and locks", "Simple work queues"},
		PoorFit: []string{"The only copy of data you cannot lose", "Datasets larger than memory", "Ad-hoc queries and joins over stored data"},
		Diagram: redisDiagram(),
		Official: []link{
			{"Develop with Redis", "https://redis.io/docs/latest/develop/"},
			{"Redis data types", "https://redis.io/docs/latest/develop/data-types/"},
			{"go-redis client", "https://pkg.go.dev/github.com/redis/go-redis/v9"},
		},
		Starters: []string{"redis/cache-invalidation"},
		Guides: []guide{
			{
				Slug: "basic-usage", Title: "Connecting and commands", Summary: "Connect over TLS, set and get a key.",
				Starter:  "redis/cache-invalidation",
				Sections: []docSection{{"connect", "Connecting"}, {"handshake", "What happens on connect"}, {"commands", "Setting and getting a key"}, {"execution", "One command at a time"}, {"run", "Run it"}},
				Body:     redisBasicUsage(),
			},
			{
				Slug: "expiry", Title: "Expiry and TTLs", Summary: "How keys expire, and what happens when memory runs out.",
				Starter:  "redis/cache-invalidation",
				Sections: []docSection{{"setting", "Setting a TTL"}, {"rules", "What keeps or clears a TTL"}, {"how", "How Redis removes expired keys"}, {"memory", "When memory runs out"}},
				Body:     redisExpiry(),
			},
			{
				Slug: "cache-aside", Title: "Cache-aside and invalidation", Summary: "Read through a cache, delete on change.",
				Starter:  "redis/cache-invalidation",
				Sections: []docSection{{"read", "Reading through the cache"}, {"invalidate", "Deleting on change"}, {"order", "Why the write comes first"}, {"race", "The stale-read race"}},
				Body:     redisCacheAside(),
			},
			{
				Slug: "data-structures", Title: "Beyond strings", Summary: "Hashes, lists, sets and sorted sets.",
				Sections: []docSection{{"types", "Every key has a type"}, {"hashes", "Hashes"}, {"lists", "Lists"}, {"sets", "Sets"}, {"sorted-sets", "Sorted sets"}},
				Body:     redisDataStructures(),
			},
			{
				Slug: "in-breadboard", Title: "Redis in Breadboard", Summary: "TLS only, the password, persistence, env vars.",
				Sections: []docSection{{"server", "What runs"}, {"tls", "TLS only, no plaintext port"}, {"env", "What your app receives"}, {"persistence", "Persistence and memory"}, {"keys", "The Keys tab and redis-cli"}},
				Body:     redisInBreadboard(),
			},
		},
	})
}

const redisConnectCode = `opts, err := redis.ParseURL(os.Getenv("REDIS_URL"))
if err != nil {
    log.Fatal(err)
}
cache := redis.NewClient(opts)`

const redisSetGetCode = `// Sends SET product:apple 412 EX 30.
if err := cache.Set(ctx, "product:apple", 412, 30*time.Second).Err(); err != nil {
    log.Print(err)
}

cached, err := cache.Get(ctx, "product:apple").Result()
switch {
case errors.Is(err, redis.Nil):
    // The key does not exist: a cache miss, not a failure.
case err != nil:
    log.Print(err) // the connection or the server failed
default:
    log.Printf("price=%s", cached)
}`

const redisTTLCode = `// A TTL at write time: SET product:apple 412 EX 30.
cache.Set(ctx, "product:apple", 412, 30*time.Second)

// No TTL: a zero duration sends a plain SET, and the key lives until deleted.
cache.Set(ctx, "config:theme", "dark", 0)

// Add or replace the TTL of a key that already exists: EXPIRE product:apple 60.
cache.Expire(ctx, "product:apple", 60*time.Second)

// Time left. -1ns means the key has no TTL; -2ns means it does not exist.
left, err := cache.TTL(ctx, "product:apple").Result()`

const redisReadCode = `// read is cache-aside: try the cache, fall back to the database, then fill
// the cache. The TTL bounds how long a missed invalidation can serve a stale price.
func read(ctx context.Context, db *pgx.Conn, cache *redis.Client, id string) (price int, hit bool, err error) {
    key := "product:" + id
    cached, err := cache.Get(ctx, key).Result()
    if err == nil {
        price, err = strconv.Atoi(cached)
        return price, true, err
    }
    if !errors.Is(err, redis.Nil) {
        return 0, false, err
    }
    if err := db.QueryRow(ctx, ` + "`SELECT price_cents FROM products WHERE id = $1`" + `, id).Scan(&price); err != nil {
        return 0, false, err
    }
    return price, false, cache.Set(ctx, key, price, 30*time.Second).Err()
}`

const redisInvalidateCode = `fetches.EachRecord(func(r *kgo.Record) {
    // Delete rather than overwrite: the next read loads the fresh price
    // from the database, so the cache never holds a value we made up.
    if err := cache.Del(ctx, "product:"+string(r.Value)).Err(); err != nil {
        log.Print(err)
        return
    }
    log.Printf("invalidated id=%s", r.Value)
})`

const redisWriterCode = `// The database is the source of truth: write it first. Announcing the
// change before the write commits would let a reader cache the old price
// after the cache entry was already removed.
if _, err := db.Exec(ctx, ` + "`UPDATE products SET price_cents = $2 WHERE id = $1`" + `, id, price); err != nil {
    log.Fatal(err)
}
if err := client.ProduceSync(ctx, &kgo.Record{Key: []byte(id), Value: []byte(id)}).FirstErr(); err != nil {
    log.Print(err) // the cached price stays stale until its TTL runs out
}`

const redisHashCode = `// HSET user:42 name Ada plan pro
cache.HSet(ctx, "user:42", "name", "Ada", "plan", "pro")
// HGETALL user:42 returns every field: map[name:Ada plan:pro]
fields, err := cache.HGetAll(ctx, "user:42").Result()`

const redisListCode = `// Producer: LPUSH jobs resize:7 adds to the head of the list.
cache.LPush(ctx, "jobs", "resize:7")

// Worker: BRPOP jobs 5 takes from the tail, waiting up to 5 seconds.
// The reply is [key, value]; on timeout the error is redis.Nil.
job, err := cache.BRPop(ctx, 5*time.Second, "jobs").Result()`

const redisSetCode = `// SADD online user:42 is idempotent: adding a member twice keeps one copy.
cache.SAdd(ctx, "online", "user:42")
// SISMEMBER online user:42
isOnline, err := cache.SIsMember(ctx, "online", "user:42").Result()`

const redisZSetCode = `// ZINCRBY leaderboard 10 ada adds 10 to ada's score (from 0 if new).
cache.ZIncrBy(ctx, "leaderboard", 10, "ada")
// The top ten, highest score first.
top, err := cache.ZRevRangeWithScores(ctx, "leaderboard", 0, 9).Result()`

templ redisIntro() {
	@docP() {
		Redis keeps all of its data in memory and serves it over the network. Each key holds one value, and that value has a type: a string, a hash, a list, a set, a sorted set, or one of several others. Commands read and change those values in place.
	}
	@docP() {
		Because nothing has to come from disk, reads and writes are fast, which makes Redis a common cache in front of a slower database. The cost is that the dataset has to fit in memory, and a cache is a copy that can fall out of step with the data it copies.
	}
	@docP() {
		Redis can also write its data to disk, so it survives a restart. Keys can carry a time to live, after which Redis deletes them on its own.
	}
}

