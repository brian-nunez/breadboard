package web

import (
	"fmt"
	"strings"

	"github.com/brian-nunez/breadboard/internal/core"
)

// exploreTab is a placeholder the page script replaces with the explorer's
// result, fetched once from /fragments/explore/<name>.
templ exploreTab(p servicePage) {
	<div data-load={ "/fragments/explore/" + p.Row.Name + "?tab=" + p.Tab }>
		@card() {
			<div class="flex items-center gap-3 p-6 text-sm text-slate-600">
				<svg viewBox="0 0 24 24" class="size-4 animate-spin" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke-width="3" class="stroke-slate-200"></circle><path d="M21 12a9 9 0 0 0-9-9" fill="none" stroke-width="3" class="stroke-slate-500"></path></svg>
				Reading { p.Row.Name } with its own tools inside the container…
			</div>
		}
	</div>
}

templ exploreResult(p servicePage) {
	if p.ExploreErr != "" {
		@card() {
			<div class="p-6">
				<h2 class="text-base font-semibold">Could not read { p.Row.Name }</h2>
				<p class="mt-2 font-mono text-sm text-red-700">{ p.ExploreErr }</p>
				<p class="mt-2 text-sm text-slate-600">The explorer runs the service's own tools inside its container, so the service must be running. Start it, then reload.</p>
				<div class="mt-4">
					@terminal("bb up")
				</div>
			</div>
		}
	} else {
		switch x := p.Explore.(type) {
			case *core.PostgresTables:
				@postgresTables(p.Dash.Experiment, p.Row.Name, x)
			case *core.RedisKeys:
				@redisKeys(p.Row.Name, x)
			case *core.ConsulCatalog:
				@consulCatalog(x)
			case *core.KafkaOverview:
				@kafkaOverview(p.Dash.Experiment, p.Dash.Domain, p.Row.Name, x)
			case *core.S3Buckets:
				@s3Buckets(x)
			case *core.OtelTelemetry:
				@otelTelemetry(p.Row.Name, x)
			case *core.EnvoyClusters:
				@envoyClusters(p.Dash.Experiment, x)
			case *core.PgBouncerPools:
				@pgbouncerPools(p.Dash.Experiment, x)
			case *core.HAProxyStats:
				@haproxyStats(x)
			case *core.TraefikRoutes:
				@traefikRoutes(x)
			case *core.NginxStatus:
				@nginxStatus(x)
		}
	}
}

// explorerCard is a card with a title, a note on where the data came from,
// and a reload link.
templ explorerCard(title, source string) {
	@explorerCardTab(title, source, "explore") {
		{ children... }
	}
}

// explorerCardTab is explorerCard for a page tab other than explore.
templ explorerCardTab(title, source, tab string) {
	@card() {
		<div class="flex items-start justify-between gap-4 px-5 pt-5 pb-4">
			<div>
				<h2 class="text-base font-semibold">{ title }</h2>
				<p class="mt-1 text-xs text-slate-500">Read with <code class="font-mono">{ source }</code> inside the container.</p>
			</div>
			<a href={ templ.SafeURL("?tab=" + tab) } class="text-sm text-indigo-600 hover:text-indigo-800">Refresh</a>
		</div>
		{ children... }
	}
}

templ emptyRow(cols int, text string) {
	<tr><td colspan={ itoa(cols) } class="px-5 py-6 text-center text-sm text-slate-500">{ text }</td></tr>
}

templ th(label string) {
	<th class="px-5 py-2.5 font-normal">{ label }</th>
}

templ postgresTables(experiment, name string, x *core.PostgresTables) {
	@explorerCard("Tables in "+x.Database, "psql") {
		<table class="w-full text-left text-sm">
			<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
				<tr>
					@th("Table")
					@th("Rows")
					@th("Size")
				</tr>
			</thead>
			<tbody class="divide-y divide-slate-200">
				for _, t := range x.Tables {
					<tr>
						<td class="px-5 py-2.5 font-mono text-[13px]">{ tableName(t) }</td>
						<td class="px-5 py-2.5">{ commas(t.Rows) }</td>
						<td class="px-5 py-2.5 text-slate-600">{ size(t.Bytes) }</td>
					</tr>
				}
				if len(x.Tables) == 0 {
					@emptyRow(3, "No tables yet. Apps create them; this database starts empty.")
				}
			</tbody>
		</table>
		<div class="p-5">
			@terminal(fmt.Sprintf("docker exec -it %s psql -U postgres %s", container(experiment, name), x.Database))
		</div>
	}
}

templ redisKeys(name string, x *core.RedisKeys) {
	@explorerCard(fmt.Sprintf("Keys (%s in total)", commas(x.Total)), "redis-cli --scan") {
		<table class="w-full text-left text-sm">
			<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
				<tr>
					@th("Key")
					@th("Type")
					@th("Expires")
				</tr>
			</thead>
			<tbody class="divide-y divide-slate-200">
				for _, k := range x.Keys {
					<tr>
						<td class="px-5 py-2.5 font-mono text-[13px]">{ k.Key }</td>
						<td class="px-5 py-2.5">{ k.Type }</td>
						<td class="px-5 py-2.5 text-slate-600">{ ttl(k.TTL) }</td>
					</tr>
				}
				if len(x.Keys) == 0 {
					@emptyRow(3, "The cache is empty.")
				}
			</tbody>
		</table>
		if x.Truncated {
			<p class="px-5 pt-3 text-xs text-slate-500">Showing the first { itoa(len(x.Keys)) } keys SCAN returned.</p>
		}
		<div class="p-5">
			@terminal("bb creds " + name)
		</div>
	}
}

templ consulCatalog(x *core.ConsulCatalog) {
	<div class="flex flex-col gap-6">
		@explorerCard("Services in the catalog", "curl /v1/catalog/services") {
			<table class="w-full text-left text-sm">
				<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
					<tr>
						@th("Service")
						@th("Instances")
						@th("Health")
						@th("Tags")
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-200">
					for _, s := range x.Services {
						<tr>
							<td class="px-5 py-2.5 font-mono text-[13px]">{ s.Name }</td>
							<td class="px-5 py-2.5">
								if s.Instances == 0 {
									—
								} else {
									{ itoa(s.Instances) }
								}
							</td>
							<td class="px-5 py-2.5">
								@consulHealth(s)
							</td>
							<td class="px-5 py-2.5 text-slate-600">{ strings.Join(s.Tags, ", ") }</td>
						</tr>
					}
				</tbody>
			</table>
		}
		@explorerCard("Agents", "curl /v1/catalog/nodes") {
			<table class="w-full text-left text-sm">
				<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
					<tr>
						@th("Node")
						@th("Address")
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-200">
					for _, n := range x.Nodes {
						<tr>
							<td class="px-5 py-2.5 font-mono text-[13px]">{ n.Name }</td>
							<td class="px-5 py-2.5 font-mono text-[13px] text-slate-600">{ n.Address }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}

templ consulHealth(s core.ConsulService) {
	switch {
		case s.Instances == 0:
			<span class="text-slate-500">no checks</span>
		case s.Critical > 0:
			@statusWord(status{fmt.Sprintf("%d critical", s.Critical), "red"})
		case s.Warning > 0:
			@statusWord(status{fmt.Sprintf("%d warning", s.Warning), "amber"})
		default:
			@statusWord(status{fmt.Sprintf("%d passing", s.Passing), "green"})
	}
}

templ kafkaOverview(experiment, domain, name string, x *core.KafkaOverview) {
	<div class="flex flex-col gap-6">
		@explorerCard("Topics", "kafka-topics.sh") {
			<table class="w-full text-left text-sm">
				<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
					<tr>
						@th("Topic")
						@th("Partitions")
						@th("Replication")
						@th("Messages")
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-200">
					for _, t := range x.Topics {
						<tr class={ templ.KV("text-slate-500", t.Internal) }>
							<td class="px-5 py-2.5 font-mono text-[13px]">{ t.Name }</td>
							<td class="px-5 py-2.5">{ itoa(t.Partitions) }</td>
							<td class="px-5 py-2.5">{ itoa(t.ReplicationFactor) }</td>
							<td class="px-5 py-2.5">
								if t.Internal {
									internal
								} else {
									{ commas(t.Messages) }
								}
							</td>
						</tr>
					}
					if len(x.Topics) == 0 {
						@emptyRow(4, "No topics yet. The broker never creates them on its own.")
					}
				</tbody>
			</table>
		}
		@explorerCard("Consumer groups", "kafka-consumer-groups.sh") {
			<table class="w-full text-left text-sm">
				<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
					<tr>
						@th("Group")
						@th("Topics")
						@th("Members")
						@th("Lag")
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-200">
					for _, g := range x.Groups {
						<tr>
							<td class="px-5 py-2.5 font-mono text-[13px]">{ g.Name }</td>
							<td class="px-5 py-2.5 font-mono text-[13px] text-slate-600">{ strings.Join(g.Topics, ", ") }</td>
							<td class="px-5 py-2.5">
								if g.Members == 0 {
									<span class="text-slate-500">none active</span>
								} else {
									{ itoa(g.Members) }
								}
							</td>
							<td class={ "px-5 py-2.5", templ.KV("font-medium text-amber-700", g.Lag > 1000) }>{ commas(g.Lag) } messages</td>
						</tr>
					}
					if len(x.Groups) == 0 {
						@emptyRow(4, "No consumer groups have committed offsets yet.")
					}
				</tbody>
			</table>
			<p class="px-5 pt-3 text-xs text-slate-500">Lag is records written but not yet committed by the group, summed over its partitions.</p>
			<div class="p-5">
				@terminal(fmt.Sprintf("docker exec -it %s /opt/kafka/bin/kafka-consumer-groups.sh --bootstrap-server %s.%s:9093 --command-config /etc/bb/config/client.properties --describe --all-groups", container(experiment, name), name, domain))
			</div>
		}
	</div>
}

templ s3Buckets(x *core.S3Buckets) {
	@explorerCard("Buckets", "curl --aws-sigv4") {
		<table class="w-full text-left text-sm">
			<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
				<tr>
					@th("Bucket")
					@th("Objects")
					@th("Size")
				</tr>
			</thead>
			<tbody class="divide-y divide-slate-200">
				for _, b := range x.Buckets {
					<tr>
						<td class="px-5 py-2.5 font-mono text-[13px]">{ b.Name }</td>
						<td class="px-5 py-2.5">
							{ itoa(b.Objects) }
							if b.Truncated {
								<span class="text-slate-500">+ (first { itoa(core.S3ObjectLimit) } counted)</span>
							}
						</td>
						<td class="px-5 py-2.5 text-slate-600">{ size(b.Bytes) }</td>
					</tr>
				}
				if len(x.Buckets) == 0 {
					@emptyRow(3, "No buckets yet. Create one from code, or list them under config.buckets.")
				}
			</tbody>
		</table>
	}
}

// envoyClusters shows where an Envoy sidecar sends traffic: each upstream
// cluster with its hosts, the replica at each address, and their health.
templ envoyClusters(experiment string, x *core.EnvoyClusters) {
	<div class="flex flex-col gap-6">
		for _, c := range x.Clusters {
			@explorerCardTab(clusterTitle(c), "GET /clusters on Envoy's admin API", infraTab(x.Proxy, "envoy")) {
				<div class="flex flex-wrap gap-x-6 gap-y-1 px-5 pb-4 text-sm text-slate-600">
					<span>{ clusterRole(c) }</span>
					<span>Retries <span class="font-medium text-slate-900">{ commas(c.Retries) }</span></span>
					<span>Ejected now <span class={ "font-medium", templ.KV("text-red-700", c.EjectionsActive > 0), templ.KV("text-slate-900", c.EjectionsActive == 0) }>{ commas(c.EjectionsActive) }</span></span>
					if c.EjectionsEnforced > 0 {
						<span>Ejections so far <span class="font-medium text-slate-900">{ commas(c.EjectionsEnforced) }</span></span>
					}
					if c.EjectionsOverflow > 0 {
						<span>Ejections held back by max_ejection_percent <span class="font-medium text-slate-900">{ commas(c.EjectionsOverflow) }</span></span>
					}
				</div>
				<table class="w-full text-left text-sm">
					<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
						<tr>
							@th("Host")
							@th("Health")
							@th("Requests")
							@th("Share")
							@th("Errors")
							@th("Connect failures")
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-200">
						for _, h := range c.Hosts {
							<tr>
								<td class="px-5 py-2.5">
									<div class="font-semibold">{ hostName(h) }</div>
									<div class="font-mono text-xs text-slate-500">{ h.Address }</div>
								</td>
								<td class="px-5 py-2.5">
									@statusWord(hostStatus(h))
								</td>
								<td class="px-5 py-2.5">{ commas(h.Requests) }</td>
								<td class="px-5 py-2.5">
									@bar(float64(h.Requests), float64(clusterRequests(c)), false)
									<div class="mt-1 text-xs text-slate-500">{ pct(float64(h.Requests), float64(clusterRequests(c))) }%</div>
								</td>
								<td class={ "px-5 py-2.5", templ.KV("font-medium text-red-700", h.Errors > 0) }>{ commas(h.Errors) }</td>
								<td class={ "px-5 py-2.5", templ.KV("font-medium text-red-700", h.ConnectFailures > 0) }>{ commas(h.ConnectFailures) }</td>
							</tr>
						}
						if len(c.Hosts) == 0 {
							@emptyRow(6, emptyClusterText(c))
						}
					</tbody>
				</table>
				<p class="px-5 pt-3 text-xs text-slate-500">Counts are since { envoyName(x) } started. Errors are 5xx responses and resets; with retries on, a request a replica failed may still have succeeded on another. Envoy's access log shows each request:</p>
				<div class="p-5">
					@terminal("bb logs " + envoyName(x) + " -f")
				</div>
			}
		}
		if len(x.Listeners) > 0 {
			@explorerCardTab("Listeners of "+envoyName(x), "GET /listeners", infraTab(x.Proxy, "envoy")) {
				<table class="w-full text-left text-sm">
					<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
						<tr>
							@th("Listener")
							@th("Address")
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-200">
						for _, l := range x.Listeners {
							<tr>
								<td class="px-5 py-2.5 font-mono text-[13px]">{ l.Name }</td>
								<td class="px-5 py-2.5 font-mono text-[13px] text-slate-600">{ l.Address }</td>
							</tr>
						}
					</tbody>
				</table>
			}
		}
		if len(x.Clusters) == 0 {
			@card() {
				<p class="p-6 text-sm text-slate-600">{ envoyName(x) } has no upstream clusters.</p>
			}
		}
	</div>
}

// pgbouncerPools shows a PgBouncer sidecar's pools.
templ pgbouncerPools(experiment string, x *core.PgBouncerPools) {
	@explorerCardTab(fmt.Sprintf("Pools of %s → %s", pgbouncerName(x), x.Service), "psql -c 'SHOW POOLS' -c 'SHOW STATS'", infraTab(x.Proxy, "pgbouncer")) {
		<div class="flex flex-wrap gap-x-6 gap-y-1 px-5 pb-4 text-sm text-slate-600">
			<span>Pool mode <span class="font-medium text-slate-900">{ x.PoolMode }</span></span>
			<span>Pool size <span class="font-medium text-slate-900">{ itoa(x.PoolSize) }</span> server connections per database and user</span>
		</div>
		<table class="w-full text-left text-sm">
			<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
				<tr>
					@th("Database / user")
					@th("Clients")
					@th("Servers")
					@th("Server use")
					@th("Queries")
					@th("Avg query")
					@th("Avg wait")
				</tr>
			</thead>
			<tbody class="divide-y divide-slate-200">
				for _, pl := range x.Pools {
					<tr>
						<td class="px-5 py-2.5 font-mono text-[13px]">{ pl.Database } / { pl.User }</td>
						<td class="px-5 py-2.5">
							{ commas(pl.ClientsActive) } active
							if pl.ClientsWaiting > 0 {
								<div class="font-medium text-amber-700">{ commas(pl.ClientsWaiting) } waiting</div>
							}
						</td>
						<td class="px-5 py-2.5">{ commas(pl.ServersActive) } active · { commas(pl.ServersIdle+pl.ServersUsed) } idle</td>
						<td class="px-5 py-2.5">
							@bar(float64(pl.ServersActive+pl.ServersIdle+pl.ServersUsed+pl.ServersLogin), float64(x.PoolSize), pl.ClientsWaiting > 0)
							<div class="mt-1 text-xs text-slate-500">{ itoa(int(pl.ServersActive+pl.ServersIdle+pl.ServersUsed+pl.ServersLogin)) } of { itoa(x.PoolSize) }</div>
						</td>
						<td class="px-5 py-2.5">{ commas(pl.Queries) }</td>
						<td class="px-5 py-2.5 text-slate-600">{ micros(pl.AvgQueryMicros) }</td>
						<td class="px-5 py-2.5 text-slate-600">{ micros(pl.AvgWaitMicros) }</td>
					</tr>
				}
				if len(x.Pools) == 0 {
					@emptyRow(7, "No pools yet: PgBouncer opens one on the app's first connection.")
				}
			</tbody>
		</table>
		if x.Proxy != "" {
			<p class="px-5 pt-3 text-xs text-slate-500">Clients are the TLS connections of every app that uses { x.Proxy } (port { itoa(x.Port) }); they share one pool per database and user. Servers are PgBouncer's connections to { x.Service }. Averages cover the last stats period (a minute).</p>
		} else {
			<p class="px-5 pt-3 text-xs text-slate-500">Clients are the app's connections to 127.0.0.1; servers are PgBouncer's TLS connections to Postgres. Averages cover the last stats period (a minute).</p>
		}
		<div class="p-5">
			@terminal(pgbouncerConsole(experiment, x))
		</div>
	}
}

// modeBadge is an upstream's TLS mode: red for a plaintext hop.
templ modeBadge(mode string) {
	if mode != "" {
		<span title={ modeHelp(mode) } class={ "rounded border px-1.5 py-0.5 font-mono text-[11px] font-normal", templ.KV("border-red-300 bg-red-50 text-red-700", mode == "off"), templ.KV("border-slate-300 text-slate-600", mode != "off") }>{ modeName(mode) }</span>
	}
}

// haproxyStats shows HAProxy's stats page: each backend's servers with
// the replica DNS gave each slot, their health, and how many sessions
// each got.
templ haproxyStats(x *core.HAProxyStats) {
	<div class="flex flex-col gap-6">
		for _, b := range x.Backends {
			@card() {
				<div class="flex items-start justify-between gap-4 px-5 pt-5 pb-4">
					<div>
						<h2 class="flex items-center gap-2 text-base font-semibold">
							{ upstreamTitle(b.Name, b.Upstream) }
							@modeBadge(b.Upstream.Mode)
						</h2>
						<p class="mt-1 text-xs text-slate-500">Read with <code class="font-mono">GET /stats;csv</code> on HAProxy's loopback monitor frontend inside the container.</p>
					</div>
					<a href={ templ.SafeURL("?tab=explore") } class="text-sm text-indigo-600 hover:text-indigo-800">Refresh</a>
				</div>
				<div class="flex flex-wrap gap-x-6 gap-y-1 px-5 pb-4 text-sm text-slate-600">
					<span>Balance <span class="font-medium text-slate-900">{ b.Balance }</span></span>
					<span>Mode <span class="font-medium text-slate-900">{ b.Mode }</span></span>
					<span>Sessions <span class="font-medium text-slate-900">{ commas(b.TotalSessions) }</span></span>
					<span>Now <span class="font-medium text-slate-900">{ commas(b.CurrentSessions) }</span></span>
					if b.Upstream.Mode != "" {
						<span>{ modeHelp(b.Upstream.Mode) }</span>
					}
				</div>
				<table class="w-full text-left text-sm">
					<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
						<tr>
							@th("Server")
							@th("State")
							@th("Last check")
							@th("Sessions")
							@th("Share")
							@th("Errors")
							@th("In / out")
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-200">
						for _, s := range b.Servers {
							<tr>
								<td class="px-5 py-2.5">
									<div class="font-semibold">{ haproxyServerName(s) }</div>
									<div class="font-mono text-xs text-slate-500">
										{ s.Name }
										if s.Address != "" {
											· { s.Address }
										}
									</div>
								</td>
								<td class="px-5 py-2.5">
									@statusWord(haproxyServerStatus(s))
								</td>
								<td class="px-5 py-2.5 font-mono text-xs text-slate-600">{ checkText(s) }</td>
								<td class="px-5 py-2.5">
									{ commas(s.TotalSessions) }
									if s.CurrentSessions > 0 {
										<div class="text-xs text-slate-500">{ commas(s.CurrentSessions) } now</div>
									}
								</td>
								<td class="px-5 py-2.5">
									@bar(float64(s.TotalSessions), float64(backendSessions(b)), false)
									<div class="mt-1 text-xs text-slate-500">{ pct(float64(s.TotalSessions), float64(backendSessions(b))) }%</div>
								</td>
								<td class={ "px-5 py-2.5", templ.KV("font-medium text-red-700", serverErrors(s) > 0) }>{ commas(serverErrors(s)) }</td>
								<td class="px-5 py-2.5 text-slate-600">{ size(s.BytesIn) } / { size(s.BytesOut) }</td>
							</tr>
						}
						if len(b.Servers) == 0 {
							@emptyRow(7, "No servers in this backend.")
						}
					</tbody>
				</table>
				<p class="px-5 py-3 text-xs text-slate-500">Each server is a <code class="font-mono">server-template</code> slot that HAProxy fills from DNS, so slot numbers need not match replica numbers. In http mode a session is one request; counts are since HAProxy started.</p>
			}
		}
		if len(x.Frontends) > 0 {
			@explorerCard("Frontends of "+x.Service, "GET /stats;csv") {
				<table class="w-full text-left text-sm">
					<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
						<tr>
							@th("Frontend")
							@th("Mode")
							@th("State")
							@th("Sessions")
							@th("Requests")
							@th("In / out")
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-200">
						for _, f := range x.Frontends {
							<tr>
								<td class="px-5 py-2.5 font-mono text-[13px]">{ f.Name }</td>
								<td class="px-5 py-2.5 text-slate-600">{ f.Mode }</td>
								<td class="px-5 py-2.5 text-slate-600">{ f.Status }</td>
								<td class="px-5 py-2.5">{ commas(f.TotalSessions) }</td>
								<td class="px-5 py-2.5">{ commas(f.Requests) }</td>
								<td class="px-5 py-2.5 text-slate-600">{ size(f.BytesIn) } / { size(f.BytesOut) }</td>
							</tr>
						}
					</tbody>
				</table>
				<p class="px-5 pt-3 text-xs text-slate-500">monitor is the loopback frontend the health check and this page read. The access log shows each request:</p>
				<div class="p-5">
					@terminal("bb logs " + x.Service + " -f")
				</div>
			}
		}
	</div>
}

// traefikRoutes shows Traefik's routers and the services they send to,
// with each server's health status.
templ traefikRoutes(x *core.TraefikRoutes) {
	<div class="flex flex-col gap-6">
		@explorerCard("Routers of "+x.Service, "GET /api/http/routers and /api/tcp/routers") {
			<table class="w-full text-left text-sm">
				<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
					<tr>
						@th("Router")
						@th("Rule")
						@th("Service")
						@th("TLS")
						@th("State")
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-200">
					for _, r := range x.Routers {
						<tr>
							<td class="px-5 py-2.5">
								<div class="font-mono text-[13px]">{ r.Name }</div>
								<div class="text-xs text-slate-500">{ r.Protocol } · { strings.Join(r.EntryPoints, ", ") }</div>
							</td>
							<td class="px-5 py-2.5 font-mono text-xs text-slate-700">
								{ r.Rule }
								if len(r.Middlewares) > 0 {
									<div class="text-slate-500">then { strings.Join(r.Middlewares, ", ") }</div>
								}
							</td>
							<td class="px-5 py-2.5 font-mono text-[13px]">{ r.Service }</td>
							<td class="px-5 py-2.5 text-slate-600">{ traefikTLS(r) }</td>
							<td class={ "px-5 py-2.5", templ.KV("text-red-700", len(r.Errors) > 0), templ.KV("text-slate-600", len(r.Errors) == 0) }>
								{ r.Status }
								for _, e := range r.Errors {
									<div class="text-xs">{ e }</div>
								}
							</td>
						</tr>
					}
					if len(x.Routers) == 0 {
						@emptyRow(5, "No routers.")
					}
				</tbody>
			</table>
			<p class="px-5 py-3 text-xs text-slate-500">A longer rule has a higher priority, so the path prefixes win over the catch-all. Traefik's own routers (the API, the dashboard and ping on the loopback entrypoint) are left out.</p>
		}
		for _, s := range x.Services {
			@card() {
				<div class="flex items-start justify-between gap-4 px-5 pt-5 pb-4">
					<div>
						<h2 class="flex items-center gap-2 text-base font-semibold">
							{ upstreamTitle(s.Name, s.Upstream) }
							@modeBadge(s.Upstream.Mode)
						</h2>
						<p class="mt-1 text-xs text-slate-500">Read with <code class="font-mono">GET /api/{ s.Protocol }/services</code> on Traefik's loopback entrypoint inside the container.</p>
					</div>
					<a href={ templ.SafeURL("?tab=explore") } class="text-sm text-indigo-600 hover:text-indigo-800">Refresh</a>
				</div>
				<div class="flex flex-wrap gap-x-6 gap-y-1 px-5 pb-4 text-sm text-slate-600">
					if s.Strategy != "" {
						<span>Strategy <span class="font-medium text-slate-900">{ s.Strategy }</span></span>
					}
					if s.HealthCheck != "" {
						<span>Health check <span class="font-medium text-slate-900">{ s.HealthCheck }</span></span>
					}
					<span>Used by <span class="font-mono text-slate-900">{ strings.Join(s.UsedBy, ", ") }</span></span>
				</div>
				<table class="w-full text-left text-sm">
					<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
						<tr>
							@th("Server")
							@th("Address")
							@th("Health")
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-200">
						for _, sv := range s.Servers {
							<tr>
								<td class="px-5 py-2.5 font-semibold">{ sv.Instance }</td>
								<td class="px-5 py-2.5 font-mono text-xs text-slate-600">{ sv.Address }</td>
								<td class="px-5 py-2.5">
									@statusWord(traefikServerStatus(sv))
								</td>
							</tr>
						}
						if len(s.Servers) == 0 {
							@emptyRow(3, "No servers.")
						}
					</tbody>
				</table>
				for _, e := range s.Errors {
					<p class="px-5 pt-3 text-xs text-red-700">{ e }</p>
				}
			}
		}
		@card() {
			<div class="p-5">
				<p class="text-sm text-slate-600">Traefik's API reports each server's health but keeps no per-server request counter. Its access log shows every request and the server that answered it:</p>
				<div class="mt-3">
					@terminal("bb logs " + x.Service + " -f")
				</div>
			</div>
		}
	</div>
}

// nginxStatus shows NGINX's stub_status counters and the instances behind
// each upstream. Open-source NGINX has no per-server statistics.
templ nginxStatus(x *core.NginxStatus) {
	<div class="flex flex-col gap-6">
		@explorerCard("Connections and requests of "+x.Service, "wget http://127.0.0.1:8404/stub_status") {
			<div class="grid grid-cols-2 gap-4 px-5 pb-5 md:grid-cols-4">
				@stat("Active connections", commas(x.Active))
				@stat("Reading", commas(x.Reading))
				@stat("Writing", commas(x.Writing))
				@stat("Waiting (keep-alive)", commas(x.Waiting))
				@stat("Accepted", commas(x.Accepts))
				@stat("Handled", commas(x.Handled))
				@stat("Requests", commas(x.Requests))
			</div>
			<p class="px-5 pb-5 text-xs text-slate-500">Totals since NGINX started, over every listener (this page's reads included). Fewer handled than accepted connections means a limit such as <code class="font-mono">worker_connections</code> was hit.</p>
		}
		@explorerCard("Upstreams of "+x.Service, "getent hosts") {
			<p class="px-5 pb-4 text-sm text-slate-600">Open-source NGINX has no per-upstream or per-server statistics: those come from the NGINX Plus API. Below is where each upstream's servers resolve inside the container, which is where NGINX sends traffic; the access log shows each request.</p>
			<table class="w-full text-left text-sm">
				<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
					<tr>
						@th("Upstream")
						@th("Server")
						@th("Resolves to")
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-200">
					for _, u := range x.Upstreams {
						for i, b := range u.Backends {
							<tr>
								<td class="px-5 py-2.5">
									if i == 0 {
										<div class="flex items-center gap-2 font-semibold">
											{ u.Target }
											@modeBadge(u.Mode)
										</div>
										<div class="font-mono text-xs text-slate-500">{ u.Route } · :{ itoa(u.Port) }</div>
									}
								</td>
								<td class="px-5 py-2.5">
									<div class="font-semibold">{ b.Instance }</div>
									<div class="font-mono text-xs text-slate-500">{ b.Name }</div>
								</td>
								<td class={ "px-5 py-2.5 font-mono text-xs", templ.KV("text-slate-600", b.Address != ""), templ.KV("text-amber-700", b.Address == "") }>{ resolvedText(b) }</td>
							</tr>
						}
					}
					if len(x.Upstreams) == 0 {
						@emptyRow(3, "No upstreams: every request gets 503.")
					}
				</tbody>
			</table>
			<div class="p-5">
				@terminal("bb logs " + x.Service + " -f")
			</div>
		}
	</div>
}

templ otelTelemetry(name string, x *core.OtelTelemetry) {
	<div class="flex flex-col gap-6">
		@explorerCard("Enabled signals ("+strings.Join(x.Signals, ", ")+")", "curl 127.0.0.1") {
			<div class="grid grid-cols-1 gap-4 px-5 pb-5 md:grid-cols-3">
				@stat("Traces (Tempo)", otelCountText(x.TracesEnabled, len(x.Traces)))
				@stat("Metrics (Prometheus)", otelCountText(x.MetricsEnabled, len(x.Metrics)))
				@stat("Logs (Loki)", otelCountText(x.LogsEnabled, len(x.Logs)))
			</div>
			<div class="px-5 pb-5">
				@terminal("bb creds " + name)
			</div>
		}
		if x.TracesEnabled {
			@explorerCard("Recent traces", "curl http://127.0.0.1:3200/api/search") {
				if len(x.TraceServices) > 0 {
					<p class="px-5 pb-3 text-xs text-slate-500">Services: <span class="font-mono text-slate-700">{ strings.Join(x.TraceServices, ", ") }</span></p>
				}
				<table class="w-full text-left text-sm">
					<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
						<tr>
							@th("Trace ID")
							@th("Root service")
							@th("Operation")
							@th("Duration")
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-200">
						for _, tr := range x.Traces {
							<tr>
								<td class="px-5 py-2.5 font-mono text-xs">{ tr.TraceID }</td>
								<td class="px-5 py-2.5 font-mono text-[13px]">{ tr.RootService }</td>
								<td class="px-5 py-2.5 text-slate-700">{ tr.RootName }</td>
								<td class="px-5 py-2.5 text-slate-600">{ fmt.Sprintf("%d ms", tr.DurationMS) }</td>
							</tr>
						}
						if len(x.Traces) == 0 {
							@emptyRow(4, "No traces ingested yet.")
						}
					</tbody>
				</table>
			}
		}
		if x.MetricsEnabled {
			@explorerCard("Metrics", "curl http://127.0.0.1:9090/api/v1/label/__name__/values") {
				if len(x.MetricServices) > 0 {
					<p class="px-5 pb-3 text-xs text-slate-500">Services: <span class="font-mono text-slate-700">{ strings.Join(x.MetricServices, ", ") }</span></p>
				}
				<table class="w-full text-left text-sm">
					<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
						<tr>
							@th("Metric name")
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-200">
						for _, m := range x.Metrics {
							<tr>
								<td class="px-5 py-2.5 font-mono text-[13px]">{ m }</td>
							</tr>
						}
						if len(x.Metrics) == 0 {
							@emptyRow(1, "No metrics ingested yet.")
						}
					</tbody>
				</table>
				if x.MetricsMore {
					<p class="px-5 py-3 text-xs text-slate-500">Showing the first { itoa(len(x.Metrics)) } metric names.</p>
				}
			}
		}
		if x.LogsEnabled {
			@explorerCard("Recent structured logs", "curl http://127.0.0.1:3100/loki/api/v1/query_range") {
				if len(x.LogServices) > 0 {
					<p class="px-5 pb-3 text-xs text-slate-500">Services: <span class="font-mono text-slate-700">{ strings.Join(x.LogServices, ", ") }</span></p>
				}
				<table class="w-full text-left text-sm">
					<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
						<tr>
							@th("Service")
							@th("Severity")
							@th("Trace ID")
							@th("Message")
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-200">
						for _, l := range x.Logs {
							<tr>
								<td class="px-5 py-2.5 font-mono text-[13px]">{ l.Service }</td>
								<td class="px-5 py-2.5 font-mono text-xs text-slate-600">{ l.Severity }</td>
								<td class="px-5 py-2.5 font-mono text-xs text-slate-500">{ l.TraceID }</td>
								<td class="px-5 py-2.5 text-slate-700">{ l.Body }</td>
							</tr>
						}
						if len(x.Logs) == 0 {
							@emptyRow(4, "No logs ingested yet.")
						}
					</tbody>
				</table>
			}
		}
	</div>
}

func otelCountText(enabled bool, n int) string {
	if !enabled {
		return "disabled"
	}
	return commas(int64(n))
}
