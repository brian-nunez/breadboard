package web

// section is which top-bar item is current.
type section string

const (
	sectionDashboard section = "dashboard"
	sectionDocs      section = "docs"
	sectionStarters  section = "starters"
)

// page is the document shell shared by every page.
templ page(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Breadboard</title>
			<link rel="icon" href="/static/icon.svg"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/app.js" defer></script>
		</head>
		<body class="min-h-screen overflow-x-hidden bg-slate-50 font-sans text-slate-900 antialiased">
			{ children... }
		</body>
	</html>
}

templ logo() {
	<a href="/" class="flex items-center gap-2.5 text-[17px] font-semibold text-slate-900">
		<svg viewBox="0 0 24 24" class="size-6" aria-hidden="true">
			<rect width="24" height="24" rx="6" class="fill-slate-900"></rect>
			for _, x := range []string{"7", "12", "17"} {
				for _, y := range []string{"7", "12", "17"} {
					<circle cx={ x } cy={ y } r="1.6" class="fill-white"></circle>
				}
			}
		</svg>
		breadboard
	</a>
}

templ topbar(current section) {
	<header class="sticky top-0 z-10 flex h-14 items-center gap-8 border-b border-slate-200 bg-white px-4 md:px-6">
		@logo()
		@searchBox("hidden w-[360px] md:flex")
		<nav class="ml-auto hidden items-center gap-6 text-sm md:flex">
			if !isStatic(ctx) {
				@topLink("/dashboard", "Dashboard", current == sectionDashboard)
			}
			@topLink("/docs", "Docs", current == sectionDocs)
			@topLink("/starters", "Starters", current == sectionStarters)
		</nav>
		<details class="relative ml-auto md:hidden">
			<summary class="cursor-pointer list-none rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium">Menu</summary>
			<nav class="absolute right-0 mt-2 flex w-56 flex-col rounded-xl border border-slate-200 bg-white p-2 text-sm shadow-lg">
				<button type="button" data-search-open class="rounded-lg px-3 py-2 text-left text-slate-700 hover:bg-slate-50">Search</button>
				if !isStatic(ctx) {
					<a href="/dashboard" class="rounded-lg px-3 py-2 text-slate-700 hover:bg-slate-50">Dashboard</a>
					<a href="/architecture" class="rounded-lg px-3 py-2 text-slate-700 hover:bg-slate-50">Architecture</a>
				}
				<a href="/docs" class="rounded-lg px-3 py-2 text-slate-700 hover:bg-slate-50">Docs</a>
				<a href="/starters" class="rounded-lg px-3 py-2 text-slate-700 hover:bg-slate-50">Starters</a>
			</nav>
		</details>
	</header>
	@searchDialog()
}

// searchBox opens the search dialog; ⌘K or Ctrl+K does too. The hint says
// Ctrl K; app.js shows ⌘K instead on Apple platforms.
templ searchBox(class string) {
	<button type="button" data-search-open class={ "h-9 items-center justify-between rounded-lg border border-slate-200 bg-white px-3 text-sm text-slate-400 hover:border-slate-300", class }>
		<span>Search docs, starters, services</span>
		<kbd data-search-shortcut class="rounded border border-slate-200 px-1.5 text-[11px] text-slate-500">Ctrl K</kbd>
	</button>
}

// searchDialog filters an index of every page, loaded on first open.
templ searchDialog() {
	<div id="search" class="fixed inset-0 z-50 hidden bg-slate-900/30 px-4 pt-24" data-search-index={ searchIndexPath(ctx) }>
		<div class="mx-auto max-w-xl overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl">
			<input type="search" placeholder="Search docs, starters, services" autocomplete="off" class="w-full border-b border-slate-200 px-4 py-3 text-[15px] outline-none" data-search-input/>
			<ul class="max-h-80 overflow-y-auto p-2 text-sm" data-search-results></ul>
			<div class="border-t border-slate-200 px-4 py-2 text-xs text-slate-500">↑ ↓ to move · Enter to open · Esc to close</div>
		</div>
	</div>
}

templ topLink(href, label string, active bool) {
	if active {
		<a href={ templ.SafeURL(href) } class="font-medium text-slate-900">{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) } class="text-slate-500 hover:text-slate-900">{ label }</a>
	}
}

// dashboardShell is the top bar plus the experiment sidebar.
templ dashboardShell(title string, d dashboardData, active string) {
	@page(title) {
		@topbar(sectionDashboard)
		<div class="flex">
			@sidebar(d, active)
			<main class="min-w-0 flex-1 px-6 py-8 md:px-10">
				{ children... }
			</main>
		</div>
	}
}

templ sidebar(d dashboardData, active string) {
	<aside class="sticky top-14 hidden h-[calc(100vh-3.5rem)] w-62 shrink-0 flex-col border-r border-slate-200 bg-white px-4 py-5 lg:flex">
		<nav class="flex flex-col text-sm">
			<a href="/docs/getting-started" class="rounded-lg px-2.5 py-1.5 font-medium text-indigo-700 hover:bg-indigo-50">Getting started</a>
		</nav>
		if d.Experiment != "" {
			<div class="mt-5 rounded-xl border border-slate-200 p-3">
				<div class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Experiment</div>
				<div class="mt-1 flex items-center gap-2 font-semibold">
					@dot(experimentColor(d))
					{ d.Experiment }
				</div>
				<div class="mt-1 truncate font-mono text-xs text-slate-500">{ d.Dir }</div>
				<div class="mt-1 text-xs text-slate-500">
					{ itoa(len(d.Services)) } services
					if u := d.Uptime(); u != "" {
						· { u }
					}
				</div>
			</div>
		}
		<nav class="mt-5 flex flex-col gap-0.5 text-sm">
			@sideLink("/dashboard", "Overview", active == "overview")
			@sideLink("/architecture", "Architecture", active == "architecture")
		</nav>
		if len(d.Services) > 0 {
			<div class="mt-6 px-2.5 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Services</div>
			<nav class="mt-2 flex flex-col gap-0.5 text-sm">
				for _, s := range d.Services {
					<a href={ templ.SafeURL("/services/" + s.Name) } class={ "flex items-center justify-between rounded-lg px-2.5 py-1.5", templ.KV("bg-indigo-50 font-medium text-indigo-700", active == "service:"+s.Name), templ.KV("text-slate-700 hover:bg-slate-50", active != "service:"+s.Name) }>
						<span class="flex min-w-0 items-center gap-2">
							if logoSrc(s.Type) != "" {
								@techLogo(s.Type, "size-4")
							} else {
								<span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-indigo-50 text-[9px] font-semibold text-indigo-700">{ s.Initial() }</span>
							}
							<span class="truncate">{ s.Name }</span>
						</span>
						@dot(s.Status().Color)
					</a>
				}
			</nav>
		}
		<div class="mt-6 px-2.5 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Learn</div>
		<nav class="mt-2 flex flex-col gap-0.5 text-sm">
			@sideLink("/docs", "Docs", false)
			@sideLink("/starters", "Starters", false)
		</nav>
		<div class="mt-auto px-2.5 text-xs leading-5 text-slate-500">
			<div class="truncate" title={ d.Version }>bb { d.Version }</div>
			if d.Domain != "" {
				<div>domain { d.Domain }</div>
			}
		</div>
	</aside>
}

templ sideLink(href, label string, active bool) {
	if active {
		<a href={ templ.SafeURL(href) } class="rounded-lg bg-indigo-50 px-2.5 py-1.5 font-medium text-indigo-700">{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) } class="rounded-lg px-2.5 py-1.5 text-slate-700 hover:bg-slate-50">{ label }</a>
	}
}

// notFoundPage is the static site's 404.html.
templ notFoundPage() {
	@page("Page not found") {
		@topbar("")
		<main class="mx-auto max-w-[880px] px-6 py-12">
			<h1 class="text-[32px] font-semibold">Page not found</h1>
			<a href="/docs" class="mt-3 inline-block text-indigo-600 hover:text-indigo-700">Go to the docs →</a>
		</main>
	}
}

// needLink is shown to a browser without a session: the token in the URL
// bb serve printed is the only way in.
templ needLink() {
	@page("Open the link from bb serve") {
		<div class="mx-auto max-w-md px-6 py-24 text-center">
			<div class="flex justify-center">
				@logo()
			</div>
			<h1 class="mt-8 text-xl font-semibold">Open the link that bb serve printed</h1>
			<p class="mt-3 text-sm leading-6 text-slate-600">This page only answers browsers that arrived through that link, so other websites cannot read your experiment.</p>
		</div>
	}
}
