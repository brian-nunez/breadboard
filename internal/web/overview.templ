package web

import (
	"fmt"
	"strings"
)

templ overviewPage(d dashboardData) {
	@dashboardShell(pageTitle(d, "Overview"), d, "overview") {
		<div data-live="/live/overview">
			@overviewBody(d)
		</div>
	}
}

func pageTitle(d dashboardData, name string) string {
	if d.Experiment == "" {
		return name
	}
	return name + " · " + d.Experiment
}

// overviewBody is the part of the overview that updates live.
templ overviewBody(d dashboardData) {
	switch {
		case d.NoExperiment:
			@noExperiment()
		case d.Problem != "":
			@problem(d.Problem)
		default:
			<div class="flex items-end justify-between gap-4">
				<div class="min-w-0 flex-1">
					<h1 class="text-[28px] font-semibold leading-tight">{ d.Experiment }</h1>
					<p class="mt-1 text-sm text-slate-500 md:hidden">
						{ itoa(len(d.Services)) } containers
						if u := d.Uptime(); u != "" {
							· { u }
						}
					</p>
					<p class="mt-1 hidden max-w-3xl truncate font-mono text-sm text-slate-500 md:block" title={ d.Dir }>
						{ d.Dir }
						if u := d.Uptime(); u != "" {
							<span class="font-sans">· { u }</span>
						}
					</p>
				</div>
				<span class="flex shrink-0 items-center gap-2 text-sm text-slate-500">
					@dot("green")
					Live
				</span>
			</div>
			<div class="mt-6 hidden grid-cols-2 gap-4 md:grid lg:grid-cols-4">
				@stat("Containers", itoa(len(d.Services)))
				@stat("Healthy", fmt.Sprintf("%d of %d", d.Healthy(), len(d.Services)))
				@tlsStat(d)
				@memoryStat(d)
			</div>
			if len(d.HostURLs) > 0 {
				@hostAccessCard(d)
			}
			<div class="mt-6 flex flex-col gap-3 md:hidden">
				for _, s := range d.Services {
					if c := s.Status().Color; c == "amber" || c == "red" {
						@attention(s)
					}
				}
				<h2 class="mt-2 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Containers</h2>
				for _, s := range d.Services {
					@containerCard(s)
				}
				<p class="text-sm text-slate-500">The architecture graph needs a wider screen; on phones it shows as a list of connections.</p>
			</div>
			<div class="mt-6 hidden md:block">
				@card() {
					<h2 class="px-5 pt-5 pb-4 text-base font-semibold">Containers</h2>
					<div class="overflow-x-auto">
						<table class="w-full text-left text-sm">
							<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
								<tr>
									<th class="px-5 py-2.5 font-normal">Service</th>
									<th class="px-3 py-2.5 font-normal">Status</th>
									<th class="px-3 py-2.5 font-normal">CPU</th>
									<th class="px-3 py-2.5 font-normal">Memory</th>
									<th class="px-3 py-2.5 font-normal">Address</th>
									<th class="px-5 py-2.5 font-normal">Edges</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-200">
								for _, s := range d.Services {
									@containerRow(s)
								}
							</tbody>
						</table>
					</div>
				}
			</div>
			if len(d.Services) > 0 {
				<div class="mt-6 hidden md:block">
					@card() {
						<div class="flex items-center justify-between px-5 pt-5">
							<h2 class="text-base font-semibold">Architecture</h2>
							<a href="/architecture" class="text-sm text-indigo-600 hover:text-indigo-800">Open →</a>
						</div>
						<div class="m-5 overflow-x-auto rounded-lg border border-slate-200 bg-slate-50 p-2">
							@graphSVG(layout(d.Services, ""), false)
						</div>
					}
				</div>
			}
	}
}

// hostAccessCard lists the URLs that reach the lab from the host, through
// its host router.
templ hostAccessCard(d dashboardData) {
	<div class="mt-6">
		@card() {
			<div class="flex items-center justify-between gap-4 px-5 pt-5">
				<h2 class="text-base font-semibold">Host access</h2>
				<a href={ templ.SafeURL("/services/" + hostRouterName(d)) } class="text-sm text-indigo-600 hover:text-indigo-800">{ hostRouterName(d) } →</a>
			</div>
			<p class="px-5 pt-1 text-sm text-slate-600">Open from your machine through the host router on <span class="font-mono text-[13px]">127.0.0.1:{ itoa(d.HostPort) }</span>. Trust the host CA first: <code class="font-mono text-[13px]">bb ca</code> shows how.</p>
			<div class="flex flex-col gap-1.5 p-5 text-sm">
				for _, u := range d.HostURLs {
					<div class="flex flex-wrap items-baseline gap-x-3">
						<a href={ templ.SafeURL(u.URL) } target="_blank" rel="noopener" class="break-all font-mono text-[13px] text-indigo-600 hover:text-indigo-800">{ u.URL }</a>
						<span class="text-slate-500">→ { hostRoute(d.Services, u) }</span>
					</div>
				}
			</div>
		}
	</div>
}

templ tlsStat(d dashboardData) {
	{{ tls, total := d.Edges() }}
	@stat("TLS edges", fmt.Sprintf("%d of %d", tls, total))
}

templ memoryStat(d dashboardData) {
	{{ used, limit := d.Memory() }}
	@stat("Memory", gib(used)+" / "+gib(limit))
}

templ containerRow(s row) {
	{{ st := s.Status() }}
	<tr>
		<td class="px-5 py-3">
			<a href={ templ.SafeURL("/services/" + s.Name) } class="flex items-center gap-3">
				@badge(s)
				<span>
					<span class="block font-semibold text-slate-900">{ s.Name }</span>
					<span class="block text-xs text-slate-500">{ s.Subtitle() }</span>
				</span>
			</a>
		</td>
		<td class="px-3 py-3">
			@statusWord(st)
		</td>
		<td class="px-3 py-3">
			@bar(s.CPUUsed, s.CPULimit, false)
			<div class="mt-1.5 text-slate-600">{ fmt.Sprintf("%.2f / %.2f cores", s.CPUUsed, s.CPULimit) }</div>
		</td>
		<td class="px-3 py-3">
			@bar(s.MemUsed, s.MemLimit, st.Color == "amber")
			<div class={ "mt-1.5", templ.KV("font-medium text-amber-700", st.Color == "amber"), templ.KV("text-slate-600", st.Color != "amber") }>{ fmt.Sprintf("%.0f / %.0f MiB", s.MemUsed, s.MemLimit) }</div>
		</td>
		<td class="px-3 py-3 font-mono text-[13px] text-slate-700">{ s.Address }</td>
		<td class="px-5 py-3">
			if s.TLS {
				<span class="text-slate-700">TLS</span>
			} else {
				<span class="text-red-700"><span class="mr-1 tracking-tighter">---</span>Plaintext</span>
			}
		</td>
	</tr>
}

templ noExperiment() {
	<div class="mx-auto max-w-xl py-16 text-center">
		<h1 class="text-2xl font-semibold">No experiment here yet</h1>
		<p class="mt-3 text-slate-600">Create one in this directory, add a service, and start it. This page updates on its own.</p>
		<div class="mt-8 text-left">
			@terminal("bb init kafka-lab", "bb add kafka", "bb starter kafka/producer-consumer", "bb up")
		</div>
	</div>
}

templ problem(msg string) {
	<div class="mx-auto max-w-xl py-16">
		<h1 class="text-xl font-semibold">Breadboard cannot read this experiment right now</h1>
		<p class="mt-3 font-mono text-sm text-red-700">{ msg }</p>
		<p class="mt-3 text-slate-600">If Docker is not running, start it. This page retries on its own.</p>
	</div>
}

// containerCard is a container on a phone-width screen.
templ containerCard(s row) {
	{{ st := s.Status() }}
	<a href={ templ.SafeURL("/services/" + s.Name) } class={ "block rounded-xl border p-4", templ.KV("border-amber-200 bg-amber-50", st.Color == "amber"), templ.KV("border-red-200 bg-red-50", st.Color == "red"), templ.KV("border-slate-200 bg-white", st.Color != "amber" && st.Color != "red") }>
		<div class="flex items-start justify-between gap-3">
			<div class="flex min-w-0 items-center gap-3">
				@badge(s)
				<div class="min-w-0">
					<div class="font-semibold">{ s.Name }</div>
					<div class="truncate font-mono text-xs text-slate-500">{ s.Address }</div>
				</div>
			</div>
			@statusWord(st)
		</div>
		<div class="mt-3 grid grid-cols-2 gap-4 text-xs text-slate-600">
			<div>
				<div class="flex justify-between"><span>CPU</span><span>{ fmt.Sprintf("%.2f/%.2f", s.CPUUsed, s.CPULimit) }</span></div>
				<div class="mt-1">
					@bar(s.CPUUsed, s.CPULimit, false)
				</div>
			</div>
			<div>
				<div class="flex justify-between"><span>Mem</span><span class={ templ.KV("font-medium text-amber-700", st.Color == "amber") }>{ fmt.Sprintf("%.0f/%.0f MiB", s.MemUsed, s.MemLimit) }</span></div>
				<div class="mt-1">
					@bar(s.MemUsed, s.MemLimit, st.Color == "amber")
				</div>
			</div>
		</div>
	</a>
}

// attention points out a service near its memory limit or unhealthy.
templ attention(s row) {
	<div class={ "rounded-xl border p-4", templ.KV("border-amber-300 bg-amber-50", s.Status().Color == "amber"), templ.KV("border-red-300 bg-red-50", s.Status().Color == "red") }>
		<div class="font-semibold">
			if s.Status().Color == "amber" {
				{ s.Name } is close to its memory limit
			} else {
				{ s.Name } is { strings.ToLower(s.Status().Word) }
			}
		</div>
		<p class="mt-1 text-sm text-slate-700">
			{ fmt.Sprintf("%.0f / %.0f MiB (%s%%).", s.MemUsed, s.MemLimit, pct(s.MemUsed, s.MemLimit)) }
			if s.OOMKilled {
				It was killed for exceeding its limit.
			}
		</p>
		<a href={ templ.SafeURL("/services/" + s.Name) } class="mt-1 inline-block text-sm text-indigo-600">Open { s.Name } →</a>
	</div>
}
