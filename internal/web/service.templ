package web

import (
	"fmt"
	"strings"
	"time"

	"github.com/brian-nunez/breadboard/internal/core"
)

// servicePage is everything one service's page shows.
type servicePage struct {
	Dash    dashboardData
	Row     row
	Details *core.ServiceDetails
	Notes   notes
	Tab     string
	Problem string
	// Explore is the explorer tab's result (one of the core explorer types),
	// read only when that tab is open; ExploreErr says why it could not be.
	Explore    any
	ExploreErr string
}

// explorerTabs names each catalog type's explorer tab.
var explorerTabs = map[string]string{
	"postgres": "Tables",
	"redis":    "Keys",
	"consul":   "Catalog",
	"kafka":    "Topics & groups",
	"s3-compatible": "Buckets",
	"otel":     "Telemetry",
	"haproxy":  "HAProxy stats",
	"traefik":  "Traefik routes",
	"nginx":    "NGINX status",
	"envoy":    "Envoy clusters",
	"pgbouncer": "PgBouncer pools",
}

// sidecarTabs names the explorer tab of each sidecar type that has one; an
// app's page and the sidecar's own page both show it.
var sidecarTabs = [][2]string{{"envoy", "Envoy"}, {"pgbouncer", "PgBouncer pools"}}

func (p servicePage) tabs() [][2]string {
	t := [][2]string{{"overview", "Overview"}}
	if p.Details != nil && p.Details.Kind == "infra" {
		if name, ok := explorerTabs[p.Details.Type]; ok {
			t = append(t, [2]string{"explore", name})
		}
	}
	for _, st := range sidecarTabs {
		if p.hasSidecar(st[0]) {
			t = append(t, st)
		}
	}
	t = append(t, [2]string{"connection", "Connection"}, [2]string{"logs", "Logs"})
	if p.Details != nil && p.Details.Type != "" && len(p.Notes.Sections) > 0 {
		t = append(t, [2]string{"learn", "Learn"})
	}
	return t
}

// hasSidecar reports whether the page is an app with a sidecar of the type,
// or that sidecar itself.
func (p servicePage) hasSidecar(typ string) bool {
	switch {
	case p.Details == nil:
		return false
	case p.Details.Sidecar != nil:
		return p.Details.Sidecar.Type == typ
	}
	for _, sc := range p.Details.Sidecars {
		if sc.Type == typ {
			return true
		}
	}
	return false
}

templ serviceView(p servicePage) {
	@dashboardShell(pageTitle(p.Dash, p.Row.Name), p.Dash, "service:"+p.Row.Name) {
		if p.Problem != "" {
			@problem(p.Problem)
		} else {
			<nav class="text-sm text-slate-500"><a href="/" class="hover:text-slate-900">Services</a> <span class="mx-1.5">/</span> <span class="text-slate-900">{ p.Row.Name }</span></nav>
			<div class="mt-4 flex items-start justify-between">
				<div class="flex items-center gap-4">
					<span class="scale-125">
						@badge(p.Row)
					</span>
					<div>
						<div class="flex items-center gap-3">
							<h1 class="text-[28px] font-semibold leading-tight">{ p.Row.Name }</h1>
							@statusWord(p.Row.Status())
						</div>
						<p class="mt-1 text-slate-600">{ serviceSubtitle(p) }</p>
					</div>
				</div>
				<span class="flex items-center gap-2 text-sm text-slate-500">
					@dot("green")
					Live
				</span>
			</div>
			<nav class="mt-6 flex gap-6 border-b border-slate-200 text-sm">
				for _, t := range p.tabs() {
					<a href={ templ.SafeURL("/services/" + p.Row.Name + "?tab=" + t[0]) } class={ "-mb-px border-b-2 pb-3", templ.KV("border-slate-900 font-medium text-slate-900", p.Tab == t[0]), templ.KV("border-transparent text-slate-500 hover:text-slate-900", p.Tab != t[0]) }>{ t[1] }</a>
				}
			</nav>
			<div class="mt-6">
				switch p.Tab {
					case "explore", "envoy", "pgbouncer":
						@exploreTab(p)
					case "connection":
						@connectionTab(p)
					case "logs":
						@logsTab(p)
					case "learn":
						@learnTab(p)
					default:
						@serviceOverview(p)
				}
			</div>
		}
	}
}

func serviceSubtitle(p servicePage) string {
	d := p.Details
	parts := []string{}
	switch d.Kind {
	case "app":
		if len(d.Replicas) > 1 {
			parts = append(parts, fmt.Sprintf("replica %d of %d", d.Instance, len(d.Replicas)))
		}
		parts = append(parts, "your code in "+d.Path)
		if len(d.Command) > 0 {
			parts = append(parts, "runs "+strings.Join(d.Command, " "))
		}
	case "sidecar":
		if d.Registry != "" {
			parts = append(parts, d.Title+" agent registering "+d.Parent)
		} else {
			parts = append(parts, d.Title+" sidecar of "+d.Parent)
		}
	default:
		parts = append(parts, d.Image)
	}
	if u := uptime(p.Row); u != "" {
		parts = append(parts, u)
	}
	return strings.Join(parts, " · ")
}

func uptime(r row) string {
	if r.State != "running" || r.StartedAt.IsZero() {
		return ""
	}
	return "up " + humanDuration(time.Since(r.StartedAt))
}

templ serviceOverview(p servicePage) {
	<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_360px]">
		<div class="flex flex-col gap-6">
			@card() {
				<div class="p-6">
					<h2 class="text-base font-semibold">What you're running</h2>
					<div class="mt-3 text-[15px] leading-7 text-slate-700">
						if p.Details.Kind == "app" {
							<p>
								Your code from <code class="font-mono text-sm">{ p.Details.Path }</code>, compiled into its image and run as <code class="font-mono text-sm">{ strings.Join(p.Details.Command, " ") }</code>.
								if len(p.Row.Uses) > 0 {
									It connects to { usesList(p.Row.Uses) }.
								}
							</p>
						} else if p.Details.Kind == "sidecar" && p.Details.Registry != "" {
							<p>A Consul client agent sharing { p.Details.Parent }'s network address and certificate. It joined the Consul server { p.Details.Registry } and registered { p.Details.Parent } there with a health check; when it stops, it leaves and the registration goes with it.</p>
						} else if p.Details.HostRouter {
							<p>The lab's host router. It is the only container published on your machine for host access: { hostRouterListen(p.Dash) }. It answers each <code class="font-mono text-sm">host</code> target at its own <code class="font-mono text-sm">*.localhost</code> name, terminates TLS with a certificate from the host CA, and opens a new TLS connection to the target, verified against the lab CA. Breadboard generates its configuration; it has no Docker socket.</p>
						} else if p.Details.Kind == "sidecar" {
							<p>{ p.Details.Summary } It runs in { p.Details.Parent }'s pod: same network namespace (same address, same <code class="font-mono text-sm">localhost</code>), same certificate, and the shared directory <code class="font-mono text-sm">/var/run/bb</code>. The app reaches it on loopback; other containers only see the ports it opens to them.</p>
						} else {
							@noteBlocks(p.Notes.section("What you got").Blocks)
						}
					</div>
				</div>
			}
			if p.Details.HostRouter {
				@hostRoutesCard(p)
			}
			if len(p.Details.Upstreams) > 0 {
				@upstreamsCard(p)
			}
			if p.Details.File != "" || p.Details.StaticFile != "" {
				@userConfigCard(p)
			}
			if p.Details.Kind == "app" && len(p.Details.Replicas) > 1 {
				@replicasCard(p)
			}
			for _, sc := range p.Details.Sidecars {
				@sidecarCard(p, sc)
			}
			if p.Details.Sidecar != nil {
				@sidecarCard(p, *p.Details.Sidecar)
			}
			if p.Details.Kind == "infra" && !p.Details.HostRouter {
				<div class="grid gap-6 md:grid-cols-2">
					@exerciseCard("Try this", "text-indigo-700", p.Notes.section("Try this").bullets())
					@exerciseCard("Break this", "text-red-700", p.Notes.section("Break this").bullets())
				</div>
			}
		</div>
		<div class="flex flex-col gap-6">
			@connectionCard(p)
			@resourcesCard(p.Row)
			@certificateCard(p.Details.Certificate)
		</div>
	</div>
}

func usesList(uses []core.Edge) string {
	names := make([]string, len(uses))
	for i, e := range uses {
		names[i] = e.To
		if e.Via != "" {
			names[i] += " (through its " + e.Via + " sidecar)"
		}
		if !e.TLS {
			names[i] += " (plaintext)"
		}
	}
	return strings.Join(names, ", ")
}

// upstreamsCard lists a proxy's upstreams: where each route goes, in which
// TLS mode, to which port.
templ upstreamsCard(p servicePage) {
	@card() {
		<div class="px-6 pt-6 pb-4">
			<h2 class="text-base font-semibold">Upstreams</h2>
			<p class="mt-1 text-sm text-slate-600">Where { p.Row.Name } sends traffic. Apps reach it with <code class="font-mono text-[13px]">uses: [{ p.Row.Name }]</code>; an app upstream is balanced over every replica.</p>
		</div>
		<table class="w-full text-left text-sm">
			<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
				<tr>
					@th("Target")
					@th("Mode")
					@th("Port")
					@th("Route")
				</tr>
			</thead>
			<tbody class="divide-y divide-slate-200">
				for _, u := range p.Details.Upstreams {
					<tr class={ templ.KV("bg-red-50", u.Mode == "off") }>
						<td class="px-5 py-2.5">
							<a href={ templ.SafeURL(serviceLink(p.Dash.Services, u.Service)) } class="font-semibold hover:text-indigo-700">{ proxyTargetLabel(u) }</a>
							if u.Name != u.Service {
								<div class="font-mono text-xs text-slate-500">route { u.Name }</div>
							}
						</td>
						<td class="px-5 py-2.5">
							@modeBadge(u.Mode)
							<div class={ "mt-1 text-xs", templ.KV("text-red-700", u.Mode == "off"), templ.KV("text-slate-500", u.Mode != "off") }>{ modeHelp(u.Mode) }</div>
							if u.Reason != "" {
								<div class="mt-1 text-xs text-red-700">Reason: { u.Reason }</div>
							}
						</td>
						<td class="px-5 py-2.5 font-mono text-[13px]">:{ itoa(u.Port) }</td>
						<td class="px-5 py-2.5 text-slate-700">{ u.Route }</td>
					</tr>
				}
			</tbody>
		</table>
		<div class="p-5 text-xs text-slate-500">Live state of each backend: the <a href={ templ.SafeURL("/services/" + p.Row.Name + "?tab=explore") } class="text-indigo-600 hover:text-indigo-800">{ explorerTabs[p.Details.Type] }</a> tab.</div>
	}
}

// userConfigCard names a proxy's own config files from experiment.yaml:
// file replaces the generated config, static_file extends the static one.
templ userConfigCard(p servicePage) {
	@card() {
		<div class="px-6 pt-6 pb-4">
			<h2 class="text-base font-semibold">Your config</h2>
			<p class="mt-1 text-sm text-slate-600">Files next to <code class="font-mono text-[13px]">experiment.yaml</code>, copied in at every <code class="font-mono text-[13px]">bb up</code>. An edit recreates { p.Row.Name }.</p>
		</div>
		<dl class="divide-y divide-slate-200 border-t border-slate-200 text-sm">
			if p.Details.File != "" {
				<div class="px-6 py-3">
					<dt class="font-mono text-[13px] text-slate-500">file</dt>
					<dd class="mt-1"><code class="font-mono text-[13px]">{ p.Details.File }</code> <span class="text-slate-600">replaces the generated config.</span></dd>
				</div>
			}
			if p.Details.StaticFile != "" {
				<div class="px-6 py-3">
					<dt class="font-mono text-[13px] text-slate-500">static_file</dt>
					<dd class="mt-1"><code class="font-mono text-[13px]">{ p.Details.StaticFile }</code> <span class="text-slate-600">is merged into the generated static config (traefik.yml). Entry points, providers, the API, ping and global stay Breadboard's.</span></dd>
				</div>
			}
		</dl>
	}
}

// hostRouterListen is where the host router listens on the host.
func hostRouterListen(d dashboardData) string {
	if d.HostPort == 0 {
		return "127.0.0.1, on a port chosen at the next bb up"
	}
	return "127.0.0.1:" + itoa(d.HostPort)
}

// hostRoutesCard lists the host router's routes: each host name and the
// containers it reaches.
templ hostRoutesCard(p servicePage) {
	@card() {
		<div class="px-6 pt-6 pb-4">
			<h2 class="text-base font-semibold">Host routes</h2>
			<p class="mt-1 text-sm text-slate-600">Each URL opens from a browser or curl on your machine. Trust the host CA first: <code class="font-mono text-[13px]">bb ca</code> shows how.</p>
		</div>
		if len(p.Dash.HostURLs) == 0 {
			<p class="border-t border-slate-200 px-6 py-4 text-sm text-slate-600">The URLs appear after the next <code class="font-mono">bb up</code>.</p>
		} else {
			<table class="w-full text-left text-sm">
				<thead class="border-y border-slate-200 bg-slate-50 text-slate-500">
					<tr>
						@th("URL")
						@th("Reaches")
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-200">
					for _, u := range p.Dash.HostURLs {
						<tr>
							<td class="px-5 py-2.5">
								<a href={ templ.SafeURL(u.URL) } target="_blank" rel="noopener" class="break-all font-mono text-[13px] text-indigo-600 hover:text-indigo-800">{ u.URL }</a>
							</td>
							<td class="px-5 py-2.5">
								<a href={ templ.SafeURL(serviceLink(p.Dash.Services, hostTarget(u))) } class="hover:text-indigo-700">{ hostRoute(p.Dash.Services, u) }</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		<div class="p-5 text-xs text-slate-500">
			Live state of each route: the <a href={ templ.SafeURL("/services/" + p.Row.Name + "?tab=explore") } class="text-indigo-600 hover:text-indigo-800">{ explorerTabs[p.Details.Type] }</a> tab. How it works: <a href="/docs/getting-started/host-access" class="text-indigo-600 hover:text-indigo-800">Host access</a>.
		</div>
	}
}

// replicasCard lists an app's instances with their live state.
templ replicasCard(p servicePage) {
	@card() {
		<div class="p-6">
			<h2 class="text-base font-semibold">Replicas</h2>
			<p class="mt-1 text-sm text-slate-600">{ itoa(len(p.Details.Replicas)) } instances of { p.Details.App }, each reachable by its own name and all of them as <code class="font-mono text-[13px]">{ p.Details.App }.{ p.Dash.Domain }</code>.</p>
			<div class="mt-4 grid gap-2 md:grid-cols-3">
				for _, name := range p.Details.Replicas {
					if r, ok := find(p.Dash.Services, name); ok {
						<a href={ templ.SafeURL("/services/" + name) } class={ "rounded-lg border px-3 py-2", templ.KV("border-indigo-600", name == p.Row.Name), templ.KV("border-slate-200 hover:border-slate-400", name != p.Row.Name) }>
							<div class="flex items-center justify-between">
								<span class="font-semibold">{ name }</span>
								@statusWord(r.Status())
							</div>
							<div class="mt-1 font-mono text-xs text-slate-500">{ r.Address }</div>
						</a>
					}
				}
			</div>
		</div>
	}
}

// sidecarCard explains one sidecar: what it does, what it listens on, and
// the environment it gives the app. Secret values never appear.
templ sidecarCard(p servicePage, sc core.SidecarInfo) {
	@card() {
		<div class="p-6">
			<div class="flex items-start justify-between gap-4">
				<div>
					<h2 class="text-base font-semibold">
						<a href={ templ.SafeURL("/services/" + sc.Service) } class="hover:text-indigo-700">{ sc.Service }</a>
						<span class="font-normal text-slate-500">· { sc.Title } sidecar</span>
					</h2>
					<p class="mt-1 text-sm text-slate-600">{ sc.Summary }</p>
				</div>
				if r, ok := find(p.Dash.Services, sc.Service); ok {
					@statusWord(r.Status())
				}
			</div>
			if sc.Transparent {
				<p class="mt-3 rounded-lg bg-slate-800 px-3 py-2 text-sm text-white">Transparent mode: iptables rules in the pod send every TCP connection of the app through Envoy. Undeclared destinations are { egressWord(sc.Egress) }.</p>
			}
			if len(sc.Ports) > 0 {
				<div class="mt-4 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Listens on</div>
				<div class="mt-2 flex flex-col gap-1.5 text-sm">
					for _, port := range sc.Ports {
						<div class="flex gap-4">
							<span class="w-32 shrink-0 font-mono text-[13px] text-slate-900">{ portAddr(port) }</span>
							<span class="text-slate-600">
								{ port.Purpose }
								if port.Loopback {
									<span class="text-slate-500">(loopback: only the app and its sidecars)</span>
								}
							</span>
						</div>
					}
				</div>
			}
			if len(sc.Env) > 0 || len(sc.Rewrites) > 0 {
				<div class="mt-4 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Gives the app</div>
				<div class="mt-2 grid gap-3 md:grid-cols-2">
					for _, v := range sc.Env {
						@envVar(v, credsService(sc))
					}
					for _, v := range sc.Rewrites {
						@envVar(v, credsService(sc))
					}
				</div>
				if len(sc.Rewrites) > 0 {
					<p class="mt-2 text-xs text-slate-500">{ rewriteNote(sc) }</p>
				}
			}
			if len(sc.Settings) > 0 {
				<div class="mt-4 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Settings</div>
				<div class="mt-1">
					for _, st := range sc.Settings {
						@kv(st.Name) {
							<span class="font-mono text-[13px]">{ st.Value }</span>
						}
					}
				</div>
			}
		</div>
	}
}

func egressWord(egress string) string {
	if egress == "deny" {
		return "refused (egress deny)"
	}
	return "passed through untouched (egress allow)"
}

// credsService is where bb creds finds a sidecar's secret values: the
// service it connects to.
func credsService(sc core.SidecarInfo) string {
	if len(sc.Targets) > 0 {
		return sc.Targets[0]
	}
	return sc.Service
}

func rewriteNote(sc core.SidecarInfo) string {
	names := make([]string, len(sc.Rewrites))
	for i, v := range sc.Rewrites {
		names[i] = v.Name
	}
	return strings.Join(names, ", ") + " replace the values " + strings.Join(sc.Targets, ", ") + " would give, so the app connects through " + sc.Name + " without code changes."
}

templ exerciseCard(label, color string, items [][]inline) {
	@card() {
		<div class="p-6">
			<div class={ "text-[11px] font-semibold uppercase tracking-wider", color }>{ label }</div>
			<ul class="mt-3 flex flex-col gap-3 text-sm leading-6 text-slate-700">
				for _, it := range items {
					<li>
						@inlineText(it)
					</li>
				}
			</ul>
		</div>
	}
}

templ kv(k string) {
	<div class="flex items-start justify-between gap-4 py-1.5 text-sm">
		<span class="text-slate-500">{ k }</span>
		<span class="text-right">
			{ children... }
		</span>
	</div>
}

templ connectionCard(p servicePage) {
	@card() {
		<div class="p-5">
			<h2 class="text-base font-semibold">Connection</h2>
			<div class="mt-3">
				@kv("Address") {
					<span class="font-mono text-[13px]">{ p.Details.Address }</span>
				}
				if len(p.Details.Listeners) > 0 {
					@kv("Protocol") {
						{ listenerSummary(p.Details.Listeners[0]) }
					}
					@kv("Client auth") {
						None in v1
					}
				}
				if len(p.Details.UsedBy) > 0 {
					@kv("Used by") {
						{ strings.Join(p.Details.UsedBy, ", ") }
					}
				}
				if registries := discovered(p.Row.Uses, "registry"); len(registries) > 0 {
					@kv("Discovers") {
						{ strings.Join(registries, ", ") }
					}
				}
				if routes := discovered(p.Row.Uses, "route"); len(routes) > 0 {
					@kv("Routes to") {
						{ strings.Join(routes, ", ") }
					}
				}
				if p.Details.HostRouter {
					@kv("On the host") {
						<span class="font-mono text-[13px]">{ hostRouterListen(p.Dash) }</span>
					}
				}
				if len(p.Details.HostURLs) > 0 {
					@kv("From the host") {
						for _, u := range p.Details.HostURLs {
							<a href={ templ.SafeURL(u) } target="_blank" rel="noopener" class="block break-all font-mono text-[13px] text-indigo-600 hover:text-indigo-800">{ u }</a>
						}
					}
				}
			</div>
			if p.Details.Kind == "infra" && len(p.Details.Env) > 0 {
				<div class="mt-4 border-t border-slate-200 pt-4 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Env vars injected into apps</div>
				<div class="mt-2 flex flex-col gap-2.5">
					for _, v := range p.Details.Env[0].Vars {
						@envVar(v, p.Row.Name)
					}
				</div>
			}
		</div>
	}
}

// discovered lists the targets of a proxy's discovery edges of one kind:
// the registry it discovers routes in, or the apps it routes to from there.
func discovered(uses []core.Edge, kind string) []string {
	var out []string
	for _, e := range uses {
		if e.Discovery == kind {
			out = append(out, e.To)
		}
	}
	return out
}

func listenerSummary(l core.Listener) string {
	s := fmt.Sprintf("%s over TLS :%d", strings.ToUpper(l.Protocol[:1])+l.Protocol[1:], l.Port)
	if l.Protocol == "https" {
		s = fmt.Sprintf("HTTPS :%d", l.Port)
	}
	return s
}

templ envVar(v core.EnvVar, service string) {
	<div class="text-[13px]">
		<div class="font-mono font-semibold text-slate-900">{ v.Name }</div>
		if v.Secret {
			<div class="font-mono text-slate-500">hidden · <span class="text-slate-700">bb creds { service }</span></div>
		} else {
			<div class="break-all font-mono text-slate-600">{ v.Value }</div>
		}
	</div>
}

templ resourcesCard(r row) {
	@card() {
		<div class="p-5">
			<h2 class="text-base font-semibold">Resources</h2>
			<div class="mt-3 flex flex-col gap-3 text-sm">
				<div>
					<div class="flex justify-between"><span class="text-slate-500">CPU</span><span>{ fmt.Sprintf("%.2f / %.2f cores", r.CPUUsed, r.CPULimit) }</span></div>
					<div class="mt-1.5">
						@bar(r.CPUUsed, r.CPULimit, false)
					</div>
				</div>
				<div>
					<div class="flex justify-between"><span class="text-slate-500">Memory</span><span>{ fmt.Sprintf("%.0f / %.0f MiB", r.MemUsed, r.MemLimit) }</span></div>
					<div class="mt-1.5">
						@bar(r.MemUsed, r.MemLimit, r.Status().Color == "amber")
					</div>
				</div>
			</div>
		</div>
	}
}

templ certificateCard(c *core.Certificate) {
	@card() {
		<div class="p-5">
			<h2 class="text-base font-semibold">Certificate</h2>
			if c == nil {
				<p class="mt-3 text-sm text-slate-600">Issued on the first <code class="font-mono">bb up</code>.</p>
			} else {
				<div class="mt-3">
					@kv("Issuer") {
						{ c.Issuer }
					}
					@kv("Name") {
						<span class="font-mono text-[13px]">{ strings.Join(c.DNSNames, ", ") }</span>
					}
					@kv("Expires") {
						{ expiresIn(c.NotAfter) }
					}
				</div>
				<div class="mt-2 break-all font-mono text-xs text-slate-500">{ c.Identity }</div>
			}
		</div>
	}
}

func expiresIn(t time.Time) string {
	days := int(time.Until(t).Hours() / 24)
	switch {
	case days < 0:
		return "expired"
	case days == 0:
		return "today"
	case days == 1:
		return "in 1 day"
	}
	return fmt.Sprintf("in %d days", days)
}

templ connectionTab(p servicePage) {
	<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_360px]">
		@card() {
			<div class="p-6">
				if p.Details.Kind == "app" {
					<h2 class="text-base font-semibold">Environment of { p.Row.Name }</h2>
					<p class="mt-1 text-sm text-slate-600">Every variable this container starts with. Your code reads these; it holds no addresses or credentials of its own.</p>
				} else {
					<h2 class="text-base font-semibold">What apps receive</h2>
					<p class="mt-1 text-sm text-slate-600">Each app that lists { p.Row.Name } under <code class="font-mono">uses</code> starts with these variables.</p>
				}
				for _, g := range p.Details.Env {
					<div class="mt-5">
						<div class={ "text-[11px] font-semibold uppercase tracking-wider", templ.KV("text-red-700", g.Plaintext), templ.KV("text-slate-500", !g.Plaintext) }>
							if g.Service == "" {
								Breadboard
							} else {
								{ g.Service } · { g.Title }
								if g.Plaintext {
									· plaintext: { g.Reason }
								}
							}
						</div>
						<div class="mt-2 grid gap-3 md:grid-cols-2">
							for _, v := range g.Vars {
								@envVar(v, g.Service)
							}
						</div>
					</div>
				}
				if len(p.Details.Env) == 0 {
					<p class="mt-4 text-sm text-slate-600">This service receives no environment from Breadboard beyond its own configuration.</p>
				}
			</div>
		}
		<div class="flex flex-col gap-6">
			@connectionCard(p)
			if p.Details.Kind == "infra" {
				@card() {
					<div class="p-5">
						<h2 class="text-base font-semibold">Credentials</h2>
						<p class="mt-2 text-sm text-slate-600">The UI never shows secrets. Print them in your terminal:</p>
						<div class="mt-3">
							@terminal("bb creds " + p.Row.Name)
						</div>
					</div>
				}
			}
		</div>
	</div>
}

templ logsTab(p servicePage) {
	@card() {
		<div class="flex items-center justify-between px-5 pt-4 pb-3">
			<h2 class="text-base font-semibold">Logs</h2>
			<span class="font-mono text-xs text-slate-500">bb logs { p.Row.Name } -f</span>
		</div>
		<pre class="h-[560px] overflow-auto rounded-b-xl bg-slate-900 px-5 py-4 font-mono text-[12.5px] leading-5 text-slate-100" data-logs={ "/live/logs/" + p.Row.Name }></pre>
	}
}

templ learnTab(p servicePage) {
	@card() {
		<article class="max-w-3xl p-6">
			for _, s := range p.Notes.Sections {
				if s.Heading != "" {
					<h2 class="mt-6 text-lg font-semibold first:mt-0">{ s.Heading }</h2>
				}
				<div class="mt-2 text-[15px] leading-7 text-slate-700">
					@noteBlocks(s.Blocks)
				</div>
			}
			<a href={ templ.SafeURL("/docs/" + p.Details.Type) } class="mt-6 inline-block text-sm text-indigo-600 hover:text-indigo-800">Read the { p.Details.Title } docs →</a>
		</article>
	}
}

templ noteBlocks(blocks []noteBlock) {
	for _, b := range blocks {
		if b.List {
			<ul class="my-2 list-disc space-y-1.5 pl-5">
				for _, it := range b.Items {
					<li>
						@inlineText(it)
					</li>
				}
			</ul>
		} else {
			for _, it := range b.Items {
				<p class="my-2">
					@inlineText(it)
				</p>
			}
		}
	}
}

templ inlineText(parts []inline) {
	for _, in := range parts {
		if in.Code {
			<code class="rounded bg-slate-100 px-1 py-0.5 font-mono text-[0.9em]">{ in.Text }</code>
		} else if in.Bold {
			<strong class="font-semibold text-slate-900">{ in.Text }</strong>
		} else {
			{ in.Text }
		}
	}
}
