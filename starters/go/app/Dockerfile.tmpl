# dev: what bb up runs. Your program is compiled here, while the image
# builds, so the container starts the finished binary: it is PID 1, receives
# SIGTERM, and is running (not compiling) when its health check passes.
FROM golang:{{.GoImage}} AS dev
ENV CGO_ENABLED=0
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# The cache mount keeps compiled packages between builds, so a rebuild after
# an edit only recompiles what changed.
RUN --mount=type=cache,target=/root/.cache/go-build go build -o /usr/local/bin/{{.Name}} .

# prod: a small non-root image of the same binary.
#   docker build --target prod -t {{.Name}} .
FROM alpine:{{.AlpineVersion}} AS prod
LABEL maintainer="Your Name <you@example.com>" \
      version="0.1.0" \
      description="{{.Name}}, written in a Breadboard lab" \
      platform="linux"
RUN adduser -D -u 10001 app
COPY --from=dev /usr/local/bin/{{.Name}} /usr/local/bin/{{.Name}}
USER app
ENTRYPOINT ["/usr/local/bin/{{.Name}}"]
