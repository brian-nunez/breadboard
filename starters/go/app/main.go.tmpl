// Command {{.Name}} is your own program in the Breadboard lab {{.Experiment}}.
// bb add app wrote it once; from now on it is yours to change.
//
// # What your lab gives this app
//
{{- if .Uses}}
// bb up starts this program with environment variables for every service in
// its uses (experiment.yaml): addresses, credentials and CA files. Your code
// reads them with os.Getenv and never hard-codes one. Variables marked secret
// hold a generated password or key; bb creds shows every value.
{{- range .Uses}}
//
// {{.Service}} ({{.Title}}): {{.Summary}}
//
{{- range .Vars}}
//	{{.Pad}}  {{.Help}}{{if .Secret}} (secret){{else if .Value}}: {{.Value}}{{end}}
{{- end}}
{{- end}}
{{- else}}
// No services yet. Add one with bb add <type> (bb catalog lists them), list
// it under this app's uses in experiment.yaml, and run bb up: the app then
// receives its variables. README.md walks through it.
{{- end}}
//
// TLS: every connection in the lab is TLS, verified against the lab CA.
// SSL_CERT_FILE points at the lab's trust bundle, and Go's crypto/tls reads
// it, so clients verify servers with no certificate code.
//
// Serving TLS yourself: BB_FQDN is this app's address, and TLS_CERT_FILE and
// TLS_KEY_FILE are its certificate and key, issued for that name.
package main

import (
	"context"
{{- if .NeedKafka}}
	"crypto/tls"
{{- end}}
{{- if .NeedOtel}}
	"errors"
{{- end}}
	"fmt"
	"log"
{{- if .NeedOtel}}
	"log/slog"
{{- end}}
{{- if .NeedHTTP}}
	"net/http"
{{- end}}
	"os"
	"os/signal"
	"strings"
	"syscall"
{{- if or .NeedHTTP .NeedOtel}}
	"time"
{{- end}}
{{- if or .NeedPostgres .NeedRedis .NeedKafka .NeedS3 .NeedConsul .NeedOtel .NeedOpenSearch .NeedNats}}

{{- if .NeedS3}}
	"github.com/aws/aws-sdk-go-v2/aws"
	"github.com/aws/aws-sdk-go-v2/config"
	"github.com/aws/aws-sdk-go-v2/credentials"
	"github.com/aws/aws-sdk-go-v2/service/s3"
{{- end}}
{{- if .NeedConsul}}
	consulapi "github.com/hashicorp/consul/api"
{{- end}}
{{- if .NeedPostgres}}
	"github.com/jackc/pgx/v5/pgxpool"
{{- end}}
{{- if .NeedNats}}
	"github.com/nats-io/nats.go"
{{- end}}
{{- if .NeedOpenSearch}}
	"github.com/opensearch-project/opensearch-go/v5"
	"github.com/opensearch-project/opensearch-go/v5/opensearchapi"
{{- end}}
{{- if .NeedRedis}}
	"github.com/redis/go-redis/v9"
{{- end}}
{{- if .NeedKafka}}
	"github.com/twmb/franz-go/pkg/kadm"
	"github.com/twmb/franz-go/pkg/kgo"
{{- end}}
{{- if .NeedOtel}}
	"go.opentelemetry.io/contrib/bridges/otelslog"
	"go.opentelemetry.io/otel"
	"go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploggrpc"
	"go.opentelemetry.io/otel/exporters/otlp/otlpmetric/otlpmetricgrpc"
	"go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc"
	otellogglobal "go.opentelemetry.io/otel/log/global"
	"go.opentelemetry.io/otel/propagation"
	sdklog "go.opentelemetry.io/otel/sdk/log"
	sdkmetric "go.opentelemetry.io/otel/sdk/metric"
	"go.opentelemetry.io/otel/sdk/resource"
	sdktrace "go.opentelemetry.io/otel/sdk/trace"
	semconv "go.opentelemetry.io/otel/semconv/v1.43.0"
{{- end}}
{{- end}}
)

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

{{- if .Uses}}
	requireEnv(
{{- range .Uses}}
		// {{.Service}} ({{.Title}})
		{{range $i, $v := .Vars}}{{if $i}} {{end}}"{{$v.Name}}",{{end}}
{{- end}}
	)
{{- else}}
	// Add a service's variables here when you add it to uses.
	requireEnv()
{{- end}}
{{- if .NeedHTTP}}

	httpClient := newHTTPClient()
	_ = httpClient
{{- end}}
{{- range .Wires}}
{{- if eq .Kind "postgres"}}

	{{.Var}} := newPostgres(ctx, "{{index .Env "url"}}")
	defer {{.Var}}.Close()
{{- else if eq .Kind "redis"}}

	{{.Var}} := newRedis(ctx, "{{index .Env "url"}}")
	defer {{.Var}}.Close()
{{- else if eq .Kind "kafka"}}

	{{.Var}} := newKafkaProducer(ctx, "{{index .Env "brokers"}}", "{{index .Env "proto"}}", "events")
	defer {{.Var}}.Close()

	{{.Var2}} := newKafkaConsumer(ctx, "{{index .Env "brokers"}}", "{{index .Env "proto"}}", "events", "{{$.Name}}-group")
	defer {{.Var2}}.Close()
{{- else if eq .Kind "s3"}}

	{{.Var}} := newS3(ctx, "{{index .Env "endpoint"}}", "{{index .Env "region"}}", "{{index .Env "key"}}", "{{index .Env "secret"}}")
	_ = {{.Var}}
{{- else if eq .Kind "consul"}}

	{{.Var}} := newConsul("{{index .Env "addr"}}", "{{index .Env "ca"}}")
	_ = {{.Var}}
{{- else if eq .Kind "otel"}}

	{{.Var}} := newOtel(ctx, "{{index .Env "endpoint"}}", "{{index .Env "traces"}}", "{{index .Env "metrics"}}", "{{index .Env "logs"}}")
	defer func() {
		shutdownCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = {{.Var}}(shutdownCtx)
	}()
{{- else if eq .Kind "opensearch"}}

	{{.Var}} := newOpenSearch(ctx, "{{index .Env "url"}}", "{{index .Env "user"}}", "{{index .Env "password"}}")
	_ = {{.Var}}
{{- else if eq .Kind "nats"}}

	{{.Var}} := newNats("{{index .Env "url"}}", "{{index .Env "token"}}")
	defer {{.Var}}.Close()
{{- else if eq .Kind "http"}}

	{{.Var}} := os.Getenv("{{index .Env "url"}}")
	_ = {{.Var}}
{{- end}}
{{- end}}

	// Your experiment goes here.
{{- if .Uses}}
	log.Println("{{.Name}}: connected and ready (edit main.go and run bb up)")
{{- else}}
	log.Println("{{.Name}}: ready (edit main.go and run bb up)")
{{- end}}
	<-ctx.Done()
}

// --- Wiring -----------------------------------------------------------------

// requireEnv exits with one message listing every name in names that is
// unset or empty. bb up sets them all from uses in experiment.yaml, so a
// missing one means uses changed without bb up, or the program runs outside
// Breadboard without them.
func requireEnv(names ...string) {
	var missing []string
	for _, name := range names {
		if os.Getenv(name) == "" {
			missing = append(missing, name)
		}
	}
	if len(missing) > 0 {
		fmt.Fprintf(os.Stderr, "{{.Name}} cannot start: missing environment variables: %s\n"+
			"bb up sets them from uses in experiment.yaml, and bb creds shows their values.\n", strings.Join(missing, ", "))
		os.Exit(1)
	}
}
{{- if .NeedPostgres}}

func newPostgres(ctx context.Context, urlEnv string) *pgxpool.Pool {
	pool, err := pgxpool.New(ctx, os.Getenv(urlEnv))
	if err != nil {
		log.Fatalf("postgres (%s): %v", urlEnv, err)
	}
	if err := pool.Ping(ctx); err != nil {
		log.Fatalf("postgres (%s) ping: %v", urlEnv, err)
	}
	return pool
}
{{- end}}
{{- if .NeedRedis}}

func newRedis(ctx context.Context, urlEnv string) *redis.Client {
	opts, err := redis.ParseURL(os.Getenv(urlEnv))
	if err != nil {
		log.Fatalf("redis (%s): %v", urlEnv, err)
	}
	client := redis.NewClient(opts)
	if err := client.Ping(ctx).Err(); err != nil {
		log.Fatalf("redis (%s) ping: %v", urlEnv, err)
	}
	return client
}
{{- end}}
{{- if .NeedKafka}}

func newKafkaProducer(ctx context.Context, brokersEnv, protoEnv, topic string) *kgo.Client {
	opts := []kgo.Opt{
		kgo.SeedBrokers(strings.Split(os.Getenv(brokersEnv), ",")...),
		kgo.DefaultProduceTopic(topic),
	}
	if os.Getenv(protoEnv) == "SSL" {
		opts = append(opts, kgo.DialTLSConfig(new(tls.Config)))
	}
	client, err := kgo.NewClient(opts...)
	if err != nil {
		log.Fatalf("kafka producer (%s): %v", brokersEnv, err)
	}
	if err := client.Ping(ctx); err != nil {
		log.Fatalf("kafka producer (%s) ping: %v", brokersEnv, err)
	}
	// The broker does not auto-create topics, so ensure the demo topic exists
	// (3 partitions, 1 replica). If it already exists, nothing changes.
	_, _ = kadm.NewClient(client).CreateTopic(ctx, 3, 1, nil, topic)
	return client
}

func newKafkaConsumer(ctx context.Context, brokersEnv, protoEnv, topic, group string) *kgo.Client {
	opts := []kgo.Opt{
		kgo.SeedBrokers(strings.Split(os.Getenv(brokersEnv), ",")...),
		kgo.ConsumerGroup(group),
		kgo.ConsumeTopics(topic),
		// Start from the oldest record, and reset there if an offset falls out of range.
		kgo.ConsumeResetOffset(kgo.NewOffset().AtStart()),
	}
	if os.Getenv(protoEnv) == "SSL" {
		opts = append(opts, kgo.DialTLSConfig(new(tls.Config)))
	}
	client, err := kgo.NewClient(opts...)
	if err != nil {
		log.Fatalf("kafka consumer (%s): %v", brokersEnv, err)
	}
	if err := client.Ping(ctx); err != nil {
		log.Fatalf("kafka consumer (%s) ping: %v", brokersEnv, err)
	}
	return client
}
{{- end}}
{{- if .NeedS3}}

func newS3(ctx context.Context, endpointEnv, regionEnv, keyEnv, secretEnv string) *s3.Client {
	cfg, err := config.LoadDefaultConfig(ctx,
		config.WithRegion(os.Getenv(regionEnv)),
		config.WithCredentialsProvider(credentials.NewStaticCredentialsProvider(
			os.Getenv(keyEnv), os.Getenv(secretEnv), "",
		)),
	)
	if err != nil {
		log.Fatalf("s3 (%s): %v", endpointEnv, err)
	}
	client := s3.NewFromConfig(cfg, func(o *s3.Options) {
		o.BaseEndpoint = aws.String(os.Getenv(endpointEnv))
		o.UsePathStyle = true
	})
	if _, err := client.ListBuckets(ctx, &s3.ListBucketsInput{}); err != nil {
		log.Fatalf("s3 (%s) check: %v", endpointEnv, err)
	}
	return client
}
{{- end}}
{{- if .NeedConsul}}

func newConsul(addrEnv, caEnv string) *consulapi.Client {
	cfg := consulapi.DefaultConfig()
	cfg.Address = os.Getenv(addrEnv)
	cfg.Scheme = "http"
	if caEnv != "" {
		cfg.TLSConfig.CAFile = os.Getenv(caEnv)
	}
	client, err := consulapi.NewClient(cfg)
	if err != nil {
		log.Fatalf("consul (%s): %v", addrEnv, err)
	}
	if _, err := client.Status().Leader(); err != nil {
		log.Fatalf("consul (%s) check: %v", addrEnv, err)
	}
	return client
}
{{- end}}
{{- if .NeedOtel}}

func newOtel(ctx context.Context, endpointEnv, tracesEnv, metricsEnv, logsEnv string) func(context.Context) error {
	endpoint := os.Getenv(endpointEnv)
	svcName := os.Getenv("BB_SERVICE")
	if svcName == "" {
		svcName = "{{.Name}}"
	}

	res, err := resource.Merge(
		resource.Default(),
		resource.NewSchemaless(
			semconv.ServiceName(svcName),
			semconv.ServiceInstanceID(svcName),
		),
	)
	if err != nil {
		log.Fatalf("otel (%s) resource: %v", endpointEnv, err)
	}

	otel.SetTextMapPropagator(propagation.NewCompositeTextMapPropagator(
		propagation.TraceContext{},
		propagation.Baggage{},
	))

	var shutdowns []func(context.Context) error

	if os.Getenv(tracesEnv) == "otlp" {
		exp, err := otlptracegrpc.New(ctx, otlptracegrpc.WithEndpointURL(endpoint))
		if err != nil {
			log.Fatalf("otel traces (%s): %v", endpointEnv, err)
		}
		tp := sdktrace.NewTracerProvider(sdktrace.WithBatcher(exp), sdktrace.WithResource(res))
		otel.SetTracerProvider(tp)
		_, span := tp.Tracer(svcName).Start(ctx, "startup")
		span.End()
		if err := tp.ForceFlush(ctx); err != nil {
			log.Fatalf("otel traces (%s) flush: %v", endpointEnv, err)
		}
		shutdowns = append(shutdowns, tp.Shutdown)
	}

	if os.Getenv(metricsEnv) == "otlp" {
		exp, err := otlpmetricgrpc.New(ctx, otlpmetricgrpc.WithEndpointURL(endpoint))
		if err != nil {
			log.Fatalf("otel metrics (%s): %v", endpointEnv, err)
		}
		mp := sdkmetric.NewMeterProvider(
			sdkmetric.WithReader(sdkmetric.NewPeriodicReader(exp, sdkmetric.WithInterval(5*time.Second))),
			sdkmetric.WithResource(res),
		)
		otel.SetMeterProvider(mp)
		if err := mp.ForceFlush(ctx); err != nil {
			log.Fatalf("otel metrics (%s) flush: %v", endpointEnv, err)
		}
		shutdowns = append(shutdowns, mp.Shutdown)
	}

	if os.Getenv(logsEnv) == "otlp" {
		exp, err := otlploggrpc.New(ctx, otlploggrpc.WithEndpointURL(endpoint))
		if err != nil {
			log.Fatalf("otel logs (%s): %v", endpointEnv, err)
		}
		lp := sdklog.NewLoggerProvider(sdklog.WithProcessor(sdklog.NewBatchProcessor(exp)), sdklog.WithResource(res))
		otellogglobal.SetLoggerProvider(lp)
		slog.SetDefault(otelslog.NewLogger(svcName))
		slog.InfoContext(ctx, "connected to OpenTelemetry collector", "service", svcName)
		if err := lp.ForceFlush(ctx); err != nil {
			log.Fatalf("otel logs (%s) flush: %v", endpointEnv, err)
		}
		shutdowns = append(shutdowns, lp.Shutdown)
	}

	return func(c context.Context) error {
		var errs []error
		for _, fn := range shutdowns {
			errs = append(errs, fn(c))
		}
		return errors.Join(errs...)
	}
}
{{- end}}
{{- if .NeedOpenSearch}}

func newOpenSearch(ctx context.Context, urlEnv, userEnv, passwordEnv string) *opensearchapi.Client {
	client, err := opensearchapi.NewClient(opensearchapi.Config{
		Client: opensearch.Config{
			Addresses: []string{os.Getenv(urlEnv)},
			Username:  os.Getenv(userEnv),
			Password:  os.Getenv(passwordEnv),
		},
	})
	if err != nil {
		log.Fatalf("opensearch (%s): %v", urlEnv, err)
	}
	if _, err := client.Info(ctx, nil); err != nil {
		log.Fatalf("opensearch (%s) check: %v", urlEnv, err)
	}
	return client
}
{{- end}}
{{- if .NeedNats}}

func newNats(urlEnv, tokenEnv string) *nats.Conn {
	nc, err := nats.Connect(os.Getenv(urlEnv), nats.Token(os.Getenv(tokenEnv)))
	if err != nil {
		log.Fatalf("nats (%s): %v", urlEnv, err)
	}
	if err := nc.Flush(); err != nil {
		log.Fatalf("nats (%s) check: %v", urlEnv, err)
	}
	return nc
}
{{- end}}
{{- if .NeedHTTP}}

func newHTTPClient() *http.Client {
	// Go's default TLS transport reads SSL_CERT_FILE, so requests to any
	// HTTPS proxy or service in the lab verify against the lab CA.
	return &http.Client{Timeout: 10 * time.Second}
}
{{- end}}
