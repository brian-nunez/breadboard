# envoy.yaml for cb-edge, from the gw/circuit-breaking starter. You own it:
# experiment.yaml sets services.cb-edge.file to this file, and bb up loads
# your edits (bb up again after a change).
#
# A circuit breaker in front of a slow backend. Envoy counts what it has
# in flight to cb-backend (connections, requests, requests waiting for a
# connection) and, once a limit is reached, answers new requests itself
# with an immediate 503 and x-envoy-overloaded: true instead of piling
# them onto the backend. The backend keeps serving at the speed it can;
# the excess fails fast, where a client can back off or try elsewhere.
#
# Envoy's word "circuit breaker" means these concurrency limits. The
# other kind, which stops calling a backend after it fails, is outlier
# detection (see the sidecar/circuit-breaking and lb/health-checks
# starters).
#
#   https://cb-edge:8443/  -> cb-backend, at most 5 requests at once
#
# Keep the admin API on 127.0.0.1:15000 (bb's health check reads /ready;
# bb serve's Envoy tab and MCP envoy_clusters read /clusters and /stats)
# and the TLS listener on 8443.

node:
  id: cb-edge
  cluster: cb-edge
admin:
  address:
    socket_address:
      address: 127.0.0.1
      port_value: 15000
static_resources:
  listeners:
    - name: https
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 8443
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: https
                codec_type: AUTO
                use_remote_address: true
                # No access log: the client sends hundreds of requests a
                # second, most of them refused. The cluster's counters in
                # bb serve's Envoy tab tell the story better.
                route_config:
                  name: cb-edge
                  virtual_hosts:
                    - name: cb-edge
                      domains:
                        - '*'
                      routes:
                        - match:
                            prefix: /
                          route:
                            cluster: cb-backend
                            # A request waiting for a connection waits at
                            # most this long in total (15s by default).
                            timeout: 5s
                            # No retries: a request refused by the breaker
                            # is not tried again behind the client's back.
                            # Retries have their own limit, max_retries.
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
          transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
              common_tls_context:
                tls_params:
                  tls_minimum_protocol_version: TLSv1_2
                alpn_protocols:
                  - h2
                  - http/1.1
                tls_certificates:
                  - certificate_chain:
                      filename: /etc/bb/tls/tls.crt
                    private_key:
                      filename: /etc/bb/tls/tls.key
  clusters:
    - name: cb-backend
      cluster_type:
        name: envoy.clusters.dns
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster
          dns_lookup_family: V4_ONLY
          dns_refresh_rate: 5s
      connect_timeout: 2s
      lb_policy: ROUND_ROBIN
      # HTTP/1.1 to the backend, said out loud: one request per connection
      # at a time, so connections and requests in flight move together.
      # Over HTTP/2 many requests share one connection, max_connections
      # hardly matters, and max_requests does the limiting.
      typed_extension_protocol_options:
        envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
          '@type': type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
          explicit_http_config:
            http_protocol_options: {}
      # The circuit breaker: limits on what Envoy has outstanding to this
      # cluster, all hosts together. Each overflow fails the request at
      # once with 503 and x-envoy-overloaded: true, and counts in a stat.
      # The defaults (1024 connections, 1024 pending, 1024 requests, 3
      # retries) protect Envoy more than a small backend.
      circuit_breakers:
        thresholds:
          - priority: DEFAULT
            # Connections Envoy opens to the cluster. Over the limit, a
            # request waits for a busy connection instead (pending), and
            # upstream_cx_overflow counts. Envoy may open one more than
            # this so every host has at least one connection: a soft limit.
            max_connections: 5
            # Requests waiting for a free connection. When the queue is
            # full, the next request is refused: upstream_rq_pending_overflow.
            max_pending_requests: 5
            # Requests outstanding to the cluster at once, the hard cap on
            # what cb-backend sees: upstream_rq_active_overflow.
            max_requests: 5
            # Retries in flight at once (the default). Retry budgets, a
            # share of active requests instead, are in gw/retries-and-timeouts.
            max_retries: 3
            # Publish remaining_cx, remaining_pending, remaining_rq and
            # remaining_retries gauges: how close each limit is.
            track_remaining: true
      load_assignment:
        cluster_name: cb-backend
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: cb-backend.{{.Domain}}
                      port_value: 8443
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: cb-backend.{{.Domain}}
          common_tls_context:
            validation_context:
              trusted_ca:
                filename: /etc/bb/ca.pem
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher:
                    exact: cb-backend.{{.Domain}}
