// Command grpc-inventory serves the gRPC service inventory.v1.Inventory
// (see proto/inventory.proto) over TLS on :8443. Envoy sends it every call
// whose path starts with /inventory.v1.Inventory/, on the same listener
// that serves the catalog.
package main

import (
	"context"
	"log"
	"net"
	"os"
	"time"

	"google.golang.org/grpc"
	"google.golang.org/grpc/credentials"
	"google.golang.org/grpc/health"
	healthpb "google.golang.org/grpc/health/grpc_health_v1"
	"google.golang.org/grpc/metadata"
	"google.golang.org/protobuf/types/known/structpb"
	"google.golang.org/protobuf/types/known/wrapperspb"
)

var name = os.Getenv("BB_SERVICE")

// Envoy routes on the HTTP/2 path, /<service>/<method>.
const service = "inventory.v1.Inventory"

// inventory is the service's description for grpc-go, as
// protoc-gen-go-grpc would generate it from proto/inventory.proto.
var inventory = grpc.ServiceDesc{
	ServiceName: service,
	Methods:     []grpc.MethodDesc{unary("CheckStock", checkStock)},
	Metadata:    "proto/inventory.proto",
}

func checkStock(ctx context.Context, sku string) (map[string]any, error) {
	log.Printf("CheckStock %s (%s)", sku, deadline(ctx))
	return map[string]any{"sku": sku, "in_stock": true, "warehouse": "east"}, nil
}

func main() {
	creds, err := credentials.NewServerTLSFromFile(os.Getenv("TLS_CERT_FILE"), os.Getenv("TLS_KEY_FILE"))
	if err != nil {
		log.Fatal(err)
	}
	s := grpc.NewServer(grpc.Creds(creds))
	s.RegisterService(&inventory, nil)
	healthpb.RegisterHealthServer(s, health.NewServer())

	lis, err := net.Listen("tcp", ":8443")
	if err != nil {
		log.Fatal(err)
	}
	log.Printf("%s serving inventory.v1.Inventory over TLS on :8443", name)
	log.Fatal(s.Serve(lis))
}

// unary turns fn into the grpc.MethodDesc of one method: the request is a
// StringValue, the response a Struct, and the answer carries this
// service's name in the x-served-by header.
func unary(method string, fn func(context.Context, string) (map[string]any, error)) grpc.MethodDesc {
	call := func(ctx context.Context, req any) (any, error) {
		grpc.SetHeader(ctx, metadata.Pairs("x-served-by", name))
		out, err := fn(ctx, req.(*wrapperspb.StringValue).GetValue())
		if err != nil {
			return nil, err
		}
		return structpb.NewStruct(out)
	}
	return grpc.MethodDesc{
		MethodName: method,
		Handler: func(_ any, ctx context.Context, dec func(any) error, interceptor grpc.UnaryServerInterceptor) (any, error) {
			in := new(wrapperspb.StringValue)
			if err := dec(in); err != nil {
				return nil, err
			}
			if interceptor == nil {
				return call(ctx, in)
			}
			return interceptor(ctx, in, &grpc.UnaryServerInfo{FullMethod: "/" + service + "/" + method}, call)
		},
	}
}

// deadline describes the deadline the call arrived with.
func deadline(ctx context.Context) string {
	if d, ok := ctx.Deadline(); ok {
		return "deadline in " + time.Until(d).Round(time.Millisecond).String()
	}
	return "no deadline"
}
