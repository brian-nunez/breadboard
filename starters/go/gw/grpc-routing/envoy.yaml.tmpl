# envoy.yaml for grpc-edge, from the gw/grpc-routing starter. You own it:
# experiment.yaml sets services.grpc-edge.file to this file, and bb up loads
# your edits (bb up again after a change).
#
# gRPC through a gateway. A gRPC call is an HTTP/2 POST to the path
# /<package>.<Service>/<Method>, with content-type application/grpc and
# its status in the grpc-status trailer. So one TLS listener can route
# calls to different services by path, like any HTTP request:
#
#   /catalog.v1.Catalog/Search    -> catalog, limited to 500 ms
#   /catalog.v1.Catalog/...       -> catalog (2 replicas, balanced per call)
#   /inventory.v1.Inventory/...   -> inventory
#   any other service             -> no route: UNIMPLEMENTED from Envoy
#
# Keep the admin API on 127.0.0.1:15000 (bb's health check reads /ready;
# bb serve's Envoy tab and MCP envoy_clusters read /clusters and /stats)
# and the TLS listener on 8443.

node:
  id: grpc-edge
  cluster: grpc-edge
admin:
  address:
    socket_address:
      address: 127.0.0.1
      port_value: 15000
static_resources:
  listeners:
    - name: https
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 8443
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: https
                # AUTO picks HTTP/2 when the client negotiated h2 by ALPN,
                # as every gRPC client does.
                codec_type: AUTO
                use_remote_address: true
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                route_config:
                  name: grpc-edge
                  virtual_hosts:
                    - name: grpc-edge
                      domains:
                        - '*'
                      # The first matching route wins, so the rule for one
                      # method comes before the rule for its whole service.
                      routes:
                        - match:
                            path: /catalog.v1.Catalog/Search
                            # Match only gRPC requests (content-type
                            # application/grpc).
                            grpc: {}
                          route:
                            cluster: catalog
                            # A deadline for this method alone. When it
                            # passes, Envoy cancels the call upstream and
                            # answers the client itself with grpc-status 4,
                            # DEADLINE_EXCEEDED ("downstream duration
                            # timeout").
                            max_stream_duration:
                              # Used when the call carries no grpc-timeout.
                              max_stream_duration: 0.5s
                              # When it does (a client with a deadline), use
                              # the client's deadline, but never more than
                              # this.
                              grpc_timeout_header_max: 0.5s
                        - match:
                            prefix: /catalog.v1.Catalog/
                            grpc: {}
                          route:
                            cluster: catalog
                            max_stream_duration:
                              # Honour the client's deadline, up to 5s.
                              grpc_timeout_header_max: 5s
                        - match:
                            prefix: /inventory.v1.Inventory/
                            grpc: {}
                          route:
                            cluster: inventory
                            max_stream_duration:
                              grpc_timeout_header_max: 5s
                http_filters:
                  # Counts calls per service and method in the route's
                  # cluster: cluster.catalog.grpc.catalog.v1.Catalog.Search.
                  # success, failure and total. Only the methods listed get
                  # their own counters; naming every method a client sends
                  # would let clients create stats without limit.
                  - name: envoy.filters.http.grpc_stats
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.filters.http.grpc_stats.v3.FilterConfig
                      individual_method_stats_allowlist:
                        services:
                          - name: catalog.v1.Catalog
                            method_names:
                              - GetItem
                              - Search
                          - name: inventory.v1.Inventory
                            method_names:
                              - CheckStock
                  - name: envoy.filters.http.router
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
          transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
              common_tls_context:
                tls_params:
                  tls_minimum_protocol_version: TLSv1_2
                alpn_protocols:
                  - h2
                  - http/1.1
                tls_certificates:
                  - certificate_chain:
                      filename: /etc/bb/tls/tls.crt
                    private_key:
                      filename: /etc/bb/tls/tls.key
  clusters:
    # catalog: both replicas of grpc-catalog (the envoy.clusters.dns
    # extension, strict DNS: every address the name resolves to is a host,
    # re-resolved every 5s). Envoy holds HTTP/2 connections to each and
    # balances calls across them, one call at a time: a single client
    # connection still reaches both replicas.
    - name: catalog
      cluster_type:
        name: envoy.clusters.dns
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster
          dns_lookup_family: V4_ONLY
          dns_refresh_rate: 5s
      connect_timeout: 2s
      lb_policy: ROUND_ROBIN
      # gRPC needs HTTP/2 to the backend too.
      typed_extension_protocol_options:
        envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
          '@type': type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
          explicit_http_config:
            http2_protocol_options: {}
      load_assignment:
        cluster_name: catalog
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: grpc-catalog.{{.Domain}}
                      port_value: 8443
      # The standard gRPC health check: grpc.health.v1.Health/Check, which
      # each server answers SERVING.
      health_checks:
        - timeout: 2s
          interval: 2s
          no_traffic_interval: 2s
          unhealthy_threshold: 3
          healthy_threshold: 2
          grpc_health_check:
            authority: grpc-catalog.{{.Domain}}
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: grpc-catalog.{{.Domain}}
          common_tls_context:
            # Offer HTTP/2 by ALPN in the TLS handshake, as gRPC over TLS
            # expects.
            alpn_protocols:
              - h2
            validation_context:
              trusted_ca:
                filename: /etc/bb/ca.pem
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher:
                    exact: grpc-catalog.{{.Domain}}
    # inventory: the same, to grpc-inventory.
    - name: inventory
      cluster_type:
        name: envoy.clusters.dns
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster
          dns_lookup_family: V4_ONLY
          dns_refresh_rate: 5s
      connect_timeout: 2s
      lb_policy: ROUND_ROBIN
      typed_extension_protocol_options:
        envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
          '@type': type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
          explicit_http_config:
            http2_protocol_options: {}
      load_assignment:
        cluster_name: inventory
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: grpc-inventory.{{.Domain}}
                      port_value: 8443
      health_checks:
        - timeout: 2s
          interval: 2s
          no_traffic_interval: 2s
          unhealthy_threshold: 3
          healthy_threshold: 2
          grpc_health_check:
            authority: grpc-inventory.{{.Domain}}
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: grpc-inventory.{{.Domain}}
          common_tls_context:
            alpn_protocols:
              - h2
            validation_context:
              trusted_ca:
                filename: /etc/bb/ca.pem
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher:
                    exact: grpc-inventory.{{.Domain}}
