# envoy.yaml for jwt-edge, from the gw/jwt-auth starter. You own it:
# experiment.yaml sets services.jwt-edge.file to this file, and bb up loads
# your edits (bb up again after a change).
#
# Authentication at the edge. The jwt_authn filter checks every request to
# /api/ for a bearer token, verifies its signature with the issuer's public
# keys (a JWKS it fetches over TLS from jwt-issuer), and checks its issuer,
# audience and expiry. A request without a valid token gets 401 from Envoy
# (403 for a valid token meant for another audience) and never reaches the
# backend. A valid one is forwarded with its claims
# as plain headers, and without the token itself.
#
#   https://jwt-edge:8443/token?user=alice  -> jwt-issuer (no token needed)
#   https://jwt-edge:8443/api/...           -> jwt-backend (a valid JWT)
#   anything else                           -> 404 from Envoy
#
# Keep the admin API on 127.0.0.1:15000 (bb's health check reads /ready;
# bb serve's Envoy tab and MCP envoy_clusters read /clusters and /stats)
# and the TLS listener on 8443.

node:
  id: jwt-edge
  cluster: jwt-edge
admin:
  address:
    socket_address:
      address: 127.0.0.1
      port_value: 15000
static_resources:
  listeners:
    - name: https
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 8443
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: https
                codec_type: AUTO
                use_remote_address: true
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                route_config:
                  name: jwt-edge
                  virtual_hosts:
                    - name: jwt-edge
                      domains:
                        - '*'
                      routes:
                        - match:
                            path: /token
                          route:
                            cluster: issuer
                        - match:
                            prefix: /api/
                          route:
                            cluster: backend
                http_filters:
                  # Filters run in order: authentication first, routing last.
                  - name: envoy.filters.http.jwt_authn
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.JwtAuthentication
                      providers:
                        issuer:
                          # The token's iss claim must be exactly this, and
                          # its aud claim must contain jwt-api. A token
                          # for another audience gets 403, "Audiences in
                          # Jwt are not allowed".
                          issuer: https://jwt-issuer.{{.Domain}}
                          audiences:
                            - jwt-api
                          # Envoy looks for "Authorization: Bearer <JWT>"
                          # (the default location) and checks exp and nbf
                          # with clock_skew_seconds of slack (default 60).
                          remote_jwks:
                            http_uri:
                              uri: https://jwt-issuer.{{.Domain}}:8443/.well-known/jwks.json
                              # The fetch goes through the issuer cluster
                              # below, so it is TLS, verified against the
                              # lab CA as jwt-issuer.<domain>.
                              cluster: issuer
                              timeout: 2s
                            # How long the keys are cached (default 10m).
                            # A rotated key verifies only after a refetch.
                            cache_duration: 30s
                            # Fetch at startup and in the background, not on
                            # the first request. If the issuer is not up yet,
                            # retry every failed_refetch_duration (1s).
                            async_fetch: {}
                          # Strip the token before forwarding (the default,
                          # written out): the backend gets claims, not a
                          # credential it could leak or replay.
                          forward: false
                          # Copy claims into request headers. Envoy sets them
                          # from the verified token, replacing any header of
                          # the same name the client sent.
                          claim_to_headers:
                            - header_name: x-jwt-sub
                              claim_name: sub
                            - header_name: x-jwt-scope
                              claim_name: scope
                      rules:
                        # The first matching rule wins. No requires: the
                        # issuer's token endpoint is open.
                        - match:
                            path: /token
                        - match:
                            prefix: /api/
                          requires:
                            provider_name: issuer
                  - name: envoy.filters.http.router
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
          transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
              common_tls_context:
                tls_params:
                  tls_minimum_protocol_version: TLSv1_2
                alpn_protocols:
                  - h2
                  - http/1.1
                tls_certificates:
                  - certificate_chain:
                      filename: /etc/bb/tls/tls.crt
                    private_key:
                      filename: /etc/bb/tls/tls.key
  clusters:
    # backend: TLS to jwt-backend, verified against the lab CA as
    # jwt-backend.<domain>. Strict DNS (the envoy.clusters.dns extension):
    # every address the name resolves to is a host, re-resolved every 5s.
    - name: backend
      cluster_type:
        name: envoy.clusters.dns
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster
          dns_lookup_family: V4_ONLY
          dns_refresh_rate: 5s
      connect_timeout: 2s
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: backend
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: jwt-backend.{{.Domain}}
                      port_value: 8443
      health_checks:
        - timeout: 2s
          interval: 2s
          no_traffic_interval: 2s
          unhealthy_threshold: 3
          healthy_threshold: 2
          http_health_check:
            host: jwt-backend.{{.Domain}}
            path: /
            # Any answer below 500 means up: the app has no route for
            # GET / and answers 404, which proves it is serving.
            expected_statuses:
              - start: 200
                end: 500
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: jwt-backend.{{.Domain}}
          common_tls_context:
            validation_context:
              trusted_ca:
                filename: /etc/bb/ca.pem
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher:
                    exact: jwt-backend.{{.Domain}}
    # issuer: the same, to jwt-issuer. It serves both the /token route and
    # the JWKS fetch above.
    - name: issuer
      cluster_type:
        name: envoy.clusters.dns
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster
          dns_lookup_family: V4_ONLY
          dns_refresh_rate: 5s
      connect_timeout: 2s
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: issuer
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: jwt-issuer.{{.Domain}}
                      port_value: 8443
      health_checks:
        - timeout: 2s
          interval: 2s
          no_traffic_interval: 2s
          unhealthy_threshold: 3
          healthy_threshold: 2
          http_health_check:
            host: jwt-issuer.{{.Domain}}
            path: /
            expected_statuses:
              - start: 200
                end: 500
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: jwt-issuer.{{.Domain}}
          common_tls_context:
            validation_context:
              trusted_ca:
                filename: /etc/bb/ca.pem
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher:
                    exact: jwt-issuer.{{.Domain}}
