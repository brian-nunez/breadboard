// Command route-users is the users service behind the gateway. The gateway
// strips /users before forwarding, so this service routes on its own paths,
// / and /<id>, and never needs to know where it is mounted.
package main

import (
	"fmt"
	"log"
	"net/http"
	"os"
)

func main() {
	name := os.Getenv("BB_SERVICE") // route-users
	mux := http.NewServeMux()
	mux.HandleFunc("GET /{$}", func(w http.ResponseWriter, r *http.Request) {
		answer(w, r, name, http.StatusOK, "users: ada, grace, linus")
	})
	mux.HandleFunc("GET /{id}", func(w http.ResponseWriter, r *http.Request) {
		answer(w, r, name, http.StatusOK, "user "+r.PathValue("id"))
	})
	mux.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
		answer(w, r, name, http.StatusNotFound, "no such users path")
	})
	// Breadboard mounts this app's own certificate and points these at it.
	log.Printf("%s listening on :8443", name)
	log.Fatal(http.ListenAndServeTLS(":8443", os.Getenv("TLS_CERT_FILE"), os.Getenv("TLS_KEY_FILE"), mux))
}

// answer names this service and what it received: the path after the
// gateway's rewrite, the prefix the gateway removed (X-Forwarded-Prefix,
// set by Traefik's stripPrefix) and the Host the client asked for.
func answer(w http.ResponseWriter, r *http.Request, name string, status int, body string) {
	w.Header().Set("X-Instance", name)
	w.WriteHeader(status)
	fmt.Fprintf(w, "%s path=%s prefix=%s host=%s | %s\n", name, r.URL.Path, or(r.Header.Get("X-Forwarded-Prefix")), r.Host, body)
	log.Printf("%s %s (prefix %s, host %s) -> %d", r.Method, r.URL.Path, or(r.Header.Get("X-Forwarded-Prefix")), r.Host, status)
}

func or(s string) string {
	if s == "" {
		return "-"
	}
	return s
}
