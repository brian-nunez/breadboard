# envoy.yaml for rate-token, from the gw/rate-limiting starter. You own it:
# experiment.yaml sets services.rate-token.file to this file, and bb up
# loads your edits (bb up again after a change).
#
# A token bucket per client. Each client (the X-Client-Id header) gets a
# bucket of 10 tokens, refilled with 5 tokens every second. A request takes
# one token or, if the bucket is empty, is answered 429 at once. So a
# client can send 5 requests a second forever, or a burst of up to 10 at
# once after a quiet moment: the burst passes immediately, the rest of it is
# rejected. Compare rate-leaky (NGINX, nginx.conf), which queues a burst.
#
#   https://rate-token:8443/  -> rate-backend, at most 5 r/s per client
#
# Keep the admin API on 127.0.0.1:15000 (bb's health check reads /ready;
# bb serve's Envoy tab and MCP envoy_clusters read /clusters and /stats)
# and the TLS listener on 8443.

node:
  id: rate-token
  cluster: rate-token
admin:
  address:
    socket_address:
      address: 127.0.0.1
      port_value: 15000
static_resources:
  listeners:
    - name: https
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 8443
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: https
                codec_type: AUTO
                use_remote_address: true
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                route_config:
                  name: rate-token
                  virtual_hosts:
                    - name: rate-token
                      domains:
                        - '*'
                      # Tell the backend which gateway sent a request.
                      request_headers_to_add:
                        - header:
                            key: x-via
                            value: rate-token
                          append_action: OVERWRITE_IF_EXISTS_OR_ADD
                      routes:
                        - match:
                            prefix: /
                          route:
                            cluster: rate-backend
                http_filters:
                  # Filters run in order: the rate limiter decides before the
                  # router forwards anything, so a rejected request never
                  # reaches rate-backend.
                  - name: envoy.filters.http.local_ratelimit
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.filters.http.local_ratelimit.v3.LocalRateLimit
                      # Stats: http_local_rate_limit.rate_limited and
                      # .enforced under this prefix, in bb serve's Envoy tab.
                      stat_prefix: rate_token
                      # Local: this Envoy's buckets, in its memory, shared by
                      # its worker threads. Two Envoys would each allow the
                      # full rate. A global limit needs a rate limit service
                      # that every gateway asks (the ratelimit filter).
                      #
                      # 1. The key. Each request gets a descriptor
                      # (client, <its X-Client-Id>). Without the header there
                      # is no descriptor, and the default bucket applies.
                      rate_limits:
                        - actions:
                            - request_headers:
                                header_name: x-client-id
                                descriptor_key: client
                      # 2. A bucket per key. The entry names the key and
                      # leaves the value out: a wildcard, so every distinct
                      # client gets its own bucket, created on its first
                      # request. A second entry with value: alice gives one
                      # client a tighter limit: Envoy takes a token from
                      # every descriptor a request matches, so the smaller
                      # bucket decides.
                      descriptors:
                        - entries:
                            - key: client
                          token_bucket:
                            # The burst: a full bucket, and where it starts.
                            max_tokens: 10
                            # The steady rate: 5 tokens per second.
                            tokens_per_fill: 5
                            fill_interval: 1s
                      # How many clients' buckets are kept (least recently
                      # used ones are dropped). The default is 20.
                      max_dynamic_descriptors: 1000
                      # 3. The default bucket: requests without a client key.
                      # It is generous here; make it small to limit
                      # anonymous callers. By default Envoy takes a token
                      # from it on every request, keyed or not; false takes
                      # one only when no descriptor matched.
                      token_bucket:
                        max_tokens: 1000
                        tokens_per_fill: 1000
                        fill_interval: 1s
                      always_consume_default_token_bucket: false
                      # Both default to 0%, which turns the filter off. 100%
                      # enabled and enforced: every request is counted and
                      # every excess one rejected. Enabled but not enforced
                      # is a dry run: counted in the stats, still forwarded.
                      filter_enabled:
                        runtime_key: rate_token_enabled
                        default_value:
                          numerator: 100
                          denominator: HUNDRED
                      filter_enforced:
                        runtime_key: rate_token_enforced
                        default_value:
                          numerator: 100
                          denominator: HUNDRED
                      # Rejected requests get 429 (the default status) and
                      # x-envoy-ratelimited: true. These add the
                      # X-RateLimit-Limit, -Remaining and -Reset headers to
                      # every response and Retry-After to rejected ones, so
                      # a well-behaved client knows when to come back.
                      enable_x_ratelimit_headers: DRAFT_VERSION_03
                      enable_retry_after_header: true
                  - name: envoy.filters.http.router
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
          transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
              common_tls_context:
                tls_params:
                  tls_minimum_protocol_version: TLSv1_2
                alpn_protocols:
                  - h2
                  - http/1.1
                tls_certificates:
                  - certificate_chain:
                      filename: /etc/bb/tls/tls.crt
                    private_key:
                      filename: /etc/bb/tls/tls.key
  clusters:
    # rate-backend: TLS to every address rate-backend.<domain> resolves to,
    # verified against the lab CA, re-resolved every 5s (the
    # envoy.clusters.dns extension).
    - name: rate-backend
      cluster_type:
        name: envoy.clusters.dns
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster
          dns_lookup_family: V4_ONLY
          dns_refresh_rate: 5s
      connect_timeout: 2s
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: rate-backend
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: rate-backend.{{.Domain}}
                      port_value: 8443
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: rate-backend.{{.Domain}}
          common_tls_context:
            validation_context:
              trusted_ca:
                filename: /etc/bb/ca.pem
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher:
                    exact: rate-backend.{{.Domain}}
