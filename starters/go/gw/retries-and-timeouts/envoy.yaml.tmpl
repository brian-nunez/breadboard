# envoy.yaml for retry-edge, from the gw/retries-and-timeouts starter. You
# own it: experiment.yaml sets services.retry-edge.file to this file, and
# bb up loads your edits (bb up again after a change).
#
# Timeouts and retries at the gateway, and what keeps retries from turning
# an outage into a storm. Four routes, two backends:
#
#   /flaky/no-retries -> retry-flaky   one try, 1s timeout
#   /flaky/retries    -> retry-flaky   up to 4 tries of 250ms each, 2s in all
#   /down/no-budget   -> retry-down    up to 4 tries, retries unlimited
#   /down/budget      -> retry-down    up to 4 tries, within a retry budget
#
# retry-flaky fails 4 requests in 10, independently, so a second try
# usually works: retries turn its 60% into nearly 100%. retry-down fails
# every request, so retries only multiply its load: up to 4 times without
# a budget, a bounded share with one.
#
# Keep the admin API on 127.0.0.1:15000 (bb's health check reads /ready;
# bb serve's Envoy tab and MCP envoy_clusters read /clusters and /stats)
# and the TLS listener on 8443.

node:
  id: retry-edge
  cluster: retry-edge
admin:
  address:
    socket_address:
      address: 127.0.0.1
      port_value: 15000
static_resources:
  listeners:
    - name: https
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 8443
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: https
                codec_type: AUTO
                use_remote_address: true
                # No access log: the client sends 120 requests a second.
                # Each cluster's upstream_rq_retry* counters in bb serve's
                # Envoy tab tell the story better.
                route_config:
                  name: retry-edge
                  virtual_hosts:
                    - name: retry-edge
                      domains:
                        - '*'
                      # Number each try in x-envoy-attempt-count: on the
                      # request to the backend (1 for the first try, 2 for
                      # the first retry...), and on the response to the
                      # client (how many tries it took). Both apps log it.
                      include_request_attempt_count: true
                      include_attempt_count_in_response: true
                      routes:
                        # No retries. timeout is the whole request's
                        # deadline (15s by default): a stuck backend answer
                        # becomes a 504 after 1s instead of holding the
                        # client for 3s. Every failure reaches the client.
                        - match:
                            path: /flaky/no-retries
                          route:
                            cluster: retry-flaky
                            timeout: 1s
                        # Retries with a per-try timeout.
                        - match:
                            path: /flaky/retries
                          route:
                            cluster: retry-flaky
                            # The client's deadline, for all tries together,
                            # back-off included. When it passes, Envoy
                            # answers 504 even if a try is still running.
                            timeout: 2s
                            retry_policy:
                              # Which failures are worth another try. 5xx
                              # covers any 5xx answer, a reset or refused
                              # connection, and a try that timed out
                              # (per_try_timeout). Narrower choices:
                              # gateway-error (502, 503, 504 only),
                              # connect-failure, reset, retriable-4xx
                              # (409), retriable-status-codes.
                              retry_on: 5xx
                              # Retries after the first try: up to 4 tries.
                              num_retries: 3
                              # Give up on one try after 250ms and try
                              # again: retry-flaky's stuck answers take 3s,
                              # its good ones 10ms. Without it, a try may
                              # use the whole 2s.
                              per_try_timeout: 0.25s
                              # Wait before retry n: a random time below
                              # base_interval * 2^(n-1), at most
                              # max_interval (default 10 * base): below
                              # 25ms, then 50ms, then 100ms. Jitter
                              # spreads retries out instead of sending them
                              # all at once. These are the defaults.
                              retry_back_off:
                                base_interval: 0.025s
                                max_interval: 0.25s
                        # The same policy against a service that is down,
                        # through two clusters that differ only in how they
                        # limit retries (see the clusters below).
                        - match:
                            path: /down/no-budget
                          route:
                            cluster: retry-down-no-budget
                            timeout: 2s
                            retry_policy:
                              retry_on: 5xx
                              num_retries: 3
                              per_try_timeout: 0.25s
                        - match:
                            path: /down/budget
                          route:
                            cluster: retry-down-budget
                            timeout: 2s
                            retry_policy:
                              retry_on: 5xx
                              num_retries: 3
                              per_try_timeout: 0.25s
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
          transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
              common_tls_context:
                tls_params:
                  tls_minimum_protocol_version: TLSv1_2
                alpn_protocols:
                  - h2
                  - http/1.1
                tls_certificates:
                  - certificate_chain:
                      filename: /etc/bb/tls/tls.crt
                    private_key:
                      filename: /etc/bb/tls/tls.key
  clusters:
    # Each cluster: TLS to every address its backend's name resolves to,
    # verified against the lab CA, re-resolved every 5s.
    - name: retry-flaky
      cluster_type:
        name: envoy.clusters.dns
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster
          dns_lookup_family: V4_ONLY
          dns_refresh_rate: 5s
      connect_timeout: 2s
      lb_policy: ROUND_ROBIN
      # Retries in flight at once to this cluster. The default, 3, is a
      # circuit breaker on retries: past it a failed try is not retried
      # (upstream_rq_retry_overflow). 3 is easily reached here, where a
      # stuck try holds its slot for 250ms, so it is raised for this
      # healthy-but-flaky backend.
      circuit_breakers:
        thresholds:
          - priority: DEFAULT
            max_retries: 100
      load_assignment:
        cluster_name: retry-flaky
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: retry-flaky.{{.Domain}}
                      port_value: 8443
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: retry-flaky.{{.Domain}}
          common_tls_context:
            validation_context:
              trusted_ca:
                filename: /etc/bb/ca.pem
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher:
                    exact: retry-flaky.{{.Domain}}

    # retry-down without a budget: retries in flight are limited only by
    # max_retries, set as high as many real configs have it. Every failed
    # try is retried, so retry-down receives 4 tries per client request:
    # the retry storm. In a chain of services that each retry 3 times, the
    # load multiplies at every hop (4 x 4 x 4...).
    - name: retry-down-no-budget
      cluster_type:
        name: envoy.clusters.dns
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster
          dns_lookup_family: V4_ONLY
          dns_refresh_rate: 5s
      connect_timeout: 2s
      lb_policy: ROUND_ROBIN
      circuit_breakers:
        thresholds:
          - priority: DEFAULT
            max_retries: 1000
      load_assignment:
        cluster_name: retry-down-no-budget
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: retry-down.{{.Domain}}
                      port_value: 8443
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: retry-down.{{.Domain}}
          common_tls_context:
            validation_context:
              trusted_ca:
                filename: /etc/bb/ca.pem
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher:
                    exact: retry-down.{{.Domain}}

    # retry-down with a retry budget: retries in flight may be at most
    # budget_percent of the requests in flight (active plus pending), and
    # never fewer than min_retry_concurrency. When most tries fail, the
    # budget runs out, and a failed try that would exceed it is answered
    # with its failure instead of being retried
    # (upstream_rq_retry_overflow). Retries stay a small share of the load
    # however bad the outage, while a healthy cluster, with few failures,
    # still retries all of them. A budget replaces max_retries.
    - name: retry-down-budget
      cluster_type:
        name: envoy.clusters.dns
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster
          dns_lookup_family: V4_ONLY
          dns_refresh_rate: 5s
      connect_timeout: 2s
      lb_policy: ROUND_ROBIN
      circuit_breakers:
        thresholds:
          - priority: DEFAULT
            retry_budget:
              # The default is 20%.
              budget_percent:
                value: 20
              # The default is 3, which at this traffic (about 2 requests
              # in flight) would allow far more than 20%.
              min_retry_concurrency: 1
      load_assignment:
        cluster_name: retry-down-budget
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: retry-down.{{.Domain}}
                      port_value: 8443
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: retry-down.{{.Domain}}
          common_tls_context:
            validation_context:
              trusted_ca:
                filename: /etc/bb/ca.pem
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher:
                    exact: retry-down.{{.Domain}}
