// Package kafkaenv builds franz-go client options from the environment that
// Breadboard injects (KAFKA_BROKERS, KAFKA_SECURITY_PROTOCOL). The same code
// runs anywhere those variables are set: nothing here is Breadboard-specific.
package kafkaenv

import (
	"crypto/tls"
	"fmt"
	"os"
	"strings"

	"github.com/twmb/franz-go/pkg/kgo"
)

// Options returns the connection options every client in this project shares.
func Options() ([]kgo.Opt, error) {
	brokers := os.Getenv("KAFKA_BROKERS")
	if brokers == "" {
		return nil, fmt.Errorf("KAFKA_BROKERS is not set")
	}
	opts := []kgo.Opt{
		// Seed brokers are only the first contact. The client asks them for
		// cluster metadata and then talks to whichever broker leads each
		// partition.
		kgo.SeedBrokers(strings.Split(brokers, ",")...),
	}
	switch protocol := os.Getenv("KAFKA_SECURITY_PROTOCOL"); protocol {
	case "SSL":
		// An empty tls.Config means: verify the broker's certificate against
		// the system roots and check that it matches the broker's hostname.
		// Go reads extra roots from SSL_CERT_FILE, which points at a bundle
		// that includes the CA that signed the broker's certificate, so no
		// certificate paths appear in code.
		opts = append(opts, kgo.DialTLSConfig(&tls.Config{MinVersion: tls.VersionTLS12}))
	case "", "PLAINTEXT":
		// Plaintext: only valid when experiment.yaml turned TLS off for this
		// edge on purpose.
	default:
		return nil, fmt.Errorf("KAFKA_SECURITY_PROTOCOL %q is not supported (use SSL or PLAINTEXT)", protocol)
	}
	return opts, nil
}

// Topic returns the topic both apps use.
func Topic() string {
	if t := os.Getenv("ORDERS_TOPIC"); t != "" {
		return t
	}
	return "orders"
}
