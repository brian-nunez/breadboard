// Command sink copies order events from Kafka into a Postgres table.
package main

import (
	"context"
	"crypto/tls"
	"encoding/json"
	"log"
	"os"
	"strings"

	"github.com/jackc/pgx/v5"
	"github.com/twmb/franz-go/pkg/kgo"
)

type Order struct {
	ID          string `json:"id"`
	Customer    string `json:"customer"`
	AmountCents int    `json:"amount_cents"`
}

func main() {
	ctx := context.Background()
	db, err := pgx.Connect(ctx, os.Getenv("DATABASE_URL"))
	if err != nil {
		log.Fatal(err)
	}
	defer db.Close(ctx)

	// A one-step migration: create the table if it is missing. Real projects
	// keep numbered migrations and a tool that applies each one once.
	if _, err := db.Exec(ctx, `CREATE TABLE IF NOT EXISTS orders (
		id           text PRIMARY KEY,
		customer     text NOT NULL,
		amount_cents integer NOT NULL,
		stored_at    timestamptz NOT NULL DEFAULT now()
	)`); err != nil {
		log.Fatal(err)
	}

	client, err := kgo.NewClient(
		kgo.SeedBrokers(strings.Split(os.Getenv("KAFKA_BROKERS"), ",")...),
		kgo.DialTLSConfig(new(tls.Config)),
		kgo.ConsumerGroup("orders-sink"),
		kgo.ConsumeTopics("order-events"),
		kgo.ConsumeResetOffset(kgo.NewOffset().AtStart()),
		// Commit offsets ourselves, only after the rows are written.
		kgo.DisableAutoCommit(),
	)
	if err != nil {
		log.Fatal(err)
	}
	defer client.Close()

	for {
		fetches := client.PollFetches(ctx)
		fetches.EachError(func(topic string, partition int32, err error) { log.Print(err) })
		fetches.EachRecord(func(r *kgo.Record) {
			var o Order
			if err := json.Unmarshal(r.Value, &o); err != nil {
				log.Printf("skipped offset=%d: %v", r.Offset, err)
				return
			}
			// The primary key makes the insert idempotent: a redelivered event
			// (after a crash before the commit below) inserts nothing.
			tag, err := db.Exec(ctx,
				`INSERT INTO orders (id, customer, amount_cents) VALUES ($1, $2, $3) ON CONFLICT (id) DO NOTHING`,
				o.ID, o.Customer, o.AmountCents)
			switch {
			case err != nil:
				log.Fatal(err) // exit without committing; the record is read again after restart
			case tag.RowsAffected() == 0:
				log.Printf("duplicate id=%s", o.ID)
			default:
				log.Printf("stored id=%s", o.ID)
			}
		})
		// Writing first and committing second is at-least-once delivery.
		if err := client.CommitUncommittedOffsets(ctx); err != nil {
			log.Print(err)
		}
	}
}
