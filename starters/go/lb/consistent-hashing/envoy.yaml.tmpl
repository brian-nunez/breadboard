# envoy.yaml for ch-edge, shipped by the lb/consistent-hashing starter:
# yours to edit. bb up copies it into the container in place of the generated
# config (services.ch-edge.file in experiment.yaml).
#
# HTTPS on :8443 with ch-edge's certificate, then two clusters that hash the
# same four replicas of ch-backend by the X-User-ID header, so you can compare
# them side by side:
#   /maglev/...      -> cluster maglev    (lb_policy: MAGLEV)
#   everything else  -> cluster ring-hash (lb_policy: RING_HASH)
# The certificate (/etc/bb/tls/tls.crt and tls.key) and the lab CA
# (/etc/bb/ca.pem) are mounted by Breadboard. Keep the admin API on
# 127.0.0.1:15000: the container's health check reads /ready there.

node:
  id: ch-edge
  cluster: ch-edge
# Loopback only: the health check reads /ready; bb serve's Envoy clusters tab
# reads /clusters and /stats through docker exec.
admin:
  address:
    socket_address:
      address: 127.0.0.1
      port_value: 15000
static_resources:
  listeners:
    # HTTPS on :8443 with this service's certificate.
    - name: https
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 8443
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: https
                codec_type: AUTO
                # Envoy is the edge: it sets X-Forwarded-Proto from the
                # connection and appends the client's address to
                # X-Forwarded-For.
                use_remote_address: true
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                      # Each request with its key and the host it went to.
                      log_format:
                        text_format_source:
                          inline_string: "%REQ(:PATH)% x-user-id=%REQ(X-USER-ID)% -> %UPSTREAM_HOST% %RESPONSE_CODE% %DURATION%ms\n"
                route_config:
                  name: ch-edge
                  virtual_hosts:
                    - name: ch-edge
                      domains:
                        - '*'
                      routes:
                        # Routes match in order: /maglev/ first, then the rest.
                        - match:
                            prefix: /maglev/
                          route:
                            cluster: maglev
                            # The hash comes from the request: here the value
                            # of X-User-ID. Without the header, no hash is
                            # made and Envoy picks a host at random.
                            hash_policy:
                              - header:
                                  header_name: x-user-id
                        - match:
                            prefix: /
                          route:
                            cluster: ring-hash
                            hash_policy:
                              - header:
                                  header_name: x-user-id
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
          transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
              common_tls_context:
                tls_params:
                  tls_minimum_protocol_version: TLSv1_2
                alpn_protocols:
                  - h2
                  - http/1.1
                tls_certificates:
                  - certificate_chain:
                      filename: /etc/bb/tls/tls.crt
                    private_key:
                      filename: /etc/bb/tls/tls.key
  clusters:
    - name: ring-hash
      # Ring hash (Ketama): every host is hashed onto a ring many times (by
      # its address), and a request goes to the first host clockwise from the
      # hash of its key. Remove a host and the keys on its stretches of the
      # ring move to their next neighbour: about 1/N of them. Envoy keeps the
      # ring's size, so each remaining host also gets a few more points, and
      # those can take a few keys from another remaining host.
      # Strict DNS (the envoy.clusters.dns extension, which replaces the
      # STRICT_DNS type): every address ch-backend.{{.Domain}} resolves to is
      # a host, one per replica. Envoy resolves it again every 5s, so a
      # replica that stops leaves the cluster and one that starts joins it.
      cluster_type:
        name: envoy.clusters.dns
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster
          dns_lookup_family: V4_ONLY
          dns_refresh_rate: 5s
      connect_timeout: 2s
      lb_policy: RING_HASH
      ring_hash_lb_config:
        # Points on the ring, shared out between the hosts by weight (with 4
        # hosts, 256 each; with 3, 342 each). More points spread keys more
        # evenly and cost memory. Envoy's defaults: minimum 1024, maximum 8M.
        minimum_ring_size: 1024
        maximum_ring_size: 8388608
        hash_function: XX_HASH
      load_assignment:
        cluster_name: ring-hash
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: ch-backend.{{.Domain}}
                      port_value: 8443
      # Active checks: a host leaves the hash after 3 failed checks and
      # comes back after 2 good ones. GET / without X-User-ID is not cached.
      health_checks:
        - timeout: 2s
          interval: 2s
          no_traffic_interval: 2s
          unhealthy_threshold: 3
          healthy_threshold: 2
          http_health_check:
            host: ch-backend.{{.Domain}}
            path: /
            expected_statuses:
              - start: 200
                end: 500
      # Re-encrypt: TLS with SNI ch-backend.{{.Domain}}, verified against the
      # lab CA and matched to that name (on every replica's certificate).
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: ch-backend.{{.Domain}}
          common_tls_context:
            validation_context:
              trusted_ca:
                filename: /etc/bb/ca.pem
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher:
                    exact: ch-backend.{{.Domain}}
    - name: maglev
      # Maglev: a lookup table (65537 entries) that each host fills in turn
      # from its own permutation, so every host owns almost the same number
      # of entries; a request's key hash picks an entry. Lookups are fast and
      # the spread is even, but removing a host disturbs a few more keys than
      # ring hash does (Envoy's docs: about double, in simulations).
      # Strict DNS (the envoy.clusters.dns extension, which replaces the
      # STRICT_DNS type): every address ch-backend.{{.Domain}} resolves to is
      # a host, one per replica. Envoy resolves it again every 5s, so a
      # replica that stops leaves the cluster and one that starts joins it.
      cluster_type:
        name: envoy.clusters.dns
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster
          dns_lookup_family: V4_ONLY
          dns_refresh_rate: 5s
      connect_timeout: 2s
      lb_policy: MAGLEV
      maglev_lb_config:
        # Must be a prime number. 65537 is Envoy's default.
        table_size: 65537
      load_assignment:
        cluster_name: maglev
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: ch-backend.{{.Domain}}
                      port_value: 8443
      # Active checks: a host leaves the hash after 3 failed checks and
      # comes back after 2 good ones. GET / without X-User-ID is not cached.
      health_checks:
        - timeout: 2s
          interval: 2s
          no_traffic_interval: 2s
          unhealthy_threshold: 3
          healthy_threshold: 2
          http_health_check:
            host: ch-backend.{{.Domain}}
            path: /
            expected_statuses:
              - start: 200
                end: 500
      # Re-encrypt: TLS with SNI ch-backend.{{.Domain}}, verified against the
      # lab CA and matched to that name (on every replica's certificate).
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: ch-backend.{{.Domain}}
          common_tls_context:
            validation_context:
              trusted_ca:
                filename: /etc/bb/ca.pem
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher:
                    exact: ch-backend.{{.Domain}}
