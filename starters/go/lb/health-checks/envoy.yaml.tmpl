# envoy.yaml for hc-passive: PASSIVE health checking (outlier detection).
#
# Envoy sends no probes here. It watches the answers real requests get, and
# after 3 consecutive 5xx from one replica it ejects that replica for the
# ejection time. Detection is fast under traffic and costs nothing extra,
# but it needs failed user requests to start, and Envoy cannot see a
# recovery: an ejected replica comes back when its ejection time runs out,
# healed or not. If it fails again, it is ejected for longer.
#
# Compare hc-active (haproxy.cfg): the same replicas, probed every 2s.
#
# Breadboard requires the admin API on 127.0.0.1:15000 (the health check
# reads /ready) and the TLS listener on 8443 with the certificate under
# /etc/bb/tls; the lab CA is /etc/bb/ca.pem.

node:
  id: hc-passive
  cluster: hc-passive
# Loopback only: /ready for the health check; /clusters and /stats for
# explorers (bb serve, envoy_clusters), which show ejections.
admin:
  address:
    socket_address:
      address: 127.0.0.1
      port_value: 15000
static_resources:
  listeners:
    - name: https
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 8443
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: https
                codec_type: AUTO
                use_remote_address: true
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                route_config:
                  name: hc-passive
                  virtual_hosts:
                    - name: hc-passive
                      domains:
                        - '*'
                      # Tell the backend which proxy sent a request.
                      request_headers_to_add:
                        - header:
                            key: x-via
                            value: hc-passive
                          append_action: OVERWRITE_IF_EXISTS_OR_ADD
                      routes:
                        # No retry policy: every 5xx reaches the client, so
                        # you can count what passive detection costs.
                        - match:
                            prefix: /
                          route:
                            cluster: hc-backend
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
          transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
              common_tls_context:
                tls_params:
                  tls_minimum_protocol_version: TLSv1_2
                alpn_protocols:
                  - h2
                  - http/1.1
                tls_certificates:
                  - certificate_chain:
                      filename: /etc/bb/tls/tls.crt
                    private_key:
                      filename: /etc/bb/tls/tls.key
  clusters:
    - name: hc-backend
      # Strict DNS (the envoy.clusters.dns extension): every address
      # hc-backend.{{.Domain}} resolves to is a host, re-resolved every 5s.
      cluster_type:
        name: envoy.clusters.dns
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster
          dns_lookup_family: V4_ONLY
          dns_refresh_rate: 5s
      connect_timeout: 1s
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: hc-backend
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: hc-backend.{{.Domain}}
                      port_value: 8443
      # No health_checks block: no active probes, only outlier detection.
      outlier_detection:
        # Eject a host after 3 consecutive 5xx answers (or connection
        # failures). Envoy's default is 5.
        consecutive_5xx: 3
        # How often Envoy sweeps: un-ejects hosts whose time is up, and runs
        # the statistical detectors. Consecutive errors eject at once.
        interval: 1s
        # The first ejection lasts 10s (Envoy's default is 30s); each
        # ejection in a row multiplies it: 10s, 20s, 30s, ... up to
        # max_ejection_time (300s by default).
        base_ejection_time: 10s
        # Envoy never ejects more than this share of the cluster. Its
        # default of 10% would refuse to eject even one host of three (33%).
        max_ejection_percent: 50
      # Re-encrypt: TLS with SNI hc-backend.{{.Domain}}, verified against the
      # lab CA and matched to that name.
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: hc-backend.{{.Domain}}
          common_tls_context:
            validation_context:
              trusted_ca:
                filename: /etc/bb/ca.pem
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher:
                    exact: hc-backend.{{.Domain}}
