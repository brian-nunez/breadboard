// Command kv-admin manages a versioned JetStream Key-Value bucket ("flags"),
// demonstrating optimistic concurrency (CAS via kv.Update with expected
// revision), stale-revision conflict rejection, and live flag rotation.
package main

import (
	"context"
	"fmt"
	"log"
	"os"
	"os/signal"
	"syscall"
	"time"

	"github.com/nats-io/nats.go"
	"github.com/nats-io/nats.go/jetstream"
)

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	nc, err := nats.Connect(os.Getenv("NATS_URL"), nats.Token(os.Getenv("NATS_TOKEN")), nats.Name("kv-admin"))
	if err != nil {
		log.Fatalf("nats connect: %v", err)
	}
	defer nc.Close()

	js, err := jetstream.New(nc)
	if err != nil {
		log.Fatalf("jetstream init: %v", err)
	}

	kv, err := js.CreateOrUpdateKeyValue(ctx, jetstream.KeyValueConfig{
		Bucket:  "flags",
		History: 5,
		Storage: jetstream.FileStorage,
	})
	if err != nil {
		log.Fatalf("create kv bucket flags: %v", err)
	}

	// Seed initial keys (Put creates or overwrites unconditionally).
	rev, err := kv.PutString(ctx, "flags.checkout", "v1")
	if err != nil {
		log.Fatalf("put flags.checkout: %v", err)
	}
	_, _ = kv.PutString(ctx, "flags.rate_limit", "100")
	log.Printf("seeded KV bucket flags: flags.checkout=v1 (rev=%d), flags.rate_limit=100", rev)

	// Demonstrate optimistic concurrency: Update succeeds with the current
	// revision, then a stale-revision Update is rejected by the server.
	newRev, err := kv.Update(ctx, "flags.checkout", []byte("v2"), rev)
	if err != nil {
		log.Fatalf("cas update flags.checkout: %v", err)
	}
	log.Printf("CAS update succeeded: flags.checkout=v2 (rev=%d -> %d)", rev, newRev)

	if _, err := kv.Update(ctx, "flags.checkout", []byte("stale-write"), rev); err != nil {
		log.Printf("CAS stale revision=%d rejected as expected: %v", rev, err)
	}

	ticker := time.NewTicker(4 * time.Second)
	defer ticker.Stop()

	step := 2
	for {
		select {
		case <-ctx.Done():
			return
		case <-ticker.C:
			step++
			entry, err := kv.Get(ctx, "flags.checkout")
			if err != nil {
				log.Printf("get flags.checkout: %v", err)
				continue
			}
			val := fmt.Sprintf("v%d", step)
			updatedRev, err := kv.Update(ctx, "flags.checkout", []byte(val), entry.Revision())
			if err != nil {
				log.Printf("update flags.checkout: %v", err)
				continue
			}
			log.Printf("rotated flags.checkout=%s (rev=%d)", val, updatedRev)
		}
	}
}
