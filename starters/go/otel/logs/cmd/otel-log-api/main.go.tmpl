// Command otel-log-api receives HTTPS job requests, logs structured attributes
// through otelslog, and forwards them to otel-log-worker with X-Request-Id.
package main

import (
	"context"
	"errors"
	"fmt"
	"io"
	"log"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"strings"
	"syscall"
	"time"

	"go.opentelemetry.io/contrib/bridges/otelslog"
	"go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploggrpc"
	otellogglobal "go.opentelemetry.io/otel/log/global"
	sdklog "go.opentelemetry.io/otel/sdk/log"
	"go.opentelemetry.io/otel/sdk/resource"
	semconv "go.opentelemetry.io/otel/semconv/v1.43.0"
)

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	logger, shutdown := initLogger(ctx, "otel-log-api")
	defer func() {
		c, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = shutdown(c)
	}()

	workerURL := fmt.Sprintf("https://otel-log-worker.%s:8443/work", labDomain())
	client := &http.Client{Timeout: 5 * time.Second}

	mux := http.NewServeMux()
	mux.HandleFunc("/jobs", func(w http.ResponseWriter, r *http.Request) {
		reqID := r.Header.Get("X-Request-Id")
		customer := r.URL.Query().Get("customer")
		amount := r.URL.Query().Get("amount")

		logger.InfoContext(r.Context(), "received job",
			"request_id", reqID, "customer", customer, "amount", amount)

		req, err := http.NewRequestWithContext(r.Context(), http.MethodPost, workerURL+"?"+r.URL.RawQuery, nil)
		if err != nil {
			logger.ErrorContext(r.Context(), "build worker request failed", "request_id", reqID, "err", err.Error())
			http.Error(w, err.Error(), http.StatusInternalServerError)
			return
		}
		req.Header.Set("X-Request-Id", reqID)

		resp, err := client.Do(req)
		if err != nil {
			logger.ErrorContext(r.Context(), "worker call failed", "request_id", reqID, "err", err.Error())
			http.Error(w, err.Error(), http.StatusBadGateway)
			return
		}
		defer resp.Body.Close()

		body, _ := io.ReadAll(resp.Body)
		if resp.StatusCode >= 400 {
			logger.WarnContext(r.Context(), "worker returned error",
				"request_id", reqID, "status", resp.StatusCode, "customer", customer)
		} else {
			logger.InfoContext(r.Context(), "job completed", "request_id", reqID, "customer", customer)
		}

		w.WriteHeader(resp.StatusCode)
		_, _ = w.Write(body)
	})

	srv := &http.Server{
		Addr:              ":8443",
		Handler:           mux,
		ReadHeaderTimeout: 5 * time.Second,
	}

	go func() {
		<-ctx.Done()
		c, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = srv.Shutdown(c)
	}()

	log.Printf("otel-log-api listening on :8443 (forwarding to %s)", workerURL)
	if err := srv.ListenAndServeTLS(os.Getenv("TLS_CERT_FILE"), os.Getenv("TLS_KEY_FILE")); err != nil && !errors.Is(err, http.ErrServerClosed) {
		log.Fatal(err)
	}
}

func initLogger(ctx context.Context, fallback string) (*slog.Logger, func(context.Context) error) {
	name := os.Getenv("BB_SERVICE")
	if name == "" {
		name = fallback
	}
	res, err := resource.Merge(
		resource.Default(),
		resource.NewSchemaless(semconv.ServiceName(name), semconv.ServiceInstanceID(name)),
	)
	if err != nil {
		log.Fatalf("otel resource: %v", err)
	}
	exp, err := otlploggrpc.New(ctx, otlploggrpc.WithEndpointURL(os.Getenv("OTEL_EXPORTER_OTLP_ENDPOINT")))
	if err != nil {
		log.Fatalf("otel log exporter: %v", err)
	}
	lp := sdklog.NewLoggerProvider(sdklog.WithProcessor(sdklog.NewBatchProcessor(exp)), sdklog.WithResource(res))
	otellogglobal.SetLoggerProvider(lp)
	return otelslog.NewLogger(name), lp.Shutdown
}

func labDomain() string {
	if _, d, ok := strings.Cut(os.Getenv("BB_FQDN"), "."); ok && d != "" {
		return d
	}
	return "{{.Domain}}"
}
