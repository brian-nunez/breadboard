// Command otel-metrics-api serves HTTPS orders across replicas and exports
// Counter, UpDownCounter, Histogram, otelhttp, and Go runtime metrics over OTLP TLS.
package main

import (
	"context"
	"errors"
	"fmt"
	"log"
	"math/rand/v2"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp"
	"go.opentelemetry.io/contrib/instrumentation/runtime"
	"go.opentelemetry.io/otel"
	"go.opentelemetry.io/otel/attribute"
	"go.opentelemetry.io/otel/exporters/otlp/otlpmetric/otlpmetricgrpc"
	"go.opentelemetry.io/otel/metric"
	sdkmetric "go.opentelemetry.io/otel/sdk/metric"
	"go.opentelemetry.io/otel/sdk/resource"
	semconv "go.opentelemetry.io/otel/semconv/v1.43.0"
)

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	instance := os.Getenv("BB_SERVICE")
	if instance == "" {
		instance = "otel-metrics-api"
	}

	// Replicas share one logical service.name and distinguish themselves with service.instance.id.
	shutdown := initMeter(ctx, "otel-metrics-api", instance)
	defer func() {
		c, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = shutdown(c)
	}()

	if err := runtime.Start(runtime.WithMinimumReadMemStatsInterval(time.Second)); err != nil {
		log.Fatalf("runtime metrics: %v", err)
	}

	meter := otel.Meter("otel-metrics-api")
	ordersTotal, err := meter.Int64Counter("orders_processed",
		metric.WithDescription("Total orders processed by outcome"),
		metric.WithUnit("{order}"),
	)
	if err != nil {
		log.Fatal(err)
	}
	inFlight, err := meter.Int64UpDownCounter("orders_in_flight",
		metric.WithDescription("Orders currently being processed"),
		metric.WithUnit("{order}"),
	)
	if err != nil {
		log.Fatal(err)
	}
	duration, err := meter.Float64Histogram("order_duration_seconds",
		metric.WithDescription("Order handler latency"),
		metric.WithUnit("s"),
		metric.WithExplicitBucketBoundaries(0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1.0),
	)
	if err != nil {
		log.Fatal(err)
	}

	mux := http.NewServeMux()
	mux.HandleFunc("/orders", func(w http.ResponseWriter, r *http.Request) {
		start := time.Now()
		inFlight.Add(r.Context(), 1)
		defer inFlight.Add(r.Context(), -1)

		// Replica 2 runs slightly slower so learners can compare p95 per instance.
		delay := 20 + rand.IntN(40)
		if instance == "otel-metrics-api-2" {
			delay += 60
		}
		time.Sleep(time.Duration(delay) * time.Millisecond)

		status := "ok"
		code := http.StatusOK
		if r.URL.Query().Get("fail") == "true" {
			status = "error"
			code = http.StatusServiceUnavailable
		}

		attrs := metric.WithAttributes(
			attribute.String("tier", r.URL.Query().Get("tier")),
			attribute.String("status", status),
		)
		ordersTotal.Add(r.Context(), 1, attrs)
		duration.Record(r.Context(), time.Since(start).Seconds(), attrs)

		w.WriteHeader(code)
		fmt.Fprintf(w, "instance=%s status=%s latency_ms=%d\n", instance, status, delay)
	})

	srv := &http.Server{
		Addr:              ":8443",
		Handler:           otelhttp.NewHandler(mux, "orders-api"),
		ReadHeaderTimeout: 5 * time.Second,
	}

	go func() {
		<-ctx.Done()
		c, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = srv.Shutdown(c)
	}()

	log.Printf("%s listening on :8443", instance)
	if err := srv.ListenAndServeTLS(os.Getenv("TLS_CERT_FILE"), os.Getenv("TLS_KEY_FILE")); err != nil && !errors.Is(err, http.ErrServerClosed) {
		log.Fatal(err)
	}
}

func initMeter(ctx context.Context, service, instance string) func(context.Context) error {
	res, err := resource.Merge(
		resource.Default(),
		resource.NewSchemaless(semconv.ServiceName(service), semconv.ServiceInstanceID(instance)),
	)
	if err != nil {
		log.Fatalf("otel resource: %v", err)
	}
	exp, err := otlpmetricgrpc.New(ctx, otlpmetricgrpc.WithEndpointURL(os.Getenv("OTEL_EXPORTER_OTLP_ENDPOINT")))
	if err != nil {
		log.Fatalf("otel metric exporter: %v", err)
	}
	mp := sdkmetric.NewMeterProvider(
		sdkmetric.WithReader(sdkmetric.NewPeriodicReader(exp, sdkmetric.WithInterval(3*time.Second))),
		sdkmetric.WithResource(res),
	)
	otel.SetMeterProvider(mp)
	return mp.Shutdown
}
