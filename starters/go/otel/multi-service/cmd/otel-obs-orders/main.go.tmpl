// Command otel-obs-orders runs as 2 replicas: it writes orders to Postgres in a
// custom DB span, records DB metrics, logs via otelslog, and publishes events to
// Kafka with W3C traceparent injected into Kafka record headers.
package main

import (
	"context"
	"crypto/tls"
	"encoding/json"
	"errors"
	"fmt"
	"log"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"strings"
	"syscall"
	"time"

	"github.com/jackc/pgx/v5/pgxpool"
	"github.com/twmb/franz-go/pkg/kadm"
	"github.com/twmb/franz-go/pkg/kgo"
	"go.opentelemetry.io/contrib/bridges/otelslog"
	"go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp"
	"go.opentelemetry.io/otel"
	"go.opentelemetry.io/otel/attribute"
	"go.opentelemetry.io/otel/codes"
	"go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploggrpc"
	"go.opentelemetry.io/otel/exporters/otlp/otlpmetric/otlpmetricgrpc"
	"go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc"
	otellogglobal "go.opentelemetry.io/otel/log/global"
	"go.opentelemetry.io/otel/metric"
	"go.opentelemetry.io/otel/propagation"
	sdklog "go.opentelemetry.io/otel/sdk/log"
	sdkmetric "go.opentelemetry.io/otel/sdk/metric"
	"go.opentelemetry.io/otel/sdk/resource"
	sdktrace "go.opentelemetry.io/otel/sdk/trace"
	semconv "go.opentelemetry.io/otel/semconv/v1.43.0"
	"go.opentelemetry.io/otel/trace"
)

const topic = "obs-orders"

type orderEvent struct {
	OrderID  string `json:"order_id"`
	Customer string `json:"customer"`
	Fail     bool   `json:"fail"`
}

// kafkaHeaders adapts franz-go record headers to OpenTelemetry TextMapCarrier.
type kafkaHeaders []kgo.RecordHeader

func (h *kafkaHeaders) Get(key string) string {
	for _, kv := range *h {
		if kv.Key == key {
			return string(kv.Value)
		}
	}
	return ""
}

func (h *kafkaHeaders) Set(key, val string) {
	*h = append(*h, kgo.RecordHeader{Key: key, Value: []byte(val)})
}

func (h *kafkaHeaders) Keys() []string {
	keys := make([]string, len(*h))
	for i, kv := range *h {
		keys[i] = kv.Key
	}
	return keys
}

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	instance := os.Getenv("BB_SERVICE")
	if instance == "" {
		instance = "otel-obs-orders"
	}

	logger, shutdown := initOtel(ctx, "otel-obs-orders", instance)
	defer func() {
		c, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = shutdown(c)
	}()

	db, err := pgxpool.New(ctx, os.Getenv("DATABASE_URL"))
	if err != nil {
		log.Fatalf("postgres: %v", err)
	}
	defer db.Close()

	if _, err := db.Exec(ctx, `
		CREATE TABLE IF NOT EXISTS obs_orders (
			id TEXT PRIMARY KEY,
			customer TEXT NOT NULL,
			status TEXT NOT NULL,
			created_at TIMESTAMPTZ NOT NULL DEFAULT now()
		)`); err != nil {
		log.Fatalf("migrate: %v", err)
	}

	kafkaClient, err := kgo.NewClient(
		kgo.SeedBrokers(strings.Split(os.Getenv("KAFKA_BROKERS"), ",")...),
		kgo.DialTLSConfig(new(tls.Config)),
	)
	if err != nil {
		log.Fatalf("kafka: %v", err)
	}
	defer kafkaClient.Close()

	// Ensure the topic exists (Kafka auto-create is disabled in Breadboard).
	_, _ = kadm.NewClient(kafkaClient).CreateTopic(ctx, 3, 1, nil, topic)

	tracer := otel.Tracer("otel-obs-orders")
	meter := otel.Meter("otel-obs-orders")
	dbDuration, err := meter.Float64Histogram("orders_db_insert_seconds", metric.WithUnit("s"))
	if err != nil {
		log.Fatal(err)
	}

	mux := http.NewServeMux()
	mux.HandleFunc("/orders", func(w http.ResponseWriter, r *http.Request) {
		orderID := r.URL.Query().Get("order")
		customer := r.URL.Query().Get("customer")
		fail := r.URL.Query().Get("fail") == "true"

		dbCtx, dbSpan := tracer.Start(r.Context(), "db.insert_order",
			trace.WithSpanKind(trace.SpanKindClient),
			trace.WithAttributes(
				attribute.String("db.system", "postgresql"),
				attribute.String("order.id", orderID),
			),
		)
		start := time.Now()
		_, err := db.Exec(dbCtx,
			`INSERT INTO obs_orders (id, customer, status) VALUES ($1, $2, 'pending') ON CONFLICT (id) DO NOTHING`,
			orderID, customer,
		)
		dbDuration.Record(dbCtx, time.Since(start).Seconds())
		if err != nil {
			dbSpan.RecordError(err)
			dbSpan.SetStatus(codes.Error, err.Error())
			dbSpan.End()
			logger.ErrorContext(r.Context(), "insert order failed", "order_id", orderID, "err", err.Error())
			http.Error(w, err.Error(), http.StatusInternalServerError)
			return
		}
		dbSpan.End()

		// Inject the active trace context into Kafka record headers so the async
		// worker's consumer span continues this exact trace.
		pubCtx, pubSpan := tracer.Start(r.Context(), "kafka.produce",
			trace.WithSpanKind(trace.SpanKindProducer),
			trace.WithAttributes(
				attribute.String("messaging.system", "kafka"),
				attribute.String("messaging.destination.name", topic),
			),
		)
		var headers kafkaHeaders
		otel.GetTextMapPropagator().Inject(pubCtx, &headers)
		payload, _ := json.Marshal(orderEvent{OrderID: orderID, Customer: customer, Fail: fail})
		rec := &kgo.Record{Topic: topic, Key: []byte(customer), Value: payload, Headers: headers}
		if err := kafkaClient.ProduceSync(pubCtx, rec).FirstErr(); err != nil {
			pubSpan.RecordError(err)
			pubSpan.SetStatus(codes.Error, err.Error())
			pubSpan.End()
			logger.ErrorContext(r.Context(), "kafka produce failed", "order_id", orderID, "err", err.Error())
			http.Error(w, err.Error(), http.StatusBadGateway)
			return
		}
		pubSpan.End()

		logger.InfoContext(r.Context(), "order persisted and queued",
			"order_id", orderID, "customer", customer, "instance", instance)
		fmt.Fprintf(w, "queued order=%s by=%s\n", orderID, instance)
	})

	srv := &http.Server{
		Addr:              ":8443",
		Handler:           otelhttp.NewHandler(mux, "obs-orders"),
		ReadHeaderTimeout: 5 * time.Second,
	}

	go func() {
		<-ctx.Done()
		c, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = srv.Shutdown(c)
	}()

	log.Printf("%s listening on :8443", instance)
	if err := srv.ListenAndServeTLS(os.Getenv("TLS_CERT_FILE"), os.Getenv("TLS_KEY_FILE")); err != nil && !errors.Is(err, http.ErrServerClosed) {
		log.Fatal(err)
	}
}

func initOtel(ctx context.Context, service, instance string) (*slog.Logger, func(context.Context) error) {
	endpoint := os.Getenv("OTEL_EXPORTER_OTLP_ENDPOINT")
	res, err := resource.Merge(
		resource.Default(),
		resource.NewSchemaless(semconv.ServiceName(service), semconv.ServiceInstanceID(instance)),
	)
	if err != nil {
		log.Fatalf("otel resource: %v", err)
	}
	otel.SetTextMapPropagator(propagation.NewCompositeTextMapPropagator(propagation.TraceContext{}, propagation.Baggage{}))

	traceExp, err := otlptracegrpc.New(ctx, otlptracegrpc.WithEndpointURL(endpoint))
	if err != nil {
		log.Fatalf("otel trace exporter: %v", err)
	}
	tp := sdktrace.NewTracerProvider(sdktrace.WithBatcher(traceExp), sdktrace.WithResource(res))
	otel.SetTracerProvider(tp)

	metricExp, err := otlpmetricgrpc.New(ctx, otlpmetricgrpc.WithEndpointURL(endpoint))
	if err != nil {
		log.Fatalf("otel metric exporter: %v", err)
	}
	mp := sdkmetric.NewMeterProvider(
		sdkmetric.WithReader(sdkmetric.NewPeriodicReader(metricExp, sdkmetric.WithInterval(3*time.Second))),
		sdkmetric.WithResource(res),
	)
	otel.SetMeterProvider(mp)

	logExp, err := otlploggrpc.New(ctx, otlploggrpc.WithEndpointURL(endpoint))
	if err != nil {
		log.Fatalf("otel log exporter: %v", err)
	}
	lp := sdklog.NewLoggerProvider(sdklog.WithProcessor(sdklog.NewBatchProcessor(logExp)), sdklog.WithResource(res))
	otellogglobal.SetLoggerProvider(lp)

	return otelslog.NewLogger(service), func(c context.Context) error {
		return errors.Join(tp.Shutdown(c), mp.Shutdown(c), lp.Shutdown(c))
	}
}
