# envoy.yaml for mirror-edge, from the proxy/request-mirroring starter. You
# own it: experiment.yaml sets services.mirror-edge.file to this file, and
# bb up loads your edits (bb up again after a change).
#
# Every request goes to v1, and Envoy sends a copy of it to v2 (a shadow).
# v2's answer is thrown away: the client only ever gets v1's. Envoy does
# not wait for v2 either, so a slow or failing v2 costs the client nothing.
#
#   https://mirror-edge:8443/      -> v1, mirrored to v2
#   https://mirror-edge:8443/v1/   -> v1 directly (prefix stripped)
#   https://mirror-edge:8443/v2/   -> v2 directly (prefix stripped)
#                                     both to compare by hand; not mirrored
#
# Keep the admin API on 127.0.0.1:15000 (bb's health check reads /ready;
# bb serve's Envoy tab and MCP envoy_clusters read /clusters and /stats)
# and the TLS listener on 8443.

node:
  id: mirror-edge
  cluster: mirror-edge
admin:
  address:
    socket_address:
      address: 127.0.0.1
      port_value: 15000
static_resources:
  listeners:
    - name: https
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 8443
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: https
                codec_type: AUTO
                use_remote_address: true
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                route_config:
                  name: mirror-edge
                  virtual_hosts:
                    - name: mirror-edge
                      domains:
                        - '*'
                      routes:
                        # Each version by hand, to compare their answers.
                        # Routes match in order, so these come first.
                        - match:
                            prefix: /v1/
                          route:
                            cluster: v1
                            prefix_rewrite: /
                        - match:
                            prefix: /v2/
                          route:
                            cluster: v2
                            prefix_rewrite: /
                        # Everything else: v1 answers, v2 gets a copy.
                        - match:
                            prefix: /
                          route:
                            cluster: v1
                            request_mirror_policies:
                              - cluster: v2
                                # The share of requests to copy: 100%. Lower
                                # it to try v2 on a sample of traffic.
                                runtime_fraction:
                                  default_value:
                                    numerator: 100
                                    denominator: HUNDRED
                                # Envoy appends -shadow to the copy's Host
                                # (mirror-edge.<domain>-shadow), so v2 can
                                # tell copies from real requests. Set
                                # disable_shadow_host_suffix_append: true to
                                # keep the Host unchanged.
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
          transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
              common_tls_context:
                tls_params:
                  tls_minimum_protocol_version: TLSv1_2
                alpn_protocols:
                  - h2
                  - http/1.1
                tls_certificates:
                  - certificate_chain:
                      filename: /etc/bb/tls/tls.crt
                    private_key:
                      filename: /etc/bb/tls/tls.key
  clusters:
    # v1: TLS to mirror-v1, verified against the lab CA as mirror-v1.<domain>.
    # Strict DNS (the envoy.clusters.dns extension): every address
    # mirror-v1.<domain> resolves to is a host, re-resolved every 5s.
    - name: v1
      cluster_type:
        name: envoy.clusters.dns
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster
          dns_lookup_family: V4_ONLY
          dns_refresh_rate: 5s
      connect_timeout: 2s
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: v1
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: mirror-v1.{{.Domain}}
                      port_value: 8443
      health_checks:
        - timeout: 2s
          interval: 2s
          no_traffic_interval: 2s
          unhealthy_threshold: 3
          healthy_threshold: 2
          http_health_check:
            host: mirror-v1.{{.Domain}}
            path: /
            # Any answer below 500 means up: the app has no route for
            # GET / and answers 405, which proves it is serving.
            expected_statuses:
              - start: 200
                end: 500
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: mirror-v1.{{.Domain}}
          common_tls_context:
            validation_context:
              trusted_ca:
                filename: /etc/bb/ca.pem
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher:
                    exact: mirror-v1.{{.Domain}}
    # v2: the same, to mirror-v2. Its failing orders (500 to POST /orders)
    # do not touch the health check, so the copies keep flowing.
    - name: v2
      cluster_type:
        name: envoy.clusters.dns
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster
          dns_lookup_family: V4_ONLY
          dns_refresh_rate: 5s
      connect_timeout: 2s
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: v2
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: mirror-v2.{{.Domain}}
                      port_value: 8443
      health_checks:
        - timeout: 2s
          interval: 2s
          no_traffic_interval: 2s
          unhealthy_threshold: 3
          healthy_threshold: 2
          http_health_check:
            host: mirror-v2.{{.Domain}}
            path: /
            # Any answer below 500 means up: the app has no route for
            # GET / and answers 405, which proves it is serving.
            expected_statuses:
              - start: 200
                end: 500
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: mirror-v2.{{.Domain}}
          common_tls_context:
            validation_context:
              trusted_ca:
                filename: /etc/bb/ca.pem
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher:
                    exact: mirror-v2.{{.Domain}}
